    /* ═══════════════════════════════════════════════════════════
       REGLAS DE IMPRESIÓN / EXPORTAR A PDF
       ═══════════════════════════════════════════════════════════
       Objetivo: al hacer Ctrl+P (o Cmd+P) → "Guardar como PDF",
       el manual se renderiza limpio, en una sola columna, sin
       índice lateral ni botones flotantes. El color de los chips
       se conserva para que la lectura de estados siga siendo útil.
    */
    @media print {
      /* 1) Forzar esquema claro al imprimir: ahorra tinta y mejora
            la legibilidad sobre papel blanco. */
      :root,
      body.light {
        --bg: #ffffff;
        --surface: #ffffff;
        --surface-2: #f8fafc;
        --border: #cbd5e1;
        --text: #0f172a;
        --text-dim: #475569;
      }

      body, body.light {
        background: #ffffff !important;
        color: #0f172a !important;
        color-scheme: light !important;
        font-size: 11.5px;
        line-height: 1.5;
        padding: 0 !important;
      }

      /* 2) Ocultar todo lo que es interacción, no contenido. */
      .sidebar,
      #btnTop,
      #btnTheme,
      .sidebar-theme-wrap {
        display: none !important;
      }

      /* 3) Layout a una sola columna, sin gaps laterales. */
      .manual-layout {
        display: block !important;
        grid-template-columns: 1fr !important;
        gap: 0 !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .content { min-width: 0 !important }

      /* 4) Evitar cortes feos dentro de bloques lógicos. */
      .manual-section,
      .manual-table,
      .captura,
      .callout {
        break-inside: avoid;
        page-break-inside: avoid;
      }

      /* 5) Mantener el color de los chips de estado (verde, ámbar,
            azul, etc.). Sin esto, Chrome los imprime en blanco y
            negro y se pierde la lectura rápida del estado. */
      .chip,
      .content-header h1,
      .meta-badge,
      .site-footer .badge {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* 6) Encabezado: reducir tamaño y eliminar el gradiente
            (algunas impresoras no renderizan background-clip: text
            y el título sale invisible). */
      .content-header {
        padding-bottom: 12px;
        margin-bottom: 20px;
      }
      .content-header h1 {
        font-size: 1.5rem;
        background: none !important;
        -webkit-text-fill-color: #0f172a !important;
        color: #0f172a !important;
      }

      /* 7) Secciones y encabezados: reducir márgenes para ganar
            densidad de contenido por página. */
      .manual-section { margin-bottom: 22px }
      .manual-section > h2 { font-size: 1.05rem; margin-bottom: 6px }
      .manual-section > h3 { font-size: .92rem; margin-top: 14px }
      .manual-section > h4 { font-size: .86rem; margin-top: 12px }

      /* 8) Tablas: reducir padding y tamaño de fuente. Evitar
            anchos forzados que rompan el layout del papel. */
      .manual-table {
        font-size: .72rem;
        page-break-inside: auto;
      }
      .manual-table th { padding: 6px 8px; font-size: .62rem }
      .manual-table td { padding: 6px 8px }
      .manual-table tr { break-inside: avoid }
      .manual-table thead { display: table-header-group }

      /* 9) Callouts: menos padding y borde más sutil. */
      .callout {
        padding: 10px 14px;
        margin: 10px 0;
        font-size: .78rem;
      }
      .callout .title { font-size: .68rem }

      /* 10) Figuras: dejar que la imagen escale al ancho del papel
             y evitar que se partan entre páginas. */
      .captura {
        margin: 10px 0 14px;
        break-inside: avoid;
      }
      .captura img { max-width: 100%; height: auto }
      .captura figcaption { padding: 6px 12px; font-size: .68rem }
      .captura .placeholder { min-height: 120px; padding: 20px 16px }

      /* 11) Footer: sin margen superior grande. */
      footer.site-footer {
        margin-top: 20px;
        padding: 12px 0;
        font-size: .66rem;
        max-width: 100%;
      }

      /* 12) Opcional: expandir URLs para que se vean en papel.
             Descomenta si quieres que aparezcan los enlaces. */
      /*
      a[href]::after {
        content: " (" attr(href) ")";
        font-size: .65em;
        color: #64748b;
      }
      */

      /* 13) Control de viudas/huérfanas en párrafos. */
      p, li { orphans: 3; widows: 3 }
    }
  </style>
