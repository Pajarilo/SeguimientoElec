    // ═══════════════════════════════════════════════════════════
    //  MANUAL DE USUARIO — POPUP CON IMÁGENES DESDE HOJA "img"
    //  Versión: __MANUAL_VERSION__
    // ═══════════════════════════════════════════════════════════

    function getModo(){
      return (typeof google !== 'undefined' && google.script && google.script.run)
        ? 'script'
        : 'local';
    }

    function toggleTheme(){
      document.body.classList.toggle('light');
      const btn = document.getElementById('btnTheme');
      if(document.body.classList.contains('light')){
        btn.textContent = '☀️ Modo claro';
        try{ localStorage.setItem('emoac-manual-theme','light'); }catch(e){}
      } else {
        btn.textContent = '🌙 Modo oscuro';
        try{ localStorage.setItem('emoac-manual-theme','dark'); }catch(e){}
      }
    }
    (function(){
      try{
        const saved = localStorage.getItem('emoac-manual-theme');
        const btn = document.getElementById('btnTheme');
        if(saved === 'light'){
          document.body.classList.add('light');
          if(btn) btn.textContent = '☀️ Modo claro';
        } else {
          document.body.classList.remove('light');
          if(btn) btn.textContent = '🌙 Modo oscuro';
        }
      }catch(e){}
    })();

    (function(){
      const enlaces = Array.from(document.querySelectorAll('#indice a'));
      const secciones = enlaces
        .map(a => document.querySelector(a.getAttribute('href')))
        .filter(Boolean);

      function onScroll(){
        const y = window.scrollY + 120;
        let activo = secciones[0];
        secciones.forEach(sec => {
          if(sec.offsetTop <= y) activo = sec;
        });
        enlaces.forEach(a => {
          a.classList.toggle('active',
            activo && a.getAttribute('href') === '#' + activo.id
          );
        });

        const btnTop = document.getElementById('btnTop');
        if(btnTop) btnTop.classList.toggle('show', window.scrollY > 400);
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();

    async function cargarImagenesManual(){
      let mapa = {};
      try{
        mapa = await apiGetImagenesManual();
      }catch(e){
        console.warn('No se pudieron cargar las imágenes del manual:', e);
        return;
      }

      const norm = (s) => String(s == null ? '' : s)
        .trim()
        .toLowerCase()
        .replace(/\s+/g, '-');

      const mapaNorm = {};
      Object.keys(mapa || {}).forEach(k => {
        mapaNorm[norm(k)] = mapa[k];
      });

      const imgs = document.querySelectorAll('img[data-img]');
      imgs.forEach(img => {
        const clave = img.getAttribute('data-img');
        const id = mapaNorm[norm(clave)];
        if(!id){
          return;
        }
        if (id.indexOf('data:') === 0) {
          img.src = id;
        } else {
          img.referrerPolicy = 'no-referrer';
          img.src = 'https://lh3.googleusercontent.com/d/' + id;
        }
        img.hidden = false;
        img.dataset.hidratada = '1';
        const fig = img.closest('figure.captura');
        if(fig){
          const ph = fig.querySelector('.placeholder');
          if(ph) ph.remove();
        }
        img.onerror = function(){
          img.hidden = true;
          const fig2 = img.closest('figure.captura');
          if(fig2 && !fig2.querySelector('.placeholder')){
            const ph = document.createElement('div');
            ph.className = 'placeholder';
            ph.innerHTML =
              '<span class="icon">⚠️</span>' +
              '<span class="label">No se pudo cargar la imagen "' + clave + '"</span>' +
              '<span class="hint">Revisa que el ID en la hoja "img" sea correcto y que el archivo sea público.</span>';
            fig2.insertBefore(ph, img);
          }
        };
      });
    }

    function _normalizarMapaImagenes(res){
      if(Array.isArray(res)){
        const obj = {};
        res.forEach(function(fila){
          if(!fila) return;
          const nombre = fila.nombre || fila.name || fila[0];
          const id     = fila.id     || fila.ID   || fila[1];
          if(nombre && id) obj[nombre] = id;
        });
        return obj;
      }
      return res || {};
    }

    function apiGetImagenesManual(){
      return new Promise(function(resolve){
        try{
          if(window.__IMG_MANUAL__ && typeof window.__IMG_MANUAL__ === 'object'){
            resolve(_normalizarMapaImagenes(window.__IMG_MANUAL__));
            return;
          }
        }catch(e){}

        if(getModo() !== 'script'){
          resolve({});
          return;
        }
        google.script.run
          .withSuccessHandler(function(res){
            resolve(_normalizarMapaImagenes(res));
          })
          .withFailureHandler(function(){ resolve({}); })
          .obtenerImagenesManual();
      });
    }

    document.addEventListener('DOMContentLoaded', function(){
      cargarImagenesManual();
      _hidratarImagenesEnBackground();
    });

    async function _hidratarImagenesEnBackground(){
      if(typeof google === 'undefined' || !google.script || !google.script.run) return;
      let hidratadas = {};
      try{
        hidratadas = await new Promise((res, rej) => {
          google.script.run
            .withSuccessHandler(res)
            .withFailureHandler(rej)
            .obtenerImagenesManualHidratadasAsync();
        });
      }catch(e){ return; }

      const norm = (s) => String(s == null ? '' : s)
        .trim().toLowerCase().replace(/\s+/g, '-');

      const mapaNorm = {};
      Object.keys(hidratadas || {}).forEach(k => { mapaNorm[norm(k)] = hidratadas[k]; });

      document.querySelectorAll('img[data-img]').forEach(img => {
        const clave = img.getAttribute('data-img');
        const dataUri = mapaNorm[norm(clave)];
        if(!dataUri) return;
        if(img.src && img.src.indexOf('data:') === 0) return;
        if(img.dataset.hidratada === '1') return;
        img.src = dataUri;
        img.dataset.hidratada = '1';
      });
    }
  </script>

</body>

</html>
