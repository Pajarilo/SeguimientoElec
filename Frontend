function fechaObjetivo(periodo){
  const p=periodo.split('-').map(Number);
  const y=p[0],m=p[1];
  const ny=m===12?y+1:y;
  const nm=m===12?1:m+1;
  return new Date(ny,nm-1,DIA_RECEPCION,0,0,0,0);
}
function fechaValida(iso){
  if(!iso)return'';
  const s=String(iso).trim();
  if(SENTINELAS.indexOf(s)!==-1)return s;
  if(!/^\d{4}-\d{2}-\d{2}$/.test(s))return'';
  return s;
}
function fechaRelevante(f,contexto){
  if(contexto==='PEAJE')return fechaValida(f.fechaPeaje);
  if(contexto==='CONSUMO')return fechaValida(f.fechaConsumo);
  if(contexto==='ARRIENDO_MEDIDOR')return fechaValida(f.fechaPeaje)||fechaValida(f.fechaConsumo);
  return fechaValida(f.fechaConsumo)||fechaValida(f.fechaPeaje);
}
function camposFaltantes(f){
  const faltantes=[];
  const hasMonto=(Number(f.sum)>0)||(Number(f.peaje)>0);
  if(!hasMonto)faltantes.push('montos');
  if(!(Number(f.kwh)>0))faltantes.push('kWh');
  const em=fechaValida(f.fechaEmision);
  if(!em||SENTINELAS.indexOf(em)!==-1)faltantes.push('fecha emisión');
  const ve=fechaValida(f.fechaVencimiento);
  if(!ve||SENTINELAS.indexOf(ve)!==-1)faltantes.push('fecha vencimiento');
  return faltantes;
}
function tieneInfoCompleta(f){return camposFaltantes(f).length===0;}
function warnHTML(f){
  const falt=camposFaltantes(f);
  if(!falt.length)return'';
  return' <span class="warn-icon" title="Falta: '+falt.join(', ')+'">⚠</span>';
}
function estadoFactura(f,contexto){
  const fecha=fechaRelevante(f,contexto);
  if(fecha==='N/A')return'na';
  if(fecha==='S/I')return'si';

  // ─── 'Sin fecha' = recibida sin día explícito ───
  //  El documento existe (la factura está cargada) aunque el usuario
  //  no haya registrado la fecha exacta de recepción. Se marca como
  //  "recibida sin fecha", NUNCA como pendiente.
  if(fecha===SENTINELA_SIN_FECHA)return'recibida-sf';

  if(fecha){
    // ─── Recibida (con fecha real) ───
    //  El desfase (emisión → recepción) ya se muestra en su propia
    //  columna; un desfase grande NO convierte la factura en "Pendiente".
    return tieneInfoCompleta(f) ? 'recibida' : 'recibida-sf';
  }

  // ─── Sin fecha de recepción registrada (celda vacía) ───
  //  Si la factura YA EXISTE (tiene N° de factura cargado), el
  //  documento está en la base de datos pero el usuario no ha
  //  registrado la fecha exacta de recepción. Se clasifica como
  //  "recibida sin fecha" — nunca como Pendiente ni Por Emitir.
  //  Sólo cae a Pendiente / Por Emitir cuando no hay factura
  //  (celda vacía real, sin N°).
  const numero = String(f.numero || '').trim();
  if(numero) return 'recibida-sf';

  const hoy=new Date();hoy.setHours(0,0,0,0);
  const p=f.periodo.split('-').map(Number);
  const pm=p[0]*12+(p[1]-1);
  const hm=hoy.getFullYear()*12+hoy.getMonth();
  if(pm>=hm)return'por-emitir';
  return 'pendiente';
}
function fechaRecepcionParaDesfase(f){
  const tipo = String(f.tipo || '').toUpperCase();

  // ─── ARRIENDO_MEDIDOR ───
  // El backend guarda la fecha de recepción de arriendo en fechaPeaje
  // (ver refrescarSeguimiento). Se prioriza esa; si no, fechaConsumo.
  if(tipo === 'ARRIENDO_MEDIDOR'){
    const p = fechaValida(f.fechaPeaje);
    const c = fechaValida(f.fechaConsumo);
    const fR = (p && SENTINELAS.indexOf(p) === -1) ? p
             : (c && SENTINELAS.indexOf(c) === -1) ? c
             : '';
    if(fR) return { fecha: fR, referencial: false };
  }

  // ─── PEAJE ───
  if(tipo === 'PEAJE'){
    const p = fechaValida(f.fechaPeaje);
    if(p && SENTINELAS.indexOf(p) === -1){
      return { fecha: p, referencial: false };
    }
  }

  // ─── SUMINISTRO (alias: CONSUMO) ───
  if(tipo === 'SUMINISTRO' || tipo === 'CONSUMO'){
    const c = fechaValida(f.fechaConsumo);
    if(c && SENTINELAS.indexOf(c) === -1){
      return { fecha: c, referencial: false };
    }
  }

  // ─── UNIFICADA (o tipo desconocido) ───
  // Se toma la fecha más tardía entre consumo y peaje: la factura
  // se considera "recibida" cuando ambas partes llegaron.
  {
    const c = fechaValida(f.fechaConsumo);
    const p = fechaValida(f.fechaPeaje);
    const cOK = c && SENTINELAS.indexOf(c) === -1;
    const pOK = p && SENTINELAS.indexOf(p) === -1;
    if(cOK || pOK){
      let fR;
      if(cOK && pOK) fR = (c > p) ? c : p;
      else           fR = cOK ? c : p;
      return { fecha: fR, referencial: false };
    }
  }

  // Sin fecha de recepción real → fallback referencial a fechaEmision.
  // El flag referencial=true indica a los consumidores que este valor
  // NO es una fecha de recepción real y sólo sirve para clasificar
  // estado (Seguimiento). La columna Desfase del Detalle lo ignora.
  const em = fechaValida(f.fechaEmision);
  const numero = String(f.numero || '').trim();
  if(numero && em && SENTINELAS.indexOf(em) === -1){
    return { fecha: em, referencial: true };
  }

  return { fecha: '', referencial: false };
}

/**
 * Calcula la diferencia en días entre dos fechas ISO (YYYY-MM-DD).
 * Usa parseo numérico para evitar problemas de zona horaria/DST:
 * ambas fechas se interpretan como UTC a medianoche, y la diferencia
 * se redondea al día entero más cercano.
 */
function _diffDiasISO(isoDesde, isoHasta){
  if(!isoDesde || !isoHasta) return null;
  const a = String(isoDesde).split('-').map(Number);
  const b = String(isoHasta).split('-').map(Number);
  if(a.length !== 3 || b.length !== 3) return null;
  if(!a[0] || !a[1] || !a[2] || !b[0] || !b[1] || !b[2]) return null;
  const tA = Date.UTC(a[0], a[1] - 1, a[2]);
  const tB = Date.UTC(b[0], b[1] - 1, b[2]);
  return Math.round((tB - tA) / (1000 * 60 * 60 * 24));
}

function diasDesfase(f){
  const info=fechaRecepcionParaDesfase(f);
  if(!info.fecha)return null;

  // En la vista Detalle el desfase debe ser un dato cuantitativo real.
  // El fallback a fechaEmision (referencial=true) sólo sirve para
  // clasificar estado en Seguimiento; aquí devolvemos null para no
  // mostrar "0 días" cuando en realidad no hay fecha de recepción.
  if(info.referencial) return null;

  const em=fechaValida(f.fechaEmision);
  if(!em||SENTINELAS.indexOf(em)!==-1)return null;

  return _diffDiasISO(em, info.fecha);
}

function diasDesfaseSum(f){
  const rec = fechaValida(f.fechaConsumo);
  const em  = fechaValida(f.fechaEmision);
  if(!rec || SENTINELAS.indexOf(rec)!==-1) return null;
  if(!em  || SENTINELAS.indexOf(em) !==-1) return null;
  return _diffDiasISO(em, rec);
}
function diasDesfasePeaje(f){
  const rec = fechaValida(f.fechaPeaje);
  const em  = fechaValida(f.fechaEmision);
  if(!rec || SENTINELAS.indexOf(rec)!==-1) return null;
  if(!em  || SENTINELAS.indexOf(em) !==-1) return null;
  return _diffDiasISO(em, rec);
}

function desfaseEsReferencial(f){
  return fechaRecepcionParaDesfase(f).referencial;
}

function claseDesfase(d){
  if(d===null)return'';
  if(d<=7)return'ok';
  if(d<=9)return'alerta';
  return'alarma';
}

function contarEstadosGrid(centros, periodos){
  const k={recibidas:0,recibidas_sf:0,pendientes:0,porEmitir:0,dentroPlazo:0,sinInfo:0,noAplica:0,total:0};
  const centrosSet=new Set(centros.map(c=>c.cliente+' ('+c.codigo+')'));
  const periodosSet=new Set(periodos);
  FACTURAS.forEach(f=>{
    const keyCli=claveCliente(f);
    if(!centrosSet.has(keyCli)||!periodosSet.has(f.periodo))return;
    const ctx=f.tipo==='PEAJE'?'PEAJE':'CONSUMO';
    const est=estadoFactura(f,ctx);
    // Las N/A NO cuentan para el total del período: no son ni
    // recibidas ni pendientes ni por emitir — simplemente no existen
    // para el cálculo de gestión.
    if(est==='na'){ k.noAplica++; return; }
    k.total++;
    if(est==='si')k.sinInfo++;
    else if(est==='recibida')k.recibidas++;
    else if(est==='recibida-sf')k.recibidas_sf++;
    else if(est==='por-emitir')k.porEmitir++;
    else if(est==='pendiente')k.pendientes++;
  });
  const idx={};
  FACTURAS.forEach(f=>{
    const key=claveCliente(f)+'|'+f.periodo;
    if(!idx[key])idx[key]={consumo:false,peaje:false};
    if(f.tipo==='CONSUMO'||f.tipo==='SUMINISTRO'||f.tipo==='UNIFICADA')idx[key].consumo=true;
    if(f.tipo==='PEAJE'  ||f.tipo==='UNIFICADA')idx[key].peaje=true;
  });
  centros.forEach(c=>{
    const keyC=c.cliente+' ('+c.codigo+')';
    periodos.forEach(p=>{
      const cell=idx[keyC+'|'+p]||{consumo:false,peaje:false};
      ['consumo','peaje'].forEach(slot=>{
        if(!cell[slot]){
          k.total++;
          if(esPeriodoPasado(p))k.pendientes++;
          else k.porEmitir++;
        }
      });
    });
  });
  // Recalcular dentro de plazo con el criterio de ≤ DIAS_ATRASO días
  k.dentroPlazo = 0;
  FACTURAS.forEach(f => {
    if (!centrosSet.has(claveCliente(f)) || !periodosSet.has(f.periodo)) return;
    const ctx = (f.tipo === 'PEAJE') ? 'PEAJE' : 'CONSUMO';
    const est = estadoFactura(f, ctx);
    if (est !== 'recibida') return;
    const d = (ctx === 'PEAJE') ? diasDesfasePeaje(f) : diasDesfaseSum(f);
    if (d !== null && d <= DIAS_ATRASO) k.dentroPlazo++;
  });

  // ─── Atrasadas ───
  //  Misma definición que renderKPIs(): sólo recibidas con desfase
  //  > DIAS_ATRASO. Las pendientes NO entran.
  k.fueraPlazo = 0;
  FACTURAS.forEach(f => {
    if (!centrosSet.has(claveCliente(f)) || !periodosSet.has(f.periodo)) return;
    const ctx = (f.tipo === 'PEAJE') ? 'PEAJE' : 'CONSUMO';
    const est = estadoFactura(f, ctx);
    if (est !== 'recibida') return;
    const d = (ctx === 'PEAJE') ? diasDesfasePeaje(f) : diasDesfaseSum(f);
    if (d !== null && d > DIAS_ATRASO) k.fueraPlazo++;
  });

  return k;
}

function sumarMontos(facturas){
  let suministro=0,peaje=0,intereses=0;
  facturas.forEach(f=>{
    suministro+=Number(f.sum)||0;
    peaje+=Number(f.peaje)||0;
    intereses+=(Number(f.intereses)||0)+(Number(f.intPeaje)||0);
  });
  return {suministro,peaje,intereses,total:suministro+peaje};
}

