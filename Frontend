function _aplicarCamposAlModal(campos, { incluirCodigo = false } = {}) {
  const numIds = { fKwh:1, fSum:1, fPeaje:1, fInt:1, fIntPeaje:1, fOtros:1, fOtrosPeaje:1, fTotal:1 };
  let aplicados = 0;
  for (const k in campos) {
    const vv = campos[k];
    if (vv === undefined || vv === null || vv === '') continue;
    if (k === 'fDTE' || k === 'fEmpresa') continue;
    if (k === 'fCodigo' && !incluirCodigo) continue;
    const el = document.getElementById(k);
    if (!el) continue;
    el.value = numIds[k] ? numeroAInput(vv) : vv;
    try {
      el.dispatchEvent(new Event('input',  { bubbles: true }));
      el.dispatchEvent(new Event('change', { bubbles: true }));
    } catch (e) {}
    aplicados++;
  }
  if (campos.fTipo) {
    document.getElementById('fTipo').value = campos.fTipo;
    aplicados++;
  }
  return aplicados;
}

function _pintarWarnPDF(lista) {
  const warn = document.getElementById('pdfWarn');
  if (!warn) return;
  if (lista && lista.length) {
    warn.innerHTML = '<b>⚠ Posibles inconsistencias del PDF:</b><ul>' +
      lista.map(w => '<li>' + w + '</li>').join('') + '</ul>';
    warn.classList.add('show');
  } else {
    warn.classList.remove('show');
    warn.innerHTML = '';
  }
}

/**
 * Normaliza un código de cliente para comparar semánticamente.
 *   · Trim
 *   · Mayúsculas
 *   · Quita espacios internos
 *   · Quita guiones y puntos (por si el OCR los pierde o agrega)
 *   · Quita ceros a la izquierda de cada segmento
 *
 * Ejemplos equivalentes:
 *   "1519912-1" ≡ "1519912 - 1" ≡ "01519912-01" ≡ "1.519.912-1"
 */
function _normCodigoCliente(s){
  return String(s || '')
    .trim()
    .toUpperCase()
    .replace(/\s+/g, '')
    .replace(/[\.\-]/g, '')
    .replace(/^0+/, '');
}

/**
 * Normaliza un RUT chileno para comparar semánticamente.
 *   · Trim
 *   · Mayúsculas
 *   · Quita puntos, espacios y guiones
 *   · Quita ceros a la izquierda del cuerpo
 *
 * Ejemplos equivalentes:
 *   "56.064.200-8" ≡ "56064200-8" ≡ "560642008" ≡ "056064200-8"
 */
function _normRutComparable(s){
  let x = String(s || '')
    .trim()
    .toUpperCase()
    .replace(/[\.\s\-]/g, '');
  // Quitar ceros a la izquierda del cuerpo (pero conservar el DV).
  const m = x.match(/^0*(\d+)([0-9K])$/);
  if(m) x = m[1] + m[2];
  return x;
}

/**
 * Determina si el OCR detectó diferencias reales respecto al estado
 * actual del formulario.
 *
 * Disparadores del modal: Código cliente y Período.
 *   · Sólo cuando el OCR extrajo un valor Y ese valor es
 *     SEMÁNTICAMENTE distinto del formulario.
 *   · Las diferencias cosméticas (espacios, guiones, ceros a la
 *     izquierda, formato del RUT, mayúsculas) NO cuentan.
 *
 * El RUT se incluye como dato informativo SÓLO si el modal ya se va a
 * abrir por otra razón (código o período). Por sí solo NO dispara el
 * modal, porque la factura ya está identificada por su N° único.
 */
/**
 * Determina si el OCR detectó diferencias reales respecto al estado
 * actual del formulario.
 *
 * DISPARADORES del modal (únicos):
 *   · Código cliente (comparación semántica + validación contra CONFIG)
 *   · Período       (comparación estricta)
 *
 * El RUT se incluye como dato informativo SÓLO si el modal ya se va a
 * abrir por código o período. Por sí solo NUNCA dispara el modal.
 */
function _detectarDiscrepanciasOCR(campos, antes){
  const base = antes || {
    codigo:  (document.getElementById('fCodigo').value  || '').trim(),
    periodo: (document.getElementById('fPeriodo').value || '').trim(),
    rut:     (document.getElementById('fRut').value     || '').trim()
  };
  const diffs = {};

  const codOCR = String(campos.fCodigo  || '').trim();
  const perOCR = String(campos.fPeriodo || '').trim();
  const rutOCR = String(campos.fRut     || '').trim();

  // ─── Código cliente ───
  //  Estrategia en 3 pasos para minimizar falsos positivos:
  //
  //  1) Si el código del OCR coincide con el actual (semánticamente,
  //     sin puntos/guiones/ceros) → no hay diff.
  //  2) Si el código del OCR apunta a un centro que EXISTE en CONFIG
  //     (por _buscarCentroPorCodigo) y es el MISMO centro que el
  //     form tiene seleccionado → no hay diff (aunque el texto del
  //     form venga con formato distinto).
  //  3) En cualquier otro caso → sí hay diff.
  if(codOCR){
    const coincideSemantico =
      _normCodigoCliente(codOCR) === _normCodigoCliente(base.codigo);

    let coincidePorCentro = false;
    if(!coincideSemantico){
      const centroOCR = _buscarCentroPorCodigo(codOCR);
      if(centroOCR){
        // El form puede tener el código como valor del select (puro)
        // o, por error de algún flujo, el texto completo. Comparamos
        // ambos contra el centro encontrado por el OCR.
        const codForm = _normCodigoCliente(base.codigo);
        const codCentro = _normCodigoCliente(centroOCR.codigo);
        coincidePorCentro = (codForm === codCentro);
      }
    }

    if(!coincideSemantico && !coincidePorCentro){
      diffs.codigo = { actual: base.codigo, ocr: codOCR };
    }
  }

  // ─── Período ───
  //  Comparación estricta: sólo cuenta si son strings distintos.
  //  Los períodos ya vienen normalizados (YYYY-MM), así que una
  //  comparación exacta es la correcta aquí.
  if(perOCR && perOCR !== base.periodo){
    diffs.periodo = { actual: base.periodo, ocr: perOCR };
  }

  // ─── RUT ───
  //  Sólo informativo. No dispara el modal por sí solo.
  if (Object.keys(diffs).length && rutOCR
      && _normRutComparable(rutOCR) !== _normRutComparable(base.rut)) {
    diffs.rut = { actual: base.rut, ocr: rutOCR };
  }

  return diffs;
}

let _OCR_DIFFS_PENDIENTES = null;

function abrirModalOCRDiscrepancia(diffs){
  // Guardarraíles:
  //   · No abrir con un objeto vacío.
  //   · No abrir si el ÚNICO diff es RUT (que es informativo, no
  //     disparador). Debe existir al menos codigo o periodo.
  if(!diffs) return;
  const tieneDisparador =
    !!(diffs.codigo || diffs.periodo);
  if(!tieneDisparador) return;

  _OCR_DIFFS_PENDIENTES = diffs || {};

  const elCodOCR = document.getElementById('odCodigoOCR');
  const elPerOCR = document.getElementById('odPeriodoOCR');
  const elRutOCR = document.getElementById('odRutOCR');
  const selCentro = document.getElementById('odSelectCentro');
  const selPeriodo = document.getElementById('odSelectPeriodo');
  const inRut = document.getElementById('odRutInput');
  const err = document.getElementById('odError');

  if(elCodOCR) elCodOCR.textContent = diffs.codigo ? diffs.codigo.ocr : '—';
  if(elPerOCR) elPerOCR.textContent = diffs.periodo ? formatPeriodo(diffs.periodo.ocr) : '—';
  if(elRutOCR) elRutOCR.textContent = diffs.rut ? diffs.rut.ocr : '—';

  if(selCentro){
    selCentro.innerHTML = CONFIG.centros.map(c=>{
      const sel = (diffs.codigo && c.codigo === diffs.codigo.ocr) ? ' selected' : '';
      return '<option value="'+c.codigo+'"'+sel+'>'+c.cliente+' ('+c.codigo+')</option>';
    }).join('');
  }

  if(selPeriodo){
    const periodos = CONFIG.periodos.slice().sort();
    if(diffs.periodo && diffs.periodo.ocr && !periodos.includes(diffs.periodo.ocr)){
      periodos.push(diffs.periodo.ocr);
    }
    selPeriodo.innerHTML = periodos.map(p=>{
      const sel = (diffs.periodo && p === diffs.periodo.ocr) ? ' selected' : '';
      return '<option value="'+p+'"'+sel+'>'+formatPeriodo(p)+'</option>';
    }).join('');
  }

  if(inRut){
    inRut.value = diffs.rut ? diffs.rut.ocr : '';
  }

  if(err){ err.classList.remove('show'); err.innerHTML=''; }

  document.getElementById('modalOCRDiscrepancia').classList.add('open');
}

