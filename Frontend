let toastId = 0;
let toastComparacionActual = null;

// ============================================================
//  showToast — duración por defecto 10 s (20 s para largos)
// ============================================================
/**
 * Muestra un toast apilable en la esquina inferior derecha.
 *
 * Reglas de cierre:
 *   · Todos los toasts se cierran al hacerles click encima.
 *   · Los toasts normales duran 3 segundos por defecto.
 *   · Los toasts persistentes (ej. comparativa OCR) NO se cierran
 *     solos: sólo al clickear o al llamar a cerrarToastComparacion().
 *
 * @param {string} msg              Texto (admite saltos de línea).
 * @param {string} [tipo]           '' | 'ok' | 'err'  (color del borde).
 * @param {Object} [opciones]
 * @param {boolean} [opciones.persistente=false]  Si true, no expira solo.
 * @param {string}  [opciones.clase]              Clase CSS adicional.
 * @param {number}  [opciones.duracion]           Override de duración (ms).
 */
function showToast(msg, tipo = '', opciones = {}){
  const container = document.getElementById('toastContainer');
  if(!container) return;

  const toast = document.createElement('div');

  const id = ++toastId;

  toast.dataset.toastId = id;
  toast.className = 'toast ' + (tipo || '');

  if(opciones.clase){
    toast.classList.add(opciones.clase);
  }

  toast.textContent = String(msg ?? '');

  container.appendChild(toast);

  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      toast.classList.add('show');
    });
  });

  // ─── Cierre por click: TODOS los toasts ───
  toast.addEventListener('click', () => {
    cerrarToastElemento(toast);
  });

  // ─── Persistente: sólo se cierra por click o por código ───
  if(opciones.persistente){
    return toast;
  }

  // ─── Duración por defecto: 3 s ───
  const duracion = (typeof opciones.duracion === 'number' && opciones.duracion > 0)
    ? opciones.duracion
    : 3000;

  setTimeout(() => {
    cerrarToastElemento(toast);
  }, duracion);

  return toast;
}

/**
 * Igual que showToast, pero acepta HTML en lugar de texto plano.
 * Sólo se usa para el toast comparativo, que necesita 2 bloques
 * con estilos distintos (tabla monoespaciada + pie normal).
 *
 * NO se debe usar con contenido no confiable: el caller es
 * responsable de escapar lo que provenga del PDF/OCR.
 */
function _showToastHTML(html, tipo = '', opciones = {}){
  const container = document.getElementById('toastContainer');
  if(!container) return;

  const toast = document.createElement('div');
  const id = ++toastId;

  toast.dataset.toastId = id;
  toast.className = 'toast ' + (tipo || '');
  if(opciones.clase) toast.classList.add(opciones.clase);

  toast.innerHTML = String(html ?? '');
  container.appendChild(toast);

  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      toast.classList.add('show');
    });
  });

  toast.addEventListener('click', () => {
    cerrarToastElemento(toast);
  });

  if(opciones.persistente){
    return toast;
  }

  const duracion = (typeof opciones.duracion === 'number' && opciones.duracion > 0)
    ? opciones.duracion
    : 3000;

  setTimeout(() => {
    cerrarToastElemento(toast);
  }, duracion);

  return toast;
}

function cerrarToastElemento(toast){
  if(!toast || !toast.parentNode) return;

  toast.classList.remove('show');
  toast.classList.add('hide');

  setTimeout(() => {
    if(toast.parentNode){
      toast.parentNode.removeChild(toast);
    }
  }, 350);
}

function cerrarToastComparacion(){
  if(toastComparacionActual){
    cerrarToastElemento(toastComparacionActual);
    toastComparacionActual = null;
  }
}

