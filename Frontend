function escAttr(s){
  return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

/**
 * Detecta centros "fantasma" que no deben aparecer en el Detalle
 * ni en los selectores de filtro:
 *   · código = TEMP
 *   · nombre contiene "SIN ASIGNAR"
 *   · nombre contiene el emoji ⚠ (U+26A0)
 *
 * Se define aquí, junto a las utilidades del script, para que el
 * hoisting la exponga a todas las funciones que la usan más abajo.
 */
function _esCentroFantasma(codigo, cliente){
  const c = String(codigo || '').trim().toUpperCase();
  const n = String(cliente || '').toUpperCase();
  if(c === 'TEMP') return true;
  if(c.indexOf('SIN C') === 0) return true;   // "Sin código"
  if(n.indexOf('SIN ASIGNAR') !== -1) return true;
  if(n.indexOf('\u26A0') !== -1) return true;
  return false;
}

