          '<option value="Acierta"' + (c.empresa==='Acierta'           ?' selected':'') + '>Acierta</option>' +
        '</select>' +
      '</td>' +
      '<td id="celdaDriveOp_'+_escAttrMant(c.codigo)+'" style="'+cellStyle+'"></td>' +
      '<td id="celdaDriveCom_'+_escAttrMant(c.codigo)+'" style="'+cellStyle+'"></td>';

    tbody.appendChild(tr);

    tr.querySelectorAll('input[data-campo], select[data-campo]').forEach(el => {
      el.addEventListener('change', _onCampoCentroChange);
      el.addEventListener('blur',   _onCampoCentroChange);
    });

    renderDriveCellMant('celdaDriveOp_'+c.codigo,  c.driveOp,  c.codigo, 'op');
    renderDriveCellMant('celdaDriveCom_'+c.codigo, c.driveCom, c.codigo, 'com');
