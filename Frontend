    /* Encabezados de la tabla de Detalle: permitir wrap y limitar el ancho
       para que las columnas no se desborden del contenedor. */
    .summary-table th.num,
    .summary-table th:not(:first-child):not(.num) {
      white-space: normal;
      word-break: break-word;
      max-width: 120px;
      vertical-align: bottom;
    }

    .summary-table th.num {
      text-align: right
    }

    .summary-table td {
      /* Padding horizontal mínimo (6px) para que el ancho de cada
         columna lo dicte el contenido, no el "aire" interno. */
      padding: 8px 6px;
      border-bottom: 1px solid var(--border);
      height: auto;
      white-space: nowrap
    }

    .summary-table td.num {
      text-align: right;
      font-variant-numeric: tabular-nums
    }

    .summary-table th:first-child,
    .summary-table td:first-child {
      width: 1%;
      white-space: nowrap;
      /* min-width bajo (60px) para que la columna N° se ajuste al
         contenido típico (números de 4-7 dígitos). */
      min-width: 60px;
      padding: 8px 8px 8px 8px
    }

    /* La primera columna del Detalle contiene el N° de factura (dato
       corto). El encabezado "N°" también es corto. Ninguno fuerza
       ancho extra. */

    body:not(.light) .summary-table tr:hover td {
      background: rgba(59, 130, 246, .05)
    }

    body.light .summary-table tr:hover td {
      background: rgba(59, 130, 246, .06)
    }

    /* ─── Tabla del Mantenedor de Centros de Costo ───
       Anchos FIJOS por columna (table-layout:fixed). El modal que la
       contiene se autoajusta al contenido en vez de estirarse a un
       max-width predefinido. */
    .tabla-centros {
      table-layout: fixed;
      width: auto;
      /* deja que la tabla dicte su ancho */
      min-width: 0 !important;
      /* anula el min-width:1600px de .summary-table */
    }

    .tabla-centros th,
    .tabla-centros td {
      overflow: hidden;
      text-overflow: ellipsis;
      vertical-align: middle;
    }

    /* ─── Header pegajoso robusto ───
       Los <td> deben quedar SIEMPRE por debajo del <thead> al hacer
       scroll. En tablas con `table-layout:fixed` algunos navegadores
       no respetan el z-index del <th> si el <tbody> no tiene su propio
       contexto de apilamiento. Forzamos:
         · thead: z-index alto + aislamiento
         · tbody: z-index bajo + position relativo (crea contexto)      */
    .tabla-centros thead {
      position: relative;
      z-index: 3;
    }

    .tabla-centros thead th {
      position: sticky;
      top: 0;
      z-index: 3;
      background: var(--surface-2);
    }

    .tabla-centros tbody {
      position: relative;
      z-index: 1;
    }

    .tabla-centros tbody td {
      position: relative;
      z-index: 1;
      background: var(--surface);
    }

    /* Aire arriba del header cuando el modal NO tiene scroll: como le
       quitamos el padding-top al .modal-body, lo reponemos aquí. */
    .tabla-centros thead th {
      padding-top: 14px;
      padding-bottom: 10px;
    }

    /* Anchos fijos por columna (aplican a th y td por igual) */
