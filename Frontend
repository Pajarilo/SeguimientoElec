<!DOCTYPE html>
<html lang="es-CL">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Seguimiento de Facturación Electricidad - U.S. Urban Realty Chile</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box
    }

    :root {
      --bg: #0f1115;
      --surface: #171a21;
      --surface-2: #1f232c;
      --border: #2e333e;
      --text: #e7e9ee;
      --text-dim: #9097a6;
      --green: #10b981;
      --amber: #f59e0b;
      --accent: #3b82f6;
      --red: #ef4444
    }

    body.light {
      --bg: #f1f5f9;
      --surface: #fff;
      --surface-2: #f8fafc;
      --border: #e2e8f0;
      --text: #0f172a;
      --text-dim: #64748b
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--bg);
      color: var(--text);
      padding: 24px;
      font-size: 13px;
      line-height: 1.5;
      transition: background .2s, color .2s;
      color-scheme: dark
    }

    body.light {
      color-scheme: light
    }

    input[type=date]::-webkit-calendar-picker-indicator {
      filter: invert(.8);
      cursor: pointer
    }

    body.light input[type=date]::-webkit-calendar-picker-indicator {
      filter: none
    }

    .container {
      max-width: 1800px;
      margin: 0 auto
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: 12px;
      gap: 20px;
      flex-wrap: wrap
    }

    header h1 {
      font-size: 1.5rem;
      font-weight: 700;
      background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text
    }

    /* El emoji no debe heredar el "text-fill transparente": si no,
       se renderiza como un recuadro azul en vez del ícono a color. */
    header h1 .h1-emoji {
      -webkit-text-fill-color: currentColor;
      color: var(--text);
      background: none;
      -webkit-background-clip: border-box;
      background-clip: border-box;
      margin-right: 6px;
    }

    body.light header h1 {
      background: linear-gradient(135deg, #1d4ed8 0%, #0891b2 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text
    }

    header .subtitle {
      color: var(--text-dim);
      font-size: .82rem;
      margin-top: 4px
    }

    .header-actions {
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap
    }

    /* Buscador de factura — reusable desde cualquier contenedor
       (header-actions o status-actions). El tamaño fino se ajusta
       por contexto más abajo. */
    .buscador-factura {
      display: inline-flex;
      align-items: stretch;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
      transition: border-color .15s;
    }

    .buscador-factura:focus-within {
      border-color: var(--accent);
    }

    .buscador-factura input {
      background: transparent;
      border: none;
      color: var(--text);
      padding: 8px 10px;
      font-family: inherit;
      font-size: .82rem;
      outline: none;
      width: 130px;
    }

    .buscador-factura input::placeholder {
      color: var(--text-dim);
      font-style: italic;
    }

    .buscador-factura input.no-encontrada::placeholder {
      color: #ef4444;
      font-weight: 600;
      font-style: normal;
    }

    .buscador-factura .btn-buscar-factura {
      background: transparent;
      border: none;
      border-left: 1px solid var(--border);
      color: var(--text-dim);
      padding: 0 10px;
      cursor: pointer;
      font-size: 1rem;
      line-height: 1;
      font-family: inherit;
      transition: all .15s;
    }

    .buscador-factura .btn-buscar-factura:hover {
      background: var(--accent);
      color: #fff;
    }

    /* Variante compacta dentro de .status-actions: homologa el alto,
       padding y tipografía con los .btn-sm vecinos ("📄 Cargar PDF
       (OCR)", "🔗 Cargar desde Drive (URL)", etc.) para que la fila
       quede visualmente alineada. */
    .status-actions .buscador-factura input {
      padding: 6px 10px;
      font-size: .76rem;
      width: 130px;
    }

    .status-actions .buscador-factura .btn-buscar-factura {
      padding: 0 10px;
      font-size: .95rem;
    }

    .header-actions .acciones-vista {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap
    }

    button {
      background: var(--surface-2);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 8px 14px;
      border-radius: 8px;
      cursor: pointer;
      font-size: .82rem;
      font-family: inherit;
      transition: all .15s;
      display: inline-flex;
      align-items: center;
      gap: 6px
    }

    button:hover {
      border-color: var(--accent);
      color: var(--accent)
    }

    body:not(.light) button:hover {
      background: #2a303b
    }

    body.light button:hover {
      background: #e2e8f0
    }

    button:disabled {
      opacity: .5;
      cursor: not-allowed
    }

    button.primary {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff
    }

    button.primary:hover {
      background: #2563eb;
      border-color: #2563eb;
      color: #fff
    }

    select {
      background: var(--surface-2);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 8px 12px;
      border-radius: 8px;
      font-family: inherit;
      font-size: .82rem;
      cursor: pointer;
      outline: none
    }

    select:hover {
      border-color: var(--accent)
    }

    .status-row {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 24px;
      flex-wrap: wrap
    }

    .status-row #status {
      max-width: 520px;
      text-align: right
    }

    .status-actions {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap
    }

    /* ─── Filter bar compartida entre las 3 vistas ───
       Los selects viven sin marco contenedor: se muestran sueltos,
       igual que el resto de los controles del header. Los valores
       son compartidos — cualquier vista los lee al renderizar. */
    .filter-bar {
      display: inline-flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
    }

    button.btn-sm {
      padding: 6px 11px;
      font-size: .76rem
    }

    /* ─── Altura unificada de todos los controles del header ───
       Fila superior (.header-actions) y fila de estado
       (.status-actions) comparten el mismo alto visual. Se fuerza
       min-height a 34px para botones, selects y el buscador, y se
       normaliza el padding vertical. */
    .header-actions button,
    .header-actions select,
    .status-actions button.btn-sm,
    .buscador-factura input {
      min-height: 34px;
      box-sizing: border-box;
    }

    .header-actions select {
      padding: 6px 12px;
      font-size: .8rem;
    }

    #status {
      color: var(--text-dim);
      font-size: .78rem;
      padding: 6px 12px;
      border-radius: 8px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis
    }

    #status.ok {
      color: #34d399;
      background: rgba(16, 185, 129, .08)
    }

    #status.err {
      color: #f87171;
      background: rgba(239, 68, 68, .08)
    }

    .kpis {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 12px;
      margin-bottom: 24px
    }

    .kpi {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
      position: relative;
      overflow: hidden;

      /* Layout interno en grid: el label ocupa la fila superior,
         y en la fila inferior el value (contador) queda a la
         izquierda y el meta (%) a su derecha, alineados por
         baseline. Si meta está vacío, el value ocupa su lugar. */
      display: grid;
      grid-template-columns: auto 1fr;
      grid-template-areas:
        "label label"
        "value meta";
      column-gap: 8px;
      row-gap: 2px;
      align-items: baseline;
    }

    body:not(.light) .kpi {
      background: linear-gradient(145deg, var(--surface) 0%, var(--surface-2) 100%)
    }

    .kpi::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 3px;
      height: 100%;
      background: var(--accent)
    }

    .kpi.green::before {
      background: var(--green)
    }

    .kpi.amber::before {
      background: var(--amber)
    }

    .kpi.red::before {
      background: var(--red)
    }

    .kpi.blue::before {
      background: var(--accent)
    }

    .kpi.gray::before {
      background: #6b7280
    }

    .kpi.purple::before {
      background: #a78bfa
    }

    .kpi .label {
      grid-area: label;
      font-size: .66rem;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: .6px;
      font-weight: 600
    }

    .kpi .value {
      grid-area: value;
      font-size: 1.35rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums
    }

    .kpi .meta {
      grid-area: meta;
      font-size: .7rem;
      color: var(--text-dim);
      font-style: italic;
      white-space: nowrap
    }

    .kpi.clickable {
      cursor: pointer;
      transition: border-color .15s, box-shadow .15s
    }

    .kpi.clickable:hover {
      border-color: var(--accent)
    }

    .kpi.clickable.active {
      border-color: var(--accent);
      box-shadow: 0 0 0 2px rgba(59, 130, 246, .25)
    }

    .filtro-fuera-plazo-banner {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 16px;
      margin-bottom: 16px;
      background: rgba(59, 130, 246, .08);
      border: 1px solid rgba(59, 130, 246, .3);
      border-radius: 10px;
      font-size: .8rem
    }

    .filtro-fuera-plazo-banner .fb-text {
      flex: 1
    }

    .filtro-fuera-plazo-banner .fb-close {
      padding: 4px 10px;
      font-size: .74rem
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px
    }

    @media (min-width:1100px) {
      .grid.lado-a-lado {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      /* Arriendo de medidor sigue ocupando todo el ancho, debajo */
      .grid.lado-a-lado>.card:nth-child(3) {
        grid-column: 1 / -1;
      }
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden
    }

    .card-head {
      padding: 14px 18px;
      background: var(--surface-2);
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      user-select: none;
      transition: background .15s;
    }

    .card-head:hover {
      background: var(--surface);
    }

    body.light .card-head:hover {
      background: #f1f5f9;
    }

    .card-head .chev {
      display: inline-block;
      margin-left: 4px;
      font-size: .7rem;
      color: var(--text-dim);
      transition: transform .2s ease;
      transform-origin: 50% 45%;
    }

    .card-head.collapsed .chev {
      transform: rotate(-90deg);
    }

    .card-head h2 {
      font-size: .95rem;
      display: flex;
      align-items: center;
      gap: 8px
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 8px rgba(16, 185, 129, .5)
    }

    .dot.amber {
      background: var(--amber);
      box-shadow: 0 0 8px rgba(245, 158, 11, .5)
    }

    .dot.blue {
      background: var(--accent);
      box-shadow: 0 0 8px rgba(59, 130, 246, .5)
    }

    .dot.gray {
      background: #4b5563;
      box-shadow: 0 0 8px rgba(75, 85, 99, .5)
    }

    .card-head .count {
      font-size: .72rem;
      color: var(--text-dim);
      background: var(--bg);
      padding: 3px 10px;
      border-radius: 20px;
      border: 1px solid var(--border)
    }

    .scroll {
      overflow: auto;
      max-height: 600px
    }

    .scroll::-webkit-scrollbar {
      width: 10px;
      height: 10px
    }

    .scroll::-webkit-scrollbar-track {
      background: var(--bg)
    }

    .scroll::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 5px
    }

    table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      font-size: .76rem
    }

    th {
      position: sticky;
      top: 0;
      background: var(--surface-2);
      color: var(--text-dim);
      padding: 10px 6px;
      font-size: .66rem;
      text-transform: uppercase;
      letter-spacing: .4px;
      font-weight: 600;
      text-align: center;
      border-bottom: 1px solid var(--border);
      z-index: 2;
      white-space: nowrap
    }

    th:first-child {
      text-align: left;
      padding-left: 16px;
      position: sticky;
      left: 0;
      z-index: 3;
      border-right: 1px solid var(--border);
      min-width: 240px
    }

    td {
      padding: 0;
      border-bottom: 1px solid var(--border);
      height: 42px;
      vertical-align: middle
    }

    td:first-child {
      text-align: left;
      padding: 10px 16px;
      font-weight: 500;
      position: sticky;
      left: 0;
      background: var(--surface);
      z-index: 1;
      border-right: 1px solid var(--border);
      font-size: .78rem
    }

    body:not(.light) tr:hover td:first-child {
      background: #1c2028
    }

    body.light tr:hover td:first-child {
      background: #f8fafc
    }

    .cell {
      text-align: center;
      cursor: pointer;
      padding: 4px;
      transition: background .15s;
      position: relative
    }

    .cell:hover {
      background: rgba(59, 130, 246, .10);
      outline: 1px dashed rgba(59, 130, 246, .4);
      outline-offset: -3px
    }

    .chip {
      display: inline-block;
      padding: 3px 8px;
      border-radius: 6px;
      font-size: .7rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      line-height: 1.4;
      white-space: nowrap;
      margin: 1px 0
    }

    .chip.recibida {
      background: rgba(16, 185, 129, .18);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, .35)
    }

    .chip.recibida-sf {
      background: rgba(16, 185, 129, .10);
      color: #34d399;
      border: 1px dashed rgba(16, 185, 129, .40);
      font-style: italic;
      font-weight: 500
    }

    .chip.pendiente {
      background: rgba(245, 158, 11, .12);
      color: #fbbf24;
      border: 1px solid rgba(245, 158, 11, .30);
      font-style: italic;
      font-weight: 500
    }

    .chip.por-emitir {
      background: rgba(74, 222, 128, .08);
      color: #86efac;
      border: 1px dashed rgba(74, 222, 128, .45);
      font-style: italic;
      font-weight: 500
    }

    .chip.plazo {
      background: rgba(59, 130, 246, .10);
      color: #60a5fa;
      border: 1px dashed rgba(59, 130, 246, .40);
      font-style: italic;
      font-weight: 500
    }

    .chip.si {
      background: rgba(107, 114, 128, .12);
      color: #9ca3af;
      border: 1px dashed rgba(107, 114, 128, .35);
      font-style: italic;
      font-weight: 500
    }

    .chip.na {
      background: rgba(148, 163, 184, .10);
      color: #cbd5e1;
      border: 1px dashed rgba(148, 163, 184, .40);
      font-style: italic;
      font-weight: 500
    }

    body.light .chip.recibida {
      background: rgba(16, 185, 129, .12);
      color: #047857;
      border-color: rgba(16, 185, 129, .45)
    }

    body.light .chip.recibida-sf {
      background: rgba(16, 185, 129, .08);
      color: #059669
    }

    body.light .chip.pendiente {
      background: rgba(245, 158, 11, .12);
      color: #b45309
    }

    body.light .chip.por-emitir {
      background: rgba(74, 222, 128, .15);
      color: #15803d
    }

    body.light .chip.plazo {
      background: rgba(59, 130, 246, .10);
      color: #1d4ed8
    }

    body.light .chip.si {
      background: rgba(107, 114, 128, .10);
      color: #4b5563
    }

    body.light .chip.na {
      background: rgba(100, 116, 139, .10);
      color: #475569
    }

    .warn-icon {
      display: inline-block;
      color: #f59e0b;
      margin-left: 4px;
      cursor: help;
      font-weight: 700
    }

    .cell-edit {
      display: flex;
      gap: 4px;
      align-items: center;
      justify-content: center;
      padding: 2px
    }

    .cell-edit input[type=date] {
      background: var(--bg);
      color: var(--accent);
      border: 2px solid var(--accent);
      border-radius: 6px;
      padding: 4px 6px;
      font-size: .72rem;
      font-family: inherit;
      outline: none;
      flex: 1;
      min-width: 0;
      max-width: 110px;
      text-align: center
    }

    .cell-edit button {
      padding: 2px 6px;
      font-size: .95rem;
      line-height: 1;
      border-radius: 6px;
      flex-shrink: 0;
      border: 1px solid var(--accent);
      background: rgba(59, 130, 246, .15);
      color: var(--accent);
      cursor: pointer;
      font-family: inherit;
      font-weight: 700
    }

    .cell-edit button:hover {
      background: var(--accent);
      color: #fff
    }

    .cell-edit button.ok {
      border-color: #10b981;
      background: rgba(16, 185, 129, .15);
      color: #10b981
    }

    .cell-edit button.ok:hover {
      background: #10b981;
      color: #fff
    }

    .cell-edit button.cancel {
      border-color: #ef4444;
      background: rgba(239, 68, 68, .12);
      color: #ef4444
    }

    .cell-edit button.cancel:hover {
      background: #ef4444;
      color: #fff
    }

    .legend {
      padding: 12px 18px;
      background: var(--surface-2);
      border-top: 1px solid var(--border);
      font-size: .7rem;
      color: var(--text-dim);
      display: flex;
      gap: 14px;
      flex-wrap: wrap
    }

    .legend span {
      display: flex;
      align-items: center;
      gap: 6px
    }

    .legend .sw {
      width: 12px;
      height: 12px;
      border-radius: 3px;
      display: inline-block
    }

    .legend .sw.recibida {
      background: rgba(16, 185, 129, .35);
      border: 1px solid rgba(16, 185, 129, .6)
    }

    .legend .sw.pendiente {
      background: rgba(245, 158, 11, .25);
      border: 1px solid rgba(245, 158, 11, .5)
    }

    .legend .sw.por-emitir {
      background: rgba(74, 222, 128, .15);
      border: 1px dashed rgba(74, 222, 128, .6)
    }

    .legend .sw.plazo {
      background: rgba(59, 130, 246, .20);
      border: 1px dashed rgba(59, 130, 246, .6)
    }

    .legend .sw.si {
      background: rgba(107, 114, 128, .20);
      border: 1px dashed rgba(107, 114, 128, .5)
    }

    .legend .sw.na {
      background: rgba(148, 163, 184, .20);
      border: 1px dashed rgba(148, 163, 184, .5)
    }

    .loading {
      padding: 60px 20px;
      text-align: center;
      color: var(--text-dim);
      font-size: .85rem
    }

    .loading::before {
      content: '';
      display: block;
      width: 32px;
      height: 32px;
      margin: 0 auto 16px;
      border: 3px solid var(--border);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin .8s linear infinite
    }

    @keyframes spin {
      to {
        transform: rotate(360deg)
      }
    }

    /* ============================================================
   TOASTS — SISTEMA APILABLE
   ============================================================ */

    #toastContainer {
      position: fixed;
      right: 24px;
      bottom: 24px;

      width: fit-content;
      min-width: 370px;
      max-width: calc(100vw - 48px);

      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 10px;

      z-index: 1300;
      pointer-events: none;
    }


    /* ------------------------------------------------------------
   Toast general
   ------------------------------------------------------------ */

    .toast {
      position: relative;

      width: 100%;
      max-width: 370px;
      box-sizing: border-box;

      background: var(--surface-2);

      border: 1px solid var(--border);
      border-left: 3px solid var(--accent);

      padding: 12px 18px;
      border-radius: 8px;

      /* Apariencia normal */
      font-size: .82rem;
      font-family: inherit;
      line-height: 1.6;

      color: var(--text);

      white-space: pre-line;

      box-shadow: 0 8px 24px rgba(0, 0, 0, .4);

      opacity: 0;
      transform: translateY(20px);

      transition:
        opacity .3s ease,
        transform .3s cubic-bezier(.34, 1.56, .64, 1);

      pointer-events: auto;
    }


    /* ------------------------------------------------------------
   Animación de entrada
   ------------------------------------------------------------ */

    .toast.show {
      opacity: 1;
      transform: translateY(0);
    }


    /* ------------------------------------------------------------
   Animación de salida
   ------------------------------------------------------------ */

    .toast.hide {
      opacity: 0;
      transform: translateY(20px);
    }


    /* ------------------------------------------------------------
   Estados
   ------------------------------------------------------------ */

    .toast.ok {
      border-left-color: var(--green);
    }

    .toast.err {
      border-left-color: var(--red);
    }


    /* ============================================================
   TOAST DE COMPARACIÓN
   ============================================================ */

    .toast.toast-comparacion {
      width: max-content;
      min-width: 370px;
      max-width: calc(100vw - 48px);

      /* Tipografía normal por defecto: sólo la "tabla" interna usa
         monoespaciada (ver .toast-comparacion .tabla-diff). */
      font-size: .78rem;
      line-height: 1.55;

      /* Permitir desplazamiento horizontal si fuera necesario */
      overflow-x: auto;

      /* Indicar que se puede hacer click para cerrar */
      cursor: pointer;

      border-left-color: var(--accent);
    }

    /* Encabezado del toast: tipografía normal, sin monoespaciado. */
    .toast.toast-comparacion .encabezado-diff {
      display: block;
      white-space: pre-line;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      font-weight: 600;
      font-size: .82rem;
      margin-bottom: 4px;
    }

    /* Bloque tabular: monoespaciado + pre para alinear columnas.
       Es el único fragmento del toast que necesita fuente ancha fija. */
    .toast.toast-comparacion .tabla-diff {
      font-family:
        ui-monospace,
        SFMono-Regular,
        Menlo,
        Monaco,
        Consolas,
        "Liberation Mono",
        monospace;
      white-space: pre;
      display: block;
    }

    /* Pie informativo del toast (línea "📄 …"): tipografía normal,
       saltos de línea respetados pero sin forzar monoespaciado. */
    .toast.toast-comparacion .pie-diff {
      display: block;
      white-space: pre-line;
      font-family: inherit;
      margin-top: 0;
    }

    .modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .6);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      z-index: 1100;
      opacity: 0;
      pointer-events: none;
      transition: opacity .2s
    }

    body.light .modal {
      background: rgba(15, 23, 42, .4)
    }

    .modal.open {
      opacity: 1;
      pointer-events: auto
    }

    .modal-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      max-width: 640px;
      width: 100%;
      max-height: 90vh;
      box-shadow: 0 24px 60px rgba(0, 0, 0, .6);
      transform: scale(.95);
      transition: transform .2s;
      display: flex;
      flex-direction: column;
      overflow: hidden
    }

    .modal-box.modal-box-wide {
      /* Antes 1300px (form 40% = 520px, preview 60% = 780px).
         Ahora la preview ocupa 72% del modal. Para que el formulario
         no pierda ancho útil (≥ 520px), el modal crece a 1900px:
           · form    28% × 1900 ≈ 532px  (≥ 520px original)
           · preview 72% × 1900 ≈ 1368px (vs. 780px originales)  */
      max-width: 1900px
    }

    /* Modal que se ajusta al contenido (ancho auto) — usado por el
       Mantenedor de Centros de Costo. Sustituye el ancho fijo por
       "hasta el 95% del viewport", pero se encoge si la tabla es
       más angosta. */
    .modal-box.modal-box-fit {
      width: auto;
      max-width: min(95vw, 1600px);
      display: inline-flex;
    }

    /* El modal del mantenedor se apoya en el scroll natural del
       .modal-body. Para que el header sticky de la tabla se ancle
       correctamente contra ESE contenedor, le fijamos un contexto
       de apilamiento explícito y un `overflow-anchor` predecible. */
    .modal-box.modal-box-fit .modal-body {
      position: relative;
      z-index: 0;
      overflow-anchor: none;
      padding-top: 0;
      /* el header sticky ya aporta el "respiro" */
    }

    .modal.open .modal-box {
      transform: scale(1)
    }

    .modal-body-flex {
      display: flex;
      gap: 20px;
      align-items: flex-start
    }

    .modal-col-form {
      flex: 1 1 auto;
      min-width: 0
    }

    .modal-col-preview {
      /* La preview ocupa 72% del ancho del modal (un 20% más que
         el 60% histórico). El formulario se estrecha un poco pero
         mantiene suficiente espacio para sus campos de 3 columnas. */
      flex: 0 0 72%;
      min-width: 520px;
      max-width: none;
      position: sticky;
      top: 0;
      display: flex;
      flex-direction: column
    }

    .modal-col-preview .preview-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: .78rem;
      color: var(--text-dim);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .4px;
      padding: 8px 12px;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 8px 8px 0 0;
      border-bottom: none
    }

    .modal-col-preview .preview-head button {
      background: transparent;
      border: none;
      color: var(--text-dim);
      font-size: 1rem;
      cursor: pointer;
      padding: 2px 6px;
      border-radius: 6px
    }

    .modal-col-preview .preview-head button:hover {
      background: var(--surface-2);
      color: var(--text)
    }

    .modal-col-preview iframe {
      width: 100%;
      height: 78vh;
      min-height: 520px;
      border: 1px solid var(--border);
      border-radius: 0 0 8px 8px;
      background: #fff;
      display: block;
      flex: 1 1 auto
    }

    .modal-col-preview #previewCanvasWrap {
      flex: 1 1 auto;
      overflow: auto;
      background: #2a2a2a;
      border: 1px solid var(--border);
      border-radius: 0 0 8px 8px;
      border-top: none;
      padding: 12px;
      max-height: 78vh;
      min-height: 520px
    }

    .modal-col-preview #previewCanvas {
      max-width: 100%;
      display: block;
      background: #fff;
      margin: 0 auto;
      box-shadow: 0 4px 12px rgba(0, 0, 0, .3)
    }

    @media (max-width:1000px) {
      .modal-body-flex {
        flex-direction: column
      }

      .modal-col-preview {
        flex: 1 1 auto;
        min-width: 0;
        max-width: none;
        position: static;
        width: 100%
      }

      .modal-col-preview iframe {
        height: 60vh;
        min-height: 420px
      }
    }

    /* Pantallas medianas (1000–1560px): la preview al 72% deja al
       formulario muy poco ancho útil. En ese rango se reduce la
       proporción a 60/40 para no asfixiar los campos de 3 columnas. */
    @media (min-width:1000px) and (max-width:1560px) {
      .modal-col-preview {
        flex: 0 0 55%;
        min-width: 420px
      }
    }

