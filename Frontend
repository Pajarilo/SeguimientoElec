function codigoDeFactura(f){
  if(f.codigo&&f.codigo.trim())return f.codigo.trim();
  const m=CONFIG.centros.find(e=>e.cliente===f.cliente);
  return m?m.codigo:'';
}
function claveCliente(f){
  const cod=codigoDeFactura(f);
  return f.cliente+' ('+(cod||'—')+')';
}
function parseClaveCliente(clave){
  const m=clave.match(/^(.+?)\s*\((.+?)\)\s*$/);
  if(m)return{cliente:m[1].trim(),codigo:m[2].trim()};
  return{cliente:clave,codigo:''};
}
function esPeriodoPasado(periodo){
  const hoy=new Date();hoy.setHours(0,0,0,0);
  const p=periodo.split('-').map(Number);
  const pm=p[0]*12+(p[1]-1);
  const hm=hoy.getFullYear()*12+hoy.getMonth();
  return pm<hm;
}
function valorMetrica(f,metrica){
  const s=Number(f.sum)||0;
  const p=Number(f.peaje)||0;
  const i=(Number(f.intereses)||0)+(Number(f.intPeaje)||0);
  if(metrica==='sum')return s;
  if(metrica==='peaje')return p;
  if(metrica==='intereses')return i;
  return s+p;
}
function hoyISO(){
  const d=new Date();
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
}
