const RUT_EMOAC = '76208888-6';

function _normRut(r)   { return String(r || '').replace(/[\.\s]/g, '').toUpperCase(); }
function _esRutEmoac(r){ return _normRut(r) === RUT_EMOAC; }

function _buscarCentroPorCodigo(valor) {
  const norm = s => String(s || '').trim().replace(/[\.\s\-]/g, '').toUpperCase();
