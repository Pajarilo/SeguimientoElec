}
function abrirModalAgregar(clave, periodo, tipoDefault, fechaInicial) {
  _abrirModal({ modo: 'crear', clave, periodo, tipo: tipoDefault, fechaInicial: fechaInicial || null });
}
function abrirModalAgregarExterno() {
  _abrirModal({ modo: 'crear', externo: true });
}

function abrirEditorCelda(td,items,contexto,clave,periodo,factura,fechaPrecargada){
  const contenidoOriginal=td.innerHTML;
  let finalizado=false;
  td.innerHTML='';
  const wrap=document.createElement('div');wrap.className='cell-edit';
  const input=document.createElement('input');input.type='date';
  // Un sentinel ('Sin fecha', 'N/A', 'S/I') no es una fecha válida para
  // el <input type="date">: se descarta y, si hay fechaPrecargada (hoy),
  // se usa esa.
  const fActual=factura?fechaRelevante(factura,contexto):'';
  let fInput=(fActual&&SENTINELAS.indexOf(fActual)===-1)?fActual:'';
  if(!fInput && fechaPrecargada) fInput=fechaPrecargada;
  input.value=fInput;input.defaultValue=fInput;
  const btnOk=document.createElement('button');btnOk.textContent='✔';btnOk.title='Guardar fecha (Enter)';btnOk.className='ok';
  btnOk.addEventListener('mousedown',e=>{e.preventDefault();e.stopPropagation();guardar();});
  const btnCancel=document.createElement('button');btnCancel.textContent='✕';btnCancel.title='Cancelar (Esc)';btnCancel.className='cancel';
  btnCancel.addEventListener('mousedown',e=>{e.preventDefault();e.stopPropagation();finalizado=true;td.innerHTML=contenidoOriginal;});
  const btnEdit=document.createElement('button');btnEdit.textContent='📝';btnEdit.title='Abrir modal para editar todos los datos';
  btnEdit.addEventListener('mousedown',e=>{
    e.preventDefault();e.stopPropagation();
    finalizado=true;td.innerHTML=contenidoOriginal;
    if(factura) abrirModalEditar(clave,periodo,contexto,factura);
    else abrirModalAgregar(clave,periodo,contexto);
  });
  const btnAdd=document.createElement('button');btnAdd.textContent='+';btnAdd.title='Agregar factura nueva en esta celda';
  btnAdd.addEventListener('mousedown',e=>{
    e.preventDefault();e.stopPropagation();
    finalizado=true;td.innerHTML=contenidoOriginal;
    abrirModalAgregar(clave,periodo,contexto);
  });
  wrap.appendChild(input);wrap.appendChild(btnOk);wrap.appendChild(btnCancel);wrap.appendChild(btnEdit);wrap.appendChild(btnAdd);
  td.appendChild(wrap);
  input.focus();
  if(input.showPicker)try{input.showPicker();}catch(e){}
  input.addEventListener('blur',()=>{ setTimeout(()=>{ if(!finalizado){finalizado=true;td.innerHTML=contenidoOriginal;} },150); });
  async function guardar(){
    if(finalizado)return;finalizado=true;
    const nf=input.value;
    if(factura){
      if(nf){
        // ─── (1) UPDATE OPTIMISTA INMEDIATO ───
        //  Reflejamos la fecha en el modelo y en la celda antes de
        //  tocar la red. La tabla se reconstruye después con cargar().
        if(contexto==='CONSUMO')factura.fechaConsumo=nf;
        else if(contexto==='PEAJE')factura.fechaPeaje=nf;
        if(factura.tipo==='UNIFICADA'){
          if(contexto==='CONSUMO')factura.fechaConsumo=nf;
          if(contexto==='PEAJE')factura.fechaPeaje=nf;
        }
        renderContenidoCelda(td,items,contexto,periodo);

        // Actualizar los KPIs (y contadores por período) al instante,
        // sin esperar al backend. El cargar() posterior reconcilia.
        renderKPIs();

        // ─── (2) TRABAJO EN BACKGROUND ───
        //  El modal de edición se abre YA (no esperamos el round-trip).
        //  La persistencia y el refresco corren en segundo plano.
        setTimeout(()=>abrirModalEditar(clave,periodo,contexto,factura),150);

        (async () => {
          try{
            const data = await apiPost({
              accion:'actualizarFecha',
              numero: factura.numero,
              fecha:  nf,
              tipo:   contexto
            });
            if(!data.ok) throw new Error(data.error);
            showToast('F-'+factura.numero+' recibida '+fmtFecha(nf),'ok');
          }catch(e){
            showToast('No se pudo guardar: '+e.message,'err');
          }finally{
            // Refresco autoritativo (revierte el optimista si falló).
            Promise.resolve()
              .then(() => cargar())
              .catch(err => console.warn('[editorCelda] cargar() falló:', err));
          }
        })();
        return;
      }
      // Sin fecha → reabrir el modal sin tocar la BD.
      td.innerHTML=contenidoOriginal;
      setTimeout(()=>abrirModalEditar(clave,periodo,contexto,factura),150);
      return;
    }
    if(!nf){td.innerHTML=contenidoOriginal;return;}
    setTimeout(()=>abrirModalAgregar(clave,periodo,contexto,nf),150);
  }
  input.addEventListener('keydown',e=>{
    if(e.key==='Enter'){e.preventDefault();guardar();}
    if(e.key==='Escape'){e.preventDefault();finalizado=true;td.innerHTML=contenidoOriginal;}
  });
}

let MODO_MODAL='crear';
let FACTURA_EDITANDO=null;

// ─── Toggles de filtro rápido en la vista Seguimiento ───
//  Son mutuamente excluyentes: activar uno desactiva el otro.
//  Ambos son volátiles (no se persisten): al recargar la página
//  vuelven a false.
//
//   · _FILTRO_FUERA_PLAZO → muestra sólo facturas RECIBIDAS con
//     MÁS DE DIAS_ATRASO días de desfase desde su emisión.
//   · _FILTRO_PENDIENTES  → muestra sólo facturas en estado
//     Pendiente (período pasado sin factura cargada).
let _FILTRO_FUERA_PLAZO = false;
let _FILTRO_PENDIENTES  = false;

// ─── Botón "Volver al Dashboard" ───
//  Se muestra SÓLO cuando el usuario llegó a Seguimiento haciendo
//  click en una barra del gráfico "Estado de recepción por mes" (o
//  en su título) desde el Dashboard. Al hacer click, vuelve al
//  Dashboard limpiando los filtros de centro y mes.
let _MOSTRAR_VOLVER_DASHBOARD = false;

/**
 * Determina si una factura está "atrasada" para el contexto dado.
 *
 * Definición: sólo cuentan las facturas YA RECIBIDAS cuyo desfase
 * (emisión → recepción) supera DIAS_ATRASO días.
 *
 * Excluidas explícitamente:
 *   · Pendientes      → tienen su propia categoría, no se mezclan aquí.
 *   · N/A y S/I       → estados de no-gestión.
 *   · 'recibida-sf'   → sin fecha de recepción, no se puede medir.
 *
 * Contexto:
 *   - CONSUMO  → fechaConsumo vs fechaEmision
 *   - PEAJE    → fechaPeaje   vs fechaEmision
 *   - ARRIENDO → fechaRelevante (fechaPeaje || fechaConsumo)
 */
function _esFacturaFueraPlazo(f, contexto){
  const ctxEstado = (contexto === 'ARRIENDO_MEDIDOR') ? 'ARRIENDO_MEDIDOR' : contexto;
  const est = estadoFactura(f, ctxEstado);

  // Sólo las recibidas con fecha real pueden estar "atrasadas".
  if (est !== 'recibida') return false;

  let d;
  if (contexto === 'PEAJE')                 d = diasDesfasePeaje(f);
  else if (contexto === 'ARRIENDO_MEDIDOR') d = diasDesfase(f);
  else                                      d = diasDesfaseSum(f);

  return d !== null && d > DIAS_ATRASO;
}

/**
 * Alterna el filtro "Atrasadas" (recibidas con desfase > DIAS_ATRASO)
 * y repinta la vista Seguimiento. Desactiva el filtro "Pendientes"
 * si estaba activo (son mutuamente excluyentes).
 * Llamada desde la tarjeta KPI y desde el botón del banner.
 */
function _toggleFiltroFueraPlazo(){
  if(VISTA !== 'KPI') return;
  _FILTRO_FUERA_PLAZO = !_FILTRO_FUERA_PLAZO;
  if(_FILTRO_FUERA_PLAZO) _FILTRO_PENDIENTES = false;
  render();
}

/**
 * Alterna el filtro "Pendientes" (períodos pasados sin factura
 * cargada) y repinta la vista Seguimiento. Desactiva el filtro
 * "Atrasadas" si estaba activo (son mutuamente excluyentes).
 * Llamada desde la tarjeta KPI y desde el botón del banner.
 */
function _toggleFiltroPendientes(){
  if(VISTA !== 'KPI') return;
  _FILTRO_PENDIENTES = !_FILTRO_PENDIENTES;
  if(_FILTRO_PENDIENTES) _FILTRO_FUERA_PLAZO = false;
  render();
}

/**
 * ¿Hay algún filtro rápido activo en la vista Seguimiento?
 * Útil para deshabilitar el contador de "celdas vacías" cuando
 * estamos mostrando sólo excepciones.
 */
function _hayFiltroRapidoActivo(){
  return _FILTRO_FUERA_PLAZO || _FILTRO_PENDIENTES;
}

/**
 * Determina si una CELDA (centro × período × contexto) debe
 * mostrarse cuando hay un filtro rápido activo.
 *
 *   · Sin filtro activo → siempre se muestra (no es este helper
 *     el que decide; lo usa renderTabla en su rama de filtro).
 *   · Filtro "Atrasadas"  → la celda con factura recibida tardía
 *     pasa; la celda vacía o con factura normal NO.
 *   · Filtro "Pendientes" → la celda vacía en período pasado pasa;
 *     la celda con factura NO.
 */
function _celdaPasaFiltroRapido(items, contexto, periodo){
  if(_FILTRO_FUERA_PLAZO){
    if(items.length === 0) return false;
    return items.some(f => _esFacturaFueraPlazo(f, contexto));
  }
  if(_FILTRO_PENDIENTES){
    if(items.length > 0) return false;
    return esPeriodoPasado(periodo);
  }
  return true;
}

/**
 * Quita el filtro rápido activo (Atrasadas o Pendientes) y repinta
 * la vista Seguimiento. Se invoca desde el botón "✕ Quitar filtro"
 * del banner.
 */
function _quitarFiltroRapido(){
  _FILTRO_FUERA_PLAZO = false;
  _FILTRO_PENDIENTES  = false;
  if(VISTA === 'KPI') render();
}

/**
 * Devuelve al Dashboard desde la vista Seguimiento, limpiando los
 * filtros de centro y mes que el usuario haya dejado activos al
 * navegar desde el gráfico "Estado de recepción por mes".
 * Se invoca desde el botón "← Volver al Dashboard" de la filter bar.
 */
function volverAlDashboardDesdeFiltros(){
  _MOSTRAR_VOLVER_DASHBOARD = false;
  _FILTRO_FUERA_PLAZO       = false;
  _FILTRO_PENDIENTES        = false;

  const selCentro = document.getElementById('filtroCentro');
  const selMes    = document.getElementById('filtroMes');
  if(selCentro) selCentro.value = 'todos';
  if(selMes)    selMes.value    = 'todos';

  irADashboard();
}

function _actualizarBotonesFactura(){
  // Rectificar y Eliminar requieren una factura existente. La
  // condición real es "¿hay una factura cargada en el modal?" —
  // no el MODO_MODAL, porque una fila N/A o sintética puede
  // abrirse en modo editar sin que MODO_MODAL refleje la
  // existencia real de la factura.
  const hayFactura = !!(FACTURA_EDITANDO && String(FACTURA_EDITANDO.numero || '').trim());

  ['btnRectificar','btnEliminar'].forEach(id=>{
    const el = document.getElementById(id);
    if(!el) return;
    el.style.opacity = hayFactura ? '1' : '0.5';
    el.style.pointerEvents = hayFactura ? '' : 'none';
    el.title = hayFactura
      ? el.title.split(' — ')[0]
      : (el.title.split(' — ')[0] + ' — Primero guarda la factura para habilitar');
  });

  // N/A siempre habilitado: un período puede no corresponder a emisión
  // aunque todavía no exista una factura cargada. Si no hay factura,
  // marcarNA() crea la fila sintética correspondiente.
  const btnNA = document.getElementById('btnNA');
  if(btnNA){
    btnNA.style.opacity = '1';
    btnNA.style.pointerEvents = '';
    btnNA.title = 'Marcar la factura como N/A (no corresponde emitir)';
  }
}

function _refrescarRutCentro(codigo, rutOCR){
  const el = document.getElementById('fRut');
