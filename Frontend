async function _extraerTextoIncrustadoPDF(base64){
  if(typeof pdfjsLib === 'undefined') return '';
  try{
    if(!pdfjsLib.GlobalWorkerOptions.workerSrc){
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js';
    }
    const bin = atob(base64);
    const bytes = new Uint8Array(bin.length);
    for(let i=0;i<bin.length;i++) bytes[i] = bin.charCodeAt(i);
    const pdf = await pdfjsLib.getDocument({ data: bytes }).promise;
    const maxPag = Math.min(pdf.numPages, 5);
    let texto = '';
    for(let p=1; p<=maxPag; p++){
      const page = await pdf.getPage(p);
      const content = await page.getTextContent();
      let linea = '';
      content.items.forEach(it => {
        if(it && it.str) linea += it.str + ' ';
        if(it && it.hasEOL) linea += '\n';
      });
      texto += linea + '\n';
    }
    return texto;
  }catch(e){
    console.warn('PDF.js getTextContent falló:', e);
    return '';
  }
}

async function _obtenerTextoPDF(base64Pdf, mimePdf, nombrePdf){
  const txtLocal = await _extraerTextoIncrustadoPDF(base64Pdf);
  const charsNoWS = (txtLocal||'').replace(/\s/g,'').length;
  console.log('[PDF.js] chars no-ws:', charsNoWS);

  if(txtLocal && charsNoWS > 100){
    if(!_esTextoBasuraFront(txtLocal)){
      console.log('[PDF.js] ✓ usando texto incrustado');
      return { ok: true, texto: txtLocal, motor: 'PDF.js (texto incrustado)' };
    }
    console.warn('[PDF.js] texto corrupto detectado → cayendo a OCR backend');
  } else {
    console.warn('[PDF.js] texto insuficiente → cayendo a OCR backend');
  }

  try{
    const res = await apiPost({
      accion: 'extraerPDF',
      nombreArchivo: nombrePdf || 'factura.pdf',
      base64: base64Pdf,
      mimeType: mimePdf || 'application/pdf'
    });
    if(res && res.ok && res.texto && res.texto.trim().length > 20){
      return { ok: true, texto: res.texto, motor: res.motor || 'OCR', fallbackDesde: res.fallbackDesde };
    }
    var _errPdfCompleto = (res && res.error) || 'OCR sin texto';
  }catch(e){
    var _errPdfCompleto = e.message;
  }

  try{
    const base64Img = await _extraerPrimeraPaginaComoImagen(base64Pdf);
    if(base64Img){
      const nombreImg = (nombrePdf||'factura').replace(/\.pdf$/i,'') + '_p1.jpg';
      const res2 = await apiPost({
        accion: 'extraerPDF',
        nombreArchivo: nombreImg,
        base64: base64Img,
        mimeType: 'image/jpeg'
      });
      if(res2 && res2.ok && res2.texto && res2.texto.trim().length > 20){
        return { ok: true, texto: res2.texto, motor: (res2.motor||'OCR') + ' (pág.1 rasterizada)', fallbackDesde: _errPdfCompleto };
      }
      return { ok: false, error: 'PDF: '+_errPdfCompleto+' · Imagen: '+((res2&&res2.error)||'sin texto') };
    }
  }catch(e){
    return { ok: false, error: 'PDF: '+_errPdfCompleto+' · Rasterizar: '+e.message };
  }
  return { ok: false, error: 'PDF: '+_errPdfCompleto };
}

async function _extraerPrimeraPaginaComoImagen(base64){
  if(typeof pdfjsLib === 'undefined') return null;
  try{
    if(!pdfjsLib.GlobalWorkerOptions.workerSrc){
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js';
    }
    const bin = atob(base64);
    const bytes = new Uint8Array(bin.length);
    for(let i=0;i<bin.length;i++) bytes[i] = bin.charCodeAt(i);
    const pdf = await pdfjsLib.getDocument({ data: bytes }).promise;
    const page = await pdf.getPage(1);
    const viewport = page.getViewport({ scale: 2.0 });
    const canvas = document.createElement('canvas');
    canvas.width = viewport.width;
    canvas.height = viewport.height;
    const ctx = canvas.getContext('2d');
    await page.render({ canvasContext: ctx, viewport: viewport }).promise;
    const dataUrl = canvas.toDataURL('image/jpeg', 0.92);
    return dataUrl.split(',')[1];
  }catch(e){
    console.warn('No se pudo extraer página 1:', e);
    return null;
  }
}

// ─── Estado del render de la preview local ───
//  Guardamos el documento PDF.js activo para poder re-renderizar
//  cuando cambia el tamaño del contenedor (resize). No se limpia
//  explícitamente porque el próximo renderPdfLocalEnCanvas lo
//  reemplaza; cerrar el modal destruye la referencia.
let _PREVIEW_PDF_ACTUAL = null;
let _PREVIEW_RESIZE_OBS = null;

/**
 * Calcula la escala "fit-to-width" para una página del PDF.
 *  · Toma el ancho disponible del contenedor (descontando padding).
 *  · Reserva un pequeño margen interior (8px por lado) para que la
 *    hoja no se vea pegada a los bordes.
 *  · Escala = anchoDisponible / anchoBase.
 *
 * @param {Object} page         Página de PDF.js ya cargada.
 * @param {HTMLElement} wrap    Contenedor con overflow:auto.
 * @returns {number}            Escala a usar en getViewport().
 */
function _calcularEscalaFitWidth(page, wrap){
  const vpBase = page.getViewport({ scale: 1 });
  const anchoBase = vpBase.width || 1;

  // El wrap tiene padding:12px por CSS. Restamos 16px extra como
  // margen interior para que la hoja no toque los bordes visuales.
  const cs = window.getComputedStyle(wrap);
  const padIzq = parseFloat(cs.paddingLeft) || 0;
  const padDer = parseFloat(cs.paddingRight) || 0;
  const scrollbar = wrap.offsetWidth - wrap.clientWidth;
  const anchoDisponible = wrap.clientWidth - padIzq - padDer - 16 - scrollbar;

  if (anchoDisponible <= 0) return 1.5;   // fallback si aún no hay layout
  return anchoDisponible / anchoBase;
}

/**
 * Renderiza la primera página del PDF en el canvas, con zoom
 * "fit-to-width". Re-renderiza cuando cambia el tamaño del
 * contenedor (ResizeObserver).
 *
 * @param {string} base64  Contenido del PDF en base64.
 */
async function renderPdfLocalEnCanvas(base64){
  if(typeof pdfjsLib === 'undefined'){
    console.warn('PDF.js no cargó — vista previa local no disponible');
    return;
  }
  try{
    if(!pdfjsLib.GlobalWorkerOptions.workerSrc){
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.worker.min.js';
    }
    const bin = atob(base64);
    const bytes = new Uint8Array(bin.length);
    for(let i=0;i<bin.length;i++) bytes[i]=bin.charCodeAt(i);
    const pdf = await pdfjsLib.getDocument({ data: bytes }).promise;
    _PREVIEW_PDF_ACTUAL = pdf;

    await _renderPreviewPagina1(pdf);

    // Registrar ResizeObserver una sola vez por contenedor para
    // re-renderizar cuando cambia el ancho del panel.
    const wrap = document.getElementById('previewCanvasWrap');
    if (wrap && !_PREVIEW_RESIZE_OBS){
      let _raf = null;
      _PREVIEW_RESIZE_OBS = new ResizeObserver(() => {
        if (_raf) cancelAnimationFrame(_raf);
        _raf = requestAnimationFrame(async () => {
          if (_PREVIEW_PDF_ACTUAL){
            await _renderPreviewPagina1(_PREVIEW_PDF_ACTUAL);
          }
        });
      });
      _PREVIEW_RESIZE_OBS.observe(wrap);
    }
  }catch(e){
    console.error('PDF.js error:', e);
  }
}

/**
 * Renderiza la página 1 del PDF (ya cargado) al canvas, ajustando
 * la escala al ancho actual del contenedor.
 */
async function _renderPreviewPagina1(pdf){
  const canvas = document.getElementById('previewCanvas');
  const wrap   = document.getElementById('previewCanvasWrap');
  if(!canvas || !wrap) return;

  // Si el wrap aún no tiene ancho (layout pendiente), esperamos al
  // siguiente frame y reintentamos. Sin esto, el primer render puede
  // caer al fallback 1.5 (zoom fijo) en lugar de fit-to-width.
  let intentos = 0;
  while (wrap.clientWidth === 0 && intentos < 30) {
    await new Promise(r => requestAnimationFrame(r));
    intentos++;
  }

  const page = await pdf.getPage(1);
  const escala = _calcularEscalaFitWidth(page, wrap);
  const viewport = page.getViewport({ scale: escala });

  canvas.width  = viewport.width;
  canvas.height = viewport.height;
  const ctx = canvas.getContext('2d');
  await page.render({ canvasContext: ctx, viewport: viewport }).promise;
}

// ─── Caché de PDFs descargados desde Drive ───
//  Cuando el usuario referencia un PDF de Drive, descargamos su
//  contenido una sola vez y lo renderizamos en el canvas local.
//  Esto permite aplicar el zoom "fit-to-width" (el iframe de Drive
//  es cross-origin y no admite control de zoom desde el padre).
//
//  IMPORTANTE — el caché se alimenta desde CUALQUIER flujo que ya
//  haya descargado el PDF (OCR, extracción, carga desde URL), para
//  no volver a bajarlo cuando toca pintar la preview. Ese doble
//  download era visible como un "flash" del iframe antes del canvas.
let _PREVIEW_DRIVE_CACHE = null;  // { id: string, base64: string, mime: string }

/**
 * Registra un base64 ya descargado en el caché de la preview, para
 * que `actualizarPreview()` lo use sin volver a descargar.
 *
 * @param {string} id      ID de Drive del archivo.
 * @param {string} base64  Contenido del PDF.
 * @param {string} [mime]  MIME (default: application/pdf).
 */
function _precargarPreviewDrive(id, base64, mime){
  if(!id || !base64) return;
  // No sobreescribir si ya hay un caché válido para el mismo id
  // (evita reemplazos innecesarios y mantiene el objeto estable).
  if(_PREVIEW_DRIVE_CACHE && _PREVIEW_DRIVE_CACHE.id === id) return;
  _PREVIEW_DRIVE_CACHE = {
    id,
    base64,
    mime: mime || 'application/pdf'
  };
  // Si el usuario tiene abierto el modal y el campo apunta a ese id,
  // forzamos un repintado para sustituir el iframe por el canvas.
  try{
    const vActual = (document.getElementById('fPDFDriveUrl').value || '').trim();
    const idActual = parseDriveIdFront(vActual);
    if(idActual === id && typeof actualizarPreview === 'function'){
      actualizarPreview();
    }
  }catch(e){ /* noop */ }
}

async function actualizarPreview(){
  const panel = document.getElementById('previewPanel');
  const frame = document.getElementById('previewFrame');
  const canvasWrap = document.getElementById('previewCanvasWrap');
  if(!panel || !frame || !canvasWrap) return;

  // ─── Resolver fuente activa (con prioridad determinista) ───
  //  Si PDF_FUENTE no está seteado (p.ej. modal recién abierto con
  //  una factura existente), lo inferimos a partir de los datos
  //  disponibles: local si hay PDF_ACTUAL, drive si hay URL válida.
  let fuente = PDF_FUENTE;
  if(!fuente){
    if(PDF_ACTUAL && PDF_ACTUAL.base64){
      fuente = 'local';
    } else {
      const _v = (document.getElementById('fPDFDriveUrl').value || '').trim();
      const _id = parseDriveIdFront(_v);
      if(_id && _id.length >= 15) fuente = 'drive';
    }
  }

  // ─── Caso 1: PDF local ───
  if(fuente === 'local' && PDF_ACTUAL && PDF_ACTUAL.base64){
    frame.style.display = 'none';
    frame.setAttribute('data-src', '');
    canvasWrap.style.display = 'block';
    panel.style.display = 'flex';
    _sincronizarAnchoModal();
    renderPdfLocalEnCanvas(PDF_ACTUAL.base64);
    return;
  }

  // ─── Caso 2: URL de Drive ───
  if(fuente === 'drive'){
    const v = (document.getElementById('fPDFDriveUrl').value || '').trim();
    const id = parseDriveIdFront(v);
    if(id && id.length >= 15){
      // Si YA tenemos el PDF de este id en caché (porque algún flujo
      // anterior —OCR, carga desde URL, auto-OCR— ya lo descargó),
      // lo renderizamos directo en el canvas local con fit-to-width.
      // Sin iframe intermedio, sin flash, sin segundo download.
      if (_PREVIEW_DRIVE_CACHE && _PREVIEW_DRIVE_CACHE.id === id) {
        frame.style.display = 'none';
        frame.setAttribute('data-src', '');
        canvasWrap.style.display = 'block';
        panel.style.display = 'flex';
        _sincronizarAnchoModal();
        renderPdfLocalEnCanvas(_PREVIEW_DRIVE_CACHE.base64);
        return;
      }

      // Sin caché: mostramos el iframe de inmediato (feedback visual
      // mientras se descarga) y disparamos la descarga en background.
      // Cuando termine, `_descargarPDFDriveParaPreview` reemplaza el
      // iframe por el canvas (con fit-to-width).
      canvasWrap.style.display = 'none';
      frame.style.display = 'block';
      const url = 'https://drive.google.com/file/d/' + id + '/preview';
      if(frame.getAttribute('data-src') !== url){
        frame.src = url;
        frame.setAttribute('data-src', url);
      }
      panel.style.display = 'flex';
      _sincronizarAnchoModal();
      _descargarPDFDriveParaPreview(id);
      return;
    }
  }

  // ─── Sin preview ───
  panel.style.display = 'none';
  _sincronizarAnchoModal();
}

/**
 * Descarga un PDF desde Drive (vía backend) y lo deja listo para
 * renderizarse en el canvas local. Evita descargas duplicadas si el
 * mismo id ya está siendo descargado o ya está en caché.
 */
let _PREVIEW_DRIVE_DESCARGANDO = null;
async function _descargarPDFDriveParaPreview(id){
  // Cache hit
  if (_PREVIEW_DRIVE_CACHE && _PREVIEW_DRIVE_CACHE.id === id) return;

  // Descarga ya en curso para el mismo id: evitar duplicado
  if (_PREVIEW_DRIVE_DESCARGANDO && _PREVIEW_DRIVE_DESCARGANDO.id === id) return;

  _PREVIEW_DRIVE_DESCARGANDO = { id };
  try{
    const dl = await apiPost({ accion: 'descargarPDFDrive', id });
    if (!dl || !dl.ok || !dl.base64) {
      console.warn('[preview] No se pudo descargar el PDF de Drive para preview:', dl && dl.error);
      return;
    }
    _PREVIEW_DRIVE_CACHE = {
      id,
      base64: dl.base64,
      mime:   dl.mime || 'application/pdf'
    };

    // Si el input sigue apuntando al mismo id, renderizamos.
    const vActual = (document.getElementById('fPDFDriveUrl').value || '').trim();
    const idActual = parseDriveIdFront(vActual);
    if (idActual === id) {
      const frame = document.getElementById('previewFrame');
      const canvasWrap = document.getElementById('previewCanvasWrap');
      const panel = document.getElementById('previewPanel');
      if (frame) { frame.style.display = 'none'; frame.setAttribute('data-src', ''); }
      if (canvasWrap) canvasWrap.style.display = 'block';
      if (panel) panel.style.display = 'flex';
      renderPdfLocalEnCanvas(dl.base64);
    }
  }catch(e){
    console.warn('[preview] Error descargando PDF de Drive:', e.message);
  }finally{
    if (_PREVIEW_DRIVE_DESCARGANDO && _PREVIEW_DRIVE_DESCARGANDO.id === id) {
      _PREVIEW_DRIVE_DESCARGANDO = null;
    }
  }
}

function cerrarPreview(){
  const panel = document.getElementById('previewPanel');
  if(panel) panel.style.display = 'none';

  // Liberar la referencia al PDF y desconectar el ResizeObserver:
  // así no se re-renderiza un canvas invisible cuando el modal
  // vuelve a abrirse y el panel se redimensiona.
  _PREVIEW_PDF_ACTUAL = null;
  if (_PREVIEW_RESIZE_OBS){
    try{ _PREVIEW_RESIZE_OBS.disconnect(); }catch(e){}
    _PREVIEW_RESIZE_OBS = null;
  }

  // Al ocultar la preview, el modal vuelve a su ancho de formulario.
  _sincronizarAnchoModal();
}

/**
 * Sincroniza el ancho del modal #modalAgregar con el estado actual
 * de la preview:
 *   · Preview visible  → ancho wide (modal-box-wide, 1900px).
 *   · Preview oculta   → ancho estándar (modal-box, 640px).
 *
 * El modal wide es necesario para que la preview tenga espacio sin
 * asfixiar el formulario. Cuando no hay preview, el modal angosto
 * es más cómodo visualmente.
 *
 * Se invoca:
 *   · Al abrir el modal (según haya o no PDF).
 *   · Al cargar / limpiar un PDF local.
 *   · Al pegar / limpiar una URL de Drive.
 *   · Al hacer click en "✕ Ocultar vista previa".
 */
function _sincronizarAnchoModal(){
  const box = document.querySelector('#modalAgregar .modal-box');
  if(!box) return;

  const panelPreview = document.getElementById('previewPanel');
  const previewVisible = !!(panelPreview && panelPreview.style.display !== 'none');

  box.classList.toggle('modal-box-wide', previewVisible);
}

