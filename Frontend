function _mostrarDiffModalVsOCR(antes, campos){
  // Mostrar el toast SIEMPRE que se haya extraído al menos un campo útil.
  // Ya no se exige fNumero ni fCodigo: si el parser devolvió algo, se
  // compara y se muestra lo que haya.
  const _claves = ['fNumero','fCodigo','fRut','fPeriodo','fEmision','fVencimiento',
                   'fKwh','fSum','fPeaje','fInt','fIntPeaje','fOtros','fOtrosPeaje','fTotal','fTipo'];
  const _tieneContenido = (obj, keys) => keys.some(k => {
    const v = obj[k];
    return v !== undefined && v !== null && v !== '' && v !== 0;
  });
  const hayDatos = campos && _tieneContenido(campos, _claves);
  if (!hayDatos) {
    cerrarToastComparacion();
    return;
  }

  // ─── Sin factura existente: el toast NO muestra tabla ───
  //  Cuando NO hay una factura real contra la que comparar (factura
  //  nueva cargada desde PDF o desde el botón de carga), el formulario
  //  está vacío o recién poblado por el propio OCR: no existen valores
  //  "actuales" que tengan sentido mostrar. Sólo mostramos la línea
  //  del PDF y su destino de Drive.
  //
  //  Discriminante correcto: FACTURA_EDITANDO. Es null cuando no hay
  //  factura existente, sin importar el MODO_MODAL (que en el flujo
  //  "cargar PDF de una factura nueva" queda en 'editar' para permitir
  //  que el usuario ajuste todo antes de guardar).
  if (!FACTURA_EDITANDO) {
    // El detalle del Drive puede contener HTML (ícono amarillo, texto
    // rojo en negrita). NO escapar: se inyecta tal cual.
    const mensajeSoloHTML = _textoPDFVinculadoHTML();
    cerrarToastComparacion();
    toastComparacionActual = _showToastHTML(
      '<span class="pie-diff" data-rol="pdf-linea">' + mensajeSoloHTML + '</span>',
      '',
      {
        persistente: true,
        clase: 'toast-comparacion'
      }
    );
    return;
  }

  const filas = [];

  function _pushDif(a, b, esNum, label){
    const aa = esNum
      ? (Number(a) || 0)
      : String(a == null ? '' : a).trim();

    const bb = esNum
      ? (Number(b) || 0)
      : String(b == null ? '' : b).trim();

    if(aa === bb) return;

    const aaTxt = esNum ? fmtMiles(aa) : (aa || '—');
    const bbTxt = esNum ? fmtMiles(bb) : (bb || '—');

    filas.push({
      label: label,
      actual: aaTxt,
      pdf: bbTxt
    });
  }

  _pushDif(antes.numero,           campos.fNumero,      false, 'N° Factura');

  // Código cliente — siempre comparado (aun si el OCR no lo detectó).
  {
    const codAct = String(antes.codigo || '').trim();
    const codPdf = String(campos.fCodigo || '').trim();
    if (codAct !== codPdf) {
      filas.push({
        label:  'Código cliente',
        actual: codAct || '—',
        pdf:    codPdf || '—'
      });
    }
  }

  // Período — siempre comparado.
  {
    const perAct = String(antes.periodo || '').trim();
    const perPdf = String(campos.fPeriodo || '').trim();
    if (perAct !== perPdf) {
      filas.push({
        label:  'Período',
        actual: perAct || '—',
        pdf:    perPdf || '—'
      });
    }
  }

  // Tipo — en display, CONSUMO se muestra como SUMINISTRO
  {
    const tipoAct = String(antes.tipo || '').toUpperCase();
    const tipoPdf = String(campos.fTipo || '').toUpperCase();
    if (tipoAct !== tipoPdf) {
      const fmtTipo = (t) => (t === 'CONSUMO' ? 'SUMINISTRO' : (t || '—'));
      filas.push({
        label:  'Tipo',
        actual: fmtTipo(tipoAct),
        pdf:    fmtTipo(tipoPdf)
      });
    }
  }

  _pushDif(antes.fechaEmision,     campos.fEmision,     false, 'F. Emisión');
  _pushDif(antes.fechaVencimiento, campos.fVencimiento, false, 'F. Vencimiento');
  _pushDif(antes.kwh,              campos.fKwh,         true,  'kWh');
  _pushDif(antes.sum,              campos.fSum,         true,  'Suministro Neto (Afecto+Exento)');
  _pushDif(antes.peaje,            campos.fPeaje,       true,  'Peaje');
  _pushDif(antes.intereses,        campos.fInt,         true,  'Int. Sum.');
  _pushDif(antes.intPeaje,         campos.fIntPeaje,    true,  'Int. Peaje');
  _pushDif(antes.otros,            campos.fOtros,       true,  'Otros Sum.');
  _pushDif(antes.otrosPeaje,       campos.fOtrosPeaje,  true,  'Otros Peaje');
  _pushDif(antes.total,            campos.fTotal,       true,  'Total');

  const modalTeniaAlgo = _tieneContenido(antes,
    ['numero','codigo','fechaEmision','fechaVencimiento','sum','peaje','total','kwh']);
  const ocrTrajoAlgo = _tieneContenido(campos,
    ['fNumero','fCodigo','fEmision','fVencimiento','fSum','fPeaje','fTotal','fKwh']);

  if(!filas.length && !modalTeniaAlgo && !ocrTrajoAlgo){
    cerrarToastComparacion();
    return;
  }

  // ─── Toast de "factura EXISTENTE" ───
  //  Se emite con 3 bloques separados:
  //    · .encabezado-diff → título del comparativo (fuente normal)
  //    · .tabla-diff      → tabla comparativa (fuente monoespaciada)
  //    · .pie-diff        → línea "📄 …" (fuente normal)
  const encabezadoTexto = '📊 INFORMACIÓN ACTUAL VS. EXTRAÍDA DESDE PDF';
  let mensaje = [];

  if(!filas.length){
    // ─── ¿La comparación tiene sentido? ───
    //  El toast "Sin diferencias" sólo aporta si estamos comparando
    //  contra una factura REAL Y EXISTENTE. Eso requiere:
    //    · FACTURA_EDITANDO no nulo
    //    · FACTURA_EDITANDO.numero no vacío
    //    · esa factura existe en FACTURAS (fue persistida antes)
    //  En caso contrario (factura nueva, fila sintética, o el modal
    //  acaba de abrirse sin contexto), no emitimos el toast.
    const _numAct = FACTURA_EDITANDO ? String(FACTURA_EDITANDO.numero || '').trim() : '';
    const _existeEnBD = _numAct && FACTURAS.some(f =>
      String(f.numero || '').trim() === _numAct
    );

    if (!_existeEnBD) {
      // Sin factura real contra la que comparar: silencio total.
      cerrarToastComparacion();
      return;
    }

    // Sólo marcar para revisión si estamos editando una factura
    // existente y el usuario todavía no ha guardado nada desde este modal.
    if (MODO_MODAL === 'editar' && !FACTURA_YA_GUARDADA_EN_BD) {
      _SIN_DIFERENCIAS_AL_ABRIR = true;
    }

    mensaje.push('✓ Sin diferencias.');
    mensaje.push('');
    mensaje.push('La información del PDF coincide con la información actual.');

    cerrarToastComparacion();

    // Encabezado + cuerpo (ambos tipografía normal), pie aparte.
    //  La línea "📄 …" va SIEMPRE en un span .pie-diff con data-rol
    //  para que `_refrescarLineaPDFEnToast` la ubique sin ambigüedad.
    //  El detalle del Drive puede contener HTML (⚠ rojo, ✓ normal);
    //  NO se escapa, se inyecta tal cual.
    const _htmlOk =
      '<span class="encabezado-diff">' + _escAttrToast(encabezadoTexto) + '</span>' +
      '<span class="pie-diff">' + _escAttrToast(mensaje.join('\n')) + '</span>' +
      '<span class="pie-diff" data-rol="pdf-linea">' + _textoPDFVinculadoHTML() + '</span>';

    toastComparacionActual = _showToastHTML(
      _htmlOk,
      'ok',
      {
        persistente: true,
        clase: 'toast-comparacion'
      }
    );

    return;
  }

  const anchoCampo = Math.max(
    'Campo'.length,
    ...filas.map(f => f.label.length)
  );

  const anchoValor = 16;

  // La tabla arranca directamente con los headers (sin el título).
  // El título va aparte, en un bloque de tipografía normal.
  mensaje.push(
    'Campo'.padEnd(anchoCampo + 2) +
    'Info. Actual'.padStart(anchoValor) +
    '  ' +
    'Info. en PDF'.padStart(anchoValor)
  );

  mensaje.push(
    '─'.repeat(anchoCampo + 2 + anchoValor * 2 + 2)
  );

  filas.forEach(f => {
    mensaje.push(
      f.label.padEnd(anchoCampo + 2) +
      f.actual.padStart(anchoValor) +
      '  ' +
      f.pdf.padStart(anchoValor)
    );
  });

  cerrarToastComparacion();

  // Construimos el HTML con 3 bloques:
  //   · .encabezado-diff → título (tipografía normal)
  //   · .tabla-diff      → tabla (monoespaciada)
  //   · .pie-diff        → línea "📄 …" (tipografía normal)
  const _tablaTexto = mensaje.join('\n');
  const _htmlToast =
    '<span class="encabezado-diff">' + _escAttrToast(encabezadoTexto) + '</span>' +
    '<span class="tabla-diff">'      + _escAttrToast(_tablaTexto)    + '</span>' +
    '<span class="pie-diff" data-rol="pdf-linea">' + _textoPDFVinculadoHTML() + '</span>';

  toastComparacionActual = _showToastHTML(
    _htmlToast,
    '',
    {
      persistente: true,
      clase: 'toast-comparacion'
    }
  );
}

/**
 * Escapa texto plano para insertarlo como HTML dentro de un toast,
 * respetando saltos de línea y espacios múltiples (uso de &nbsp;
 * sólo cuando es necesario para no romper el layout en `pre-line`).
 * El bloque .tabla-diff usa `white-space: pre` → los espacios se
 * preservan tal cual.
 */
function _escAttrToast(s){
  return String(s == null ? '' : s)
    .replace(/&/g,'&amp;')
    .replace(/</g,'&lt;')
    .replace(/>/g,'&gt;');
}

/**
 * Devuelve el detalle del Drive del centro en formato HTML.
 *
 * Los avisos con ⚠ se renderizan con el ícono en amarillo y el
 * texto en negrita + rojo. El caso OK (✓) se deja tal cual.
 *
 * El caller debe inyectar este HTML en un contenedor que permita
 * HTML (los toasts usan _showToastHTML y _escAttrToast NO debe
 * aplicarse a este fragmento).
 */
function _detalleDriveActual() {
  const codigoActual = (document.getElementById('fCodigo').value || '').trim();
  const centroActual = centroPorCodigo(codigoActual);
  const tieneOp  = centroActual && centroActual.driveOp;
  const tieneCom = centroActual && centroActual.driveCom;

  const icoAmarillo = '<span style="color:#f59e0b;font-weight:700;">⚠</span>';
  const txtRojoNegro = (t) =>
    '<span style="color:#ef4444;font-weight:700;">' + t + '</span>';

  if (tieneOp && tieneCom) {
    return '✓ PDF con repositorios de Operaciones y Comunidad';
  }
  if (tieneOp) {
    return icoAmarillo + ' ' + txtRojoNegro('Solo Drive Operaciones configurado');
  }
  if (tieneCom) {
    return icoAmarillo + ' ' + txtRojoNegro('Solo Drive Comunidad configurado');
  }
  return icoAmarillo + ' ' + txtRojoNegro('Sin Drive configurado');
}

/**
 * Devuelve el texto "📄 …" del toast comparativo como HTML.
 *  · El prefijo "📄 <estado> · " es texto plano.
 *  · El detalle del Drive (ℹ/⚠/✓) puede contener HTML con color
 *    y negrita; se devuelve SIN escapar.
 *
 * El caller es responsable de inyectarlo sin aplicar _escAttrToast.
 */
function _textoPDFVinculadoHTML() {
  const factura        = FACTURA_EDITANDO;
  const urlInp         = (document.getElementById('fPDFDriveUrl').value || '').trim();
  const tieneLocal     = !!(PDF_ACTUAL && PDF_ACTUAL.base64);
  const tieneVinculado = !!(factura && factura.pdfId);
  const tieneUrl       = !!parseDriveIdFront(urlInp);
  const detalle        = _detalleDriveActual();

  if (tieneLocal)     return '📄 PDF local listo para subir · '   + detalle;
  if (tieneVinculado) return '📄 PDF ya vinculado · '             + detalle;
  if (tieneUrl)       return '📄 PDF referenciado por URL · '     + detalle;
  return '📄 Sin PDF · ' + detalle;
}

/**
 * Versión text-plano de _textoPDFVinculadoHTML, para contextos donde
 * se necesita el string completo sin etiquetas (ej. comparaciones,
 * logs). Reemplaza los tags HTML por su contenido.
 */
function _textoPDFVinculado() {
  return _textoPDFVinculadoHTML().replace(/<[^>]+>/g, '');
}

/**
 * Refresca la última línea del toast comparativo (📄 …) sin
 * regenerar todo el toast. No hace nada si no hay toast visible.
 */
function _refrescarLineaPDFEnToast() {
  if (!toastComparacionActual) return;
  // Buscamos específicamente el span del pie que contiene la línea
  // del PDF (marcado con data-rol="pdf-linea"), no cualquier .pie-diff
  // — en el toast "Sin diferencias" hay 2.
  const pie = toastComparacionActual.querySelector('.pie-diff[data-rol="pdf-linea"]');
  if (!pie) return;
  // El detalle del Drive puede contener HTML (⚠ rojo/negrita); se
  // inyecta sin escapar porque lo genera _detalleDriveActual().
  pie.innerHTML = _textoPDFVinculadoHTML();
}

async function extraerDatosOCR() {
  if (PDF_ACTUAL) {
    return _ejecutarOCR({
      base64: PDF_ACTUAL.base64,
      mime:   PDF_ACTUAL.mimeType,
      nombre: PDF_ACTUAL.nombre
    });
  }
  const v  = (document.getElementById('fPDFDriveUrl').value || '').trim();
  const id = parseDriveIdFront(v);
  if (id && id.length >= 15) {
    setStatus('Descargando PDF desde Drive...', '');
    const dl = await apiPost({ accion: 'descargarPDFDrive', id });
    if (!dl.ok) { showToast('No se pudo descargar el PDF: ' + dl.error, 'err'); return; }

    // Cachear el base64 para la preview (evita un segundo download).
    _precargarPreviewDrive(id, dl.base64, dl.mime || 'application/pdf');

    return _ejecutarOCR({
      base64: dl.base64,
      mime:   dl.mime || 'application/pdf',
      nombre: dl.nombre || 'factura.pdf',
      urlOrigen: v
    });
  }
  showToast('Primero carga un PDF o pega la URL de Drive', 'err');
}

/**
 * Extrae texto del PDF y lo parsea.
 *
 * IMPORTANTE — este método NO escribe en el modal.
 * Sólo deja el resultado en `_ULTIMOS_CAMPOS_OCR` y muestra un toast
 * comparativo ("info actual vs. info extraída"). El usuario aplica
 * los campos manualmente con "🔄 Actualizar desde OCR", que
 * lee `_ULTIMOS_CAMPOS_OCR`.
 *
 * @param {Object}  p
 * @param {string}  p.base64       PDF en base64.
 * @param {string}  p.mime         MIME type.
 * @param {string}  p.nombre       Nombre del archivo.
 * @param {boolean} p.silent       Auto-OCR al abrir un modal existente
 *                                 (no altera botones ni status).
 * @param {string}  p.urlOrigen    URL de Drive (para recuperación).
 */
async function _ejecutarOCR({ base64, mime, nombre, silent = false, urlOrigen = '' }) {
  const btn = document.getElementById('btnExtraerOCR');
  const txtBtn = btn ? btn.textContent : '';
  if (btn && !silent) { btn.disabled = true; btn.textContent = '⏳ Extrayendo…'; }

  if (!silent) setStatus('Extrayendo texto del PDF...', '');

  try {
    const r = await _obtenerTextoPDF(base64, mime || 'application/pdf', nombre || 'factura.pdf');
    if (!r.ok) throw new Error(r.error);
    if (r.motor) setStatus('✓ ' + r.motor, 'ok');

    const campos = await parsearFacturaCompleta(r.texto);
    _ULTIMOS_CAMPOS_OCR = JSON.parse(JSON.stringify(campos));
    _PDF_TEXTO_OCR = r.texto || '';

    const antes = _leerCamposModal();

    // ─── NO se aplican campos al modal ───
    //  La extracción OCR sólo deja disponible `_ULTIMOS_CAMPOS_OCR` y
    //  muestra el comparativo. El botón "🔄 Actualizar desde OCR"
    //  es el ÚNICO que escribe en el formulario.
    _mostrarDiffModalVsOCR(antes, campos);

    PDF_WARNINGS = verificarPDFvsFactura(r.texto);
    _pintarWarnPDF(PDF_WARNINGS);

    if (!silent) {
      const diffs = _detectarDiscrepanciasOCR(campos, {
        codigo:  antes.codigo,
        periodo: (document.getElementById('fPeriodo').value || '').trim(),
        rut:     (document.getElementById('fRut').value || '').trim()
      });
      if (Object.keys(diffs).length) {
        setTimeout(() => {
          // Guardarraíles: no abrir el modal si el contexto cambió
          // entre el momento del OCR y el momento de mostrar el modal.
          //  · El modal principal debe seguir abierto.
          //  · No debe haberse guardado la factura en el ínterin.
          const m = document.getElementById('modalAgregar');
          if (!m || !m.classList.contains('open')) return;
          if (FACTURA_YA_GUARDADA_EN_BD) return;
          abrirModalOCRDiscrepancia(diffs);
        }, 600);
      }
    }

    if (!silent) {
      const motor = r.motor || 'OCR';
      // Contamos cuántos campos útiles llegaron para el mensaje.
      // No es "aplicados" sino "extraídos" (ya nada se aplica aquí).
      const _claves = ['fNumero','fCodigo','fRut','fPeriodo','fEmision','fVencimiento',
                       'fKwh','fSum','fPeaje','fInt','fIntPeaje','fOtros','fOtrosPeaje','fTotal','fTipo'];
      const _extraidos = _claves.filter(k => {
        const v = campos[k];
        return v !== undefined && v !== null && v !== '' && v !== 0;
      }).length;

      if (PDF_WARNINGS.length) {
        showToast('⚠ ' + motor + ': ' + _extraidos + ' campos extraídos · ' + PDF_WARNINGS.length + ' advertencias. Usa 🔄 Actualizar desde OCR para aplicarlos.', 'err');
        setStatus('OCR (' + motor + ') con advertencias', 'err');
      } else {
        showToast('✓ ' + motor + ': ' + _extraidos + ' campos extraídos · PDF verificado. Usa 🔄 Actualizar desde OCR para aplicarlos.', 'ok');
        setStatus('OCR (' + motor + ') OK', 'ok');
      }
    }
    return { ok: true, campos, motor: r.motor };
  } catch (e) {
    if (silent) { console.warn('Auto-OCR falló:', e.message); return { ok: false, error: e.message }; }
    showToast('OCR no disponible: ' + e.message + ' — selecciona centro y período manualmente.', 'err');
    setStatus('⚠ OCR falló · selecciona centro y período manualmente', 'err');
    _abrirModalOCRFallido(urlOrigen);
    return { ok: false, error: e.message };
  } finally {
    if (btn && !silent) { btn.disabled = false; btn.textContent = txtBtn; }
  }
}

