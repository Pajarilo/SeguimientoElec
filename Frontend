function verificarPDFvsFactura(texto){
  const problemas=[];
  const t=String(texto||'').toUpperCase();

  const clienteForm = String((_getClienteSeleccionado().cliente) || '').toUpperCase();
  const esSinAsignar = !clienteForm
                    || clienteForm.indexOf('SIN ASIGNAR') !== -1
                    || clienteForm.indexOf('⚠')         !== -1
                    || clienteForm.indexOf('TEMP')       !== -1;
  const palabras = clienteForm.split(/\s+/).filter(w=>w.length>=5);
  if(!esSinAsignar && palabras.length && !palabras.some(w=>t.includes(w))){
    problemas.push('Centro de costo: no se reconoce "'+clienteForm+'" en el PDF');
  }

  const periodoForm = String((document.getElementById('fPeriodo') || {}).value || '');
  if(/^\d{4}-\d{2}$/.test(periodoForm)){
    const pp = periodoForm.split('-');
    const MESES_LARGOS = ['ENERO','FEBRERO','MARZO','ABRIL','MAYO','JUNIO','JULIO','AGOSTO','SEPTIEMBRE','OCTUBRE','NOVIEMBRE','DICIEMBRE'];
    const mesIdx = parseInt(pp[1], 10);
    const mesLargo = MESES_LARGOS[mesIdx-1] || '';
    const mesCorto = (MESES[mesIdx-1] || '').toUpperCase();
    const tieneMesLargo = mesLargo && t.includes(mesLargo) && t.includes(pp[0]);
    const tieneMesCorto = mesCorto && (
      t.includes(mesCorto+' '+pp[0]) ||
      t.includes(mesCorto+'-'+pp[0]) ||
      t.includes(mesCorto+'/'+pp[0])
    );
    const tieneIso = t.includes(periodoForm) || t.includes(pp[1]+'/'+pp[0]) || t.includes(pp[1]+'-'+pp[0]);
    if(!tieneMesLargo && !tieneMesCorto && !tieneIso){
      problemas.push('Período: no se reconoce '+mesLargo+' '+pp[0]+' ('+periodoForm+') en el PDF');
    }
  }

  const tipoForm = String((document.getElementById('fTipo') || {}).value || '');
  const tieneSum = t.includes('ENERGIA')||t.includes('SUMINISTRO');
  const tienePeaje = t.includes('PEAJE')||t.includes('DISTRIBUCION')||t.includes(' DX');
  const tieneArriendo = t.includes('ARRIENDO')||t.includes('MEDIDOR');
  if((tipoForm==='CONSUMO' || tipoForm==='SUMINISTRO') && !tieneSum){ problemas.push('Tipo: el PDF no parece corresponder a Suministro'); }
  else if(tipoForm==='PEAJE' && !tienePeaje){ problemas.push('Tipo: el PDF no parece corresponder a Peaje'); }
  else if(tipoForm==='UNIFICADA' && !tieneSum && !tienePeaje){ problemas.push('Tipo: el PDF no contiene cargos de Suministro ni Peaje'); }
  else if(tipoForm==='ARRIENDO_MEDIDOR' && !tieneArriendo){ problemas.push('Tipo: el PDF no parece corresponder a Arriendo de Medidor'); }
  return problemas;
}

function _diffFacturaPDF(existente, campos){
  const diffs = [];
  function fmtDif(a, b, esNum, label){
    const aa = esNum ? (Number(a)||0) : String(a||'').trim();
    const bb = esNum ? (Number(b)||0) : String(b||'').trim();
    if(aa === bb) return;
    const aaTxt = esNum ? fmtMiles(aa) : (aa || '—');
    const bbTxt = esNum ? fmtMiles(bb) : (bb || '—');
    diffs.push('   · ' + label + ':  ' + aaTxt + '  →  ' + bbTxt);
  }
  fmtDif(existente.codigo, campos.fCodigo, false, 'Código cliente');
  fmtDif(existente.periodo, campos.fPeriodo, false, 'Período');
  fmtDif(existente.tipo, campos.fTipo, false, 'Tipo');
  fmtDif(existente.fechaEmision, campos.fEmision, false, 'F. Emisión');
  fmtDif(existente.fechaVencimiento, campos.fVencimiento, false, 'F. Vencimiento');
  fmtDif(existente.kwh, campos.fKwh, true, 'kWh');
  fmtDif(existente.sum, campos.fSum, true, 'Suministro Neto (Afecto+Exento)');
  fmtDif(existente.peaje, campos.fPeaje, true, 'Peaje');
  fmtDif(existente.intereses, campos.fInt, true, 'Int. Sum.');
  fmtDif(existente.intPeaje, campos.fIntPeaje, true, 'Int. Peaje');
  fmtDif(existente.otros, campos.fOtros, true, 'Otros Sum.');
  fmtDif(existente.otrosPeaje, campos.fOtrosPeaje, true, 'Otros Peaje');
  fmtDif(existente.total, campos.fTotal, true, 'Total');
  return diffs;
}

