const _MAP_DIFF = [
  { dom:'fNumero',    fac:'numero',          par:'fNumero',     num:false },
  { dom:'fTipo',      fac:'tipo',            par:'fTipo',       num:false },
  { dom:'fCodigo',    fac:'codigo',          par:'fCodigo',     num:false },
  { dom:'fEmision',   fac:'fechaEmision',    par:'fEmision',    num:false },
  { dom:'fVencimiento',fac:'fechaVencimiento',par:'fVencimiento',num:false },
  { dom:'fFecha',     fac:'fechaConsumo',    par:'fEmision',    num:false },
  { dom:'fKwh',       fac:'kwh',             par:'fKwh',        num:true  },
  { dom:'fSum',       fac:'sum',             par:'fSum',        num:true  },
  { dom:'fPeaje',     fac:'peaje',           par:'fPeaje',      num:true  },
  { dom:'fInt',       fac:'intereses',       par:'fInt',        num:true  },
  { dom:'fIntPeaje',  fac:'intPeaje',        par:'fIntPeaje',   num:true  },
  { dom:'fOtros',     fac:'otros',           par:'fOtros',      num:true  },
  { dom:'fOtrosPeaje',fac:'otrosPeaje',      par:'fOtrosPeaje', num:true  },
  { dom:'fTotal',     fac:'total',           par:'fTotal',      num:true  }
];
function _obtenerValor(fuente, fac, par){
  if(fuente[fac] !== undefined && fuente[fac] !== null && fuente[fac] !== '') return fuente[fac];
  if(fuente[par] !== undefined && fuente[par] !== null && fuente[par] !== '') return fuente[par];
  return undefined;
}

function _pintarCamposDesde(fuente){
  const tipoActual = (document.getElementById('fTipo').value || '').toUpperCase();
  _MAP_DIFF.forEach(({dom, fac, par, num}) => {
    const el = document.getElementById(dom);
    if(!el) return;
    const facUsar = (dom === 'fFecha' && tipoActual === 'PEAJE') ? 'fechaPeaje' : fac;
    const v = _obtenerValor(fuente, facUsar, par);
    if(v === undefined) return;
    el.value = num ? numeroAInput(v) : v;
  });
}

function _pintarSoloFaltantes(fuente){
  const tipoActual = (document.getElementById('fTipo').value || '').toUpperCase();
  _MAP_DIFF.forEach(({dom, fac, par, num}) => {
    const el = document.getElementById(dom);
    if(!el || el.value) return;
    const facUsar = (dom === 'fFecha' && tipoActual === 'PEAJE') ? 'fechaPeaje' : fac;
    const v = _obtenerValor(fuente, facUsar, par);
    if(v === undefined) return;
    el.value = num ? numeroAInput(v) : v;
  });
}

