    const cellStyle  = 'padding:6px 8px;vertical-align:middle;';

    tr.innerHTML =
      '<td style="'+cellStyle+'font-family:monospace;font-weight:600;color:var(--accent);">'+_escAttrMant(c.codigo)+'</td>' +
      '<td style="'+cellStyle+'"><input type="text" data-campo="cliente" data-codigo="'+_escAttrMant(c.codigo)+'" value="'+_escAttrMant(c.cliente)+'" style="'+inputStyle+'"></td>' +
      '<td style="'+cellStyle+'"><input type="text" data-campo="rut" data-codigo="'+_escAttrMant(c.codigo)+'" value="'+_escAttrMant(c.rut||'')+'" placeholder="ej: 77.333.033-6" style="'+inputStyle+'"></td>' +
      '<td style="'+cellStyle+'">' +
        '<select data-campo="empresa" data-codigo="'+_escAttrMant(c.codigo)+'" style="'+inputStyle+'">' +
