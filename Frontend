async function confirmarRectificar(){
  if(!FACTURA_EDITANDO) return;
  const err = document.getElementById('rcError');
  err.classList.remove('show');
  const codigoNuevo = document.getElementById('rcSelectCentro').value;
  const periodoNuevo = document.getElementById('rcSelectPeriodo').value;
  const centroNuevo = centroPorCodigo(codigoNuevo);
  if(!centroNuevo){ err.textContent='Centro inválido'; err.classList.add('show'); return; }
  if(!periodoNuevo){ err.textContent='Período inválido'; err.classList.add('show'); return; }
  const cambiarCentro  = centroNuevo.codigo !== FACTURA_EDITANDO.codigo;
  const cambiarPeriodo = periodoNuevo !== FACTURA_EDITANDO.periodo;
  if(!cambiarCentro && !cambiarPeriodo){ showToast('No hay cambios para aplicar','err'); return; }
  const lineas = ['¿Rectificar la factura '+FACTURA_EDITANDO.numero+'?',''];
  if(cambiarCentro){
    lineas.push('   Centro: '+(FACTURA_EDITANDO.cliente||'—')+' ('+(FACTURA_EDITANDO.codigo||'—')+')');
    lineas.push('        → '+centroNuevo.cliente+' ('+centroNuevo.codigo+')');
  }
  if(cambiarPeriodo){ lineas.push('   Período: '+FACTURA_EDITANDO.periodo+' → '+periodoNuevo); }
  lineas.push('');
  lineas.push('Se actualizarán TODAS las filas con ese N° de factura.');
  if(!confirm(lineas.join('\n'))) return;
  setStatus('Rectificando factura...','');
  try{
    const res = await apiPost({
      accion: 'rectificarFactura',
      numero: FACTURA_EDITANDO.numero,
      nuevoCliente:  cambiarCentro ? centroNuevo.cliente : null,
      nuevoCodigo:   cambiarCentro ? centroNuevo.codigo  : null,
      nuevoPeriodo:  cambiarPeriodo ? periodoNuevo : null
    });
    if(!res.ok) throw new Error(res.error||'Error al rectificar');
    showToast('✓ Factura '+FACTURA_EDITANDO.numero+' rectificada','ok');
    setStatus('✓ Factura rectificada','ok');
    cerrarModalRectificar();
    cerrarModal();
    setTimeout(() => {
      Promise.resolve()
        .then(() => cargar())
        .catch(e => console.warn('[rectificar] cargar() falló:', e));
    }, 0);
  }catch(e){
    setStatus('Error: '+e.message,'err');
    err.textContent=e.message;
    err.classList.add('show');
  }
}

async function eliminarFactura(){
  if(!FACTURA_EDITANDO){
    showToast('No hay factura cargada para eliminar','err');
    return;
  }
  const num = FACTURA_EDITANDO.numero;
  const cli = FACTURA_EDITANDO.cliente || '—';
  const cod = FACTURA_EDITANDO.codigo || '—';
  const per = FACTURA_EDITANDO.periodo || '—';
  const tip = FACTURA_EDITANDO.tipo || '—';
  const tot = Number(FACTURA_EDITANDO.total) || 0;
  const ok = confirm(
    '⚠ Eliminar definitivamente la factura N° ' + num + '\n\n' +
    '   Centro: ' + cli + ' (' + cod + ')\n' +
    '   Período: ' + per + ' · Tipo: ' + tip + '\n' +
    '   Monto total: $' + tot.toLocaleString('es-CL') + '\n\n' +
    'Se borrarán TODAS las filas con ese número de factura.\n' +
    'Esta acción no se puede deshacer.'
  );
  if(!ok) return;

  // ─── UI optimista inmediata ───
  //  Deshabilitamos el botón, cerramos el modal y quitamos la factura
  //  del modelo local ANTES de esperar la red. El usuario ve el cambio
  //  reflejado en KPIs, tablas y gráficos de inmediato.
  const btn = document.getElementById('btnEliminar');
  if(btn) btn.disabled = true;

  // Snapshot para poder revertir si el backend falla.
  const _previasEliminadas = FACTURAS.filter(f =>
    String(f.numero || '').trim() === String(num || '').trim()
  );
  const _numStr = String(num || '').trim();
  FACTURAS = FACTURAS.filter(f => String(f.numero || '').trim() !== _numStr);

  cerrarModal();
  _renderVistaActiva();
  setStatus('Eliminando factura ' + num + '…','');

  try{
    const res = await apiPost({ accion: 'eliminarFacturaCompleta', numero: num });
    if(!res.ok) throw new Error(res.error || 'Error al eliminar');
    const detalle = res.eliminadas > 1 ? ' (' + res.eliminadas + ' filas)' : '';
    showToast('✓ Factura ' + num + ' eliminada' + detalle, 'ok');
    setStatus('✓ Factura eliminada','ok');

    setTimeout(() => {
      Promise.resolve()
        .then(() => cargar())
        .catch(e => console.warn('[eliminar] cargar() falló:', e));
    }, 0);
  }catch(e){
    // Revertir: reinsertar las filas que se habían quitado.
    if(_previasEliminadas.length){
      _previasEliminadas.forEach(f => FACTURAS.push(f));
      _renderVistaActiva();
    }
    setStatus('Error: ' + e.message, 'err');
    showToast('Error: ' + e.message, 'err');
  }
}

function cerrarModal(){
  // Resetear el ancho del modal al estándar (por si estaba en modo
  // wide por tener preview). El próximo `_abrirModal` lo ajustará
  // según corresponda.
  const _box = document.querySelector('#modalAgregar .modal-box');
  if(_box) _box.classList.remove('modal-box-wide');

  // ─── Registrar "revisión sin diferencias" antes de limpiar el estado ───
  //  Si al abrir la factura el OCR la comparó y no encontró diferencias,
  //  actualizamos "Procesado" en la BD para dejar constancia de la revisión.
  //  Se hace en background: no bloquea el cierre del modal ni la navegación.
  try {
    const _debeRegistrarRevision =
      VISTA !== 'DETALLE' &&
      _SIN_DIFERENCIAS_AL_ABRIR &&
      !_REVISION_YA_REGISTRADA &&
      MODO_MODAL === 'editar' &&
      FACTURA_EDITANDO &&
      FACTURA_EDITANDO.numero &&
      !FACTURA_YA_GUARDADA_EN_BD;

    if (_debeRegistrarRevision) {
      const numRev = String(FACTURA_EDITANDO.numero).trim();
      _REVISION_YA_REGISTRADA = true;
      apiPost({ accion: 'marcarFacturaRevisada', numero: numRev })
        .then(res => {
          if (res && res.ok) {
            try { cargar(); } catch (e) {}
          } else if (res && res.error) {
            console.warn('[revisión] No se pudo marcar como revisada:', res.error);
          }
        })
        .catch(err => {
          console.warn('[revisión] Error al marcar como revisada:', err);
        });
    }
  } catch (e) {
    console.warn('[revisión] Excepción al registrar revisión:', e);
  }

  document.getElementById('modalAgregar').classList.remove('open');
  cerrarModalOCRDiscrepancia();
  cerrarToastComparacion();
  MODO_MODAL='crear';
  FACTURA_EDITANDO=null;
  PDF_ACTUAL=null;
  PDF_FUENTE=null;
  PDF_WARNINGS=[];
  PDF_YA_SUBIDO=false;
  FACTURA_YA_GUARDADA_EN_BD=false;
  _ocultarDiffPanel();
  _FACTURA_ORIGINAL_DIFF=null;
  _CAMPOS_PDF_PENDIENTE=null;
  _PDF_ACTUAL_PENDIENTE=null;
  _PDF_WARNINGS_PENDIENTE=null;
  _ULTIMOS_CAMPOS_OCR=null;
  _PDF_TEXTO_OCR='';
  _SIN_DIFERENCIAS_AL_ABRIR=false;
  _REVISION_YA_REGISTRADA=false;
  cerrarPreview();
}

function renderResumen(){
  const fM=document.getElementById('filtroMes').value;
  const fC=document.getElementById('filtroCentro').value;
  const soloDesfase=document.getElementById('chkDesfase').checked;
  const soloDesfase10=document.getElementById('chkDesfase10').checked;
  const soloInt=document.getElementById('chkIntereses').checked;
  const soloSI=document.getElementById('chkSI').checked;
  const chkSinFechaEl=document.getElementById('chkSinFecha');
  const soloSinFecha=chkSinFechaEl ? chkSinFechaEl.checked : true;
  const chkVaciosEl=document.getElementById('chkVacios');
  const ocultarVacios=chkVaciosEl ? chkVaciosEl.checked : true;
  const filtroTipo=(document.getElementById('filtroTipoDetalle')||{}).value || 'todo';

  // Resolver el subconjunto de períodos que aplica el filtro de mes:
  //   'todos'      → hasta el mes actual
  //   'ult3/6/12'  → los N más recientes hasta hoy
  //   'YYYY-MM'    → ese único mes
  const _periodosFiltroDet = _periodosSegunFiltroMes(fM);
  const _periodosDetSet    = new Set(_periodosFiltroDet);

  let facturasFiltradas=FACTURAS.slice();
  // Excluir centros "fantasma" (TEMP / Sin asignar / ⚠)
  facturasFiltradas = facturasFiltradas.filter(f => !_esCentroFantasma(f.codigo, f.cliente));
  facturasFiltradas = facturasFiltradas.filter(f => _periodosDetSet.has(f.periodo));
  if(fC!=='todos')facturasFiltradas=facturasFiltradas.filter(f=>claveCliente(f)===fC);

  if(filtroTipo !== 'todo'){
    facturasFiltradas = facturasFiltradas.filter(f => {
      const t = (f.tipo||'').toUpperCase();
      if(filtroTipo === 'SUMINISTRO') return t === 'SUMINISTRO' || t === 'CONSUMO';
      return t === filtroTipo;
    });
  }

  if(soloInt)facturasFiltradas=facturasFiltradas.filter(f=>(Number(f.intereses)>0)||(Number(f.intPeaje)>0));

  // Usa el MISMO contexto que la fila (f.tipo). Para UNIFICADA el estado
  // cae en la rama por defecto de fechaRelevante — igual que en el render.
  if(soloSI)facturasFiltradas=facturasFiltradas.filter(f=>estadoFactura(f,f.tipo)==='si');

  // "Mostrar sin fecha de recibido": conserva sólo las facturas cuya
  // fecha de recepción relevante (consumo/peaje según tipo) NO sea una
  // fecha ISO real. Se consideran "sin fecha":
  //   · celda vacía
  //   · sentinela 'Sin fecha'  ← el usuario marcó recibida sin día
  // NO se consideran "sin fecha":
  //   · fechas ISO reales (YYYY-MM-DD)
  //   · sentinelas 'N/A' y 'S/I' (son estados explícitos, no falta de fecha)
  if(soloSinFecha){
    const _sinFechaRec = (v) => {
      const s = String(v == null ? '' : v).trim();
      if (s === '')                  return true;   // celda vacía
      if (s === SENTINELA_SIN_FECHA) return true;   // "Sin fecha" (recibida sin día)
      return false;                                 // fecha ISO, N/A, S/I → no aplica
    };
    facturasFiltradas = facturasFiltradas.filter(f => {
      const sc = _sinFechaRec(f.fechaConsumo);
      const sp = _sinFechaRec(f.fechaPeaje);
      if(f.tipo === 'CONSUMO' || f.tipo === 'SUMINISTRO') return sc;
      if(f.tipo === 'PEAJE')                              return sp;
      if(f.tipo === 'UNIFICADA')                          return sc || sp;
      return sc && sp;
    });
  }

  if(soloDesfase)facturasFiltradas=facturasFiltradas.filter(f=>{
    const e=estadoFactura(f,f.tipo==='PEAJE'?'PEAJE':'CONSUMO');
    if(e!=='recibida'&&e!=='recibida-sf')return false;
    const d=diasDesfase(f);
    // diasDesfase() ya descarta el fallback referencial: si devuelve
    // null, la factura no tiene fecha de recepción real y no debe
    // contarse en el filtro de desfase.
    return d!==null && d>7;
  });

  if(soloDesfase10)facturasFiltradas=facturasFiltradas.filter(f=>{
    const d=diasDesfase(f);
    return d!==null && d>10;
  });

  const centrosFiltro=(fC!=='todos'?CONFIG.centros.filter(c=>c.cliente+' ('+c.codigo+')'===fC):CONFIG.centros)
                        .filter(c => !_esCentroFantasma(c.codigo, c.cliente));
  // Reutilizar el mismo subconjunto de períodos ya resuelto arriba
  // (respeta 'todos' / 'ultN' / mes puntual).
  const periodosFiltro = _periodosFiltroDet;
  const k=contarEstadosGrid(centrosFiltro,periodosFiltro);
  const sumas=sumarMontos(facturasFiltradas);
  const otrosTot = facturasFiltradas.reduce((a,f)=>a+(Number(f.otros)||0)+(Number(f.otrosPeaje)||0),0);

  // Las tarjetas KPI son compartidas entre las 3 vistas: las
  // renderiza renderKPIs() en el div #kpis, fuera de los
  // contenedores de vista.

  const filasSinteticas=[];
  if(!ocultarVacios&&!soloSI&&!soloInt&&!soloDesfase&&!soloDesfase10){
    const matrix={};
    FACTURAS.forEach(f=>{
      const key=claveCliente(f)+'|'+f.periodo;
      if(!matrix[key])matrix[key]={consumo:false,peaje:false};
      if(f.tipo==='CONSUMO'||f.tipo==='SUMINISTRO'||f.tipo==='UNIFICADA')matrix[key].consumo=true;
      if(f.tipo==='PEAJE'||f.tipo==='UNIFICADA')matrix[key].peaje=true;
    });
    CONFIG.centros.forEach(c=>{
      const key=c.cliente+' ('+c.codigo+')';
      if(fC!=='todos'&&fC!==key)return;
      if(_esCentroFantasma(c.codigo, c.cliente)) return;
      // Sólo los períodos que aplica el filtro (respeta 'ultN' y
      // excluye meses futuros cuando el filtro es 'todos').
      _periodosFiltroDet.forEach(p=>{
        const mkey=key+'|'+p;
        const has=matrix[mkey]||{consumo:false,peaje:false};
        const quiereSum    = (filtroTipo === 'todo' || filtroTipo === 'SUMINISTRO');
        const quierePeaje  = (filtroTipo === 'todo' || filtroTipo === 'PEAJE');
        if(!has.consumo && quiereSum)  filasSinteticas.push({tipo:'CONSUMO',factura:null,periodo:p,centro:key,codigo:c.codigo,cliente:c.cliente});
        if(!has.peaje  && quierePeaje) filasSinteticas.push({tipo:'PEAJE',  factura:null,periodo:p,centro:key,codigo:c.codigo,cliente:c.cliente});
      });
    });
  }

  const filas=[];
  facturasFiltradas.forEach(f=>filas.push({tipo:f.tipo,factura:f,periodo:f.periodo,centro:claveCliente(f)}));
  filasSinteticas.forEach(r=>filas.push(r));
  filas.sort((a,b)=>a.centro.localeCompare(b.centro)||a.periodo.localeCompare(b.periodo)||(a.factura?0:1)-(b.factura?0:1));

  const tbody=document.getElementById('tablaResumenBody');
  tbody.innerHTML='';
  // Los valores SENTINELAS ('Sin fecha', 'N/A', 'S/I') se muestran tal cual;
  // las fechas ISO reales se formatean a dd/mm; el resto → '—'.
  const fmtCell=v=>{const x=fechaValida(v);if(!x)return'—';if(SENTINELAS.indexOf(x)!==-1)return x;return fmtFecha(x);};
  // Las columnas de RECEPCIÓN usan un helper distinto: si la celda
  // está vacía, la factura existe pero sin día de recepción → "Sin fecha"
  // (en lugar de "—", que se interpretaría como "sin dato").
  const fmtRecep=v=>{
    const x=fechaValida(v);
    if(!x) return 'Sin fecha';
    if(SENTINELAS.indexOf(x)!==-1) return x;
    return fmtFecha(x);
  };

  filas.forEach(r=>{
    const f=r.factura;
    const tr=document.createElement('tr');
    if(!f){
      const pasado=esPeriodoPasado(r.periodo);
      const est=pasado?'Pendiente':'Por Emitir';
      const color=pasado?'#fbbf24':'#86efac';
      tr.innerHTML=`
        <td class="ghost" title="Agregar factura en este período">+</td>
        <td class="ghost">${r.codigo}</td>
        <td class="ghost">${r.cliente}</td>
        <td class="ghost">${formatPeriodo(r.periodo)}</td>
        <td class="ghost"><span class="tipo-badge ${r.tipo.toLowerCase()}">${r.tipo==='CONSUMO'?'SUMINISTRO':(r.tipo==='ARRIENDO_MEDIDOR'?'ARRIENDO MEDIDOR':r.tipo)}</span></td>
        <td class="ghost">—</td><td class="ghost">—</td><td class="ghost">—</td><td class="ghost">—</td>
        <td class="num ghost">—</td><td class="num ghost">—</td><td class="num ghost">—</td><td class="num ghost">—</td><td class="num ghost">—</td><td class="num ghost">—</td><td class="num ghost">—</td><td class="num ghost">—</td><td class="num ghost">—</td>
        <td style="color:${color};font-weight:600;font-size:0.7rem;">${est}</td>`;
      tr.querySelectorAll('td').forEach(td=>td.addEventListener('click',ev=>{
        ev.stopPropagation();
        abrirModalAgregar(r.centro,r.periodo,r.tipo);
      }));
      tbody.appendChild(tr);
      return;
    }
    const e=estadoFactura(f,r.tipo);
    let label,color;
    if(e==='recibida')         {label='✓ Recibida';         color='#34d399';}
    else if(e==='recibida-sf') {label='📅 Sin Fecha';       color='#fbbf24';}
    else if(e==='pendiente')   {label='⚠ Pendiente';        color='#fbbf24';}
    else if(e==='plazo')       {label='◷ Dentro del plazo'; color='#60a5fa';}
    else if(e==='por-emitir')  {label='◷ Por Emitir';       color='#86efac';}
    else if(e==='na')          {label='⊘ N/A';              color='#94a3b8';}
    else                       {label='— S/I';              color='#9ca3af';}
    const tipoClase=(f.tipo||'SUMINISTRO').toLowerCase();
    const tipoLabel = f.tipo === 'SUMINISTRO' ? 'SUMINISTRO'
                    : f.tipo === 'ARRIENDO_MEDIDOR' ? 'ARRIENDO MEDIDOR'
                    : f.tipo;
    // ─── Desfase unificado (según tipo de factura) ───
    //  diasDesfase() devuelve null si no hay fecha de recepción REAL
    //  (el fallback a fechaEmision se ignora aquí para no mostrar "0d"
    //  cuando en realidad la factura no tiene fecha de recepción).
    const dUnif = diasDesfase(f);
    const claseUnif = claseDesfase(dUnif);
    let diasUnifTxt;
    if (dUnif === null) {
      diasUnifTxt = '';   // sin fecha de recepción → celda vacía
    } else {
      diasUnifTxt = (dUnif >= 0 ? '+' + dUnif + 'd' : dUnif + 'd');
    }
    const falt=camposFaltantes(f);
    const warnTxt=(e!=='si'&&e!=='na'&&falt.length)?' <span class="warn-icon" title="Falta: '+falt.join(', ')+'">⚠</span>':'';

    // ─── Reglas de edición por tipo de factura ───
    //  · CONSUMO           → sólo Recep. Sum. editable
    //  · PEAJE             → sólo Recep. Peaje editable
    //  · ARRIENDO_MEDIDOR  → sólo Recep. Peaje editable (mismo criterio que Peaje)
    //  · UNIFICADA         → ambas editables, misma fecha mostrada en ambas
    //  · Otro / sin tipo   → ambas bloqueadas
    const _editConsumo = (f.tipo === 'CONSUMO') || (f.tipo === 'SUMINISTRO') || (f.tipo === 'UNIFICADA');
    const _editPeaje   = (f.tipo === 'PEAJE')   || (f.tipo === 'ARRIENDO_MEDIDOR') || (f.tipo === 'UNIFICADA');

    // Para UNIFICADA, mostrar SIEMPRE el mismo valor en ambas columnas.
    // Se toma el mayor (o el único presente), consistente con el criterio
    // de fechaRecepcionParaDesfase / diasDesfase.
    let _dispConsumo = f.fechaConsumo;
    let _dispPeaje   = f.fechaPeaje;
    if (f.tipo === 'UNIFICADA') {
      const _vc  = fechaValida(f.fechaConsumo);
      const _vp  = fechaValida(f.fechaPeaje);
      const _cOk = _vc && SENTINELAS.indexOf(_vc) === -1;
      const _pOk = _vp && SENTINELAS.indexOf(_vp) === -1;
      let _fU = '';
      if (_cOk && _pOk)  _fU = (_vc > _vp) ? _vc : _vp;
      else if (_cOk)     _fU = _vc;
      else if (_pOk)     _fU = _vp;
      else if (_vc)      _fU = _vc;   // sentinel N/A o S/I
      else if (_vp)      _fU = _vp;
      _dispConsumo = _fU;
      _dispPeaje   = _fU;
    }

    const _celdaRecepConsumo = _editConsumo
      ? `<td class="editable" data-campo="fechaConsumo">${fmtRecep(_dispConsumo)}</td>`
      : `<td style="text-align:center;color:var(--text-dim);font-weight:600;">—</td>`;

    const _celdaRecepPeaje = _editPeaje
      ? `<td class="editable" data-campo="fechaPeaje">${fmtRecep(_dispPeaje)}</td>`
      : `<td style="text-align:center;color:var(--text-dim);font-weight:600;">—</td>`;

    tr.innerHTML=`
      <td class="editable" data-campo="numero">${f.numero}</td>
      <td>${f.codigo||'—'}</td>
      <td>${f.cliente}</td>
      <td>${formatPeriodo(f.periodo)}</td>
      <td class="editable" data-campo="tipo"><span class="tipo-badge ${tipoClase}">${tipoLabel}</span></td>
      <td class="editable" data-campo="fechaEmision">${fmtCell(f.fechaEmision)}</td>
      <td class="editable" data-campo="fechaVencimiento">${fmtCell(f.fechaVencimiento)}</td>
      ${_celdaRecepConsumo}
      ${_celdaRecepPeaje}
      <td class="num desfase ${claseUnif}">${diasUnifTxt}</td>
      <td class="num editable" data-campo="kwh">${fmtKwh(f.kwh)}</td>
      <td class="num editable" data-campo="sum">$${fmtMiles(f.sum)}</td>
      <td class="num editable" data-campo="peaje">$${fmtMiles(f.peaje)}</td>
      <td class="num editable" data-campo="intereses">$${fmtMiles(f.intereses)}</td>
      <td class="num editable" data-campo="intPeaje">$${fmtMiles(f.intPeaje)}</td>
      <td class="num editable" data-campo="otros">$${fmtMiles(f.otros)}</td>
      <td class="num editable" data-campo="otrosPeaje">$${fmtMiles(f.otrosPeaje)}</td>
      <td class="num editable" data-campo="total"><b>$${fmtMiles(f.total)}</b></td>
      <td style="color:${color};font-weight:600;font-size:0.7rem;">${label}${warnTxt}</td>`;
    tr.querySelectorAll('td.editable').forEach(td=>td.addEventListener('click',ev=>{
      ev.stopPropagation();
      if(td.dataset.campo === 'numero'){
        abrirModalEditar(claveCliente(f), f.periodo, f.tipo || 'CONSUMO', f);
        return;
      }
      abrirEditorInlineDetalle(td,f,td.dataset.campo);
    }));
    tbody.appendChild(tr);
  });

  // Si no hay filas visibles, mostrar un mensaje informativo en la tabla
  // en lugar de dejar el tbody vacío (confunde al usuario).
  if(!filas.length){
    const trVacio = document.createElement('tr');
    trVacio.innerHTML =
      '<td colspan="19" style="text-align:center;padding:32px 16px;' +
      'color:var(--text-dim);font-style:italic;font-size:.82rem;">' +
      'No hay facturas que coincidan con los filtros seleccionados.' +
      '</td>';
    tbody.appendChild(trVacio);
  }
}

function abrirEditorInlineDetalle(td,factura,campo){
  if(td.querySelector('.cell-edit-det'))return;
  const contenidoOriginal=td.innerHTML;
  let finalizado=false;
  const esFecha=campo.indexOf('fecha')===0;
  const esTipo=campo==='tipo';
  td.innerHTML='';
  const wrap=document.createElement('div');wrap.className='cell-edit-det';
  let input;
  if(esTipo){
    input=document.createElement('select');
    [
      ['SUMINISTRO','Suministro'],
      ['PEAJE','Peaje'],
      ['UNIFICADA','Unificada'],
      ['ARRIENDO_MEDIDOR','Arriendo medidor']
    ].forEach(([v,label])=>{
      const o=document.createElement('option');o.value=v;o.textContent=label;
      if((factura.tipo||'').toUpperCase()===v)o.selected=true;
      input.appendChild(o);
    });
  }else if(esFecha){
    input=document.createElement('input');input.type='date';
    const v=fechaValida(factura[campo]);
    input.value=(v&&SENTINELAS.indexOf(v)===-1)?v:'';
  }else if(campo==='numero'){
    input=document.createElement('input');input.type='text';
    input.value=factura.numero||'';
  }else{
    input=document.createElement('input');
    input.type='text';
    input.inputMode='decimal';
    input.value=numeroAInput(factura[campo]);
  }
  wrap.appendChild(input);td.appendChild(wrap);
  const valorInicial = input.value;   // lo que realmente mostró el editor
  input.focus();
  if(esFecha&&input.showPicker)try{input.showPicker();}catch(e){}
  async function guardar(){
    if(finalizado)return;finalizado=true;
    const nuevoValor=input.value;
    const esNum = !(campo==='numero'||esTipo||esFecha);
    const anterior=esTipo?(factura.tipo||''):
                   esFecha?(fechaValida(factura[campo])||''):
                   campo==='numero'?(factura.numero||''):
                   (Number(factura[campo])||0);
    const valorEnviar = esNum ? inputANumero(nuevoValor) : nuevoValor;
    const sinCambio = esNum
      ? inputANumero(nuevoValor) === (Number(factura[campo])||0)
      : String(nuevoValor) === String(valorInicial);
    if(sinCambio){td.innerHTML=contenidoOriginal;return;}

    // ─── (1) UPDATE OPTIMISTA ───
    //  Reflejar el nuevo valor en la celda al instante, con el mismo
    //  formato que usa el renderizado normal de la tabla. El editor se
    //  cierra ya (su <input> queda fuera del DOM al reemplazar innerHTML).
    //  Si el backend falla, `cargar()` reconstruye la tabla con el valor
    //  autoritativo y el optimista se revierte solo.
    {
      let htmlOpt;
      if(esTipo){
        const t   = String(valorEnviar || '').toUpperCase();
        const cls = t.toLowerCase();
        const lbl = t === 'SUMINISTRO'      ? 'SUMINISTRO'
                  : t === 'ARRIENDO_MEDIDOR' ? 'ARRIENDO MEDIDOR'
                  : t;
        htmlOpt = '<span class="tipo-badge ' + cls + '">' + lbl + '</span>';
      } else if(esFecha){
        const x = fechaValida(valorEnviar);
        htmlOpt = (x && SENTINELAS.indexOf(x) === -1) ? fmtFecha(x) : (x || '—');
      } else if(campo === 'numero'){
        htmlOpt = escAttr(String(valorEnviar || '—'));
      } else if(campo === 'kwh'){
        htmlOpt = fmtMiles(valorEnviar);
      } else {
        htmlOpt = '$' + fmtMiles(valorEnviar);
      }
      td.innerHTML = htmlOpt;
    }

    // ─── Actualización del modelo local ───
    //  `factura` es una referencia viva dentro de FACTURAS, así que
    //  mutarla ya refleja el cambio en el modelo. Se re-renderiza la
    //  vista en el próximo frame para no interferir con el evento
    //  que el usuario acaba de disparar (blur del input).
    if(esTipo){
      factura.tipo = String(valorEnviar || '').toUpperCase();
    } else if(esFecha){
      const v = fechaValida(valorEnviar);
      factura[campo] = (v && SENTINELAS.indexOf(v) === -1) ? v : (v || '');
    } else if(campo === 'numero'){
      factura.numero = String(valorEnviar || '');
    } else {
      factura[campo] = Number(valorEnviar) || 0;
    }
    // Refresco diferido: KPIs + tabla Detalle, sin bloquear el guardado.
    setTimeout(() => {
      _renderVistaActiva();
    }, 0);

    const numOrig           = factura.numero;
    const tipoOrig          = factura.tipo;
    const periodo           = factura.periodo;
    const esFechaRecepcion  = (campo === 'fechaConsumo' || campo === 'fechaPeaje');
    setStatus('Guardando...','');

    // ─── (2) TRABAJO EN BACKGROUND ───
    //  No se await-ea desde el handler del editor: el usuario ya tiene
    //  la celda actualizada y puede seguir editando otras. Al terminar
    //  (éxito o error) se dispara cargar() para sincronizar la tabla
    //  con el servidor.
    (async () => {
      try{
        let res;
        if (esFechaRecepcion) {
          // Delegar en actualizarFecha: aplica reglas por tipo de factura.
          res = await apiPost({
            accion: 'actualizarFecha',
            numero: numOrig,
            fecha:  nuevoValor,
            tipo:   (factura.tipo === 'UNIFICADA') ? 'AMBAS' : factura.tipo
          });
        } else {
          res = await apiPost({
            accion: 'actualizarCampo',
            numeroOriginal: numOrig,
            tipoOriginal:   tipoOrig,
            periodo,
            campo,
            valor: valorEnviar
          });
        }
        if(!res || !res.ok) throw new Error((res && res.error) || 'Error');
        showToast('F-' + numOrig + ' · ' + campo + ' actualizado','ok');
      }catch(e){
        setStatus('Error: ' + e.message,'err');
        showToast('Error: ' + e.message,'err');
      }finally{
        // Refresco en background: sincroniza con el estado del servidor.
        cargar();
      }
    })();
  }
  input.addEventListener('blur',guardar);
  input.addEventListener('keydown',e=>{
    if(e.key==='Enter'){e.preventDefault();input.blur();}
    if(e.key==='Escape'){e.preventDefault();finalizado=true;td.innerHTML=contenidoOriginal;}
  });
}

function renderDashboard(){
  // La filter bar compartida alimenta al Dashboard con los mismos
  // controles que Seguimiento y Detalle, más "📊 Métrica" exclusivo.
  // Los valores viven en el DOM; no hay estado local ni persistencia.
  // dashMetrica se resetea a "total" desde irADashboard / irASeguimiento
  // / irADetalle según especificación.
  const comunidad = (document.getElementById('filtroCentro') || {}).value || 'todos';
  const rango     = (document.getElementById('filtroMes')    || {}).value || 'todos';
  const metrica   = (document.getElementById('dashMetrica')  || {}).value || 'total';

  const titulos={ total:'Evolución mensual — Total facturado', sum:'Evolución mensual — Suministro', peaje:'Evolución mensual — Peaje', intereses:'Evolución mensual — Intereses' };
  const elTit=document.getElementById('tituloTendencia');
  if(elTit)elTit.textContent=titulos[metrica]||'Evolución mensual';

const titRank=document.getElementById('tituloRanking');
if(titRank){
if(comunidad==='todos'){
titRank.innerHTML='Ranking por centro de costo <span class="chart-sub" id="subtituloRanking">promedio mensual ($)</span>';
}else{
titRank.innerHTML='Evolución mensual <span class="chart-sub" id="subtituloRanking">mensual ($)</span>';
}
}

  // ───────────────────────────────────────────────────────
  //  1) Rango de períodos: delegado al helper común.
  //     'todos'  → todos hasta el mes actual
  //     'ult6'   → 6 más recientes hasta hoy
  //     'ult12'  → 12 más recientes hasta hoy
  //     El helper también excluye meses futuros.
  // ───────────────────────────────────────────────────────
  // _periodosSegunFiltroMes ya entiende 'todos', 'ult3/6/12' y 'YYYY-MM'.
  // Pasar el valor tal cual del selector mantiene el Dashboard alineado
  // con las otras dos vistas (antes sólo soportaba ult6/ult12).
  const periodos = _periodosSegunFiltroMes(rango);

  // Universo de centros para el KPI
  let centrosKpi = CONFIG.centros.filter(c => !_esCentroFantasma(c.codigo, c.cliente));
  if (comunidad !== 'todos') {
    centrosKpi = centrosKpi.filter(c => c.cliente+' ('+c.codigo+')' === comunidad);
  }

  const clientesSet = new Set(centrosKpi.map(c => c.cliente + ' (' + c.codigo + ')'));
  const periodosSet = new Set(periodos);

  // ─── Fuente única de verdad para TODO el Dashboard ───
  //  facturasVisibles = FACTURAS ∩ clientesSet ∩ periodosSet,
  //  deduplicada por N° de factura (para que las UNIFICADAS
  //  —que aparecen en 2 filas de la hoja— cuenten una sola vez).
  //
  //  Se construye AQUÍ (antes de los contadores y de todos los
  //  gráficos) para que cualquier cálculo posterior la use.
  //
  //  Nota sobre UNIFICADA: se prefiere la fila donde está el
  //  registro "principal" (tipo === 'UNIFICADA') antes que sus
  //  variantes CONSUMO/PEAJE, porque los montos (sum, peaje,
  //  intereses, intPeaje) están consolidados en esa fila.
  const facturasVisibles = (() => {
    const porNumero = new Map();
    FACTURAS.forEach(f => {
      if (!clientesSet.has(claveCliente(f))) return;
      if (!periodosSet.has(f.periodo))        return;
      const num = String(f.numero || '').trim();
      if (!num) return;
      const prev = porNumero.get(num);
      if (!prev) { porNumero.set(num, f); return; }
      const prevEsUnif = String(prev.tipo || '').toUpperCase() === 'UNIFICADA';
      const currEsUnif = String(f.tipo    || '').toUpperCase() === 'UNIFICADA';
      if (!prevEsUnif && currEsUnif) porNumero.set(num, f);
    });
    return Array.from(porNumero.values());
  })();

  // Alias `facturas` para no romper los bloques que la referencian.
  const facturas = facturasVisibles;

  // ───────────────────────────────────────────────────────
  //  2) Contadores y montos: mismo criterio que la vista
  //     seguimiento (facturas reales + celdas vacías).
  // ───────────────────────────────────────────────────────
  const k = {recibidas:0, recibidas_sf:0, pendientes:0, porEmitir:0,
             dentroPlazo:0, sinInfo:0, noAplica:0, total:0};
  const celdasConFactura = { CONSUMO:{}, PEAJE:{} };
  let suministro = 0, peaje = 0, intereses = 0;

  facturasVisibles.forEach(f => {
    const cl = claveCliente(f);

    const _sumar = est => {
      if      (est === 'na')           k.noAplica++;
      else if (est === 'si')           k.sinInfo++;
      else if (est === 'recibida')     k.recibidas++;
      else if (est === 'recibida-sf')  k.recibidas_sf++;
      else if (est === 'por-emitir')   k.porEmitir++;
      else if (est === 'plazo')        k.dentroPlazo++;
      else if (est === 'pendiente')    k.pendientes++;
    };

    // Contadores de estado: cuentan la factura en CADA tabla donde
    // aparece (Suministro y/o Peaje), igual que en la vista Seguimiento.
    if (f.tipo === 'CONSUMO' || f.tipo === 'SUMINISTRO' || f.tipo === 'UNIFICADA') {
      k.total++;
      _sumar(estadoFactura(f, 'CONSUMO'));
      celdasConFactura.CONSUMO['CONSUMO|' + cl + '|' + f.periodo] = true;
    }
    if (f.tipo === 'PEAJE' || f.tipo === 'UNIFICADA') {
      k.total++;
      _sumar(estadoFactura(f, 'PEAJE'));
      celdasConFactura.PEAJE['PEAJE|' + cl + '|' + f.periodo] = true;
    }

    // Montos: ya viene deduplicado por N° factura.
    suministro += Number(f.sum) || 0;
    peaje      += Number(f.peaje) || 0;
    intereses  += (Number(f.intereses) || 0) + (Number(f.intPeaje) || 0);
  });

  // ─── "Dentro del plazo" = recibidas en ≤ 5 días desde EMISIÓN ───
  //  estadoFactura() nunca devuelve 'plazo', así que este contador
  //  debe recalcularse igual que en renderKPIs(): se recorren las
  //  facturas ya recibidas (con fecha real) y se cuenta la diferencia
  //  emisión → recepción ≤ 5 días. La recepción se mide contra
  //  fechaConsumo (suministro) o fechaPeaje (peaje), ambas referidas
  //  a la fecha de emisión de la factura.
  k.dentroPlazo = 0;
  facturasVisibles.forEach(f => {
    const ctx = (f.tipo === 'PEAJE') ? 'PEAJE' : 'CONSUMO';
    const est = estadoFactura(f, ctx);
    if (est !== 'recibida') return;
    const d = (ctx === 'PEAJE') ? diasDesfasePeaje(f) : diasDesfaseSum(f);
    if (d !== null && d <= DIAS_ATRASO) k.dentroPlazo++;
  });

  // ─── Atrasadas ───
  //  Misma definición que renderKPIs(): sólo recibidas con desfase
  //  > DIAS_ATRASO. Las pendientes NO entran.
  k.fueraPlazo = 0;
  facturasVisibles.forEach(f => {
    const ctx = (f.tipo === 'PEAJE') ? 'PEAJE' : 'CONSUMO';
    const est = estadoFactura(f, ctx);
    if (est !== 'recibida') return;
    const d = (ctx === 'PEAJE') ? diasDesfasePeaje(f) : diasDesfaseSum(f);
    if (d !== null && d > DIAS_ATRASO) k.fueraPlazo++;
  });

  // Celdas vacías → Pendiente (período pasado) / Por Emitir (actual o futuro)
  ['CONSUMO','PEAJE'].forEach(ctx => {
    centrosKpi.forEach(c => {
      const cl = c.cliente + ' (' + c.codigo + ')';
      periodos.forEach(p => {
        const key = ctx + '|' + cl + '|' + p;
        if (celdasConFactura[ctx][key]) return;
        k.total++;
        if (esPeriodoPasado(p)) k.pendientes++;
        else                    k.porEmitir++;
      });
    });
  });

  // (movido arriba — ver Cambio 4)

  const sumas = { suministro, peaje, intereses, total: suministro + peaje };

  let lastClass,lastLabel,lastValue,lastMeta;
  if(metrica==='total'||metrica==='intereses'){
    lastClass='red'; lastLabel='Total Intereses'; lastValue=sumas.intereses;
    lastMeta=facturas.filter(f=>(f.intereses>0)||(f.intPeaje>0)).length+' facturas con int.';
  }else if(metrica==='sum'){
    lastClass='green'; lastLabel='Total Suministro'; lastValue=sumas.suministro;
    lastMeta=facturas.filter(f=>f.sum>0).length+' facturas con Sum.';
  }else if(metrica==='peaje'){
    lastClass='amber'; lastLabel='Total Peaje'; lastValue=sumas.peaje;
    lastMeta=facturas.filter(f=>f.peaje>0).length+' facturas con peaje';
  } else {
    lastClass='gray'; lastLabel='Sin datos'; lastValue=0; lastMeta='';
  }

  // Las tarjetas KPI son compartidas entre las 3 vistas: las
  // renderiza renderKPIs() en el div #kpis, fuera de los
  // contenedores de vista.

  const sumMes={},peajeMes={},intMes={},recibMes={},pendMes={};
  periodos.forEach(p=>{sumMes[p]=0;peajeMes[p]=0;intMes[p]=0;recibMes[p]=0;pendMes[p]=0;});
  facturasVisibles.forEach(f=>{
    if(!(f.periodo in sumMes))return;
    sumMes[f.periodo]+=Number(f.sum)||0;
    peajeMes[f.periodo]+=Number(f.peaje)||0;
    intMes[f.periodo]+=(Number(f.intereses)||0)+(Number(f.intPeaje)||0);
  });

  // ─── Meses con datos para "Evolución mensual" ───
  //  Criterio según la MÉTRICA activa: un mes se omite si la serie
  //  que se está graficando vale 0 en ese mes.
  //    · total     → sum + peaje ≠ 0
  //    · sum       → sum ≠ 0
  //    · peaje     → peaje ≠ 0
  //    · intereses → intereses + intPeaje ≠ 0
  const _mesesConDatos = new Set();
  periodos.forEach(p => {
    let tiene = false;
    if      (metrica === 'sum')       tiene = sumMes[p]   !== 0;
    else if (metrica === 'peaje')     tiene = peajeMes[p] !== 0;
    else if (metrica === 'intereses') tiene = intMes[p]   !== 0;
    else /* total */                  tiene = (sumMes[p] !== 0 || peajeMes[p] !== 0);
    if (tiene) _mesesConDatos.add(p);
  });

  const idxEstado={};
  // Se recorre FACTURAS (no facturasVisibles) porque necesitamos
  // ambas filas de las UNIFICADAS: una para 'consumo', otra para
  // 'peaje'. Pero el filtro clientesSet + periodosSet garantiza que
  // no entren fantasmas ni períodos fuera del rango.
  FACTURAS.forEach(f=>{
    if(!clientesSet.has(claveCliente(f))) return;
    if(!periodosSet.has(f.periodo))        return;
    const key=claveCliente(f)+'|'+f.periodo;
    if(!idxEstado[key])idxEstado[key]={consumo:null,peaje:null};
    if(f.tipo==='CONSUMO'||f.tipo==='SUMINISTRO'||f.tipo==='UNIFICADA')idxEstado[key].consumo=f;
    if(f.tipo==='PEAJE'||f.tipo==='UNIFICADA')idxEstado[key].peaje=f;
  });
  const _centrosBase = CONFIG.centros.filter(c => !_esCentroFantasma(c.codigo, c.cliente));
  const centrosEstado = comunidad==='todos' ? _centrosBase : _centrosBase.filter(c=>c.cliente+' ('+c.codigo+')'===comunidad);
  centrosEstado.forEach(c=>{
    const clave=c.cliente+' ('+c.codigo+')';
    periodos.forEach(p=>{
      if(!(p in recibMes))return;
      [['consumo','CONSUMO'],['peaje','PEAJE']].forEach(pair=>{
        const cell=idxEstado[clave+'|'+p]||{consumo:null,peaje:null};
        const f=cell[pair[0]];
        let est;
        if(f)est=estadoFactura(f,pair[1]);
        else est=esPeriodoPasado(p)?'pendiente':'por-emitir';
        if(est==='recibida'||est==='recibida-sf')recibMes[p]++;
        else if(est==='pendiente'||est==='plazo')pendMes[p]++;
        // 'por-emitir' no se acumula: nunca ocurre en el rango visible
        // del Dashboard (todos los períodos son cerrados).
      });
    });
  });

  const labels=periodos.map(p=>formatPeriodo(p));
  const isDark=!document.body.classList.contains('light');
  const gridColor=isDark?'rgba(255,255,255,.08)':'rgba(0,0,0,.08)';
  const textColor=isDark?'#8892a6':'#64748b';
  Chart.defaults.color = textColor;

  destroyChart('chartTendencia');
  const ctx1=document.getElementById('chartTendencia');
  if(ctx1){
    // ─── Filtrar períodos sin datos ───
    //  Evolución mensual omite los meses en los que las 3 series
    //  son 0 (sin facturas visibles). El resto de los gráficos
    //  conserva la línea temporal completa.
    const _periodosConDatos = periodos.filter(p => _mesesConDatos.has(p));
    const _labelsTend      = _periodosConDatos.map(p => formatPeriodo(p));

    const seriesAll=[
      {key:'sum',label:'Suministro',data:_periodosConDatos.map(p=>sumMes[p]),borderColor:'#3b82f6',bg:'rgba(59,130,246,.15)',dashed:false},
      {key:'peaje',label:'Peaje',data:_periodosConDatos.map(p=>peajeMes[p]),borderColor:'#f59e0b',bg:'rgba(245,158,11,.15)',dashed:false},
      {key:'intereses',label:'Intereses',data:_periodosConDatos.map(p=>intMes[p]),borderColor:'#ef4444',bg:'rgba(239,68,68,.10)',dashed:true}
    ];
    let datasets;
    if(metrica==='total'){
      datasets=seriesAll.map(s=>({label:s.label,data:s.data,borderColor:s.borderColor,backgroundColor:s.bg,tension:.35,fill:true,borderWidth:2,pointRadius:3,borderDash:s.dashed?[4,4]:[]}));
    }else{
      const s=seriesAll.find(x=>x.key===metrica)||seriesAll[0];
      datasets=[{label:s.label,data:s.data,borderColor:s.borderColor,backgroundColor:s.bg,tension:.35,fill:true,borderWidth:3,pointRadius:4,borderDash:s.dashed?[6,4]:[]}];
    }
    CHARTS.tendencia=new Chart(ctx1,{
      type:'line',
      data:{labels:_labelsTend,datasets},
      options:{
        responsive:true,maintainAspectRatio:false,
        plugins:{
          legend:{display:datasets.length>1,labels:{color:textColor,font:{size:11}}},
          tooltip:{callbacks:{label:ctx=>ctx.dataset.label+': $'+fmtMiles(ctx.parsed.y)}}
        },
        scales:{
          x:{ticks:{color:textColor,font:{size:10}},grid:{color:gridColor}},
          y:{ticks:{color:textColor,font:{size:10},callback:v=>'$'+fmtMiles(v)},grid:{color:gridColor}}
        }
      }
    });
  }

  destroyChart('chartRanking');
  const ctx2=document.getElementById('chartRanking');
  if(ctx2){
    let labelsRanking=[],dataRanking=[];
    if(comunidad==='todos'){
      const porCentro={};
      facturasVisibles.forEach(f=>{
        const key=claveCliente(f);
        if(!porCentro[key])porCentro[key]={total:0,meses:new Set()};
        porCentro[key].total+=valorMetrica(f,metrica);
        porCentro[key].meses.add(f.periodo);
      });

      // Se muestran TODOS los centros de costo, sin límite de top-N.
      // Se identifica cada centro por nombre + código.
      const arr=Object.entries(porCentro)
        .map(([name,d])=>({
          name,
          prom:d.meses.size?d.total/d.meses.size:0
        }))
        .sort((a,b)=>b.prom-a.prom);

      labelsRanking=arr.map(x=>x.name);
      dataRanking=arr.map(x=>x.prom);
    }else{
      const porMes={};
      periodos.forEach(p=>porMes[p]=0);
      facturasVisibles.forEach(f=>{
        if(!(f.periodo in porMes))return;
        porMes[f.periodo]+=valorMetrica(f,metrica);
      });
      labelsRanking=periodos.map(p=>formatPeriodo(p));
      dataRanking=periodos.map(p=>porMes[p]);
    }
    CHARTS.ranking=new Chart(ctx2,{
      type:'bar',
      data:{labels:labelsRanking,datasets:[{label:comunidad==='todos'?'Promedio mensual':'Monto mensual',data:dataRanking,backgroundColor:'rgba(59,130,246,.7)',borderColor:'#3b82f6',borderWidth:1,borderRadius:6}]},
      options:{
        responsive:true,maintainAspectRatio:false,indexAxis:'y',
        plugins:{legend:{display:false},tooltip:{callbacks:{label:ctx=>'$'+fmtMiles(ctx.parsed.x)}}},
        scales:{
          x:{ticks:{color:textColor,font:{size:10},callback:v=>'$'+fmtMiles(v)},grid:{color:gridColor}},
          y:{ticks:{color:textColor,font:{size:10}},grid:{color:gridColor}}
        }
      }
    });
  }

  // ─── Ranking por consumo (MWh) ───
  //  Suma kWh de todas las facturas del período visible y las
  //  convierte a MWh (÷ 1000). Sólo se consideran facturas del
  //  período — las N/A y celdas vacías quedan excluidas naturalmente
  //  porque su kWh es 0.
  //
  //  Título dinámico:
  //    · con comunidad seleccionada → "Consumo por mes" (1 serie temporal)
  //    · sin comunidad + rango ultN → "Consumo por centro" (ranking)
  //    · sin comunidad + mes puntual → "Consumo del mes" (ranking)
  {
    const _hayComunidad = (comunidad !== 'todos');
    const _unMes = (_FILTRO_MES_RANGOS.indexOf(rango) === -1);
    const _tk = document.getElementById('tituloRankingKwh');
    if(_tk){
      let _titulo, _subtitulo;
      if(_hayComunidad){
        _titulo    = 'Consumo por mes';
        _subtitulo = _unMes ? 'MWh del mes' : 'MWh mensuales';
      } else {
        _titulo    = _unMes ? 'Consumo del mes' : 'Ranking por consumo';
        _subtitulo = _unMes ? 'MWh del mes'      : 'MWh totales';
      }
      _tk.innerHTML = _titulo + ' <span class="chart-sub" id="subtituloRankingKwh">' + _subtitulo + '</span>';
    }
  }
  destroyChart('chartRankingKwh');
  const ctxKwh=document.getElementById('chartRankingKwh');
  if(ctxKwh){
    let labelsKwh=[], dataKwh=[];
    if(comunidad === 'todos'){
      // Ranking por centro de costo: se muestran todos los centros.
      const porCentro={};
      facturasVisibles.forEach(f => {
        const key = claveCliente(f);
        if(!porCentro[key]) porCentro[key] = 0;
        porCentro[key] += Number(f.kwh) || 0;
      });

      const arr = Object.entries(porCentro)
        .map(([name, kwh]) => ({ name, mwh: kwh / 1000 }))
        .sort((a,b) => b.mwh - a.mwh);
      labelsKwh = arr.map(x => x.name);
      dataKwh   = arr.map(x => x.mwh);
    } else {
      // Vista de un centro único: evolución mensual en MWh.
      //  Se omiten los meses sin consumo (kWh == 0).
      const porMes={};
      periodos.forEach(p => porMes[p] = 0);
      facturasVisibles.forEach(f => {
        if(!(f.periodo in porMes)) return;
        porMes[f.periodo] += Number(f.kwh) || 0;
      });
      const _periodosConKwh = periodos.filter(p => porMes[p] !== 0);
      labelsKwh = _periodosConKwh.map(p => formatPeriodo(p));
      dataKwh   = _periodosConKwh.map(p => porMes[p] / 1000);
    }
    CHARTS.rankingKwh = new Chart(ctxKwh, {
      type: 'bar',
      data: {
        labels: labelsKwh,
        datasets: [{
          label: comunidad === 'todos' ? 'MWh totales' : 'MWh por mes',
          data: dataKwh,
          backgroundColor: 'rgba(16, 185, 129, .7)',
          borderColor: '#10b981',
          borderWidth: 1,
          borderRadius: 6
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false, indexAxis: 'y',
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: ctx => {
                const v = ctx.parsed.x;
                return v.toLocaleString('es-CL', { maximumFractionDigits: 2 }) + ' MWh';
              }
            }
          }
        },
        scales: {
          x: {
            ticks: { color: textColor, font: { size: 10 },
              callback: v => v.toLocaleString('es-CL', { maximumFractionDigits: 0 }) + ' MWh'
            },
            grid: { color: gridColor }
          },
          y: { ticks: { color: textColor, font: { size: 10 } }, grid: { color: gridColor } }
        }
      }
    });
  }

  // ─── Acumuladores compartidos entre los 2 gráficos de la tarjeta ───
  //  · chartConcepto       → % mensual (100% apilado)
  //  · chartConceptoTotal  → consolidado del rango visible (barra horizontal)
  //  Se declaran aquí (fuera del if del primer gráfico) para que
  //  ambos tengan acceso sin depender de que el canvas exista.
  const sumMesConc = {}, peajeMesConc = {}, intMesConc = {}, otrosMesConc = {};
  periodos.forEach(p => {
    sumMesConc[p]   = 0;
    peajeMesConc[p] = 0;
    intMesConc[p]   = 0;
    otrosMesConc[p] = 0;
  });
  facturasVisibles.forEach(f => {
    if(!(f.periodo in sumMesConc)) return;
    const i = (Number(f.intereses) || 0) + (Number(f.intPeaje) || 0);
    sumMesConc[f.periodo]   += (Number(f.sum)   || 0) - (Number(f.intereses) || 0);
    peajeMesConc[f.periodo] += (Number(f.peaje) || 0) - (Number(f.intPeaje) || 0);
    intMesConc[f.periodo]   += i;
    otrosMesConc[f.periodo] += (Number(f.otros) || 0) + (Number(f.otrosPeaje) || 0);
  });

  // Total por mes (denominador del 100%)
  const totalMes = {};
  periodos.forEach(p => {
    totalMes[p] = sumMesConc[p] + peajeMesConc[p] + intMesConc[p] + otrosMesConc[p];
  });

  // ─── Meses con datos para "Distribución por concepto" ───
  //  Un mes se omite si su total es 0 (ninguna de las 4 series
  //  aporta monto). La serie apilada se construye SÓLO con los
  //  meses que pasan este filtro.
  const _periodosConConcepto = periodos.filter(p => totalMes[p] !== 0);

  // Serie normalizada: cada valor como % del total del mes.
  // Si el mes no tiene datos (total 0), el segmento es 0%.
  const _pctMes = (p, v) => totalMes[p] ? (v / totalMes[p] * 100) : 0;

  destroyChart('chartConcepto');
  const ctx3=document.getElementById('chartConcepto');
  if(ctx3){
    // ─── Serie mensual por concepto — 100% apilado ───
    //  Cada mes se normaliza a 100%: cada barra muestra el peso
    //  relativo de cada concepto (Suministro/Peaje/Intereses/Otros)
    //  dentro del total facturado de ese mes.
    //  En el tooltip se conserva el monto real ($) además del %.
    //  Los meses sin datos se omiten de labels/data/_montoReal.
    CHARTS.concepto=new Chart(ctx3,{
      type:'bar',
      data:{
        labels: _periodosConConcepto.map(p => formatPeriodo(p)),
        datasets:[
          {
            label:'Suministro',
            data: _periodosConConcepto.map(p => _pctMes(p, sumMesConc[p])),
            backgroundColor:'#3b82f6',
            borderRadius:4,
            stack:'concepto',
            _montoReal: _periodosConConcepto.map(p => sumMesConc[p])
          },
          {
            label:'Peaje',
            data: _periodosConConcepto.map(p => _pctMes(p, peajeMesConc[p])),
            backgroundColor:'#f59e0b',
            borderRadius:4,
            stack:'concepto',
            _montoReal: _periodosConConcepto.map(p => peajeMesConc[p])
          },
          {
            label:'Intereses',
            data: _periodosConConcepto.map(p => _pctMes(p, intMesConc[p])),
            backgroundColor:'#ef4444',
            borderRadius:4,
            stack:'concepto',
            _montoReal: _periodosConConcepto.map(p => intMesConc[p])
          },
          {
            label:'Otros',
            data: _periodosConConcepto.map(p => _pctMes(p, otrosMesConc[p])),
            backgroundColor:'#a78bfa',
            borderRadius:4,
            stack:'concepto',
            _montoReal: _periodosConConcepto.map(p => otrosMesConc[p])
          }
        ]
      },
      options:{
        responsive:true,
        maintainAspectRatio:false,
        plugins:{
          legend:{
            position:'bottom',
            labels:{ color:textColor, font:{size:11}, padding:12, boxWidth:14, boxHeight:14 },
            // ─── Recalcular 100% al ocultar/mostrar series ───
            //  Igual que chartConceptoTotal: al alternar visibilidad,
            //  se renormalizan los segmentos VISIBLES sobre su subtotal
            //  mensual. La animación arranca desde 0 para que el
            //  reordenamiento sea visible.
            onClick: (evt, item, legend) => {
              const chart = legend.chart;
              const idxDs = item.datasetIndex;

              // 1) Toggle nativo
              const ds = chart.data.datasets[idxDs];
              ds.hidden = !ds.hidden;

              // 2) Guardar los valores renormalizados en _montoRealVisible
              //    para poder arrancar la animación desde 0.
              const n = chart.data.labels.length;
              for (let i = 0; i < n; i++) {
                let subtotal = 0;
                chart.data.datasets.forEach(d => {
                  if (d.hidden) return;
                  subtotal += Number(d._montoReal[i]) || 0;
                });
                chart.data.datasets.forEach(d => {
                  if (d._montoReal[i] === undefined) return;
                  d.data[i] = subtotal
                    ? (d._montoReal[i] / subtotal * 100)
                    : 0;
                });
              }

              // 3) Forzar que la animación arranque desde 0:
              //    se snapshotean los valores finales, se ponen los
              //    actuales en 0 y se restaura en el siguiente frame.
              const _finales = chart.data.datasets.map(d => d.data.slice());
              chart.data.datasets.forEach(d => {
                d.data = d.data.map(() => 0);
              });
              chart.update('none');   // sin animación al poner los 0
              chart.data.datasets.forEach((d, j) => {
                d.data = _finales[j];
              });
              chart.update();         // anima 0 → valor final
            }
          },
          tooltip:{
            callbacks:{
              label: ctx => {
                const pct = Number(ctx.parsed.y) || 0;
                const real = Number(ctx.dataset._montoReal[ctx.dataIndex]) || 0;
                return ctx.dataset.label + ': ' +
                       pct.toLocaleString('es-CL', { maximumFractionDigits: 1 }) + '%' +
                       '  ($' + fmtMiles(real) + ')';
              },
              footer: (items) => {
                if(!items || !items.length) return '';
                const idx = items[0].dataIndex;
                // El "Total" refleja el subtotal de las series VISIBLES
                // (coherente con el 100% renormalizado).
                let subtotal = 0;
                const chart = items[0].chart;
                chart.data.datasets.forEach((ds) => {
                  if (ds.hidden) return;
                  subtotal += Number(ds._montoReal[idx]) || 0;
                });
                return 'Total: $' + fmtMiles(subtotal);
              }
            }
          }
        },
        scales:{
          x:{
            stacked:true,
            ticks:{ color:textColor, font:{size:10} },
            grid:{ display:false }
          },
          y:{
            stacked:true,
            beginAtZero:true,
            max:100,
            ticks:{
              color:textColor,
              font:{size:10},
              callback: v => v + '%'
            },
            grid:{ color:gridColor }
          }
        }
      }
    });
  }

  // ─── Totales consolidados por concepto (barra horizontal apilada) ───
  //  Una sola barra horizontal que representa el rango visible completo.
  //  Cada segmento es la suma del concepto en todos los meses mostrados.
  //  Se reutilizan los acumuladores ya calculados arriba
  //  (sumMesConc, peajeMesConc, intMesConc, otrosMesConc) y `facturas`
  //  (ya filtrado por comunidad y por el rango de períodos visible).
  destroyChart('chartConceptoTotal');
  const ctxTot = document.getElementById('chartConceptoTotal');
  if(ctxTot){
    const _totalSum = periodos.reduce((a,p) => a + sumMesConc[p],   0);
    const _totalPea = periodos.reduce((a,p) => a + peajeMesConc[p], 0);
    const _totalInt = periodos.reduce((a,p) => a + intMesConc[p],   0);
    const _totalOtr = periodos.reduce((a,p) => a + otrosMesConc[p], 0);
    const _granTotal = _totalSum + _totalPea + _totalInt + _totalOtr;

    // Etiquetas: una sola barra → un solo label en el eje Y.
    // Para evitar que Chart.js reserve espacio innecesario, se usa
    // una etiqueta vacía y se apoya el título en el subtítulo del <h3>.
    const _labelsTot = [''];

    // Cada dataset es un concepto, apilado horizontalmente. El eje X
    // (indexAxis:'y') representa montos en $.
    CHARTS.conceptoTotal = new Chart(ctxTot, {
      type: 'bar',
      data: {
        labels: _labelsTot,
        datasets: [
          {
            label: 'Suministro',
            data: [_granTotal ? _totalSum / _granTotal * 100 : 0],
            backgroundColor: '#3b82f6',
            borderRadius: 4,
            stack: 'total',
            _montoReal: [_totalSum]
          },
          {
            label: 'Peaje',
            data: [_granTotal ? _totalPea / _granTotal * 100 : 0],
            backgroundColor: '#f59e0b',
            borderRadius: 4,
            stack: 'total',
            _montoReal: [_totalPea]
          },
          {
            label: 'Intereses',
            data: [_granTotal ? _totalInt / _granTotal * 100 : 0],
            backgroundColor: '#ef4444',
            borderRadius: 4,
            stack: 'total',
            _montoReal: [_totalInt]
          },
          {
            label: 'Otros',
            data: [_granTotal ? _totalOtr / _granTotal * 100 : 0],
            backgroundColor: '#a78bfa',
            borderRadius: 4,
            stack: 'total',
            _montoReal: [_totalOtr]
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        indexAxis: 'y',
        plugins: {
          legend: {
            position: 'bottom',
            labels: { color: textColor, font: { size: 11 }, padding: 12, boxWidth: 14, boxHeight: 14 },
            // ─── Recalcular 100% al ocultar/mostrar series ───
            //  Al alternar visibilidad se renormalizan los segmentos
            //  VISIBLES sobre su subtotal y la animación arranca desde
            //  0% para hacer visible el reordenamiento.
            onClick: (evt, item, legend) => {
              const chart = legend.chart;
              const idxDs = item.datasetIndex;

              // 1) Toggle nativo
              const ds = chart.data.datasets[idxDs];
              ds.hidden = !ds.hidden;

              // 2) Recalcular % de la barra única según visibles
              const n = chart.data.labels.length;
              for (let i = 0; i < n; i++) {
                let subtotal = 0;
                chart.data.datasets.forEach(d => {
                  if (d.hidden) return;
                  subtotal += Number(d._montoReal[i]) || 0;
                });
                chart.data.datasets.forEach(d => {
                  if (d._montoReal[i] === undefined) return;
                  d.data[i] = subtotal
                    ? (d._montoReal[i] / subtotal * 100)
                    : 0;
                });
              }

              // 3) Forzar animación desde 0:
              //    snapshot de los finales, poner todo en 0 sin animar,
              //    restaurar y animar.
              const _finales = chart.data.datasets.map(d => d.data.slice());
              chart.data.datasets.forEach(d => {
                d.data = d.data.map(() => 0);
              });
              chart.update('none');
              chart.data.datasets.forEach((d, j) => {
                d.data = _finales[j];
              });
              chart.update();
            }
          },
          tooltip: {
            callbacks: {
              label: ctx => {
                const pct = Number(ctx.parsed.x) || 0;
                const real = Number(ctx.dataset._montoReal[ctx.dataIndex]) || 0;
                return ctx.dataset.label + ': ' +
                       pct.toLocaleString('es-CL', { maximumFractionDigits: 1 }) + '%' +
                       '  ($' + fmtMiles(real) + ')';
              },
              footer: (items) => {
                if (!items || !items.length) return '';
                const idx = items[0].dataIndex;
                let subtotal = 0;
                const chart = items[0].chart;
                chart.data.datasets.forEach(d => {
                  if (d.hidden) return;
                  subtotal += Number(d._montoReal[idx]) || 0;
                });
                return 'Total: $' + fmtMiles(subtotal);
              }
            }
          }
        },
        scales: {
          x: {
            stacked: true,
            beginAtZero: true,
            max: 100,
            ticks: {
              color: textColor,
              font: { size: 10 },
              callback: v => v + '%'
            },
            grid: { color: gridColor }
          },
          y: {
            stacked: true,
            ticks: { display: false },
            grid: { display: false }
          }
        }
      }
    });
  }

