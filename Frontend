/**
 * Envuelve apiPost('vincularPDF') manejando el conflicto:
 * si el backend detecta que el ID ya está en otra factura,
 * levanta el modal y devuelve { conflicto:true } en vez de
 * lanzar error. Los flujos que llaman a este helper deben
 * comprobar `res.conflicto` y abortar silenciosamente.
 */
async function _vincularPDFSeguro(numero, id, nombreArchivo) {
  const res = await apiPost({
    accion: 'vincularPDF',
    numero: numero,
    urlOrId: id,
    nombreArchivo: nombreArchivo || ''
  });
  if (res && res.conflicto) {
    _mostrarModalPDFConflicto({
      id: id,
      numeroNuevo: numero,
      nombreArchivo: nombreArchivo || '',
      facturasEnConflicto: res.facturasEnConflicto || []
    });
    return { ok: false, conflicto: true };
  }
  return res;
}

