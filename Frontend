}

async function importarCSV(evt){
  const file=evt.target.files[0];if(!file)return;
  evt.target.value='';
  const texto=(await file.text()).replace(/^\uFEFF/,'');
  const lineas=texto.split(/\r?\n/).filter(l=>l.trim());
  if(lineas.length<2){showToast('CSV vacío','err');return;}
  const sep=detectarSeparador(lineas[0]);
  const head=parsearLineaCSV(lineas[0],sep).map(mapearHeader);
  if(!head.includes('numero')){showToast('Falta columna N° Factura','err');return;}
  const facturas=[];
  for(let i=1;i<lineas.length;i++){
    const vals=parsearLineaCSV(lineas[i],sep);
    const obj={};head.forEach((c,idx)=>{if(c)obj[c]=(vals[idx]||'').trim();});
    if(!obj.numero)continue;
    obj.periodo=normalizarPeriodo(obj.periodo);
    obj.tipo=(obj.tipo||'CONSUMO').toUpperCase();
    ['fechaConsumo','fechaPeaje','fechaEmision','fechaVencimiento'].forEach(c=>{if(obj[c])obj[c]=normalizarFecha(obj[c]);});
    ['kwh','sum','peaje','intereses','intPeaje','otros','otrosPeaje','total'].forEach(c=>{if(obj[c]!==undefined)obj[c]=parsearMonto(obj[c]);});
    facturas.push(obj);
  }
  if(!facturas.length){showToast('Sin facturas válidas','err');return;}
  if(!confirm('¿Importar '+facturas.length+' facturas?'))return;
  try{
    const res=await apiPost({accion:'importarFacturas',facturas});
    if(!res.ok)throw new Error(res.error);
    showToast('✓ '+res.importadas+' importadas · '+res.duplicadas+' duplicadas','ok');
    await cargar();
  }catch(e){showToast('Error: '+e.message,'err');}
}
function detectarSeparador(l){const t=(l.match(/\t/g)||[]).length,s=(l.match(/;/g)||[]).length,c=(l.match(/,/g)||[]).length;if(t>=s&&t>=c&&t>0)return'\t';if(s>=c&&s>0)return';';return',';}
function parsearLineaCSV(l,sep){const vals=[];let cur='',q=false;for(let i=0;i<l.length;i++){const c=l[i];if(c==='"'){if(q&&l[i+1]==='"'){cur+='"';i++;}else q=!q;}else if(c===sep&&!q){vals.push(cur);cur='';}else cur+=c;}vals.push(cur);return vals;}
function mapearHeader(h){const k=String(h).toLowerCase().trim().replace(/[°º]/g,'').replace(/\s+/g,' ');return{'n factura':'numero','numero factura':'numero','numero':'numero','n':'numero','codigo cliente':'codigo','codigo':'codigo','cod cliente':'codigo','empalme':'codigo','fecha recepcion consumo':'fechaConsumo','fecha consumo':'fechaConsumo','fecha recepcion suministro':'fechaConsumo','fecha recepcion peaje':'fechaPeaje','fecha peaje':'fechaPeaje','fecha emision':'fechaEmision','fecha vencimiento':'fechaVencimiento','centro de costo':'cliente','centro costo':'cliente','cliente':'cliente','centro':'cliente','periodo':'periodo','período':'periodo','mes':'periodo','tipo':'tipo','tipo factura':'tipo','kwh':'kwh','sum. neto':'sum','sum neto':'sum','suministro neto':'sum','suministro':'sum','peaje':'peaje','peaje neto':'peaje','intereses sum':'intereses','intereses':'intereses','interes':'intereses','intereses peaje':'intPeaje','otros sum':'otros','otros':'otros','otros peaje':'otrosPeaje','total':'total','total factura':'total'}[k]||null;}
function normalizarPeriodo(p){if(!p)return'';const s=String(p).trim().toLowerCase();if(/^\d{4}-\d{1,2}$/.test(s)){const p2=s.split('-');return p2[0]+'-'+String(parseInt(p2[1],10)).padStart(2,'0');}const M={ene:1,enero:1,feb:2,febrero:2,mar:3,marzo:3,abr:4,abril:4,may:5,mayo:5,jun:6,junio:6,jul:7,julio:7,ago:8,agosto:8,sep:9,sept:9,septiembre:9,oct:10,octubre:10,nov:11,noviembre:11,dic:12,diciembre:12};const m=s.match(/([a-záéíóúñ]+)[\s\-\/]+(\d{4})/);if(m){const mes=M[m[1]];if(mes)return m[2]+'-'+String(mes).padStart(2,'0');}return s;}
function normalizarFecha(f){if(!f)return'';const s=String(f).trim();if(SENTINELAS.indexOf(s)!==-1)return s;if(/^\d{4}-\d{2}-\d{2}$/.test(s))return s;let m=s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);if(m)return m[3]+'-'+m[2].padStart(2,'0')+'-'+m[1].padStart(2,'0');m=s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2})$/);if(m)return'20'+m[3]+'-'+m[2].padStart(2,'0')+'-'+m[1].padStart(2,'0');return s;}
function parsearMonto(v){if(v==null||v==='')return 0;if(typeof v==='number')return v;let s=String(v).replace(/[\$\s]/g,'').trim();if(s.includes(','))s=s.replace(/\./g,'').replace(',','.');const n=Number(s);return isNaN(n)?0:n;}

function formatPeriodo(iso){const p=iso.split('-');return MESES[parseInt(p[1],10)-1]+'-'+p[0].slice(2);}
function fmtFecha(iso){if(!iso)return'';const s=String(iso);if(SENTINELAS.indexOf(s)!==-1)return s;const p=s.split('-');if(p.length<3)return s;return p[2]+'/'+p[1];}
function fmtMiles(n){if(n==null||n===0)return'0';return Math.round(n).toLocaleString('es-CL');}
function fmtKwh(n){
  if(n==null || n===0) return '0';
  const num = Number(n);
  if(!isFinite(num)) return '0';
  return Math.round(num).toLocaleString('es-CL');
}
