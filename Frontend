function _onCampoCentroChange(ev){
  const el = ev.currentTarget;
  const codigo = el.getAttribute('data-codigo');
  const campo  = el.getAttribute('data-campo');
  if(!codigo || !campo) return;
  if(campo === 'cliente') actualizarNombreCentro(codigo, el.value);
  else if(campo === 'rut') actualizarRutCentroMant(codigo, el.value);
