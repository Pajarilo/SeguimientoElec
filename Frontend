async function _cargarFacturaDesdePDF({ base64, mime, nombre, urlOriginal }) {
  setStatus('Procesando PDF...', '');
  try {
    const r = await _obtenerTextoPDF(base64, mime || 'application/pdf', nombre || 'factura.pdf');
    if (!r.ok) {
      _abrirModalOCRFallido(urlOriginal || null);
      showToast('OCR no disponible: ' + r.error, 'err');
      setStatus('⚠ OCR falló · selecciona centro y período manualmente', 'err');
      return;
    }
    if (r.motor) setStatus('✓ ' + r.motor, 'ok');

    const campos = await parsearFacturaCompleta(r.texto);

    // Si el parser explotó, avisar y salir (evita modal vacío silencioso).
    if (campos && campos._error) {
      showToast('⚠ Error del parser: ' + campos._error, 'err');
      setStatus('Error del parser: ' + campos._error, 'err');
      console.warn('[Frontend] Parser error: ' + campos._error);
      return;
    }

    _ULTIMOS_CAMPOS_OCR = JSON.parse(JSON.stringify(campos));
    _PDF_TEXTO_OCR      = r.texto || '';
    PDF_WARNINGS        = verificarPDFvsFactura(r.texto);

    const numeroPDF = String(campos.fNumero || '').trim();
    let facturaExistente = null;
    if (numeroPDF) {
      const matches = FACTURAS.filter(f => String(f.numero || '').trim() === numeroPDF);
      if (matches.length) facturaExistente = matches[0];
    }

    _abrirModal({
      modo: 'editar',
      factura: facturaExistente,
      clave: facturaExistente
        ? (facturaExistente.cliente || '') + ' (' + (facturaExistente.codigo || '') + ')'
        : null,
      periodo: facturaExistente ? facturaExistente.periodo : null,
      tipo:    facturaExistente ? (facturaExistente.tipo || 'CONSUMO') : 'CONSUMO',
      externo: !facturaExistente
    });
    if (facturaExistente) {
      document.getElementById('modalAgregarTitulo').textContent = 'Actualizar factura · ' + facturaExistente.numero;
    }

    if (urlOriginal) {
      const urlInp = document.getElementById('fPDFDriveUrl');
      // Guardamos SOLO el ID en el campo, no la URL completa.
      const _idSolo = parseDriveIdFront(urlOriginal) || String(urlOriginal).trim();
      urlInp.value = _idSolo;
      const actionsDiv = document.getElementById('fPDFDriveActions');
      if (actionsDiv) actionsDiv.style.display = 'flex';
      PDF_ACTUAL = null;
      PDF_FUENTE = 'drive';
      actualizarPreview();
      _sincronizarAnchoModal();
      const info = document.getElementById('pdfInfo');
      info.textContent = '🔗 PDF cargado desde Drive — al Guardar se copiará al Drive de Operaciones y de la Comunidad';
      info.classList.add('show');
    } else {
      PDF_ACTUAL = { nombre, base64, mimeType: mime || 'application/pdf' };
      PDF_FUENTE = 'local';
      const info = document.getElementById('pdfInfo');
      info.textContent = '📎 ' + nombre + ' — se subirá al Drive del centro';
      info.classList.add('show');
      actualizarPreview();
      _sincronizarAnchoModal();
    }

    if (facturaExistente) {
      // ─── FACTURA EXISTENTE: NO tocar campos, SÓLO comparar y mostrar toast ───
      lockSelectoresClientePeriodo();
      _actualizarBotonesFactura();
      _FACTURA_ORIGINAL_DIFF = JSON.parse(JSON.stringify(facturaExistente));
      _CAMPOS_PDF_PENDIENTE  = JSON.parse(JSON.stringify(campos));
      _refrescarInfoDriveCentro();
      _renderDiffPanel(facturaExistente, campos);
      _mostrarDiffModalVsOCR(facturaExistente, campos);

      if (!facturaExistente.pdfId && !PDF_YA_SUBIDO) {
        try {
          setStatus('Subiendo PDF al Drive del centro...', '');
          await subirPDFSiCorresponde();
        } catch (e) {
          showToast('Factura detectada, pero el PDF no se pudo subir: ' + e.message, 'err');
          setStatus('PDF con error de subida', 'err');
        }
      }

      _pintarWarnPDF(PDF_WARNINGS);
      setStatus('✓ PDF procesado · revisa la comparación', 'ok');

      // Si el OCR no pudo determinar período o código, abrir el modal
      // de corrección con esos campos en blanco para que el usuario
      // los ajuste contra el PDF visible.
      try {
        const diffsEx = _detectarDiscrepanciasOCR(campos, {
          codigo:  facturaExistente.codigo  || '',
          periodo: facturaExistente.periodo || '',
          rut:     facturaExistente.rut     || ''
        });
        if (Object.keys(diffsEx).length) {
          setTimeout(() => {
            const m = document.getElementById('modalAgregar');
            if (!m || !m.classList.contains('open')) return;
            if (FACTURA_YA_GUARDADA_EN_BD) return;
            abrirModalOCRDiscrepancia(diffsEx);
          }, 700);
        }
      } catch (e) { console.warn('No se pudo evaluar discrepancia OCR:', e); }
    } else {
      // ─── FACTURA NUEVA: aplicar campos del OCR directamente ───
      // Capturamos el estado ANTES de aplicar para que el comparativo
      // muestre "vacío → extraído" y el usuario vea qué llegó del PDF.
      const antesNueva = _leerCamposModal();

      const centro = _buscarCentroPorCodigo(campos.fCodigo);
      if (centro) {
        document.getElementById('fCliente').value = centro.codigo;
        document.getElementById('fCodigo').value  = centro.codigo;
      } else if (campos.fCodigo) {
        showToast('⚠ Código "' + campos.fCodigo + '" no está en Config — selecciona el centro manualmente', 'err');
      } else {
        showToast('⚠ No se detectó código de cliente en el PDF — selecciónalo manualmente', 'err');
      }
      if (campos.fPeriodo && CONFIG.periodos.includes(campos.fPeriodo)) {
        document.getElementById('fPeriodo').value = campos.fPeriodo;
      }
      _refrescarInfoDriveCentro();
      _aplicarCamposAlModal(campos, { incluirCodigo: false });

      _mostrarDiffModalVsOCR(antesNueva, campos);

      _pintarWarnPDF(PDF_WARNINGS);
      setStatus('✓ PDF procesado · datos cargados', 'ok');

      // ─── Discrepancias OCR en factura NUEVA ───
      //  En este flujo NO hay valores previos del usuario: el OCR
      //  acaba de poblar el formulario. Comparar contra un "antes"
      //  vacío generaría siempre un diff falso.
      //
      //  Sólo abrimos el modal de corrección si el OCR NO pudo
      //  determinar el centro o el período, o si el código leído no
      //  existe en Config (ambigüedad real que el usuario debe resolver).
      try {
        const codDetectado = String(campos.fCodigo  || '').trim();
        const perDetectado = String(campos.fPeriodo || '').trim();

        const codNoEncontrado = codDetectado && !_buscarCentroPorCodigo(codDetectado);
        const perNoExiste     = perDetectado && !CONFIG.periodos.includes(perDetectado);
        const sinCodigo       = !codDetectado;
        const sinPeriodo      = !perDetectado;

        const necesitaIntervencion =
          codNoEncontrado || perNoExiste || sinCodigo || sinPeriodo;

        if (necesitaIntervencion) {
          // Reconstruimos el objeto de diffs informativos a partir de
          // lo que el OCR detectó y lo que realmente quedó en el form.
          const diffsNv = {};
          if (codDetectado) {
            diffsNv.codigo = {
              actual: (document.getElementById('fCodigo').value || '').trim(),
              ocr:    codDetectado
            };
          }
          if (perDetectado) {
            diffsNv.periodo = {
              actual: (document.getElementById('fPeriodo').value || '').trim(),
              ocr:    perDetectado
            };
          }
          const rutDetectado = String(campos.fRut || '').trim();
          if (rutDetectado && _normRutComparable(rutDetectado) !==
                              _normRutComparable(document.getElementById('fRut').value || '')) {
            diffsNv.rut = {
              actual: (document.getElementById('fRut').value || '').trim(),
              ocr:    rutDetectado
            };
          }
          if (Object.keys(diffsNv).length) {
            setTimeout(() => {
              const m = document.getElementById('modalAgregar');
              if (!m || !m.classList.contains('open')) return;
              if (FACTURA_YA_GUARDADA_EN_BD) return;
              abrirModalOCRDiscrepancia(diffsNv);
            }, 700);
          }
        }
      } catch (e) { console.warn('No se pudo evaluar discrepancia OCR:', e); }
    }
  } catch (e) {
    setStatus('Error: ' + e.message, 'err');
    showToast('Error al procesar PDF: ' + e.message, 'err');
  }
}

async function cargarPDFExterno(evt) {
  const file = evt.target.files[0];
  evt.target.value = '';
  if (!file) return;
  const base64 = await new Promise((res, rej) => {
    const r = new FileReader();
    r.onload = e => res(e.target.result.split(',')[1]);
    r.onerror = rej;
    r.readAsDataURL(file);
  });
  return _cargarFacturaDesdePDF({
    base64,
    mime: file.type || 'application/pdf',
    nombre: file.name
  });
}

// Extrae el ID de un archivo de Drive desde el portapapeles.
// Acepta:
//   · URL de Drive/Docs de un archivo (/file/d/ID, open?id=ID, uc?id=ID)
//   · ID suelto (sólo letras, números, "-" y "_", 15+ caracteres)
// Rechaza URLs de carpetas y cualquier otro texto.
function _idDriveDesdeURL(s){
  const t = String(s || '').trim();
  if(!t) return '';

  // ID suelto
  if(/^[a-zA-Z0-9_-]{15,}$/.test(t)) return t;

  // URL de Drive / Docs
  if(!/^https?:\/\/(drive|docs)\.google\.com\//i.test(t)) return '';
  if(/\/folders\//i.test(t)) return '';
  const id = parseDriveIdFront(t);
  return (id && id !== t && /^[a-zA-Z0-9_-]{15,}$/.test(id)) ? id : '';
}

async function cargarPDFDesdeURLExterno() {
  const btn = document.getElementById('btnCargarDriveUrl');
  if (!btn || btn.disabled) return;

  const TXT_ORIGINAL = '🔗 Cargar desde Drive (URL)';
  const TXT_CARGANDO = '📋 URL copiada, cargando…';

  // Error visible 1 segundo en el propio botón y luego restaura el texto.
  const mostrarError = (txt) => {
    btn.textContent = txt;
    btn.disabled = true;
    setTimeout(() => {
      btn.textContent = TXT_ORIGINAL;
      btn.disabled = false;
    }, 1000);
  };

  // 1) Leer el portapapeles (puede estar bloqueado por el navegador o el iframe)
  let clip = '';
  try {
    clip = String((await navigator.clipboard.readText()) || '').trim();
  } catch (e) {
    console.warn('Clipboard no disponible:', e.message);
    mostrarError('⚠ Sin acceso al portapapeles');
    return;
  }

  // 2) Validar que sea una URL de archivo de Drive
  const id = _idDriveDesdeURL(clip);
  if (!id) {
    mostrarError('⚠ URL de Drive no válida');
    return;
  }

  // 3) Iniciar la carga
  btn.textContent = TXT_CARGANDO;
  const urlCompleta = 'https://drive.google.com/file/d/' + id + '/view';
  setStatus('Descargando PDF desde Drive...', '');
  try {
    const dl = await apiPost({ accion: 'descargarPDFDrive', id });
    if (!dl.ok) {
      showToast('No se pudo descargar el PDF: ' + dl.error, 'err');
      return;
    }

    // Cachear el base64 para que la preview NO vuelva a descargar
    // el mismo archivo: se renderiza directo en el canvas.
    _precargarPreviewDrive(id, dl.base64, dl.mime || 'application/pdf');

    return await _cargarFacturaDesdePDF({
      base64: dl.base64,
      mime:   dl.mime || 'application/pdf',
      nombre: dl.nombre || 'factura.pdf',
      urlOriginal: urlCompleta
    });
  } catch (e) {
    showToast('Error al cargar desde Drive: ' + e.message, 'err');
    setStatus('Error: ' + e.message, 'err');
  } finally {
    // Si el modal ya se abrió, _abrirModal restauró el texto; si no, se restaura aquí.
    if (btn.textContent === TXT_CARGANDO) btn.textContent = TXT_ORIGINAL;
  }
}

