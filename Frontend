async function configurarDriveCentro(tipo){
  const codigo = (document.getElementById('fCodigo').value || '').trim();
  if(!codigo){ showToast('Primero selecciona un centro','err'); return; }
  const centro = centroPorCodigo(codigo);
  if(!centro){ showToast('Centro no encontrado: '+codigo,'err'); return; }

  const configurarOp  = (tipo !== 'com');
  const configurarCom = (tipo !== 'op');

  let op  = centro.driveOp  || '';
  let com = centro.driveCom || '';
  let cambios = false;

  if(configurarOp){
    const actualOp = op ? ('\nActual: '+op) : '\n(Sin configurar)';
    const entradaOp = prompt(
      'Drive de OPERACIONES para "'+centro.cliente+'" ('+codigo+')'+actualOp+
      '\n\nPega la URL o el ID.\n· Deja el mismo valor para no cambiarlo.\n· Escribe "-" (guion) para borrarlo.',
      op
    );
    if(entradaOp === null) return;
    const opTrim = String(entradaOp).trim();
    if(opTrim === '-'){ op = ''; cambios = true; }
    else if(opTrim && opTrim !== op){
      const v = await apiPost({ accion: 'verificarDrive', id: opTrim });
      if(v.ok){ op = v.id; cambios = true; showToast('✓ Drive Op: "'+v.nombre+'"','ok'); }
      else { showToast('Drive Op inválido · '+v.error,'err'); return; }
    }
  }

  if(configurarCom){
    const actualCom = com ? ('\nActual: '+com) : '\n(Sin configurar)';
    const entradaCom = prompt(
      'Drive de la COMUNIDAD para "'+centro.cliente+'" ('+codigo+')'+actualCom+
      '\n\nPega la URL o el ID.\n· Deja el mismo valor para no cambiarlo.\n· Escribe "-" (guion) para borrarlo.',
      com
    );
    if(entradaCom === null) return;
    const comTrim = String(entradaCom).trim();
    if(comTrim === '-'){ com = ''; cambios = true; }
    else if(comTrim && comTrim !== com){
      const v = await apiPost({ accion: 'verificarDrive', id: comTrim });
      if(v.ok){ com = v.id; cambios = true; showToast('✓ Drive Com: "'+v.nombre+'"','ok'); }
      else { showToast('Drive Com inválido · '+v.error,'err'); return; }
    }
  }

  if(!cambios){ showToast('Sin cambios','ok'); return; }

  setStatus('Guardando Drive del centro...','');
  try{
    centro.driveOp  = op;
    centro.driveCom = com;
    _driveLSGuardar(codigo, op, com);
    _refrescarInfoDriveCentro();

    const res = await apiPost({ accion:'guardarDriveConfig', codigo, driveOp: op, driveCom: com });
    if(!res.ok) throw new Error(res.error||'Error al guardar');
    showToast('✓ Drive guardado para "'+centro.cliente+'"','ok');
    setStatus('✓ Drive configurado para '+centro.cliente,'ok');
  }catch(e){
    showToast('Error al guardar Drive: '+e.message,'err');
    setStatus('Error: '+e.message,'err');
  }
}

// ─── Estado del modal "Drive faltante" ───
//  Cada vez que se abre, guarda el resolver de la Promise que
//  espera el flujo secuencial (subirPDFSiCorresponde / subirPDFSolo).
let _DF_RESOLVER = null;
let _DF_OPCIONAL = false;
let _DF_TIPO = 'op';       // 'op' | 'com'
let _DF_CODIGO = '';

/**
 * Abre el modal "Drive faltante" y devuelve una Promise que se
 * resuelve con el ID validado (o '' si el usuario omite/cancela).
 *
 * NO bloquea el hilo: el usuario puede seguir viendo la UI detrás.
 *
 * @param {Object} p
 * @param {string} p.codigo       Código del centro.
 * @param {string} p.cliente      Nombre del centro (para el título).
 * @param {'op'|'com'} p.tipo     Qué Drive se está configurando.
 * @param {boolean} p.opcional    true si se puede omitir (Drive Comunidad).
 * @returns {Promise<string>}     ID validado, '' si se omite, o rechaza si cancela.
 */
function _pedirDriveFaltante({ codigo, cliente, tipo, opcional }){
  return new Promise((resolve, reject) => {
    _DF_RESOLVER   = resolve;
    _DF_OPCIONAL   = !!opcional;
    _DF_TIPO       = tipo;
    _DF_CODIGO     = codigo;

    const esOp = (tipo === 'op');
    document.getElementById('dfTitulo').textContent =
      esOp ? 'Configurar Drive de Operaciones' : 'Configurar Drive de la Comunidad';
    document.getElementById('dfCentro').textContent = cliente + ' (' + codigo + ')';
    document.getElementById('dfMensaje').innerHTML = esOp
      ? 'El centro <b>no tiene Drive de Operaciones</b>. Sin él no se puede subir el PDF.'
      : 'El centro <b>no tiene Drive de la Comunidad</b> (opcional). Puedes omitirlo o configurarlo ahora.';

    const input = document.getElementById('dfInput');
    input.value = '';
    input.placeholder = 'https://drive.google.com/open?id=... o sólo el ID';
    const err = document.getElementById('dfError');
    err.classList.remove('show'); err.textContent = '';

    const btnOmitir = document.getElementById('dfBtnOmitir');
    btnOmitir.style.display = _DF_OPCIONAL ? '' : 'none';

    document.getElementById('modalDriveFaltante').classList.add('open');
    setTimeout(() => input.focus(), 100);

    // Enter = confirmar
    input.onkeydown = (ev) => {
      if(ev.key === 'Enter'){ ev.preventDefault(); confirmarModalDriveFaltante(); }
      if(ev.key === 'Escape'){ ev.preventDefault(); cancelarModalDriveFaltante(); }
    };
  });
}

async function confirmarModalDriveFaltante(){
  if(!_DF_RESOLVER) return;
  const input = document.getElementById('dfInput');
  const err   = document.getElementById('dfError');
  err.classList.remove('show'); err.textContent = '';

  const valor = String(input.value || '').trim();
  if(!valor){
    err.textContent = 'Pega una URL o ID de Drive.';
    err.classList.add('show');
    input.focus();
    return;
  }

  const btn = document.getElementById('dfBtnConfirmar');
  const txtOrig = btn.textContent;
  btn.disabled = true;
  btn.textContent = '⏳ Verificando…';

  try{
    const v = await apiPost({ accion: 'verificarDrive', id: valor });
    if(!v || !v.ok){
      err.textContent = 'ID/URL inválido · ' + ((v && v.error) || 'Error');
      err.classList.add('show');
      input.focus();
      return;
    }

    // Verificado → persistir
    const centro = centroPorCodigo(_DF_CODIGO);
    if(centro){
      if(_DF_TIPO === 'op') centro.driveOp  = v.id;
      else                  centro.driveCom = v.id;
      _driveLSGuardar(_DF_CODIGO, centro.driveOp, centro.driveCom);
      try{
        const res = await apiPost({
          accion:'guardarDriveConfig',
          codigo: _DF_CODIGO,
          driveOp: centro.driveOp || '',
          driveCom: centro.driveCom || ''
        });
        if(!res || !res.ok){
          showToast('⚠ Drive configurado en esta sesión, pero no se pudo persistir: ' + ((res && res.error) || 'Error'), 'err');
        }
      }catch(e){
        showToast('⚠ Drive configurado en esta sesión, pero no se pudo persistir: ' + e.message, 'err');
      }
      _refrescarInfoDriveCentro();
    }

    showToast('✓ Drive ' + (_DF_TIPO === 'op' ? 'Operaciones' : 'Comunidad') + ': "' + v.nombre + '"', 'ok');

    const resolver = _DF_RESOLVER;
    _cerrarModalDriveFaltanteInterno();
    resolver(v.id);

  }catch(e){
    err.textContent = 'Error al verificar: ' + e.message;
    err.classList.add('show');
  }finally{
    btn.disabled = false;
    btn.textContent = txtOrig;
  }
}

function omitirModalDriveFaltante(){
  if(!_DF_RESOLVER) return;
  const resolver = _DF_RESOLVER;
  _cerrarModalDriveFaltanteInterno();
  resolver('');   // el caller decide si '' es aceptable
}

function cancelarModalDriveFaltante(){
  if(!_DF_RESOLVER) return;
  const rejecter = _DF_RESOLVER;
  _cerrarModalDriveFaltanteInterno();
  rejecter(new Error('Configuración de Drive cancelada por el usuario.'));
}

function _cerrarModalDriveFaltanteInterno(){
  document.getElementById('modalDriveFaltante').classList.remove('open');
  _DF_RESOLVER = null;
}

async function asegurarCarpetasDrive(codigo) {
  const centro = centroPorCodigo(codigo);
  if(!centro) throw new Error('Centro no encontrado: ' + codigo);

  if(!centro.driveOp || !centro.driveCom){
    const ls = _driveLSBuscar(codigo);
    if(ls){
      if(!centro.driveOp && ls.op)  centro.driveOp  = ls.op;
      if(!centro.driveCom && ls.com) centro.driveCom = ls.com;
      _refrescarInfoDriveCentro();
    }
  }

  // ─── Drive de Operaciones (obligatorio) ───
  while (!centro.driveOp) {
    const id = await _pedirDriveFaltante({
      codigo,
      cliente: centro.cliente,
      tipo: 'op',
      opcional: false
    });
    if(!id){
      throw new Error('Subida cancelada: falta el Drive de Operaciones del centro "' + centro.cliente + '".');
    }
    // _pedirDriveFaltante ya verificó y persistió; refrescamos estado.
    const c2 = centroPorCodigo(codigo);
    if(c2) centro.driveOp = c2.driveOp || id;
    else   centro.driveOp = id;
  }

  // ─── Drive de la Comunidad (opcional) ───
  if (!centro.driveCom) {
    const id = await _pedirDriveFaltante({
      codigo,
      cliente: centro.cliente,
      tipo: 'com',
      opcional: true
    });
    if(id){
      const c2 = centroPorCodigo(codigo);
      if(c2) centro.driveCom = c2.driveCom || id;
      else   centro.driveCom = id;
    }
    // Si id === '' → el usuario omitió; se continúa sin Drive de Comunidad.
  }

  return { op: centro.driveOp || '', com: centro.driveCom || '' };
}

async function subirPDFSiCorresponde(){
  if(!PDF_ACTUAL) return null;
  if(PDF_YA_SUBIDO) return null;
  const codigo = (document.getElementById('fCodigo').value || '').trim();
  if(!codigo) throw new Error('Falta el código del centro para saber a qué Drive subir.');
  await asegurarCarpetasDrive(codigo);
  const numero = (document.getElementById('fNumero').value || '').trim() || 'sin-numero';
  const periodo= (document.getElementById('fPeriodo').value || '').trim() || 'sin-periodo';
  const tipo   = (document.getElementById('fTipo').value || '').trim() || 'X';
  const nombre = await nombreArchivoEstandar(numero, codigo, periodo, tipo);
  const res = await apiPost({
    accion:'subirPDF',
    codigoCliente: codigo,
    nombreArchivo: nombre,
    base64: PDF_ACTUAL.base64,
    mimeType: PDF_ACTUAL.mimeType
  });
  if(!res.ok) throw new Error(res.error||'Error al subir PDF');
  PDF_YA_SUBIDO = true;
  if(res.archivos && res.archivos.length){
    const urlInp = document.getElementById('fPDFDriveUrl');
    if(urlInp && !urlInp.value){
      // Guardamos SOLO el ID, no la URL completa.
      urlInp.value = res.archivos[0].id;
      const actionsDiv = document.getElementById('fPDFDriveActions');
      if(actionsDiv) actionsDiv.style.display = 'flex';
    }
    const numLink = (document.getElementById('fNumero').value || '').trim();
    if(numLink){
      try{
        await apiPost({
          accion:'vincularPDF',
          numero: numLink,
          urlOrId: res.archivos[0].id,
          nombreArchivo: nombre
        });
      }catch(e){ console.warn('No se pudo vincular el PDF a la factura:', e); }
    }
  }
  return res.archivos;
}

