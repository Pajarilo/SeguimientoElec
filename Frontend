          : (f.tipo === 'PEAJE' ? 'Peaje'
          : (f.tipo === 'ARRIENDO_MEDIDOR' ? 'Arriendo medidor' : (f.tipo || '—')));
  const k = (Number(f.kwh) || 0).toLocaleString('es-CL');
  const p = f.pdfId ? '\n📄 PDF vinculado' : '';
  return 'N° de Factura: ' + n + '\nTipo: ' + t + '\nKWh: ' + k + p;
