function _renderDriveCentro(el, driveId, tipo){
  if(!el) return;

  const t = (tipo === 'com') ? 'com' : 'op';

  if(!driveId){
    el.innerHTML =
      '<span class="missing drive-link" onclick="configurarDriveCentro(\''+t+'\')">' +
      'Sin configurar. <span class="replace-hint">Click para establecerlo</span>' +
      '</span>';
    return;
  }

  el.innerHTML = '<span class="id">Cargando carpeta…</span>';

  apiPost({
    accion: 'verificarDrive',
    id: driveId
  }).then(res => {
    if(!res || !res.ok){
      el.innerHTML =
        '<span class="id drive-link" onclick="configurarDriveCentro(\''+t+'\')" ' +
        'title="No se pudo obtener el nombre de la carpeta. Click para reemplazar.">' +
        driveId +
        ' <span class="replace-hint">Click para reemplazar.</span>' +
        '</span>';
      return;
    }

    const wrap = document.createElement('span');
    wrap.className = 'id';

    const link = document.createElement('a');
    link.href = res.url || ('https://drive.google.com/drive/folders/' + driveId);
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.textContent = res.nombre || driveId;
    link.title = 'Abrir carpeta en Google Drive';
    link.style.color = 'var(--accent)';
    link.style.textDecoration = 'underline';
    link.style.textUnderlineOffset = '3px';

    link.addEventListener('click', ev => {
      ev.stopPropagation();
    });

    const sep = document.createTextNode(' ');

    const reemplazar = document.createElement('span');
    reemplazar.className = 'replace-hint';
    reemplazar.textContent = 'Click para reemplazar.';
    reemplazar.style.cursor = 'pointer';

    reemplazar.addEventListener('click', ev => {
      ev.stopPropagation();
      configurarDriveCentro(t);
    });

    wrap.appendChild(link);
    wrap.appendChild(sep);
    wrap.appendChild(reemplazar);

    el.innerHTML = '';
    el.appendChild(wrap);

  }).catch(() => {
    el.innerHTML =
      '<span class="id drive-link" onclick="configurarDriveCentro(\''+t+'\')" ' +
      'title="No se pudo obtener el nombre de la carpeta. Click para reemplazar.">' +
      driveId +
      ' <span class="replace-hint">Click para reemplazar.</span>' +
      '</span>';
  });
}

