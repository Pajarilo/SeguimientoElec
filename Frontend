function render(){
  // ─── Banner de filtro rápido activo ───
  //  Visible si CUALQUIERA de los dos filtros está on. Texto e ícono
  //  se adaptan al filtro activo.
  const banner = document.getElementById('filtroFueraPlazoBanner');
  if (banner) banner.style.display = _hayFiltroRapidoActivo() ? '' : 'none';

  const fbTxt  = document.getElementById('fbTexto');
  const fbIcon = document.getElementById('fbIcono');
  if (_FILTRO_FUERA_PLAZO) {
    if (fbIcon) fbIcon.textContent = '⏱';
    if (fbTxt) {
      fbTxt.innerHTML = 'Mostrando sólo facturas <b>atrasadas</b> '
        + '(recibidas con más de ' + DIAS_ATRASO + ' días de desfase desde la emisión)';
    }
  } else if (_FILTRO_PENDIENTES) {
    if (fbIcon) fbIcon.textContent = '⚠';
    if (fbTxt) {
      fbTxt.innerHTML = 'Mostrando sólo <b>pendientes</b> '
        + '(períodos pasados sin factura cargada)';
    }
  }

  // Con un mes puntual o últimos 3/6/12 meses, Suministro y Peaje van lado a lado.
  const _gridSeg = document.querySelector('#viewKPI .grid');
  if (_gridSeg) {
    const _fMes = document.getElementById('filtroMes') ? document.getElementById('filtroMes').value : 'todos';
    _gridSeg.classList.toggle('lado-a-lado', _fMes !== 'todos');
  }

  renderKPIs();
  renderTabla('wrapConsumo','countConsumo','CONSUMO');
  renderTabla('wrapPeaje','countPeaje','PEAJE');
  renderTabla('wrapArriendo','countArriendo','ARRIENDO_MEDIDOR');
}

function renderKPIs(){
  // ─── Leer los mismos filtros que aplican las tablas ───
  const fC = document.getElementById('filtroCentro') ? document.getElementById('filtroCentro').value : 'todos';
  const fM = document.getElementById('filtroMes')    ? document.getElementById('filtroMes').value    : 'todos';

  // Mismo subconjunto de clientes y períodos que ven las tablas
  let clientes = CONFIG.centros
    .filter(e => !_esCentroFantasma(e.codigo, e.cliente))
    .map(e => e.cliente + ' (' + e.codigo + ')');
  if (fC !== 'todos') clientes = clientes.filter(c => c === fC);

  // Resolver el subconjunto de períodos igual que las tablas:
  //   'todos'      → hasta el mes actual (sin futuros)
  //   'ult3/6/12'  → los N más recientes hasta hoy
  //   'YYYY-MM'    → ese único mes
  const periodos = _periodosSegunFiltroMes(fM);

  const clientesSet = new Set(clientes);
  const periodosSet = new Set(periodos);

  // ─── 1) Contar exactamente lo que muestran las tablas ───
  //  Cada factura se cuenta una vez por cada tabla en la que aparece:
  //    · CONSUMO y UNIFICADA  → tabla Suministro
  //    · PEAJE   y UNIFICADA  → tabla Peaje
  //  Las celdas vacías se cuentan como Pendiente (período pasado) o
  //  Por Emitir (período actual/futuro).
  const k = {
    recibidas: 0, recibidas_sf: 0, pendientes: 0, porEmitir: 0,
    dentroPlazo: 0, sinInfo: 0, noAplica: 0, total: 0
  };

  const celdasConFactura = { CONSUMO: {}, PEAJE: {} };

  FACTURAS.forEach(f => {
    const cl = claveCliente(f);
    if (!clientesSet.has(cl) || !periodosSet.has(f.periodo)) return;

    const _sumarEstado = (est) => {
      if (est === 'na')              k.noAplica++;
      else if (est === 'si')         k.sinInfo++;
      else if (est === 'recibida')   k.recibidas++;
      else if (est === 'recibida-sf')k.recibidas_sf++;
      else if (est === 'por-emitir') k.porEmitir++;
      else if (est === 'plazo')      k.dentroPlazo++;
      else if (est === 'pendiente')  k.pendientes++;
    };

    if (f.tipo === 'CONSUMO' || f.tipo === 'SUMINISTRO' || f.tipo === 'UNIFICADA') {
      k.total++;
      _sumarEstado(estadoFactura(f, 'CONSUMO'));
      celdasConFactura.CONSUMO['CONSUMO|' + cl + '|' + f.periodo] = true;
    }
    if (f.tipo === 'PEAJE' || f.tipo === 'UNIFICADA') {
      k.total++;
      _sumarEstado(estadoFactura(f, 'PEAJE'));
      celdasConFactura.PEAJE['PEAJE|' + cl + '|' + f.periodo] = true;
    }
  });

  // Celdas vacías (aparecen en las tablas como Pendiente / Por Emitir)
  ['CONSUMO', 'PEAJE'].forEach(ctx => {
    clientes.forEach(cl => {
      periodos.forEach(p => {
        const key = ctx + '|' + cl + '|' + p;
        if (celdasConFactura[ctx][key]) return;
        k.total++;
        if (esPeriodoPasado(p)) k.pendientes++;
        else                    k.porEmitir++;
      });
    });
  });

  // ─── Atrasadas ───
  //  Sólo se consideran "atrasadas" las facturas YA RECIBIDAS cuyo
  //  desfase (emisión → recepción) supera DIAS_ATRASO días.
  //
  //  Excluidas explícitamente:
  //    · Pendientes  → no llegaron, pero no entran en esta métrica
  //                     (tienen su propia tarjeta).
  //    · N/A y S/I   → estados de no-gestión.
  //    · Recibidas sin fecha → no hay fecha para medir desfase.
  k.fueraPlazo = 0;
  FACTURAS.forEach(f => {
    const cl = claveCliente(f);
    if (!clientesSet.has(cl) || !periodosSet.has(f.periodo)) return;
    const ctx = (f.tipo === 'PEAJE') ? 'PEAJE' : 'CONSUMO';
    const est = estadoFactura(f, ctx);
    if (est !== 'recibida') return;
    const d = (ctx === 'PEAJE') ? diasDesfasePeaje(f) : diasDesfaseSum(f);
    if (d !== null && d > DIAS_ATRASO) k.fueraPlazo++;
  });

  // ─── 2) Sumar montos: sólo facturas dentro del filtro, sin duplicar ───
  //  UNIFICADA se ve en ambas tablas, pero su sum+peaje debe contarse
  //  UNA sola vez (si no, el peaje del unificado se sumaría dos veces).
  let suministro = 0, peaje = 0, intereses = 0, otros = 0;
  const vistas = new Set();
  FACTURAS.forEach(f => {
    const cl = claveCliente(f);
    if (!clientesSet.has(cl) || !periodosSet.has(f.periodo)) return;
    const num = String(f.numero || '').trim();
    if (!num || vistas.has(num)) return;
    vistas.add(num);
    suministro += Number(f.sum) || 0;
    peaje      += Number(f.peaje) || 0;
    intereses  += (Number(f.intereses) || 0) + (Number(f.intPeaje) || 0);
    otros      += (Number(f.otros) || 0) + (Number(f.otrosPeaje) || 0);
  });
  const totalFacturado = suministro + peaje;

  // ─── Denominador de gestión ───
  //  Se usa para calcular los % de Recibidas, Pendientes y Atrasadas.
  //  Excluye N/A, S/I y celdas no informadas — sólo mide gestión real.
  const _denomGestion = k.recibidas + k.recibidas_sf + k.pendientes + k.porEmitir;
const _pct = (n) => _denomGestion ? Math.round(n / _denomGestion * 100) + '% del total' : '';

  document.getElementById('kpis').innerHTML=`
    <div class="kpi green"><div class="label">Recibidas</div><div class="value">${k.recibidas}</div><div class="meta">${_pct(k.recibidas)}</div></div>
    <div class="kpi amber clickable${_FILTRO_PENDIENTES && VISTA === 'KPI' ? ' active' : ''}"
         onclick="_toggleFiltroPendientes()"
         title="${VISTA !== 'KPI' ? 'Pendientes = períodos pasados sin factura cargada. El filtro se activa desde la vista Seguimiento.' : (_FILTRO_PENDIENTES ? 'Click para quitar el filtro' : 'Click para mostrar sólo las facturas pendientes (períodos pasados sin factura cargada)')}">
      <div class="label">Pendientes</div>
      <div class="value">${k.pendientes}</div>
      <div class="meta">${
        VISTA !== 'KPI'
          ? _pct(k.pendientes)
          : (_FILTRO_PENDIENTES ? '● Filtro activo — click para quitar' : _pct(k.pendientes) + ' · click para filtrar')
      }</div>
    </div>
    <div class="kpi blue clickable${_FILTRO_FUERA_PLAZO && VISTA === 'KPI' ? ' active' : ''}"
         onclick="_toggleFiltroFueraPlazo()"
         title="${VISTA !== 'KPI' ? 'Atrasadas = facturas recibidas con más de ' + DIAS_ATRASO + ' días de desfase desde emisión. El filtro se activa desde la vista Seguimiento.' : (_FILTRO_FUERA_PLAZO ? 'Click para quitar el filtro' : 'Click para mostrar sólo las facturas atrasadas (recibidas con más de ' + DIAS_ATRASO + ' días de desfase)')}">
      <div class="label">Atrasadas (&gt;${DIAS_ATRASO}d)</div>
      <div class="value">${k.fueraPlazo}</div>
      <div class="meta">${
        VISTA !== 'KPI'
          ? _pct(k.fueraPlazo)
          : (_FILTRO_FUERA_PLAZO ? '● Filtro activo — click para quitar' : _pct(k.fueraPlazo) + ' · click para filtrar')
      }</div>
    </div>
    <div class="kpi green"><div class="label">Total Suministro</div><div class="value">$${fmtMiles(suministro)}</div></div>
    <div class="kpi amber"><div class="label">Total Peaje</div><div class="value">$${fmtMiles(peaje)}</div></div>
    <div class="kpi red"><div class="label">Total Intereses</div><div class="value">$${fmtMiles(intereses)}</div></div>
    <div class="kpi purple"><div class="label">Total facturado</div><div class="value">$${fmtMiles(totalFacturado)}</div></div>`;
}

// Construye la matriz { cliente: { periodo: [facturas] } } del contexto.
// Acepta opcionalmente una lista ya filtrada (`facturasFuente`). Si no
// se pasa, usa FACTURAS completa. Esto permite que el toggle
// "Fuera de plazo" no duplique la lógica de clasificación por tipo.
function construirMatriz(contexto, facturasFuente){
  const fuente = Array.isArray(facturasFuente) ? facturasFuente : FACTURAS;
  const m={};
  fuente.forEach(f=>{
    const tipo = String(f.tipo || '').toUpperCase();
    // Reglas duras de clasificación (excluyentes):
    //  · ARRIENDO_MEDIDOR sólo aparece en su propia tabla.
    //  · Las tablas Suministro/Peaje sólo reciben CONSUMO/PEAJE/UNIFICADA.
    let aplica = false;
    if (contexto === 'ARRIENDO_MEDIDOR') {
      aplica = (tipo === 'ARRIENDO_MEDIDOR');
    } else if (contexto === 'CONSUMO') {
      aplica = (tipo === 'CONSUMO' || tipo === 'SUMINISTRO' || tipo === 'UNIFICADA');
    } else if (contexto === 'PEAJE') {
      aplica = (tipo === 'PEAJE' || tipo === 'UNIFICADA');
    }
    if(!aplica)return;
    const key=claveCliente(f);
    if(!m[key])m[key]={};
    if(!m[key][f.periodo])m[key][f.periodo]=[];
    m[key][f.periodo].push(f);
  });
  return m;
}

function parseDriveIdFront(input){
  if(!input) return '';
  const s = String(input).trim();
  if(!s) return '';
  if(/^[a-zA-Z0-9_-]{15,}$/.test(s)) return s;
  let m = s.match(/[?&]id=([^&\s]+)/);
  if(m) return decodeURIComponent(m[1]);
  m = s.match(/\/(?:folders|d)\/([^\/?\s&]+)/);
  if(m) return decodeURIComponent(m[1]);
  return s;
}

function renderTabla(wrapId,countId,contexto){
  const wrap=document.getElementById(wrapId);

  // Fuente de datos de esta tabla, ya filtrada por el toggle rápido
  // activo (Atrasadas o Pendientes) si corresponde.
  //   · Atrasadas  → recibidas con desfase > DIAS_ATRASO (por factura).
  //   · Pendientes → esta tabla NO filtra por factura; las "celdas
  //                  pendientes" son las que no tienen items. Se
  //                  filtran más abajo, en el renderizado de filas.
  const _fuente = _FILTRO_FUERA_PLAZO
    ? FACTURAS.filter(f => _esFacturaFueraPlazo(f, contexto))
    : FACTURAS;

  const matriz=construirMatriz(contexto, _fuente);
  const fC=document.getElementById('filtroCentro')?document.getElementById('filtroCentro').value:'todos';
  const fM=document.getElementById('filtroMes')?document.getElementById('filtroMes').value:'todos';

  let clientes=CONFIG.centros
    .filter(e => !_esCentroFantasma(e.codigo, e.cliente))
    .map(e=>e.cliente+' ('+e.codigo+')');
  if(fC!=='todos')clientes=clientes.filter(c=>c===fC);

  // Subconjunto de períodos a mostrar según el filtro de mes:
  //   'todos'      → todos los períodos configurados
  //   'ult3/6/12'  → los N más recientes
  //   'YYYY-MM'    → ese único mes
  const periodos = _periodosSegunFiltroMes(fM);
  const periodosVisibles = periodos;

  // ─── Ocultar filas sin facturas ───
  //  Reglas:
  //   · Con "Todos los meses": ocultar centros sin facturas en la
  //     ventana visible (comportamiento histórico).
  //   · Con el toggle "Fuera de plazo" activo (sólo recibidas con
  //     desfase > DIAS_ATRASO): ocultar centros sin ninguna factura
  //     que pase el filtro — el usuario está persiguiendo excepciones
  //     y no quiere ver ruido.
  //   · En cualquier otro caso: mostrar todos los centros para
  //     poder registrar recepciones.
  if(fM === 'todos' || _FILTRO_FUERA_PLAZO){
    clientes = clientes.filter(cl => {
      return _fuente.some(f => {
        if (claveCliente(f) !== cl) return false;
        if (!periodosVisibles.includes(f.periodo)) return false;
        if (contexto==='CONSUMO' && (f.tipo==='CONSUMO'||f.tipo==='SUMINISTRO'||f.tipo==='UNIFICADA')) return true;
        if (contexto==='PEAJE'   && (f.tipo==='PEAJE'  ||f.tipo==='UNIFICADA')) return true;
        if (contexto==='ARRIENDO_MEDIDOR' && f.tipo==='ARRIENDO_MEDIDOR') return true;
        return false;
      });
    });
  }

  // Con el filtro "Pendientes" activo, sólo se muestran centros que
  // tengan al menos una celda PENDIENTE (sin factura y en período
  // pasado) en la ventana visible. Los centros con todas las celdas
  // resueltas (con factura, N/A, S/I, por emitir) se ocultan.
  if(_FILTRO_PENDIENTES){
    clientes = clientes.filter(cl => {
      return periodosVisibles.some(p => {
        const items = (matriz[cl] && matriz[cl][p]) || [];
        if (items.length > 0) return false;
        return esPeriodoPasado(p);
      });
    });
  }

  const clientesSet=new Set(clientes);
  const periodosSet=new Set(periodos);

  const esArriendo = (contexto === 'ARRIENDO_MEDIDOR');
  let total=0,recibidas=0,recibidas_sf=0;
  _fuente.forEach(f=>{
    const tipo = String(f.tipo || '').toUpperCase();
    let aplica = false;
    if (contexto === 'ARRIENDO_MEDIDOR') {
      aplica = (tipo === 'ARRIENDO_MEDIDOR');
    } else if (contexto === 'CONSUMO') {
      aplica = (tipo === 'CONSUMO' || tipo === 'SUMINISTRO' || tipo === 'UNIFICADA');
    } else if (contexto === 'PEAJE') {
      aplica = (tipo === 'PEAJE' || tipo === 'UNIFICADA');
    }
    if(!aplica)return;
    if(!clientesSet.has(claveCliente(f))||!periodosSet.has(f.periodo))return;
    total++;
    if(esArriendo){
      // Arriendo de medidor: no se exige fecha, la factura está "recibida"
      // por el sólo hecho de estar registrada.
      recibidas++;
    } else {
      const e=estadoFactura(f,contexto);
      if(e==='recibida')recibidas++;
      else if(e==='recibida-sf')recibidas_sf++;
    }
  });
  // Con un filtro rápido activo, las celdas vacías NO suman al total:
  //   · "Atrasadas"  → no hay "fuera de plazo" en una celda vacía.
  //   · "Pendientes" → las celdas vacías son justamente el filtro;
  //                    contarlas como parte del total de recibidas no
  //                    aporta (ya no mostramos el ratio).
  if(!esArriendo && !_hayFiltroRapidoActivo()){
    clientes.forEach(c=>{
      periodos.forEach(p=>{
        const items=(matriz[c]&&matriz[c][p])||[];
        if(items.length===0)total++;
      });
    });
  }
  const countTxt = esArriendo
    ? (total + (total === 1 ? ' factura' : ' facturas'))
    : (recibidas+'/'+total+' recibidas'+(recibidas_sf?' (+'+recibidas_sf+' s/f)':''));
  document.getElementById(countId).textContent = countTxt;

  const table=document.createElement('table');
  const thead=document.createElement('thead');
  thead.innerHTML='<tr><th>Centro de costo (Código)</th>'+
    periodos.map(p=>'<th>'+formatPeriodo(p)+'</th>').join('')+'</tr>';
  table.appendChild(thead);
  const tbody=document.createElement('tbody');
  clientes.forEach(clave=>{
    const tr=document.createElement('tr');
    tr.innerHTML = '<td>' + clave + '</td>';
    periodos.forEach(periodo=>{
      const items=(matriz[clave]&&matriz[clave][periodo])||[];
      const td=document.createElement('td');
      td.className='cell';
      renderContenidoCelda(td,items,contexto,periodo);
      td.querySelectorAll('.chip').forEach(chip => { chip.style.cursor = 'pointer'; });
      td.addEventListener('click', ev => {
        ev.stopPropagation();
        const chipEl = ev.target.closest('.chip');
        if(chipEl && chipEl.dataset && chipEl.dataset.fidx !== undefined && chipEl.dataset.fidx !== ''){
          const idx = parseInt(chipEl.dataset.fidx, 10);
          const facturaAsociada = items[idx] || items[0];
          onClickCelda(td, items, contexto, clave, periodo, facturaAsociada);
        } else {
          onClickCelda(td, items, contexto, clave, periodo);
        }
      });
      tr.appendChild(td);
    });
    tbody.appendChild(tr);
  });
  table.appendChild(tbody);

  wrap.innerHTML='';
  wrap.appendChild(table);
}

function renderContenidoCelda(td,items,contexto,periodo){
  // ─── Arriendo de medidor ───
  //  No se espera factura en todos los períodos. Por eso:
  //    · celda vacía            → "—" (no "Pendiente" / "Por Emitir")
  //    · celda con factura      → N° de factura (no requiere fecha)
  if(contexto === 'ARRIENDO_MEDIDOR'){
    if(items.length === 0){
      td.innerHTML = '<span style="color:var(--text-dim);font-weight:600;">—</span>';
      return;
    }
    const chipsArr = items.map((f, idx) => {
      const tt   = escAttr(tooltipFactura(f));
      const fecha= fechaRelevante(f, contexto);
      const dIdx = ' data-fidx="'+idx+'"';
      const pdfIco = f.pdfId ? ' <span style="opacity:.75;font-weight:400">📄</span>' : '';
      if(fecha === 'N/A') return '<span class="chip na"'+dIdx+' title="'+tt+'">N/A'+pdfIco+'</span>';
      if(fecha === 'S/I') return '<span class="chip si"'+dIdx+' title="'+tt+'">S/I'+pdfIco+'</span>';
      const numFactura = String(f.numero || '').trim() || 'Recibida';
      return '<span class="chip recibida"'+dIdx+' title="'+tt+'">'+numFactura+pdfIco+'</span>';
    });
    td.innerHTML = chipsArr.join('');
    return;
  }

  // ─── Suministro y Peaje (lógica original) ───
  if(items.length===0){
    // Filtro "Pendientes": las celdas vacías en período pasado SON el
    // contenido buscado → se muestran con su chip normal.
    // Cualquier otra combinación (período actual/futuro, o filtro
    // "Atrasadas") muestra un punto discreto para no distraer.
    if(_FILTRO_PENDIENTES){
      if(esPeriodoPasado(periodo)){
        td.innerHTML = '<span class="chip pendiente">Pendiente</span>';
      } else {
        td.innerHTML = '<span style="color:var(--text-dim);opacity:.35;font-weight:600;">·</span>';
      }
      return;
    }
    // Filtro "Atrasadas": las celdas vacías se atenúan; no son
    // "Atrasadas" (esa categoría requiere factura recibida).
    if(_FILTRO_FUERA_PLAZO){
      td.innerHTML = '<span style="color:var(--text-dim);opacity:.35;font-weight:600;">·</span>';
      return;
    }
    // Sin filtro: comportamiento original.
    if(esPeriodoPasado(periodo)) td.innerHTML='<span class="chip pendiente">Pendiente</span>';
    else                         td.innerHTML='<span class="chip por-emitir">Por Emitir</span>';
    return;
  }

  // ─── Con factura y filtro "Pendientes" activo ───
  // La celda tiene contenido pero el usuario está persiguiendo celdas
  // VACÍAS. Se muestra un punto discreto en vez del chip de la factura.
  if(_FILTRO_PENDIENTES){
    td.innerHTML = '<span style="color:var(--text-dim);opacity:.35;font-weight:600;">·</span>';
    return;
  }
  const chips = items.map((f, idx) => {
    const tt   = escAttr(tooltipFactura(f));
    const fecha= fechaRelevante(f, contexto);
    const dIdx = ' data-fidx="'+idx+'"';
    const pdfIco = f.pdfId ? ' <span style="opacity:.75;font-weight:400">📄</span>' : '';
    if(fecha === 'N/A') return '<span class="chip na"'+dIdx+' title="'+tt+'">N/A'+pdfIco+'</span>';
    if(fecha === 'S/I') return '<span class="chip si"'+dIdx+' title="'+tt+'">S/I'+pdfIco+'</span>';
    // Chip "recibida": mostrar el N° de factura en lugar de la fecha.
    if(fecha){
      const numFactura = String(f.numero || '').trim() || fmtFecha(fecha);
      return '<span class="chip recibida"'+dIdx+' title="'+tt+'">'+numFactura+pdfIco+'</span>';
    }
    const est = estadoFactura(f, contexto);
    let label, cls = est;
    if(est === 'recibida' || est === 'recibida-sf'){ label='Recibida';  cls='recibida-sf'; }
    else if(est === 'pendiente') { label='Pendiente'; }
    else if(est === 'por-emitir'){ label='Por Emitir'; }
    else if(est === 'plazo')     { label='En plazo'; }
    else if(est === 'na')        { label='N/A'; }
    else                         { label='S/I'; }
    return '<span class="chip '+cls+'"'+dIdx+' title="'+tt+'">'+label+'</span>';
  });
  const est0 = estadoFactura(items[0], contexto);
  const warn = (est0 === 'si' || est0 === 'na') ? '' : warnHTML(items[0]);
  td.innerHTML = chips.join('') + warn;
}

function onClickCelda(td, items, contexto, clave, periodo, facturaEspecifica){
  if(td.querySelector('.cell-edit')) return;
  if(items.length === 0){ abrirModalAgregar(clave, periodo, contexto); return; }
  const factura = facturaEspecifica || items[0];
  const fecha = fechaRelevante(factura, contexto);
  if(fecha && SENTINELAS.indexOf(fecha) === -1){
    abrirModalEditar(clave, periodo, contexto, factura);
    return;
  }
  abrirEditorCelda(td, items, contexto, clave, periodo, factura, hoyISO());
}

// El <select id="fTipo"> NO tiene la opción "CONSUMO" (fue renombrada a
// "SUMINISTRO"). Si algún caller (grid, OCR, DB legacy) pasa 'CONSUMO',
// la asignación silenciosa deja el select vacío y rompe la validación.
function _normalizarTipoSelect(t){
  const u = String(t || '').toUpperCase();
  if (u === 'CONSUMO') return 'SUMINISTRO';
  if (['SUMINISTRO','PEAJE','UNIFICADA','ARRIENDO_MEDIDOR'].indexOf(u) !== -1) return u;
  // Sin valor → cadena vacía, para que el select muestre su
  // placeholder y la validación obligue a elegir.
  return '';
}

function _abrirModal({ modo = 'crear', clave = null, periodo = null, tipo = 'CONSUMO',
                       factura = null, externo = false, fechaInicial = null } = {}) {
  MODO_MODAL = modo;
  // FACTURA_EDITANDO sólo se setea si hay una factura con N° real.
  // Una factura sin N° (celda vacía o fila sintética sin número) se
  // trata como "no hay factura": Rectificar y Eliminar quedan
  // deshabilitados y la validación de Guardar se activa.
  FACTURA_EDITANDO = (modo === 'editar' && factura && String(factura.numero || '').trim())
    ? factura
    : null;
  PDF_ACTUAL = null;
  PDF_FUENTE = null;
  PDF_WARNINGS = [];
  PDF_YA_SUBIDO = false;
  FACTURA_YA_GUARDADA_EN_BD = false;
  _ocultarDiffPanel();
  _FACTURA_ORIGINAL_DIFF = null;
  _CAMPOS_PDF_PENDIENTE = null;
  _SIN_DIFERENCIAS_AL_ABRIR = false;
  _REVISION_YA_REGISTRADA = false;

  const partes = clave ? parseClaveCliente(clave) : { cliente: '', codigo: '' };
  const titulo = externo
    ? 'Cargar factura desde PDF'
    : (modo === 'editar' ? ('Editar factura · ' + factura.numero)
                         : ('Agregar factura · ' + partes.cliente));
  document.getElementById('modalAgregarTitulo').textContent = titulo;

  const resetIds = ['fNumero','fFecha','fEmision','fVencimiento','fKwh','fSum','fPeaje',
                    'fInt','fIntPeaje','fOtros','fOtrosPeaje','fTotal'];
  resetIds.forEach(id => document.getElementById(id).value = '');
  document.getElementById('fPDF').value = '';
  document.getElementById('fPDFDriveUrl').value = '';
  document.getElementById('fCodigo').value = '';
  // Tipo de factura: por defecto SIN selección. Se setea más abajo
  // según el modo (editar → tipo real; crear con contexto → tipo del
  // contexto; crear externo → vacío hasta que OCR o el usuario lo
  // determinen).
  document.getElementById('fTipo').value = '';
  document.getElementById('fRut').value = '';
  document.getElementById('fRut').style.color = '';
  document.getElementById('fRut').title = '';

  const pda = document.getElementById('fPDFDriveActions'); if (pda) pda.style.display = 'none';
  const bex = document.getElementById('btnExtraerPDFDrive'); if (bex) bex.disabled = false;
  document.getElementById('pdfInfo').classList.remove('show');
  document.getElementById('pdfWarn').classList.remove('show');
  document.getElementById('pdfWarn').innerHTML = '';
  document.getElementById('formError').classList.remove('show');
  cerrarPreview();

  poblarSelectoresCentro();

  if (!externo) {
    document.getElementById('fCliente').value = partes.codigo || '';
    document.getElementById('fCodigo').value  = partes.codigo;
    _refrescarRutCentro(partes.codigo);
    document.getElementById('fPeriodo').value = periodo || '';
    // Sólo en modo "editar" el tipo viene de la factura existente.
    // En modo "crear" con contexto (click en celda del Seguimiento)
    // el `tipo` refleja el tipo de factura que corresponde a esa
    // columna — se respeta. Si el caller no aporta tipo, queda ''.
    if (modo === 'editar') {
      document.getElementById('fTipo').value = _normalizarTipoSelect(tipo);
    } else if (tipo && _normalizarTipoSelect(tipo)) {
      document.getElementById('fTipo').value = _normalizarTipoSelect(tipo);
    }
    lockSelectoresClientePeriodo();
  } else {
    document.getElementById('fCliente').value = '';
    document.getElementById('fPeriodo').value = '';
    unlockSelectoresClientePeriodo();
  }

  if (fechaInicial) document.getElementById('fFecha').value = fechaInicial;

  // Helper: los sentinels ('Sin fecha', 'N/A', 'S/I') no son válidos para
  // <input type="date">; se filtran antes de asignar.
  const _fechaLimpia = (v) => {
    const s = fechaValida(v);
    return (s && SENTINELAS.indexOf(s) === -1) ? s : '';
  };

  if (modo === 'editar' && factura) {
    document.getElementById('fNumero').value        = factura.numero;
    document.getElementById('fFecha').value         = _fechaLimpia(factura.fechaConsumo || factura.fechaPeaje);
    document.getElementById('fEmision').value       = _fechaLimpia(factura.fechaEmision);
    document.getElementById('fVencimiento').value   = _fechaLimpia(factura.fechaVencimiento);
    document.getElementById('fKwh').value           = numeroAInput(factura.kwh);
    document.getElementById('fSum').value           = numeroAInput(factura.sum);
    document.getElementById('fPeaje').value         = numeroAInput(factura.peaje);
    document.getElementById('fInt').value           = numeroAInput(factura.intereses);
    document.getElementById('fIntPeaje').value      = numeroAInput(factura.intPeaje);
    document.getElementById('fOtros').value         = numeroAInput(factura.otros);
    document.getElementById('fOtrosPeaje').value    = numeroAInput(factura.otrosPeaje);
    document.getElementById('fTotal').value         = numeroAInput(factura.total);
    document.getElementById('fTipo').value          = _normalizarTipoSelect(factura.tipo || tipo);

    const urlInp = document.getElementById('fPDFDriveUrl');
    const actionsDiv = document.getElementById('fPDFDriveActions');
    const pid = factura.pdfId || '';
    const pidLimpio = pid ? parseDriveIdFront(pid) : '';
    urlInp.value = pidLimpio;   // solo el ID, no la URL completa
    if (actionsDiv) actionsDiv.style.display = urlInp.value ? 'flex' : 'none';

    // Marcar la fuente como 'drive' para que la preview lo use sin
    // ambigüedad (hay factura existente con PDF vinculado).
    if (urlInp.value) PDF_FUENTE = 'drive';
  }

  _refrescarInfoDriveCentro();
  actualizarPreview();
  _sincronizarAnchoModal();
  _actualizarBotonesFactura();
    document.getElementById('modalAgregar').classList.add('open');

    // La carga iniciada desde una URL copiada ya llegó al modal.
    const _btnDriveCarga = document.getElementById('btnCargarDriveUrl');
    if (_btnDriveCarga && _btnDriveCarga.textContent === '📋 URL copiada, cargando…') {
      _btnDriveCarga.textContent = '🔗 Cargar desde Drive (URL)';
    }

    setTimeout(() => {
    const foco = (modo === 'editar') ? 'fKwh' : (externo ? 'fCliente' : 'fNumero');
    document.getElementById(foco).focus();
  }, 100);

  if (modo === 'editar' && factura && factura.pdfId && !_ULTIMOS_CAMPOS_OCR) {
    const pid = String(factura.pdfId).trim();
    setTimeout(() => {
      // Toda la cadena de auto-OCR corre en background. No await-eamos
      // desde aquí: el modal ya está abierto y usable.
      (async () => {
        try {
          const dl = await apiPost({ accion: 'descargarPDFDrive', id: pid });
          if (!dl.ok) return;

          // Cachear el base64 para que la preview NO vuelva a descargar
          // el mismo archivo (evita el flash del iframe).
          _precargarPreviewDrive(pid, dl.base64, dl.mime || 'application/pdf');

          await _ejecutarOCR({
            base64: dl.base64,
            mime: dl.mime || 'application/pdf',
            nombre: dl.nombre || 'factura.pdf',
            silent: true
          });
        } catch (e) { console.warn('Auto-OCR no se pudo iniciar:', e); }
      })();
    }, 250);
  }
}

