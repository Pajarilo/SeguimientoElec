 * Garantiza que el encabezado siempre tenga 2 de 3 botones.
 */
function _actualizarBotonesVista(){
  const bSeg = document.getElementById('btnVerSeguimiento');
  const bDet = document.getElementById('btnVerDetalle');
  const bDas = document.getElementById('btnVerDashboard');
  if (bSeg) bSeg.style.display = (VISTA === 'KPI')       ? 'none' : '';
  if (bDet) bDet.style.display = (VISTA === 'DETALLE')   ? 'none' : '';
  if (bDas) bDas.style.display = (VISTA === 'DASHBOARD') ? 'none' : '';
}

async function cargar(){
  setStatus('Cargando...','');
  const btn=document.getElementById('btnReload');
  if(btn)btn.disabled=true;
  try{
    const data=await apiGet();
    if(data.error)throw new Error(data.error);
    FACTURAS=data.facturas||[];
    if(data.config)CONFIG=data.config;

    // ─── Versión del frontend (viene del backend: fuente única) ───
    if(data.version){
      const _badge = document.getElementById('footerVersionBadge');
      if(_badge) _badge.textContent = 'Versión ' + String(data.version);
    }
    if(!Array.isArray(CONFIG.centros))CONFIG.centros=[];
    CONFIG.centros=CONFIG.centros.map(c=>({
      codigo:c.codigo||'',
      cliente:c.cliente||'',
      empConsumo:c.empConsumo||'',
      empPeaje:c.empPeaje||'',
      driveOp:c.driveOp||'',
      driveCom:c.driveCom||'',
      rut:c.rut||'',
      empresa:c.empresa||'EMOAC'
    }));
    CONFIG.centros.forEach(c=>{
      if(!c.driveOp || !c.driveCom){
        const ls = _driveLSBuscar(c.codigo);
        if(ls){
          let cambio = false;
          if(!c.driveOp && ls.op){ c.driveOp = ls.op; cambio = true; }
          if(!c.driveCom && ls.com){ c.driveCom = ls.com; cambio = true; }
          if(cambio){
            apiPost({ accion:'guardarDriveConfig', codigo: c.codigo, driveOp: c.driveOp, driveCom: c.driveCom })
              .catch(()=>{});
          }
        }
      }
    });
    poblarFiltros();
    // Renderizar sólo la vista activa — evita trabajo doble y parpadeos.
    if(VISTA === 'DASHBOARD')      { renderKPIs(); renderDashboard(); }
    else if(VISTA === 'DETALLE')   { renderKPIs(); renderResumen();   }
    else                           { render(); }
    _actualizarBotonesVista();
    _aplicarVisibilidadFiltros();
    setStatus('✓ '+FACTURAS.length+' facturas · '+CONFIG.periodos.length+' períodos · '+CONFIG.centros.length+' centros','ok');
  }catch(e){setStatus('Error: '+e.message,'err');showToast('No se pudieron cargar: '+e.message,'err');}
  finally{if(btn)btn.disabled=false;}
}

// Valores "especiales" del selector de meses (no son períodos ISO).
const _FILTRO_MES_RANGOS = ['todos','ult3','ult6','ult12'];

/**
 * Aplica un valor del selector de meses sobre la lista completa de
 * períodos de CONFIG y devuelve el subconjunto que corresponde mostrar.
 *
 *   · 'todos'   → todos los períodos (sin recorte).
 *   · 'ultN'    → los N períodos cerrados más recientes anteriores
 *                 al mes actual. El mes en curso nunca se incluye porque
 *                 todavía no está cerrado.
 *                 Ej.: en octubre de 2026, "últimos 3 meses" devuelve
 *                 jul-26, ago-26 y sep-26.
 *   · 'YYYY-MM' → sólo ese período.
 */
function _periodosSegunFiltroMes(filtroMes){
  const todos = CONFIG.periodos.slice().sort();

  // Mes actual (año * 12 + mes) para poder comparar sin crear Date
  // completos: `Date` con día/hora provoca off-by-one por zona horaria.
  const hoy = new Date();
  const mesActual = hoy.getFullYear() * 12 + hoy.getMonth();

// El mes en curso NO está cerrado todavía → se excluye del conteo.
// "últimos 3 meses" en octubre-2026 devuelve jul/ago/sep-26.
const pasados = todos.filter(p => {
const [y, m] = p.split('-').map(Number);
return (y * 12 + (m - 1)) < mesActual;
});

  if(!filtroMes || filtroMes === 'todos') return pasados;

  const m = String(filtroMes).match(/^ult(\d+)$/);
  if(m){
    const n = parseInt(m[1], 10);
    if(!isFinite(n) || n <= 0) return pasados;
    return pasados.slice(-n);
  }

  // Valor de mes puntual (YYYY-MM): sólo si existe en Config.
  return todos.includes(filtroMes) ? [filtroMes] : pasados;
}

function poblarFiltros(){
  const selMes=document.getElementById('filtroMes');
  const selCentro=document.getElementById('filtroCentro');
  const mA=selMes.value,cA=selCentro.value;
  const periodos=CONFIG.periodos.slice().sort();

  // Los "rangos" (todos/ult3/ult6/ult12) van siempre al principio; los
  // meses puntuales se anexan después, en orden cronológico.
  const opcionesRango =
    '<option value="todos">📅 Todos los meses</option>' +
    '<option value="ult3">⏱ Últimos 3 meses</option>' +
    '<option value="ult6">⏱ Últimos 6 meses</option>' +
    '<option value="ult12">⏱ Últimos 12 meses</option>';
  const opcionesMes = periodos.map(p=>'<option value="'+p+'">'+formatPeriodo(p)+'</option>').join('');
  selMes.innerHTML = opcionesRango + opcionesMes;

  // Preservar la selección actual si sigue siendo válida. Como la
  // filter bar es compartida, el select ya tiene el valor elegido por
  // el usuario — sólo hay que garantizar que las opciones existan.
  const validoMes = _FILTRO_MES_RANGOS.indexOf(mA) !== -1 || periodos.includes(mA);
  selMes.value = validoMes ? mA : 'todos';

  const centros=CONFIG.centros
    .filter(c => !_esCentroFantasma(c.codigo, c.cliente))
    .map(c=>c.cliente+' ('+c.codigo+')')
    .sort();
  selCentro.innerHTML='<option value="todos">🏢 Todos los centros</option>'+centros.map(c=>'<option value="'+c+'">'+c+'</option>').join('');

  const validoCentro = cA && (cA === 'todos' || centros.includes(cA));
  selCentro.value = validoCentro ? cA : 'todos';
}

function aplicarFiltros(){
  // Los filtros son compartidos: el DOM ya tiene los valores elegidos.
  // Sólo hay que repintar la vista activa para que los aplique.
  // Las tarjetas KPI son comunes a las 3 vistas → se refrescan
  // siempre, en cualquier vista activa.
  if(VISTA === 'DASHBOARD') { renderKPIs(); renderDashboard(); return; }
  if(VISTA === 'DETALLE')   { renderKPIs(); renderResumen();   return; }
  render();   // ya incluye renderKPIs()
}

function abrirModalMes(){
  const sel=document.getElementById('mesSelect');
  const hoy=new Date();
  const y=hoy.getFullYear(), m=hoy.getMonth()+1;
  const opciones=[];
  for(let i=0;i<24;i++){
    const d=new Date(y,m-1+i,1);
    const yy=d.getFullYear();
    const mm=String(d.getMonth()+1).padStart(2,'0');
    const val=yy+'-'+mm;
    const existe=CONFIG.periodos.includes(val);
    opciones.push({val,label:MESES[d.getMonth()]+'-'+yy+(existe?' (ya existe)':''),disabled:existe});
  }
  sel.innerHTML=opciones.map(o=>'<option value="'+o.val+'"'+(o.disabled?' disabled':'')+'>'+o.label+'</option>').join('');
  const primeraNoExistente=opciones.find(o=>!o.disabled);
  if(primeraNoExistente) sel.value=primeraNoExistente.val;
  document.getElementById('mesError').classList.remove('show');
  document.getElementById('modalAgregarMes').classList.add('open');
}

function limpiar(){
  const ids = ['fEmision','fVencimiento','fKwh','fSum','fPeaje','fInt','fIntPeaje','fOtros','fOtrosPeaje','fTotal'];
  ids.forEach(id => {
    const el = document.getElementById(id);
    if(el) el.value = '';
  });
  const elTipo = document.getElementById('fTipo');
  if(elTipo) elTipo.value = 'SUMINISTRO';
  showToast('🧹 Campos limpiados','ok');
}

function actualizarTodoDesdeOCR(){
  if(!_ULTIMOS_CAMPOS_OCR){
    showToast('Primero extrae datos con OCR (🔍)','err');
    return;
  }

  const btn = document.getElementById('btnActualizarOCR');
  const btnTxtOriginal = btn ? btn.textContent : '';
  if(btn){ btn.disabled = true; btn.textContent = '⏳ Aplicando…'; }

  try {
    const ids = ['fEmision','fVencimiento','fKwh','fSum','fPeaje','fInt','fIntPeaje','fOtros','fOtrosPeaje','fTotal'];
    ids.forEach(id => {
      const el = document.getElementById(id);
      if(el) el.value = '';
    });

    const campos = _ULTIMOS_CAMPOS_OCR;
    const numIds = {fKwh:1,fSum:1,fPeaje:1,fInt:1,fIntPeaje:1,fOtros:1,fOtrosPeaje:1,fTotal:1};
    let aplicados = 0;
    for(const k in campos){
      const vv = campos[k];
      if(vv===undefined || vv===null || vv==='') continue;
      const el = document.getElementById(k);
      if(!el) continue;
      el.value = numIds[k] ? numeroAInput(vv) : vv;
      aplicados++;
    }
    if(campos.fTipo){
      document.getElementById('fTipo').value = campos.fTipo;
      aplicados++;
    }

    {
      const cod = (document.getElementById('fCodigo').value || '').trim();
      if(cod && campos.fRut){
        _refrescarRutCentro(cod, campos.fRut);
        aplicados++;
      }
    }

    showToast('✓ '+aplicados+' campos aplicados — revisa y presiona Guardar','ok');
  } catch(e){
    console.warn('actualizarTodoDesdeOCR falló:', e);
    showToast('Error al aplicar: '+e.message,'err');
  } finally {
    if(btn){ btn.disabled = false; btn.textContent = btnTxtOriginal; }
  }
}

function cerrarModalMes(){
  document.getElementById('modalAgregarMes').classList.remove('open');
}
async function confirmarAgregarMes(){
  const err=document.getElementById('mesError');
  err.classList.remove('show');
  const p=document.getElementById('mesSelect').value;
  if(!p){ err.textContent='Selecciona un mes'; err.classList.add('show'); return; }
  if(!/^\d{4}-\d{2}$/.test(p)){ err.textContent='Formato inválido'; err.classList.add('show'); return; }
  setStatus('Agregando período '+p+'...','');
  try{
    const r=await apiPost({accion:'agregarPeriodo',periodo:p});
    if(!r.ok) throw new Error(r.error);
    showToast('✓ Período '+p+' agregado','ok');
    setStatus('✓ Período agregado · actualizando…','ok');
    cerrarModalMes();
    setTimeout(() => {
      Promise.resolve()
        .then(() => cargar())
        .catch(e => console.warn('[periodo] cargar() falló:', e));
    }, 0);
  }catch(e){
    setStatus('Error: '+e.message,'err');
    err.textContent=e.message;
    err.classList.add('show');
  }
}

