  // Respetar el filtro de mes en sus 3 formas: todos / ult3-6-12 / YYYY-MM
  const periodosExp = new Set(_periodosSegunFiltroMes(fM));
  let datos=FACTURAS.filter(f => periodosExp.has(f.periodo));
  if(fC!=='todos')datos=datos.filter(f=>claveCliente(f)===fC);
  if(!datos.length){showToast('No hay facturas','err');return;}
  const SEP=';';
  const esc=v=>{const s=String(v==null?'':v);return(s.includes(SEP)||s.includes('"')||s.includes('\n'))?'"'+s.replace(/"/g,'""')+'"':s;};
  const head=['N° Factura','Código Cliente','Centro de costo','Periodo','Tipo','kWh','Sum. Neto','Peaje','Intereses Sum','Intereses Peaje','Otros Sum','Otros Peaje','Total','Recepción Suministro','Recepción Peaje','Fecha Emisión','Fecha Vencimiento'];
  const filas=datos.map(f=>[f.numero,f.codigo||'',f.cliente,f.periodo,f.tipo||'',f.kwh||0,f.sum||0,f.peaje||0,f.intereses||0,f.intPeaje||0,f.otros||0,f.otrosPeaje||0,f.total||0,f.fechaConsumo||'',f.fechaPeaje||'',f.fechaEmision||'',f.fechaVencimiento||''].map(esc).join(SEP));
  const csv=[head.join(SEP),...filas].join('\n');
  const blob=new Blob(['\uFEFF'+csv],{type:'text/csv;charset=utf-8;'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');a.href=url;a.download='detalle_facturacion_'+new Date().toISOString().slice(0,10)+'.csv';
  document.body.appendChild(a);a.click();document.body.removeChild(a);URL.revokeObjectURL(url);
