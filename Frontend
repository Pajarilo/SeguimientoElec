/**
 * Convierte el payload del modal (o del grid) al formato interno
 * que usa FACTURAS. Se aplica en el paso optimista para que el
 * modelo local refleje el cambio antes de que el backend responda.
 *
 * NO toca el backend. Sólo construye el objeto tal como lo leería
 * leerResumen() del lado servidor.
 */
function _normalizarFacturaParaModelo(datos, previa){
  const tipo = String(datos.tipo || (previa && previa.tipo) || 'SUMINISTRO').toUpperCase();
  const esUnif    = tipo === 'UNIFICADA';
  const esSum     = (tipo === 'SUMINISTRO' || tipo === 'CONSUMO' || esUnif);
  const esPeaje   = (tipo === 'PEAJE' || tipo === 'ARRIENDO_MEDIDOR' || esUnif);

  const _fechaRecep = (aplica, explicita, campoPrevio) => {
    // Cuando el tipo no aplica a este campo, se preserva el valor
    // previo que traía la factura (edición de UNIFICADA → SUMINISTRO
    // o viceversa). Si no hay previa, queda vacío.
    if(!aplica) return (previa ? (previa[campoPrevio] || '') : '');
    // Prioridad: campo explícito del payload > campo genérico 'fecha'.
    const src = (explicita != null && explicita !== '')
      ? explicita
      : (datos.fecha != null ? datos.fecha : '');
    if(!src) return SENTINELA_SIN_FECHA;
    const s = String(src).trim();
    if(SENTINELAS.indexOf(s) !== -1) return s;
    return /^\d{4}-\d{2}-\d{2}$/.test(s) ? s : '';
  };

  const fechaConsumo = _fechaRecep(esSum,   datos.fechaConsumo, 'fechaConsumo');
  const fechaPeaje   = _fechaRecep(esPeaje, datos.fechaPeaje,   'fechaPeaje');

  const _fechaSimple = (v) => {
    if(v == null || v === '') return '';
    const s = String(v).trim();
    if(SENTINELAS.indexOf(s) !== -1) return s;
    return /^\d{4}-\d{2}-\d{2}$/.test(s) ? s : '';
  };

  return {
    numero:      String(datos.numero || (previa && previa.numero) || '').trim(),
    codigo:      String(datos.codigo || (previa && previa.codigo) || '').trim(),
    cliente:     String(datos.cliente || (previa && previa.cliente) || '').trim(),
    periodo:     String(datos.periodo || (previa && previa.periodo) || '').trim(),
    tipo:        tipo,
    kwh:         Number(datos.kwh) || 0,
    sum:         Number(datos.sum) || 0,
    peaje:       Number(datos.peaje) || 0,
    intereses:   Number(datos.intereses) || 0,
    otros:       Number(datos.otros) || 0,
    total:       Number(datos.total) || 0,
    intPeaje:    Number(datos.intPeaje) || 0,
    otrosPeaje:  Number(datos.otrosPeaje) || 0,
    fechaConsumo,
    fechaPeaje,
    fechaEmision:     _fechaSimple(datos.fechaEmision),
    fechaVencimiento: _fechaSimple(datos.fechaVencimiento),
    pdfId:            String(datos.pdfDriveUrl || (previa && previa.pdfId) || '').trim()
  };
}

async function guardarFactura(){
  const err=document.getElementById('formError');
  const btnGuardar=document.getElementById('btnGuardarFactura');
  err.classList.remove('show');
  err.innerHTML='';

  const _cliSel = _getClienteSeleccionado();
  const datos={
    numero:document.getElementById('fNumero').value.trim(),
    codigo:document.getElementById('fCodigo').value.trim(),
    cliente:_cliSel.cliente,
    periodo:document.getElementById('fPeriodo').value,
    tipo:document.getElementById('fTipo').value,
    fecha:document.getElementById('fFecha').value,
    fechaEmision:document.getElementById('fEmision').value,
    fechaVencimiento:document.getElementById('fVencimiento').value,
    kwh:inputANumero(document.getElementById('fKwh').value),
    sum:inputANumero(document.getElementById('fSum').value),
    peaje:inputANumero(document.getElementById('fPeaje').value),
    intereses:inputANumero(document.getElementById('fInt').value),
    intPeaje:inputANumero(document.getElementById('fIntPeaje').value),
    otros:inputANumero(document.getElementById('fOtros').value),
    otrosPeaje:inputANumero(document.getElementById('fOtrosPeaje').value),
    total:inputANumero(document.getElementById('fTotal').value),
    pdfDriveUrl: document.getElementById('fPDFDriveUrl').value.trim()
  };

  // ─── (1) UPDATE OPTIMISTA: mutar FACTURAS en memoria ───
  //  Se aplica la factura al modelo local y se repinta la vista
  //  activa ANTES de llamar al backend. Con esto:
  //    · Los KPIs (montos, contadores) reflejan el cambio al instante.
  //    · La tabla del Seguimiento / Detalle / Dashboard muestra el
  //      cambio sin esperar el round-trip a Apps Script.
  //    · El backend se llama después; si falla, se revierte el modelo
  //      y se repinta para volver al estado autoritativo.
  //
  //  Se guarda la copia del estado previo por si hay que revertir.
  const _snapshotPrevio = (() => {
    // Sólo el registro que vamos a tocar (más liviano que clonar FACTURAS).
    if(MODO_MODAL === 'editar' && FACTURA_EDITANDO){
      const idx = FACTURAS.findIndex(f =>
        String(f.numero || '').trim() === String(FACTURA_EDITANDO.numero || '').trim() &&
        String(f.tipo   || '').toUpperCase() === String(FACTURA_EDITANDO.tipo || '').toUpperCase()
      );
      return { idx, previa: idx >= 0 ? FACTURAS[idx] : null };
    }
    return { idx: -1, previa: null };
  })();

  const _aplicarOptimista = () => {
    const entrada = _normalizarFacturaParaModelo(datos, _snapshotPrevio.previa);
    if(_snapshotPrevio.idx >= 0){
      // Edición: reemplazar in-place conservando la posición.
      FACTURAS[_snapshotPrevio.idx] = entrada;
    } else {
      // Alta: agregar al final (el orden real lo fija el backend;
      // para la UI actual el orden lo determinan los sorts internos
      // de cada vista, no el orden del arreglo).
      FACTURAS.push(entrada);
    }
    _renderVistaActiva();
  };

  const _revertirOptimista = () => {
    if(_snapshotPrevio.idx >= 0){
      if(_snapshotPrevio.previa) FACTURAS[_snapshotPrevio.idx] = _snapshotPrevio.previa;
      else FACTURAS.splice(_snapshotPrevio.idx, 1);
    } else {
      // Alta: quitar la entrada recién agregada (por numero + tipo).
      const num = String(datos.numero || '').trim();
      const tipo = String(datos.tipo || '').toUpperCase();
      const i = FACTURAS.findIndex(f =>
        String(f.numero || '').trim() === num &&
        String(f.tipo   || '').toUpperCase() === tipo
      );
      if(i >= 0) FACTURAS.splice(i, 1);
    }
    _renderVistaActiva();
  };

  _aplicarOptimista();

  if(!FACTURA_YA_GUARDADA_EN_BD){
    const faltantes=[];
    if(!datos.numero)faltantes.push({id:'fNumero',label:'N° Factura'});
    if(!datos.tipo)faltantes.push({id:'fTipo',label:'Tipo de factura'});
    if(!datos.fechaEmision)faltantes.push({id:'fEmision',label:'Fecha emisión'});
    if(faltantes.length){
      _msgWithCopy('formError', '⚠ Campos obligatorios: <b>'+faltantes.map(f=>f.label).join(', ')+'</b>');
      err.classList.add('show');
      faltantes.forEach(f=>{
        const el=document.getElementById(f.id);
        if(el){el.style.borderColor='#ef4444';el.style.boxShadow='0 0 0 2px rgba(239,68,68,.2)';setTimeout(()=>{el.style.borderColor='';el.style.boxShadow='';},3000);}
      });
      const first=document.getElementById(faltantes[0].id);
      if(first)first.focus();
      return;
    }

    if(!datos.fecha){
      const ok = confirm(
        '⚠ No se ingresó la fecha de recepción.\n\n' +
        'La factura quedará registrada como "Sin fecha" en la base de datos.\n\n' +
        '¿Guardar de todos modos?\n\n' +
        '(Cancelar para escribir la fecha y reintentar)'
      );
      if(!ok){
        const el = document.getElementById('fFecha');
        if(el){
          el.focus();
          el.style.borderColor = '#f59e0b';
          el.style.boxShadow = '0 0 0 2px rgba(245,158,11,.25)';
          setTimeout(() => { el.style.borderColor=''; el.style.boxShadow=''; }, 3000);
        }
        return;
      }
    }

    if(_PDF_TEXTO_OCR){
      PDF_WARNINGS = verificarPDFvsFactura(_PDF_TEXTO_OCR);
    }
    if(PDF_WARNINGS.length){
      const ok=confirm('El PDF presenta las siguientes inconsistencias:\n\n· '+PDF_WARNINGS.join('\n· ')+'\n\n¿Guardar de todos modos?');
      if(!ok)return;
    }
  }

  if(btnGuardar) btnGuardar.disabled = true;

  try {
    // ───────────────────────────────────────────────────────
    //  1) GUARDAR FACTURA EN LA HOJA
    // ───────────────────────────────────────────────────────
    if(!FACTURA_YA_GUARDADA_EN_BD){
      try{
        let res;
        if(MODO_MODAL==='editar' && FACTURA_EDITANDO){
          res = await apiPost({accion:'actualizarFactura', datos, idDrive: ''});
        } else {
          res = await apiPost({accion:'agregarFactura', datos});
        }
        if(!res || !res.ok) throw new Error((res && res.error) || 'Error al guardar la factura');
        FACTURA_YA_GUARDADA_EN_BD = true;

        // Enriquecer el modelo local con datos que sólo conoce el backend.
        if(res.pdf && res.pdf.id){
          const _i = FACTURAS.findIndex(f =>
            String(f.numero || '').trim() === String(datos.numero || '').trim() &&
            String(f.tipo   || '').toUpperCase() === String(datos.tipo || '').toUpperCase()
          );
          if(_i >= 0){
            FACTURAS[_i].pdfId = res.pdf.id;
            // Sin _renderVistaActiva(): el cambio es cosmético (icono 📄
            // en el chip) y aparece en el próximo render, sin causar
            // parpadeos por cada vinculación.
          }
        }

        showToast('✓ '+res.mensaje,'ok');
        if(res.pdf) showToast('✓ PDF vinculado a la factura','ok');

        try {
          const rutActual = (document.getElementById('fRut').value || '').trim();
          const codActual = (document.getElementById('fCodigo').value || '').trim();
          const centroActual = centroPorCodigo(codActual);
          if(rutActual && rutActual !== '—' && codActual && centroActual && !centroActual.rut){
            const rRut = await apiPost({ accion:'guardarRutCentro', codigo: codActual, rut: rutActual });
            if(rRut && rRut.ok && rRut.guardado){
              centroActual.rut = rRut.rut;
              const elRut = document.getElementById('fRut');
              if(elRut){ elRut.style.color=''; elRut.title='RUT desde Config'; }
            }
          }
        } catch(eRut) { }
      }catch(e){
        if(MODO_MODAL==='crear' && /Ya existe/i.test(e.message)){
          try{
            const res2 = await apiPost({accion:'actualizarFactura', datos, idDrive: ''});
            if(!res2 || !res2.ok) throw new Error((res2 && res2.error) || 'Error al actualizar');
            FACTURA_YA_GUARDADA_EN_BD = true;
            showToast('✓ Factura existente actualizada','ok');
          }catch(e2){
            _revertirOptimista();
            _msgWithCopy('formError', '⚠ <b>No se pudo guardar la factura:</b> '+e2.message+'<br>Corrige el problema y vuelve a presionar Guardar.');
            err.classList.add('show');
            setStatus('Error al guardar: '+e2.message,'err');
            return;
          }
        } else {
          _revertirOptimista();
          _msgWithCopy('formError', '⚠ <b>No se pudo guardar la factura:</b> '+e.message+'<br>Corrige el problema y vuelve a presionar Guardar.');
          err.classList.add('show');
          setStatus('Error al guardar: '+e.message,'err');
          return;
        }
      }
    }

    // ───────────────────────────────────────────────────────
    //  2) CAPTURAR LO NECESARIO PARA EL TRABAJO DE PDF
    //     (antes de cerrar el modal, por seguridad)
    // ───────────────────────────────────────────────────────
    const urlPDFActual = (document.getElementById('fPDFDriveUrl').value || '').trim();
    const idPDFActual  = urlPDFActual ? parseDriveIdFront(urlPDFActual) : '';
    const numeroForm   = (document.getElementById('fNumero').value  || '').trim()  || 'sin-numero';
    const codigoForm   = (document.getElementById('fCodigo').value  || '').trim();
    const periodoForm  = (document.getElementById('fPeriodo').value || '').trim()  || 'sin-periodo';
    const tipoForm     = (document.getElementById('fTipo').value    || '').trim()  || 'X';
    const rutForm      = (document.getElementById('fRut').value     || '').trim();

    const hayPDFLocal = !!(PDF_ACTUAL && !PDF_YA_SUBIDO);
    const hayPDFUrl   = !!(idPDFActual && idPDFActual.length >= 15);

    // Capturamos PDF_ACTUAL en una constante local: cerrarModal() lo
    // pone a null antes de que _procesarPDFs() corra en background.
    const _pdfLocalPendiente = hayPDFLocal ? PDF_ACTUAL : null;

    // ───────────────────────────────────────────────────────
    //  3) FUNCIÓN QUE HACE EL TRABAJO DE PDFs
    //     (una sola fuente de verdad, usada por ambas ramas)
    // ───────────────────────────────────────────────────────
    const _procesarPDFs = async () => {
      // 3a) PDF local → subir al Drive del centro.
      //  Restauramos PDF_ACTUAL porque cerrarModal() lo puso en null.
      //  El objeto capturado en _pdfLocalPendiente es el mismo que el
      //  usuario cargó en el formulario.
      if(hayPDFLocal && _pdfLocalPendiente){
        PDF_ACTUAL = _pdfLocalPendiente;
        try {
          await subirPDFSiCorresponde();
          showToast('✓ PDF subido al Drive de Operaciones y de la Comunidad','ok');
        } finally {
          // Dejar el estado limpio, como si cerrarModal() hubiera corrido
          // después del procesamiento.
          PDF_ACTUAL = null;
        }
        return;
      }

      // 3b) URL de Drive → renombrar + copiar a destinos
      if(hayPDFUrl){
        const centroAct = centroPorCodigo(codigoForm);
        const tieneOp  = centroAct && centroAct.driveOp;
        const tieneCom = centroAct && centroAct.driveCom;

        if(!tieneOp && !tieneCom){
          showToast('ℹ️ Sin Drive configurado en el centro — no se copió el PDF','');
          return;
        }

        const nombre = await nombreArchivoEstandar(numeroForm, codigoForm || 'sin-codigo', periodoForm, tipoForm);

        const renombrado = await _vincularPDFSeguro(numeroForm, idPDFActual, nombre);
        if(renombrado && renombrado.conflicto){
          // El modal ya avisó al usuario. No seguimos con la copia del PDF;
          // la factura ya quedó guardada y el usuario decidirá si reasignar.
          return;
        }
        if(!renombrado || !renombrado.ok){
          throw new Error((renombrado && renombrado.error) || 'No se pudo renombrar el PDF vinculado');
        }

        const res = await apiPost({
          accion: 'copiarPDFDriveADestinos',
          id: idPDFActual,
          codigoCliente: codigoForm,
          nombreArchivo: nombre
        });
        if(!res || !res.ok) throw new Error((res && res.error) || 'Error al copiar el PDF');

        if(res.archivos && res.archivos.length){
          await _vincularPDFSeguro(numeroForm, res.archivos[0].id, nombre);
        }

        const carpetas = (res.archivos||[]).map(a=>a.carpeta).join(' + ');
        if(!tieneCom){
          showToast('✓ PDF guardado en Operaciones (sin Drive de la Comunidad configurado)','ok');
        } else if(!tieneOp){
          showToast('✓ PDF guardado en el Drive de la Comunidad (sin Drive de Operaciones configurado)','ok');
        } else {
          showToast('✓ PDF guardado en '+carpetas,'ok');
        }
      }
    };

    // ───────────────────────────────────────────────────────
    //  4) DECIDIR FLUJO
    // ───────────────────────────────────────────────────────
    if(_CERRAR_MODAL_AL_GUARDAR){
      // ─── Rama "cerrar de inmediato, actualizar en background" ───
      //  1) Cerrar el modal ya.
      //  2) Disparar cargar() en segundo plano (refresca la tabla,
      //     sin bloquear al usuario).
      //  3) Disparar _procesarPDFs() en segundo plano. Los errores
      //     se reportan por toast, no por UI inline (el modal ya no
      //     está visible).
      cerrarModal();
      setStatus('✓ Factura guardada · actualizando…','ok');

      // Refresco de la tabla: sin await.
      Promise.resolve()
        .then(() => cargar())
        .catch(e => console.warn('[guardar] cargar() falló:', e));

      // Procesamiento de PDFs: sin await.
      _procesarPDFs()
        .then(() => {
          setStatus('✓ Factura guardada','ok');
          // Segunda pasada de cargar() por si el PDF vinculó un id
          // que la primera pasada no alcanzó a ver.
          Promise.resolve()
            .then(() => cargar())
            .catch(e => console.warn('[guardar] cargar() post-PDF falló:', e));
        })
        .catch(e => {
          showToast('⚠ PDF no se pudo procesar: ' + e.message, 'err');
          setStatus('Factura guardada · PDF con error','err');
        });

      // Devolvemos el control. El finally se ejecuta inmediatamente
      // (habilita el botón y NO espera a cargar).
      return;
    }

    // ─── Rama "modal sigue abierto" (debug) ───
    //  Espera los PDFs y muestra errores inline. Sólo activa si se
    //  llamó a _setCerrarModalAlGuardar(false) desde la consola.
    FACTURA_YA_GUARDADA_EN_BD = true;
    _actualizarBotonesFactura();
    setStatus('Procesando PDF...','');
    try {
      await _procesarPDFs();
      setStatus('✓ Factura guardada (modal sigue abierto)','ok');
    } catch(e){
      _msgWithCopy('formError',
        '⚠ <b>La factura se guardó, pero el PDF no se pudo procesar:</b><br>'+e.message+
        '<br><br>· Verifica el Drive del centro tocando <b>"Sin configurar. Click para establecerlo"</b>.<br>'+
        '· Luego presiona <b>Guardar</b> de nuevo para reintentar. '+
        '(La factura ya está en la base de datos; no se duplicará.)');
      err.classList.add('show');
      setStatus('Factura guardada · PDF con error','err');
    }
  } finally {
    if(btnGuardar) btnGuardar.disabled = false;
    // NOTA: ya NO se llama cargar() aquí. En la rama "cerrar al
    // guardar" (la normal) el refresco se dispara en background
    // antes del return; en la rama de debug, el modal sigue abierto
    // y el refresco ocurre cuando el usuario cierre el modal.
  }
}

async function marcarNA(){
  // ─── Caso 1: factura existente ───
  if(FACTURA_EDITANDO){
    if(!confirm('¿Marcar la factura ' + FACTURA_EDITANDO.numero + ' como N/A?')) return;

    const btn = document.getElementById('btnNA');
    if(btn) btn.disabled = true;

    // Snapshot + mutación optimista.
    const _numNA = String(FACTURA_EDITANDO.numero || '').trim();
    const _previasNA = FACTURAS
      .filter(f => String(f.numero || '').trim() === _numNA)
      .map(f => ({ ref: f, fConsumo: f.fechaConsumo, fPeaje: f.fechaPeaje }));

    _previasNA.forEach(({ref}) => {
      if(ref.tipo === 'SUMINISTRO' || ref.tipo === 'CONSUMO' || ref.tipo === 'UNIFICADA'){
        ref.fechaConsumo = 'N/A';
      }
      if(ref.tipo === 'PEAJE' || ref.tipo === 'UNIFICADA'){
        ref.fechaPeaje = 'N/A';
      }
    });

    cerrarModal();
    _renderVistaActiva();
    setStatus('Marcando factura ' + FACTURA_EDITANDO.numero + ' como N/A…','');

    try{
      const res = await apiPost({
        accion: 'actualizarFecha',
        numero: FACTURA_EDITANDO.numero,
        fecha: 'N/A',
        tipo: 'AMBAS'
      });
      if(!res.ok) throw new Error(res.error);
      showToast('✓ Factura marcada como N/A','ok');
      setStatus('✓ N/A aplicado','ok');

      setTimeout(() => {
        Promise.resolve()
          .then(() => cargar())
          .catch(e => console.warn('[N/A] cargar() falló:', e));
      }, 0);
    }catch(e){
      // Revertir las fechas.
      _previasNA.forEach(({ref, fConsumo, fPeaje}) => {
        ref.fechaConsumo = fConsumo;
        ref.fechaPeaje   = fPeaje;
      });
      _renderVistaActiva();
      showToast('Error: '+e.message,'err');
      setStatus('Error al marcar N/A','err');
    }
    return;
  }

  // ─── Caso 2: no hay factura (celda pendiente / por emitir) ───
  //  Se crea una fila sintética con fecha = 'N/A' para que la celda
  //  quede marcada como N/A sin necesidad de inventar una factura real.
  const _cli = _getClienteSeleccionado();
  const periodo = (document.getElementById('fPeriodo').value || '').trim();
  const tipo    = (document.getElementById('fTipo').value || 'CONSUMO').trim();

  if(!_cli.codigo){ showToast('Selecciona un centro de costo primero','err'); return; }
  if(!periodo){ showToast('Selecciona un período primero','err'); return; }

  // N° sintético único por (centro, período, tipo). Sirve para poder
  // identificar y eliminar la fila si luego se revierte la decisión.
  const numeroNA = 'N/A-' + _cli.codigo + '-' + periodo + '-' + tipo.charAt(0);

  const ok = confirm(
    '¿Marcar el período ' + formatPeriodo(periodo) + ' como N/A?\n\n' +
    '  Centro: ' + _cli.cliente + ' (' + _cli.codigo + ')\n' +
    '  Tipo:   ' + tipo + '\n\n' +
    'Se creará una fila N/A en la base de datos.'
  );
  if(!ok) return;

  const btn = document.getElementById('btnNA');
  if(btn) btn.disabled = true;

  // Alta optimista en el modelo local con la fila sintética N/A.
  const _datosNA = {
    numero: numeroNA,
    codigo: _cli.codigo,
    cliente: _cli.cliente,
    periodo: periodo,
    tipo: tipo,
    fecha: 'N/A',
    fechaEmision: '',
    fechaVencimiento: '',
    kwh: 0, sum: 0, peaje: 0,
    intereses: 0, intPeaje: 0, otros: 0, otrosPeaje: 0, total: 0
  };
  const _entradaNA = _normalizarFacturaParaModelo(_datosNA, null);
  FACTURAS.push(_entradaNA);

  cerrarModal();
  _renderVistaActiva();
  setStatus('Marcando período ' + formatPeriodo(periodo) + ' como N/A…','');

  try{
    const res = await apiPost({
      accion: 'agregarFactura',
      datos: _datosNA
    });
    if(!res || !res.ok) throw new Error((res && res.error) || 'Error al marcar N/A');
    showToast('✓ Período ' + formatPeriodo(periodo) + ' marcado como N/A','ok');
    setStatus('✓ Período marcado como N/A','ok');

    setTimeout(() => {
      Promise.resolve()
        .then(() => cargar())
        .catch(e => console.warn('[N/A] cargar() falló:', e));
    }, 0);
  }catch(e){
    // Revertir: quitar la entrada sintética.
    const _i = FACTURAS.findIndex(f =>
      String(f.numero || '').trim() === numeroNA
    );
    if(_i >= 0) FACTURAS.splice(_i, 1);
    _renderVistaActiva();
    setStatus('Error: '+e.message,'err');
    showToast('Error al marcar N/A: ' + e.message,'err');
  }
}

