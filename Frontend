/**
 * Busca una factura por N° y abre su modal de edición.
 * - Éxito: limpia el input y abre el modal.
 * - Sin match: limpia el input, cambia el placeholder a "No encontrada"
 *   en rojo (vía clase .no-encontrada) y devuelve el foco al input.
 */
function buscarFacturaPorNumero(){
  const inp = document.getElementById('inputBuscarFactura');
  if(!inp) return;

  const numero = String(inp.value || '').trim();
  if(!numero){
    inp.focus();
    return;
  }

  // Normaliza ceros a la izquierda para tolerar "0628" ≡ "628"
  const norm = s => String(s || '').trim().replace(/^0+/, '') || '0';
  const numNorm = norm(numero);

  const matches = FACTURAS.filter(f => norm(f.numero) === numNorm);

  if(!matches.length){
    inp.value = '';
    inp.classList.add('no-encontrada');
    inp.placeholder = 'No encontrada';
    inp.focus();
    return;
  }

  // Estado normal + limpiar input antes de abrir el modal
  inp.classList.remove('no-encontrada');
  inp.placeholder = 'Buscar';
  inp.value = '';

  const f = matches[0];
  const clave = claveCliente(f);
  abrirModalEditar(clave, f.periodo, f.tipo || 'CONSUMO', f);
}

/**
 * Si el input quedó en estado "No encontrada", al empezar a escribir
 * se restaura el placeholder original ("Buscar") y el color normal.
 */
function resetPlaceholderBusqueda(){
  const inp = document.getElementById('inputBuscarFactura');
  if(!inp) return;
  if(inp.classList.contains('no-encontrada')){
    inp.classList.remove('no-encontrada');
    inp.placeholder = 'Buscar';
  }
}

/**
 * Abre el modal "Seleccionar período" para un centro.
 * NO bloquea el hilo (reemplaza al viejo `prompt()`).
 * Al confirmar, delega en abrirModalAgregar / abrirModalEditar
 * según existan o no facturas para ese centro×período.
 */
let _SP_CLAVE_PENDIENTE = null;

function buscarFacturaCentro(clave){
  _SP_CLAVE_PENDIENTE = clave;

  const periodos = CONFIG.periodos.slice().sort().reverse();
  const sel = document.getElementById('spSelectPeriodo');
  sel.innerHTML = periodos.map(p =>
    '<option value="'+p+'">'+formatPeriodo(p)+'</option>'
  ).join('');

  document.getElementById('spTitulo').textContent = 'Seleccionar período';
  document.getElementById('spCentro').textContent = clave;
  const err = document.getElementById('spError');
  err.classList.remove('show'); err.textContent = '';

  document.getElementById('modalSeleccionPeriodo').classList.add('open');
}

function cerrarModalSeleccionPeriodo(){
  document.getElementById('modalSeleccionPeriodo').classList.remove('open');
  _SP_CLAVE_PENDIENTE = null;
}

function confirmarSeleccionPeriodo(){
  if(!_SP_CLAVE_PENDIENTE) return;
  const err = document.getElementById('spError');
  err.classList.remove('show'); err.textContent = '';

  const per = document.getElementById('spSelectPeriodo').value;
  if(!per){ err.textContent='Selecciona un período'; err.classList.add('show'); return; }

  const clave = _SP_CLAVE_PENDIENTE;
  cerrarModalSeleccionPeriodo();

  const matches = FACTURAS.filter(f =>
    claveCliente(f) === clave && f.periodo === per
  );
  if (!matches.length) {
    abrirModalAgregar(clave, per, 'CONSUMO');
  } else {
    abrirModalEditar(clave, per, matches[0].tipo || 'CONSUMO', matches[0]);
  }
}

async function configurarDriveMant(codigo, tipo){
  const centro = centroPorCodigo(codigo);
  if(!centro){ showToast('Centro no encontrado','err'); return; }
  const esOp = (tipo === 'op');
  const actual = esOp ? (centro.driveOp || '') : (centro.driveCom || '');
  const label  = esOp ? 'Drive de OPERACIONES' : 'Drive de la COMUNIDAD';

  const entrada = prompt(
    label + ' para "'+centro.cliente+'" ('+codigo+')' +
    (actual ? '\nActual: '+actual : '\n(Sin configurar)') +
    '\n\nPega la URL o el ID.' +
    '\n· Escribe "-" (guion) para borrarlo.' +
    '\n· Deja el mismo valor para no cambiarlo.',
    actual
  );
  if(entrada === null) return;
  const trim = String(entrada).trim();

  let nuevo = actual;
  if(trim === '-'){ nuevo = ''; }
  else if(trim && trim !== actual){
    const v = await apiPost({ accion:'verificarDrive', id: trim });
    if(!v || !v.ok){ showToast('ID/URL inválido · '+((v&&v.error)||'Error'),'err'); return; }
    nuevo = v.id;
    showToast('✓ '+label+': "'+v.nombre+'"','ok');
  }
  if(nuevo === actual) return;

  const nuevoOp  = esOp ? nuevo : (centro.driveOp  || '');
  const nuevoCom = esOp ? (centro.driveCom || '') : nuevo;

  try{
    centro.driveOp  = nuevoOp;
    centro.driveCom = nuevoCom;
    _driveLSGuardar(codigo, nuevoOp, nuevoCom);
    const res = await apiPost({ accion:'guardarDriveConfig', codigo, driveOp:nuevoOp, driveCom:nuevoCom });
    if(!res || !res.ok) throw new Error((res&&res.error)||'Error al guardar');
    showToast('✓ '+(esOp?'Drive Operaciones':'Drive Comunidad')+' actualizado','ok');
    renderCentros();
  }catch(e){
    showToast('Error al guardar Drive: '+e.message,'err');
  }
}

async function actualizarNombreCentro(codigo, nuevo){
  const centro = centroPorCodigo(codigo);
  if(!centro) return;
  const n = String(nuevo||'').trim();
  if(!n){ showToast('El nombre no puede quedar vacío','err'); renderCentros(); return; }
  if(n === (centro.cliente||'')) return;
  try{
    const res = await apiPost({ accion:'actualizarInfoCentro', codigo, cambios:{ cliente: n } });
    if(!res || !res.ok) throw new Error((res&&res.error)||'Error');
    centro.cliente = n;
    showToast('✓ Nombre actualizado','ok');
  }catch(e){
    showToast('Error al actualizar nombre: '+e.message,'err');
  }
}

async function actualizarRutCentroMant(codigo, nuevo){
  const centro = centroPorCodigo(codigo);
