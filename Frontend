    .chart-card h3 {
      font-size: .9rem;
      font-weight: 600;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 8px
    }

    .chart-card h3::before {
      content: '';
      width: 4px;
      height: 14px;
      background: var(--accent);
      border-radius: 2px
    }

    .chart-card.wide {
      grid-column: 1/-1
    }

    .chart-card .chart-sub {
      font-size: .7rem;
      color: var(--text-dim);
      font-weight: 400;
      margin-left: auto
    }

    .chart-wrap {
      position: relative;
      height: 280px
    }

    .chart-wrap-sm {
      position: relative;
      height: 220px
    }

    footer.site-footer {
      max-width: 1800px;
      margin: 40px auto 0;
      padding: 24px 20px;
      border-top: 1px solid var(--border);
      text-align: center;
      color: var(--text-dim);
      font-size: .72rem;
      line-height: 1.7
    }

    footer.site-footer .badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      background: rgba(59, 130, 246, .10);
      color: var(--accent);
      border: 1px solid rgba(59, 130, 246, .30);
      font-weight: 600;
      margin-bottom: 8px;
      letter-spacing: .3px
    }

    body.light footer.site-footer .badge {
      background: rgba(59, 130, 246, .08);
      color: #1d4ed8
    }

    /* ─── Modal del Manual de Usuario ───
       El modal tiene altura fija (92vh) y el body del modal no
       aporta padding: el iframe ocupa todo el espacio disponible.
       Esto garantiza que el manual se vea como una ventana completa
       dentro del modal, sin scroll doble. */
    #modalManual .modal-body {
      padding: 0 !important;
      overflow: hidden;
      height: 100%;
      min-height: 0;
    }
    #modalManual .modal-box {
      height: 92vh;
    }
    #modalManual #iframeManual {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
    }
  </style>
</head>

<body>

  <div class="container">
    <header>
      <div>
        <h1 id="tituloPrincipal"><span class="h1-emoji">📊</span>Dashboard Comparativo</h1>
        <div class="subtitle" id="subtituloPrincipal">Análisis histórico y comparativo entre comunidades.
        </div>
      </div>
      <div class="header-actions">
        <div class="acciones-vista" id="accionesKPI" style="display:none"></div>

        <!-- ─── Filter bar compartida por las 3 vistas ───
             Los selects viven sueltos, sin marco contenedor. Sus
             valores son compartidos: cualquier vista los lee al
             renderizar. Se resetea dashMetrica al entrar/salir del
             Dashboard. -->
        <div class="filter-bar" id="filterBar">

          <!-- 📊 Métrica: exclusiva del Dashboard. Su visibilidad la
               controla _aplicarVisibilidadFiltros() según VISTA. -->
          <select id="dashMetrica" onchange="aplicarFiltros()">
            <option value="total">📊 Total facturado</option>
            <option value="sum">📊 Suministro</option>
            <option value="peaje">📊 Peaje</option>
            <option value="intereses">📊 Solo intereses</option>
          </select>

          <button class="btn-sm" id="btnVolverDashboard" onclick="volverAlDashboardDesdeFiltros()" style="display:none" title="Volver al Dashboard y limpiar los filtros de centro y mes">← Volver al Dashboard</button>
          <select id="filtroCentro" onchange="aplicarFiltros()">
            <option value="todos">🏢 Todos los centros</option>
          </select>
          <select id="filtroMes" onchange="aplicarFiltros()">
            <option value="todos">📅 Todos los meses</option>
            <option value="ult3">⏱ Últimos 3 meses</option>
            <option value="ult6">⏱ Últimos 6 meses</option>
            <option value="ult12">⏱ Últimos 12 meses</option>
          </select>

          <!-- ⚠️ BOTONES CSV — OCULTOS TEMPORALMENTE
               Para reactivarlos: descomentar los 2 <button> de abajo
               y las 2 líneas correspondientes en
               _aplicarVisibilidadFiltros(). -->
          <!--
          <button class="btn-sm" id="btnExportCSV" onclick="exportarCSV()" title="Exportar CSV">⬇️ CSV</button>
          <button class="btn-sm" id="btnImportCSV" onclick="document.getElementById('fileImport').click()" title="Importar CSV">⬆️ CSV</button>
          -->
        </div>

        <button id="btnTheme" onclick="toggleTheme()">🌙 Ver modo oscuro</button>
        <button id="btnVerDashboard" onclick="irADashboard()" style="display:none">📊 Dashboard</button>
        <button id="btnVerDetalle" onclick="irADetalle()">📋 Detalle</button>
        <button id="btnVerSeguimiento" onclick="irASeguimiento()">📊 Seguimiento</button>
      </div>
    </header>

    <div class="status-row">
      <div id="status">Cargando datos...</div>
      <div class="status-actions">
        <div class="buscador-factura">
          <input id="inputBuscarFactura" type="text" placeholder="Buscar" autocomplete="off"
                 onkeydown="if(event.key==='Enter'){event.preventDefault();buscarFacturaPorNumero();}"
                 oninput="resetPlaceholderBusqueda()">
          <button type="button" class="btn-buscar-factura" title="Buscar factura" onclick="buscarFacturaPorNumero()">🔍</button>
        </div>

        <button class="btn-sm" onclick="document.getElementById('fileExterno').click()">📄 Cargar PDF</button>
        <button class="btn-sm" id="btnCargarDriveUrl" onclick="cargarPDFDesdeURLExterno()">🔗 Cargar desde Drive (URL)</button>
        <button class="btn-sm" onclick="abrirModalCentros()">🏢 Centros de costo</button>
        <button class="btn-sm" onclick="abrirManual()" title="Abrir el manual de usuario">📘 Manual</button>
      </div>
      <input type="file" id="fileImport" accept=".csv,.txt" style="display:none" onchange="importarCSV(event)">
      <input type="file" id="fileExterno" accept=".pdf,application/pdf" style="display:none" onchange="cargarPDFExterno(event)">
    </div>

    <!-- Bloque de tarjetas KPI compartido por las 3 vistas.
         Se ubica fuera de los contenedores #view... para que
         permanezca visible en Seguimiento, Detalle y Dashboard. -->
    <div class="kpis" id="kpis"></div>

    <div id="viewKPI" style="display:none">

      <div id="filtroFueraPlazoBanner" class="filtro-fuera-plazo-banner" style="display:none">
        <span class="fb-icon" id="fbIcono">⏱</span>
        <span class="fb-text" id="fbTexto">Mostrando sólo facturas filtradas</span>
        <button type="button" class="fb-close" onclick="_quitarFiltroRapido()" title="Quitar el filtro y volver a la vista completa">✕ Quitar filtro</button>
      </div>

      <div class="grid">
        <div class="card">
          <div class="card-head" onclick="toggleTabla('wrapConsumo', this)" title="Click para colapsar / expandir">
            <h2><span class="dot"></span> Suministro <span class="chev">▼</span></h2>
            <span class="count" id="countConsumo">—</span>
          </div>
          <div class="scroll" id="wrapConsumo">
            <div class="loading">Cargando...</div>
          </div>
          <div class="legend">
            <span><span class="sw recibida"></span> Recibida</span>
            <span><span class="sw plazo"></span> En plazo</span>
            <span><span class="sw pendiente"></span> Pendiente</span>
            <span><span class="sw por-emitir"></span> Por Emitir</span>
            <span><span class="sw si"></span> S/I</span>
            <span><span class="sw na"></span> N/A</span>
          </div>
        </div>
        <div class="card">
          <div class="card-head" onclick="toggleTabla('wrapPeaje', this)" title="Click para colapsar / expandir">
            <h2><span class="dot blue"></span> Peaje <span class="chev">▼</span></h2>
            <span class="count" id="countPeaje">—</span>
          </div>
          <div class="scroll" id="wrapPeaje">
            <div class="loading">Cargando...</div>
          </div>
          <div class="legend">
            <span><span class="sw recibida"></span> Recibida</span>
            <span><span class="sw plazo"></span> En plazo</span>
            <span><span class="sw pendiente"></span> Pendiente</span>
            <span><span class="sw por-emitir"></span> Por Emitir</span>
            <span><span class="sw si"></span> S/I</span>
            <span><span class="sw na"></span> N/A</span>
          </div>
        </div>
        <div class="card">
          <div class="card-head" onclick="toggleTabla('wrapArriendo', this)" title="Click para colapsar / expandir">
            <h2><span class="dot gray"></span> Arriendo de medidor <span class="chev">▼</span></h2>
            <span class="count" id="countArriendo">—</span>
          </div>
          <div class="scroll" id="wrapArriendo">
            <div class="loading">Cargando...</div>
          </div>
          <div class="legend">
            <span><span class="sw recibida"></span> Recibida</span>
            <span style="color:var(--text-dim);">— Sin factura (no aplica)</span>
          </div>
        </div>
      </div>
    </div>

    <div id="viewDetalle" style="display:none">
      <div class="filtros-detalle">
        <label><input type="checkbox" id="chkDesfase" onchange="renderResumen()"> Solo recibidas con desfase</label>
        <label><input type="checkbox" id="chkDesfase10" onchange="renderResumen()"> &gt;10 días de desfase</label>
        <label><input type="checkbox" id="chkIntereses" onchange="renderResumen()"> Solo con intereses</label>
        <label><input type="checkbox" id="chkSI" onchange="renderResumen()"> Solo S/I</label>
        <label><input type="checkbox" id="chkSinFecha" onchange="renderResumen()" checked> Mostrar sólo sin fecha de recibido</label>
        <label><input type="checkbox" id="chkVacios" onchange="renderResumen()" checked title="Oculta las filas de meses en los que no hay ninguna factura registrada para el centro"> Ocultar meses no informados</label>
        <label>Ver:
        <select id="filtroTipoDetalle" onchange="renderResumen()">
          <option value="todo">Todo</option>
          <option value="UNIFICADA">Unificadas</option>
          <option value="SUMINISTRO">Suministro</option>
          <option value="PEAJE">Peaje</option>
          <option value="ARRIENDO_MEDIDOR">Arriendo medidor</option>
        </select>
      </label>
      </div>
      <div class="card" style="overflow:hidden;">
        <div class="scroll" style="max-height:calc(100vh - 260px);overflow:auto;">
          <table class="summary-table">
            <thead>
              <tr>
                <th title="N° de Factura">N°</th>
                <th title="Código del Cliente">Cód. Cli.</th>
                <th title="Centro de costo">Centro de costo</th>
                <th title="Período de la factura">Período</th>
                <th title="Tipo de factura">Tipo</th>
                <th title="Fecha de Emisión">F. Emi.</th>
                <th title="Fecha de Vencimiento">F. Ven.</th>
                <th title="Fecha de Recepción del Suministro">Rec. Sum.</th>
                <th title="Fecha de Recepción del Peaje">Rec. Peaje</th>
                <th class="num" title="Días entre emisión y recepción">Desfase</th>
                <th class="num" title="Consumo en kWh">kWh</th>
                <th class="num" title="Suministro Neto (Afecto + Exento)">Sum. Neto</th>
                <th class="num" title="Peaje Neto">Peaje</th>
                <th class="num" title="Intereses por Suministro">Int. Sum.</th>
                <th class="num" title="Intereses por Peaje">Int. Peaje</th>
                <th class="num" title="Otros Cobros (Suministro)">Otros</th>
                <th class="num" title="Otros Cobros (Peaje)">Otros Peaje</th>
                <th class="num" title="Total facturado">Total</th>
                <th title="Estado de recepción">Estado</th>
              </tr>
            </thead>
            <tbody id="tablaResumenBody"></tbody>
          </table>
        </div>
      </div>
    </div>

    <div id="viewDashboard">
      <div class="dash-grid">
        <!-- Fila 1: Evolución (2/3) + Estado (1/3), proporción 2:1 -->
        <div class="chart-card" style="grid-column: span 2;">
          <h3 id="tituloTendencia">Evolución mensual</h3>
          <div class="chart-wrap"><canvas id="chartTendencia"></canvas></div>
        </div>

        <div class="chart-card">
          <h3 id="tituloEstadoMes" style="cursor:pointer;"
            title="Click en el título para ver en Seguimiento. Click en una barra para ver ese mes en Seguimiento.">
            Estado de recepción por mes
            <span class="chart-sub" style="font-style:italic;opacity:.7;">(Click en el mes para ver en el seguimiento.)</span>
          </h3>
          <div class="chart-wrap"><canvas id="chartEstado"></canvas></div>
        </div>

        <!-- Fila 2: Ranking comunidad | Ranking consumo | Distribución -->
        <div class="chart-card" id="cardRankingCentro">
          <h3 id="tituloRanking">Ranking por centro de costo
            <span class="chart-sub" id="subtituloRanking">promedio mensual</span>
          </h3>
          <div class="chart-wrap" id="wrapRankingCentro"><canvas id="chartRanking"></canvas></div>
        </div>

        <div class="chart-card" id="cardRankingKwh">
          <h3 id="tituloRankingKwh">Ranking por consumo
            <span class="chart-sub" id="subtituloRankingKwh">MWh totales</span>
          </h3>
          <div class="chart-wrap" id="wrapRankingKwh"><canvas id="chartRankingKwh"></canvas></div>
        </div>

        <div class="chart-card">
          <h3>Distribución por concepto <span class="chart-sub">% del total mensual</span></h3>
          <div class="chart-wrap"><canvas id="chartConcepto"></canvas></div>

          <h3 style="margin-top:18px;padding-top:14px;border-top:1px solid var(--border);">
            Totales consolidados <span class="chart-sub"></span>
          </h3>
          <div class="chart-wrap"><canvas id="chartConceptoTotal"></canvas></div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL ÚNICO: AGREGAR/EDITAR FACTURA -->
  <div class="modal" id="modalAgregar">
    <div class="modal-box">
      <div class="modal-head">
        <h3 id="modalAgregarTitulo">Agregar factura</h3>
        <button class="close" onclick="cerrarModal()">✕</button>
      </div>
      <div class="modal-body">
        <div class="modal-body-flex">
          <div class="modal-col-form">
            <div class="form-grid">
              <input id="fCodigo" type="hidden">

              <!-- Fila 1: Centro de costo (ancho) + RUT (angosto) -->
              <div class="full" style="display:grid;grid-template-columns:2fr 1fr;gap:14px;">
                <div><label>Centro de costo</label><select id="fCliente"></select></div>
                <div><label>RUT</label><input id="fRut" readonly placeholder="—"></div>
              </div>

              <!-- Fila 2: Tipo | Factura | Período (3 columnas) -->
              <div class="full" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;">
                <div><label>Tipo de factura *</label>
                  <select id="fTipo">
                    <option value="">— Selecciona tipo —</option>
                    <option value="SUMINISTRO">Suministro</option>
                    <option value="PEAJE">Peaje</option>
                    <option value="UNIFICADA">Unificada (Suministro + Peaje)</option>
                    <option value="ARRIENDO_MEDIDOR">Arriendo medidor</option>
                  </select>
                </div>
                <div><label>N° Factura *</label><input id="fNumero" type="text" autocomplete="off"></div>
                <div><label>Período</label><select id="fPeriodo"></select></div>
              </div>

              <!-- Fila 3: Fechas (3 columnas) -->
              <div class="full" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;">
                <div><label>Fecha recepción *</label><input id="fFecha" type="date"></div>
                <div><label>Fecha emisión *</label><input id="fEmision" type="date"></div>
                <div><label>Fecha vencimiento</label><input id="fVencimiento" type="date"></div>
              </div>

              <!-- Fila 4: Total factura + kWh -->
              <div><label>Total factura</label><input id="fTotal" type="text" inputmode="decimal" autocomplete="off">
              </div>
              <div><label>kWh</label><input id="fKwh" type="text" inputmode="decimal" autocomplete="off"></div>

              <!-- Fila 5: Montos -->
              <div><label>Suministro Neto (Afecto + Exento)</label><input id="fSum" type="text" inputmode="decimal" autocomplete="off">
              </div>
              <div><label>Peaje Neto</label><input id="fPeaje" type="text" inputmode="decimal" autocomplete="off"></div>
              <div><label>Intereses (Suministro)</label><input id="fInt" type="text" inputmode="decimal" autocomplete="off">
              </div>
              <div><label>Intereses (Peaje)</label><input id="fIntPeaje" type="text" inputmode="decimal" autocomplete="off">
              </div>
              <div><label>Otros Cobros (Suministro)</label><input id="fOtros" type="text" inputmode="decimal" autocomplete="off">
              </div>
              <div><label>Otros Cobros (Peaje)</label><input id="fOtrosPeaje" type="text" inputmode="decimal" autocomplete="off">
              </div>

              <div class="full">
                <!-- ─── 2 columnas: PDF local | PDF Drive ─── -->
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">

                  <!-- Columna izquierda: PDF local -->
                  <div>
                    <label>PDF local</label>
                    <input id="fPDF" type="file" accept=".pdf,application/pdf">
                  </div>

                  <!-- Columna derecha: PDF Drive -->
                  <div>
                    <label>PDF Drive</label>
                    <div style="display:flex;gap:8px;align-items:center;flex-wrap:nowrap;">
                      <input id="fPDFDriveUrl" type="text" placeholder="ID de Drive" style="flex:1;min-width:0;">
                      <button type="button" id="btnVincularPDFDrive" onclick="vincularPDFAFactura()" class="btn-sm" style="flex-shrink:0;">🔗 Vincular</button>
                    </div>
                    <div id="fPDFDriveActions" style="display:none;"></div>
                  </div>
                </div>

                <!-- ─── Textos fijos de ayuda + dinámicos (debajo de las 2 columnas) ─── -->
                <div style="font-size:.7rem;color:var(--text-dim);margin-top:6px;line-height:1.5;">
                  📌 Al <b>Guardar</b>, el PDF se copia al repositorio de <b>Operaciones</b> y de la <b>Comunidad</b>
                  del centro.<br>
                  ⚠️ Si el OCR no está disponible (por cuota, por ejemplo), completa los campos manualmente.<br>
                  🔗 <b>Vincular</b>: asocia el PDF en la BD y renombra el archivo según plantilla
                  (<code>Período_Código_N°Factura_Tipo_CentroDeCosto.pdf</code>).
                </div>
                <div id="pdfInfo" class="form-info"></div>
                <div id="pdfWarn" class="form-warn"></div>
              </div>

              <div class="full">
                <label>Drive del centro de costo</label>
                <div class="drive-info" id="driveCentroInfo">
                  <div>🔧 Drive Operaciones: <span class="id" id="driveCentroOp">—</span></div>
                  <div>🏢 Drive Comunidad: <span class="id" id="driveCentroCom">—</span></div>
                </div>
                <!-- Configuración por click en el texto "Sin configurar" -->
                <div style="font-size:.7rem;color:var(--text-dim);margin-top:4px;line-height:1.5;">
                  Cada centro tiene un repositorio en el <b>Drive de Operaciones</b> y otro en el
                  <b>Drive de la Comunidad</b>.
                  Se debe dejar una copia en <b>ambos</b> repositorios. Al cargar la factura en PDF —ya sea usando un archivo local o desde drive— se hace automáticamente.
                </div>
              </div>
            </div>
            <div class="form-warn" id="pdfDiff"></div>
            <div class="form-error" id="formError"></div>
          </div><!-- /modal-col-form -->
          <div class="modal-col-preview" id="previewPanel" style="display:none">
            <div class="preview-head">
              <span>📄 Vista previa del PDF</span>
              <button type="button" onclick="cerrarPreview()" title="Ocultar vista previa">✕</button>
            </div>
            <iframe id="previewFrame" src="about:blank" referrerpolicy="no-referrer"></iframe>
            <div id="previewCanvasWrap" style="display:none">
              <canvas id="previewCanvas"></canvas>
            </div>
          </div>
        </div><!-- /modal-body-flex -->
      </div>
      <div class="modal-foot">
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button id="btnNA" class="btn-na" onclick="marcarNA()" title="Marcar la factura como N/A (no corresponde emitir)">⊘ N/A</button>
          <button id="btnRectificar" class="btn-na" onclick="abrirModalRectificar()" title="Permite modificar el centro de costo y el período precargados de una factura mal asignada. Se actualizarán todas las filas con el mismo N° de factura.">✏️ Rectificar Centro/Mes</button>
          <button id="btnEliminar" class="btn-na" onclick="eliminarFactura()" title="Eliminar definitivamente la factura de la base de datos" style="color:#f87171;border-color:#f87171;">🗑️ Eliminar</button>
        </div>
        <div class="right">
          <button onclick="cerrarModal()">Cancelar</button>
          <button type="button" onclick="limpiar()" title="Limpia los campos transaccionales. Conserva URL, Centro, RUT, N° Factura, Período y Fecha de recepción.">🧹 Limpiar</button>
          <button type="button" id="btnExtraerOCR" onclick="extraerDatosOCR()" title="Extrae datos del PDF cargado (local o desde URL de Drive)">🔍 Extraer datos OCR</button>
          <button type="button" id="btnActualizarOCR" onclick="actualizarTodoDesdeOCR()" style="background:#10b981;border-color:#10b981;color:#fff;" title="Limpia los campos y carga los datos del OCR. NO guarda: revisa y presiona Guardar.">🔄 Actualizar desde OCR</button>
          <button class="primary" id="btnGuardarFactura" onclick="guardarFactura()">💾 Guardar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL: RECTIFICAR INFO PRECARGADA -->
  <div class="modal" id="modalRectificar">
    <div class="modal-box" style="max-width:520px;">
      <div class="modal-head">
        <h3>Rectificar Centro/Mes</h3>
        <button class="close" onclick="cerrarModalRectificar()">✕</button>
      </div>
      <div class="modal-body">
        <div
          style="background:rgba(59,130,246,.08);border:1px solid rgba(59,130,246,.25);border-radius:8px;padding:12px 14px;font-size:.8rem;margin-bottom:18px;line-height:1.7;">
          <div><b>Factura:</b> <span id="rcFacturaNum">—</span> · <span id="rcFacturaTipo">—</span></div>
          <div><b>Centro actual:</b> <span id="rcFacturaClienteAct">—</span></div>
          <div><b>Período actual:</b> <span id="rcFacturaPeriodoAct">—</span></div>
        </div>
        <div class="form-grid">
          <div class="full">
            <label>Centro de costo</label>
            <select id="rcSelectCentro"></select>
          </div>
          <div class="full">
            <label>Período</label>
            <select id="rcSelectPeriodo"></select>
          </div>
        </div>
        <div style="font-size:.72rem;color:var(--text-dim);margin-top:12px;line-height:1.6;">
          ℹ️ El N° de factura es único. Se actualizarán <b>todas las filas</b> con este número.
        </div>
        <div class="form-error" id="rcError"></div>
      </div>
      <div class="modal-foot">
        <div></div>
        <div class="right">
          <button onclick="cerrarModalRectificar()">Cancelar</button>
          <button class="primary" id="rcBtnConfirmar" onclick="confirmarRectificar()">Guardar cambios</button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL: AGREGAR MES -->
