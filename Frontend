 * el usuario vea el cambio al instante, sin esperar al backend.
 *
 * No altera filtros, VISTA, ni estado de toasts/modales.
 */
function _renderVistaActiva(){
  try{
    if(VISTA === 'DASHBOARD'){
      renderKPIs();
      renderDashboard();
    } else if(VISTA === 'DETALLE'){
      renderKPIs();
      renderResumen();
    } else {
