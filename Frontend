// ============================================================
//  MANUAL DE USUARIO — popup HTML
// ============================================================
//  El botón "📘 Manual" abre SIEMPRE el manual en formato HTML
//  dentro de una ventana emergente del navegador.
//
//  El HTML del manual se sirve desde Apps Script
//  (obtenerHTMLManual() en Code.gs) como string y se inyecta con
//  document.write() en la ventana hija.
//
//  El HTML del manual trae su propio toggle de tema claro/oscuro
//  y su propio índice; no depende del frontend para nada más que
//  el texto HTML inicial.
//
//  Se cachea el HTML para que abrir el manual varias veces no
//  vuelva a pedirlo al backend.
let _MANUAL_HTML_CACHE = null;

/**
 * Abre el manual de usuario en un popup HTML.
 * Se invoca desde el botón "📘 Manual" de la barra de acciones.
 */
async function abrirManual(){
  // ─── Si ya tenemos el HTML cacheado, abrir el popup directo ───
  if(_MANUAL_HTML_CACHE){
    _abrirPopupManual(_MANUAL_HTML_CACHE);
    return;
  }

  // ─── Primera vez: pedir el HTML al backend ───
  setStatus('Cargando manual…', '');
  try {
    const html = await new Promise((res, rej) => {
      google.script.run
        .withSuccessHandler(res)
        .withFailureHandler(rej)
        .obtenerHTMLManual();
    });

    if(!html || typeof html !== 'string'){
      throw new Error('El backend no devolvió el HTML del manual.');
    }

    _MANUAL_HTML_CACHE = html;
    setStatus('', '');
    _abrirPopupManual(html);

  } catch(e){
    setStatus('Error al cargar el manual', 'err');
    showToast('No se pudo cargar el manual: ' + e.message, 'err');
  }
}

/**
 * Abre el HTML del manual en una ventana emergente del navegador.
 * Dimensiona la ventana al 90% del viewport y la centra.
 * Si el navegador bloquea el popup, muestra un toast de aviso.
 *
 * @param {string} html  HTML completo del manual (con <!DOCTYPE html>).
 */
function _abrirPopupManual(html){
  const w = Math.min(1400, Math.round(screen.width  * 0.9));
  const h = Math.min(1000, Math.round(screen.height * 0.9));
  const left = Math.max(0, Math.round((screen.width  - w) / 2));
  const top  = Math.max(0, Math.round((screen.height - h) / 2));

  const win = window.open(
    '',
    'ManualFacturacion',
    'width='  + w +
    ',height=' + h +
    ',left='   + left +
    ',top='    + top +
    ',menubar=no,toolbar=no,location=no,status=no,resizable=yes,scrollbars=yes'
  );

  if(!win){
    showToast('El navegador bloqueó la ventana. Permite las ventanas emergentes para este sitio.', 'err');
    return;
  }

  // Inyectar el HTML completo del manual en la ventana hija.
  win.document.open();
  win.document.write(html);
  win.document.close();
}

// ============================================================
//  Números: parser chileno y formato con coma
// ============================================================
function inputANumero(v){
  if(v==null) return 0;
  if(typeof v === 'number') return isFinite(v) ? v : 0;
  let s = String(v).trim();
  if(!s) return 0;
  s = s.replace(/[\$\s]/g,'');
  if(!s) return 0;

  const gruposPuntos = (s.match(/\.\d{3}(?!\d)/g) || []).length;
  if(gruposPuntos >= 3) return 0;

  if(s.includes(',')){
    s = s.replace(/\./g,'').replace(',','.');
  } else if(s.includes('.')){
    if(/^\d{1,3}(\.\d{3})+$/.test(s)) s = s.replace(/\./g,'');
  }
  const n = Number(s);
  return isFinite(n) ? n : 0;
}
function numeroAInput(n){
  if(n==null || n==='') return '';
  const num = Number(n);
  if(!isFinite(num) || num === 0) return '';
  const s = String(num);
  const idx = s.indexOf('.');
  let entero, decimal;
  if(idx === -1){ entero = s; decimal = ''; }
  else { entero = s.slice(0, idx); decimal = s.slice(idx + 1); }
  entero = entero.replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  return decimal ? entero + ',' + decimal : entero;
}

// ============================================================
//  Detector de basura (espejo del backend)
// ============================================================
function _esTextoBasuraFront(txt){
  if(!txt) return true;
  const s = String(txt);
  const palabras = s.match(/[A-Za-zÁÉÍÓÚÑáéíóúñ]{3,}/g) || [];
  if(palabras.length < 8) return true;
  const unos = (s.match(/(?:^|\s)1(?:\s|$)/g) || []).length;
  if(unos > 30) return true;
  const tokens = s.split(/\s+/).filter(Boolean);
  if (tokens.length > 50) {
    const unosTokens = tokens.filter(t => t === '1').length;
    if (unosTokens / tokens.length > 0.5) return true;
  }
  const rareza = (s.match(/[¢£¤¥¦§¨©ª«¬®¯°±²³´µ¶·¸¹º»¼½¾¿]/g) || []).length;
  if(rareza > 15) return true;
  return false;
}

// ============================================================
//  Nombre de archivo estándar
// ============================================================
function etiquetaTipoParaArchivo(tipo){
  const t = String(tipo||'').toUpperCase();
  if(t === 'CONSUMO' || t === 'SUMINISTRO') return 'Suministro';
  if(t === 'PEAJE') return 'Peaje';
  if(t === 'UNIFICADA') return 'Unificada';
  if(t === 'ARRIENDO_MEDIDOR') return 'ArriendoMedidor';
  return tipo || 'X';
}

/**
 * Pide al backend el nombre estándar. El backend es la fuente única de
 * verdad; el frontend no re-implementa el algoritmo.
 *
 * @returns {Promise<string>} nombre del archivo (con extensión .pdf)
 */
async function nombreArchivoEstandar(numero, codigo, periodo, tipo){
  try{
    const res = await apiPost({
      accion: 'construirNombreArchivo',
      datos: { numero, codigo, periodo, tipo }
    });
    // El backend puede devolver {ok:true, nombre:"..."} o el string
    // directo (según versión del bridge). Aceptamos ambos formatos.
    if (typeof res === 'string' && res.trim()) return res.trim();
    if (res && res.ok && res.nombre) return res.nombre;
    if (res && res.nombre) return res.nombre;
  }catch(e){
    console.warn('nombreArchivoEstandar falló, usando fallback local:', e);
  }
  // Fallback local: resolvemos el nombre del centro desde CONFIG
  // (que ya está cargado en el frontend) para no perder información.
  const n = String(numero||'').trim() || 'sin-numero';
  const c = String(codigo||'').trim() || 'sin-codigo';
  const p = String(periodo||'').trim() || 'sin-periodo';
  const t = etiquetaTipoParaArchivo(tipo);
  const centro = CONFIG.centros.find(x => String(x.codigo||'').trim() === c);
  const centroNombre = centro ? String(centro.cliente||'').trim() : '';
  const centroSafe = centroNombre
    ? centroNombre.replace(/[\/\\:*?"<>|]/g, '-')
    : 'sin-centro';
  return p + '_' + c + '_' + n + '_' + centroSafe + '_' + t + '.pdf';
}

function centroPorCodigo(codigo){
  return CONFIG.centros.find(c => c.codigo === String(codigo||'').trim()) || null;
}

