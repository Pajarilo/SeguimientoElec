function actualizarFecha(numero, fecha, tipo) {
  const sh = SpreadsheetApp.openById(SS_ID).getSheetByName(HOJA_RESUMEN);
  const data = sh.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][COL.NUMERO - 1]).trim() === String(numero).trim()) {
      const tipoFactura = String(data[i][COL.TIPO - 1] || '').toUpperCase();
      let cols = [];
      if (tipoFactura === 'UNIFICADA') {
        cols = [COL.FECHA_SUMINISTRO, COL.FECHA_PEAJE];
      } else if (tipoFactura === 'SUMINISTRO' || tipoFactura === 'CONSUMO') cols = [COL.FECHA_SUMINISTRO];
      else if (tipoFactura === 'PEAJE' || tipoFactura === 'ARRIENDO_MEDIDOR') cols = [COL.FECHA_PEAJE];
      else {
        if (Number(data[i][COL.SUM - 1]) > 0) cols.push(COL.FECHA_SUMINISTRO);
        if (Number(data[i][COL.PEAJE - 1]) > 0) cols.push(COL.FECHA_PEAJE);
      }
      cols.forEach(function (col) {
        const c = sh.getRange(i + 1, col);
        if (SENTINELAS.indexOf(fecha) !== -1) {
          c.setNumberFormat('@');
          c.setValue(fecha);
        } else if (fecha) {
          const p = fecha.split('-').map(Number);
          c.setNumberFormat('dd/mm/yyyy');
          c.setValue(new Date(p[0], p[1] - 1, p[2]));
        } else {
          c.setValue('');
        }
      });
      refrescarSeguimiento();
      return { ok: true, numero: numero, fecha: fecha, tipo: tipoFactura };
    }
  }
  return { ok: false, error: 'Factura no encontrada: ' + numero };
}

function actualizarCampo(numeroOrig, tipoOrig, periodo, campo, valor) {
  const ss = SpreadsheetApp.openById(SS_ID);
  const sh = ss.getSheetByName(HOJA_RESUMEN);
  const data = sh.getDataRange().getValues();
  const mapa = {
    'numero': COL.NUMERO, 'tipo': COL.TIPO,
    'fechaConsumo': COL.FECHA_SUMINISTRO, 'fechaPeaje': COL.FECHA_PEAJE,
    'fechaEmision': COL.FECHA_EMISION, 'fechaVencimiento': COL.FECHA_VENC,
    'kwh': COL.KWH, 'sum': COL.SUM, 'peaje': COL.PEAJE,
    'intereses': COL.INT, 'total': COL.TOTAL,
    'intPeaje': COL.INT_PEAJE
  };
  const col = mapa[campo];
  if (!col) return { ok: false, error: 'Campo no permitido: ' + campo };
  for (let i = 1; i < data.length; i++) {
    const n = String(data[i][COL.NUMERO - 1]).trim();
    if (n === String(numeroOrig).trim()) {
      const celda = sh.getRange(i + 1, col);
      if (campo.indexOf('fecha') === 0) {
        if (SENTINELAS.indexOf(valor) !== -1) {
          celda.setNumberFormat('@');
          celda.setValue(valor);
        } else if (valor) {
          const pp = String(valor).split('-').map(Number);
          celda.setNumberFormat('dd/mm/yyyy');
          celda.setValue(new Date(pp[0], pp[1] - 1, pp[2]));
        } else {
          celda.setValue('');
        }
      } else if (campo === 'numero') celda.setValue(String(valor || '').trim());
      else if (campo === 'tipo') celda.setValue(String(valor || '').trim().toUpperCase());
      else {
        let num = valor;
        if (typeof valor === 'string') {
          let s = valor.replace(/[\$\s]/g, '');
          if (s.includes(',')) s = s.replace(/\./g, '').replace(',', '.');
          else if (/^\d{1,3}(\.\d{3})+$/.test(s)) s = s.replace(/\./g, '');
          num = Number(s);
        }
        celda.setValue(Number(num) || 0);
      }
      refrescarSeguimiento();
      return { ok: true };
    }
  }
  return { ok: false, error: 'Factura no encontrada' };
}

