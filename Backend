function procesarCarpetaTransicion(opciones) {
  opciones = opciones || {};
  const cfg = leerConfig();
  const fantasma = cfg.centros.find(c => _esCentroFantasmaBack(c.codigo, c.cliente));
  if (!fantasma) return { ok: false, error: 'No hay centro "Sin asignar" en Config' };
  if (!fantasma.driveOp) return { ok: false, error: 'El centro "Sin asignar" no tiene DriveOp configurado en Config' };

  const carpetaId = String(fantasma.driveOp).trim();
  let folder;
  try { folder = DriveApp.getFolderById(carpetaId); }
  catch (e) { return { ok: false, error: 'No se pudo acceder a la carpeta de transición: ' + e.message }; }

  const archivos = [];
  const it = folder.getFiles();
  while (it.hasNext()) {
    const f = it.next();
    if (!/\.pdf$/i.test(f.getName())) continue;
    archivos.push(f);
  }

  if (!archivos.length) {
    return {
      ok: true, sinActividad: true,
      total: 0, procesados: 0, saltados: 0,
      okNuevas: 0, sinCentro: 0, rectificadas: 0, duplicadas: 0,
      revManual: 0, revisionManual: 0, errores: 0,
      detalleOk: [], detalleFallidos: [], detalleRectificadas: [],
      tiempoAgotado: false, restantes: 0
    };
  }

  archivos.sort((a, b) => {
    let da = 0, db = 0;
    try { da = a.getDateCreated().getTime(); } catch (e) { }
    try { db = b.getDateCreated().getTime(); } catch (e) { }
    return da - db;
  });

  const reg = cargarRegistroPDFs();
  const existentes = leerResumen();
  const resultado = {
    ok: true, sinActividad: false,
    total: archivos.length, procesados: 0, saltados: 0,
    okNuevas: 0, sinCentro: 0, rectificadas: 0, duplicadas: 0,
    revManual: 0, revisionManual: 0, errores: 0,
    detalleOk: [], detalleFallidos: [], detalleRectificadas: [],
    tiempoAgotado: false, restantes: 0
  };

  const inicio = Date.now();
  for (let i = 0; i < archivos.length; i++) {
    if (Date.now() - inicio > TIEMPO_MAX_TRANSICION_MS) {
      resultado.tiempoAgotado = true;
      resultado.restantes = archivos.length - i;
      break;
    }
    const file = archivos[i];
    let fileId = '';
    try { fileId = file.getId(); } catch (e) { }
    if (!fileId) continue;

    const prev = reg[fileId];
    if (prev && ['ok', 'rectificada', 'sin_centro', 'duplicada', 'revision_manual'].indexOf(prev.estado) !== -1) {
      resultado.saltados++;
      continue;
    }

    let fechaCreacion = '';
    try {
      const d = file.getDateCreated();
      fechaCreacion = Utilities.formatDate(d, Session.getScriptTimeZone(), 'yyyy-MM-dd');
    } catch (e) { }

    const r = _procesarUnPDFTransicion(file, fechaCreacion, existentes, cfg, fantasma);

    let nombreArchivo = '';
    try { nombreArchivo = file.getName(); } catch (e) { }
    reg[fileId] = {
      path: '(transición)/' + nombreArchivo,
      estado: r.estado,
      detalle: (r.detalle || '').slice(0, 4500),
      ts: new Date().toISOString(),
      numero: r.numeroFactura || ''
    };

    resultado.procesados++;
    if (r.estado === 'ok') {
      resultado.okNuevas++;
      resultado.detalleOk.push({ archivo: nombreArchivo, numero: r.numeroFactura, centro: r.centro, warnings: r.warnings });
    } else if (r.estado === 'sin_centro') {
      resultado.sinCentro++;
      resultado.detalleOk.push({ archivo: nombreArchivo, numero: r.numeroFactura, centro: 'Sin asignar', warnings: r.warnings });
    } else if (r.estado === 'rectificada') {
      resultado.rectificadas++;
      resultado.detalleRectificadas.push({ archivo: nombreArchivo, numero: r.numeroFactura, warnings: r.warnings });
    } else if (r.estado === 'rev_manual') {
      resultado.revManual++;
      resultado.detalleRectificadas.push({ archivo: nombreArchivo, numero: r.numeroFactura, diffs: r.detalle, warnings: r.warnings });
    } else if (r.estado === 'duplicada') {
      resultado.duplicadas++;
    } else if (r.estado === 'revision_manual') {
      resultado.revisionManual++;
      resultado.detalleFallidos.push({ archivo: nombreArchivo, motivo: r.detalle || 'Sin datos mínimos' });
    } else {
      resultado.errores++;
      resultado.detalleFallidos.push({ archivo: nombreArchivo, motivo: r.detalle || r.estado });
    }

    if (r.nuevaFactura) existentes.push(r.nuevaFactura);

    try { guardarRegistroPDFs(reg); } catch (e) { }
  }

  try { guardarRegistroPDFs(reg); } catch (e) { }
  try { refrescarSeguimiento(); } catch (e) { }

  if (resultado.procesados > 0) {
    try { _enviarCorreoTransicion(resultado); }
    catch (e) { Logger.log('Correo transición falló: ' + e.message); }
  }

  Logger.log(JSON.stringify({
    total: resultado.total, procesados: resultado.procesados,
    saltados: resultado.saltados, ok: resultado.okNuevas,
    sinCentro: resultado.sinCentro, rectificadas: resultado.rectificadas,
    duplicadas: resultado.duplicadas, revManual: resultado.revManual,
    revisionManual: resultado.revisionManual, errores: resultado.errores,
    tiempoAgotado: resultado.tiempoAgotado, restantes: resultado.restantes
  }, null, 2));

  return resultado;
}

function _procesarUnPDFTransicion(file, fechaCreacion, existentes, cfg, fantasma) {
  let base64, mime;
  try {
    const blob = file.getBlob();
    base64 = Utilities.base64Encode(blob.getBytes());
    mime = blob.getContentType() || 'application/pdf';
  } catch (e) {
    return { estado: 'error_ocr', detalle: 'Lectura falló: ' + e.message };
  }

  const c = _cascadaOCRTransicion(base64, mime, file.getName());
  if (!c.ok || !c.campos) {
    return { estado: 'error_ocr', detalle: c.error || 'Ninguna fuente pudo extraer campos' };
  }
  const campos = c.campos;
  const motorUsado = c.fuente || '?';

  const tieneNumero = !!(campos.fNumero && String(campos.fNumero).trim());
  const tienePeriodo = !!(campos.fPeriodo && String(campos.fPeriodo).trim());
  if (!tieneNumero || !tienePeriodo) {
    _renombrarConPrefijo(file, '[REVISIÓN MANUAL]');
    const falta = [];
    if (!tieneNumero) falta.push('N° factura');
    if (!tienePeriodo) falta.push('período');
    return {
      estado: 'revision_manual',
      detalle: 'Faltan datos mínimos: ' + falta.join(', ') + ' · Motor: ' + motorUsado,
      numeroFactura: campos.fNumero || ''
    };
  }

  const _normCod = (s) => String(s || '').trim().replace(/[\.\s\-]/g, '').toUpperCase();
  const codBuscado = _normCod(campos.fCodigo);
  const centroReal = codBuscado
    ? cfg.centros.find(x => _normCod(x.codigo) === codBuscado && !_esCentroFantasmaBack(x.codigo, x.cliente))
    : null;
  const esReal = !!centroReal;
  const centroFinal = centroReal || fantasma;

  const tipo = (campos.fTipo || 'SUMINISTRO').toUpperCase();
  const numFactura = String(campos.fNumero).trim();
  const dup = existentes.find(f => String(f.numero).trim() === numFactura);

  let warning = '';

  if (dup) {
    // ─── Reemplazo inteligente por cantidad de páginas ─────────────
    //  · Si el archivo está en "Sin asignar", reemplazarYDistribuirPDF
    //    lo MUEVE al centro real cuando corresponde.
    //  · Si el vigente gana (mismo o más páginas), el nuevo (que está
    //    en "Sin asignar") se elimina.
    //  · Si el nuevo gana, se limpia el vigente de DriveOp/DriveCom.
    const nombreEst = _construirNombreArchivoEstandar(campos, centroFinal);
    let rReemplazo;
    try {
      rReemplazo = reemplazarYDistribuirPDF(
        numFactura,
        file.getId(),
        esReal ? centroFinal.codigo : '',
        nombreEst
      );
    } catch (e) {
      return { estado: 'error_otro', detalle: 'Reemplazo PDF: ' + e.message, numeroFactura: numFactura };
    }
    if (rReemplazo.conflicto) {
      const nums = (rReemplazo.facturasEnConflicto || []).map(x => x.numero).join(', ');
      return { estado: 'error_otro', detalle: 'Reemplazo PDF: conflicto con factura(s) ' + (nums || 'desconocida'), numeroFactura: numFactura };
    }
    if (!rReemplazo.ok) {
      return { estado: 'error_otro', detalle: 'Reemplazo PDF: ' + (rReemplazo.error || 'error desconocido'), numeroFactura: numFactura };
    }

    if (!rReemplazo.reemplazado) {
      const _det = 'Duplicado sin mejora · ' + (rReemplazo.motivo || '');
      try { _registrarMotivoReemplazoEnProcesados(numFactura, _det); } catch (e) { }
      return {
        estado: 'duplicada',
        detalle: _det,
        numeroFactura: numFactura
      };
    }

    const idDriveNuevo = rReemplazo.pdfId || '';

    let rAct;
    try {
      rAct = actualizarFacturaDesdePDF({
        numero: numFactura, tipo: tipo,
        cliente: centroFinal.cliente, codigo: centroFinal.codigo,
        periodo: campos.fPeriodo,
        kwh: campos.fKwh, sum: campos.fSum, peaje: campos.fPeaje,
        intereses: campos.fInt, intPeaje: campos.fIntPeaje,
        total: campos.fTotal,
        fechaEmision: campos.fEmision, fechaVencimiento: campos.fVencimiento,
        fechaConsumo: '', fechaPeaje: ''
      }, idDriveNuevo, new Date());
    } catch (e) {
      return { estado: 'error_otro', detalle: 'Rectificar: ' + e.message, numeroFactura: numFactura };
    }
    if (!rAct.ok) return { estado: 'error_otro', detalle: 'Rectificar: ' + rAct.error, numeroFactura: numFactura };

    const diffs = _diffFacturaPDF(dup, campos);
    //  Motivo del reemplazo en `detalle` para que viaje al correo y
    //  al log del lote de transición.
    const _detReemplazo = '[PDF] ' + (rReemplazo.motivo || '');

    if (diffs.length) {
      return {
        estado: 'rev_manual',
        detalle: _detReemplazo + '\nDiferencias:\n' + diffs.join('\n'),
        numeroFactura: numFactura, centro: centroFinal.cliente, warnings: warning
      };
    }
    return {
      estado: 'rectificada',
      detalle: _detReemplazo,
      numeroFactura: numFactura, centro: centroFinal.cliente, warnings: warning
    };
  }

  const fechaRecep = fechaCreacion || '';
  const aplicaConsumo = (tipo === 'SUMINISTRO' || tipo === 'UNIFICADA');
  const aplicaPeaje = (tipo === 'PEAJE' || tipo === 'UNIFICADA' || tipo === 'ARRIENDO_MEDIDOR');

  let idDriveFinal = '';
  if (esReal && (centroReal.driveOp || centroReal.driveCom)) {
    const nombreEst = _construirNombreArchivoEstandar(campos, centroReal);
    const rMv = copiarPDFDriveADestinos(file.getId(), centroReal.codigo, nombreEst, fantasma.driveOp);
    if (rMv.ok && rMv.archivos && rMv.archivos.length) idDriveFinal = rMv.archivos[0].id;
    else if (!rMv.ok) warning = 'PDF no movido: ' + (rMv.error || 'sin detalle');
  } else {
    const nombreEst = _construirNombreArchivoEstandar(campos, fantasma);
    try {
      const cur = file.getName();
      if (cur !== nombreEst && cur.indexOf('[') !== 0) file.setName(nombreEst);
    } catch (e) { }
    idDriveFinal = file.getId();
  }

  const datos = {
    numero: numFactura, codigo: centroFinal.codigo, cliente: centroFinal.cliente,
    periodo: campos.fPeriodo, tipo: tipo,
    fecha: fechaRecep,
    fechaConsumo: aplicaConsumo ? fechaRecep : '',
    fechaPeaje:   aplicaPeaje   ? fechaRecep : '',
    fechaEmision: campos.fEmision || '',
    fechaVencimiento: campos.fVencimiento || '',
    kwh: campos.fKwh || 0, sum: campos.fSum || 0, peaje: campos.fPeaje || 0,
    intereses: campos.fInt || 0, intPeaje: campos.fIntPeaje || 0,
    total: campos.fTotal || 0,
    pdfDriveUrl: idDriveFinal || '',
    procesadoMasivo: true
  };

  try { agregarFacturaFront(datos); }
  catch (e) { return { estado: 'error_otro', detalle: 'Al guardar: ' + e.message, numeroFactura: numFactura }; }

  return {
    estado: esReal ? 'ok' : 'sin_centro',
    numeroFactura: numFactura, centro: centroFinal.cliente, warnings: warning,
    nuevaFactura: { numero: numFactura, cliente: centroFinal.cliente, periodo: campos.fPeriodo, tipo: tipo }
  };
}

function _cascadaOCRTransicion(base64, mime, nombreArchivo) {
  let mejor = null, mejorScore = -1, mejorFuente = '';
  const _try = (fuente, campos) => {
    if (!campos) return;
    const score = _contarCamposDetectadosBack(campos).total;
    if (score > mejorScore) { mejorScore = score; mejor = campos; mejorFuente = fuente; }
  };

  if (!_driveOcrEstaBloqueado()) {
    try {
      const r1 = _extraerConDriveOCR(nombreArchivo, base64, mime);
      if (r1.ok && r1.texto) _try('Drive OCR', _parsearFacturaCompleta(r1.texto));
    } catch (e) { }
  }
  try {
    const r2 = _extraerConOCRSpace(nombreArchivo, base64, mime);
    if (r2.ok && r2.texto) _try('OCR.space', _parsearFacturaCompleta(r2.texto));
  } catch (e) { }
  if (GEMINI_API_KEY && String(GEMINI_API_KEY).trim()) {
    try {
      const g = _extraerConGemini(base64, mime, nombreArchivo);
      if (g.ok && g.campos) _try('Gemini', g.campos);
    } catch (e) { }
  }

  if (!mejor) return { ok: false, error: 'Ninguna fuente pudo extraer campos' };
  return { ok: true, campos: mejor, fuente: mejorFuente };
}

function _renombrarConPrefijo(file, prefijo) {
  try {
    const actual = String(file.getName() || '');
    if (actual.indexOf(prefijo) === 0) return;
    file.setName(prefijo + ' ' + actual);
  } catch (e) { Logger.log('_renombrarConPrefijo: ' + e.message); }
}

