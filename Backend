function leerResumen() {
  const sh = SpreadsheetApp.openById(SS_ID).getSheetByName(HOJA_RESUMEN);
  if (!sh) throw new Error('No existe la hoja "' + HOJA_RESUMEN + '"');
  const data = sh.getDataRange().getValues();
  data.shift();
  const tz = Session.getScriptTimeZone();
  return data
    .filter(function (r) { return r[COL.NUMERO - 1]; })
    .map(function (r) {
      return {
        numero: String(r[COL.NUMERO - 1]).trim(),
        codigo: String(r[COL.CODIGO - 1] || '').trim(),
        cliente: String(r[COL.CLIENTE - 1]).trim(),
        periodo: normalizarPeriodoLectura(r[COL.PERIODO - 1]),
        tipo: String(r[COL.TIPO - 1] || '').trim().toUpperCase(),
        kwh: Number(r[COL.KWH - 1]) || 0,
        sum: Number(r[COL.SUM - 1]) || 0,
        peaje: Number(r[COL.PEAJE - 1]) || 0,
        intereses: Number(r[COL.INT - 1]) || 0,
        total: Number(r[COL.TOTAL - 1]) || 0,
        fechaConsumo: formatearFechaSegura(r[COL.FECHA_SUMINISTRO - 1], tz),
        fechaPeaje: formatearFechaSegura(r[COL.FECHA_PEAJE - 1], tz),
        fechaEmision: formatearFechaSegura(r[COL.FECHA_EMISION - 1], tz),
        fechaVencimiento: formatearFechaSegura(r[COL.FECHA_VENC - 1], tz),
        pdfId: String(r[COL.PDF_ID - 1] || '').trim(),
        intPeaje: Number(r[COL.INT_PEAJE - 1]) || 0
      };
    });
}

