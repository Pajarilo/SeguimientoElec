function agregarPeriodoConfig(periodo) {
  periodo = String(periodo || '').trim();
  if (!/^\d{4}-\d{2}$/.test(periodo)) return { ok: false, error: 'Formato YYYY-MM' };
  const ss = SpreadsheetApp.openById(SS_ID);
  let sh = ss.getSheetByName(HOJA_CONFIG);
  if (!sh) { _configCache = null; leerConfig(); sh = ss.getSheetByName(HOJA_CONFIG); }
  const lr = Math.max(sh.getLastRow(), 1);
  let periodos = [];
  if (lr >= 2) {
    const vals = sh.getRange(2, 1, lr - 1, 1).getValues();
    periodos = vals.map(r => String(r[0]).trim()).filter(p => /^\d{4}-\d{2}$/.test(p));
  }
  if (periodos.includes(periodo)) return { ok: false, error: 'Ya existe ' + periodo };
  periodos.push(periodo); periodos.sort();
  sh.getRange(2, 1, sh.getMaxRows() - 1, 1).clearContent();
  sh.getRange(2, 1, periodos.length, 1).setValues(periodos.map(p => [p]));
  sh.getRange(2, 1, periodos.length, 1).setNumberFormat('@');
  _configCache = null;
  refrescarSeguimiento();
  return { ok: true, periodos };
}

function agregarCentroConfig(centro) {
  if (!centro || !centro.codigo || !centro.cliente)
    return { ok: false, error: 'Falta código o cliente' };
  const ss = SpreadsheetApp.openById(SS_ID);
  let sh = ss.getSheetByName(HOJA_CONFIG);
  if (!sh) { _configCache = null; leerConfig(); sh = ss.getSheetByName(HOJA_CONFIG); }
  const lr = Math.max(sh.getLastRow(), 1);
  if (lr >= 2) {
    const vals = sh.getRange(2, 3, lr - 1, 2).getValues();
    const dup = vals.some(r => String(r[0]).trim() === String(centro.codigo).trim());
    if (dup) return { ok: false, error: 'Ya existe el código ' + centro.codigo };
  }
