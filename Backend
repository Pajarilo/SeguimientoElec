// ============================================================
//  DIAGNÓSTICO — reporte consolidado por PDF
// ============================================================
let _DIAG_BUFFER = [];
let _DIAG_INTENTOS = [];

function _logDiag(msg) {
  try { Logger.log(msg); } catch (e) { }
  _DIAG_BUFFER.push(String(msg));
}

function _diagReset(nombreArchivo) {
  _DIAG_BUFFER = [];
  _DIAG_INTENTOS = [];
  _DIAG_ARCHIVO = String(nombreArchivo || 'factura.pdf');
}
let _DIAG_ARCHIVO = '';

/**
 * Registra un intento de extracción en el buffer de diagnóstico.
 */
function _diagIntentar(fuente, ok, datos) {
  datos = datos || {};
  const campos = datos.campos || null;
  const entry = {
    fuente: String(fuente || '?'),
    ok: !!ok,
    chars: datos.chars || 0,
    error: datos.error || '',
    campos: campos,
    preview: (datos.preview || '').slice(0, 300)
  };
  _DIAG_INTENTOS.push(entry);

  // Log inmediato resumido por fuente
  if (ok && campos) {
    const det = _contarCamposDetectadosBack(campos);
    Logger.log('[DIAG] ' + fuente + ' → OK · chars=' + entry.chars +
      ' · campos=' + det.total + '/' + det.totalClaves +
      (det.faltantes.length ? ' · faltan: ' + det.faltantes.join(', ') : ''));
  } else {
    Logger.log('[DIAG] ' + fuente + ' → FALLO · ' + (entry.error || 'sin detalle'));
  }
}

/**
 * Emite el reporte final con todas las fuentes intentadas.
 */
function _diagReporteFinal(camposFinales, fuenteFinal, ok) {
  const lineas = [];
  const sep = '═══════════════════════════════════════════════════════════════';

  lineas.push(sep);
  lineas.push('📋 DIAGNÓSTICO · ' + _DIAG_ARCHIVO);
  lineas.push(sep);

  _DIAG_INTENTOS.forEach((it, i) => {
    lineas.push('');
    lineas.push('[' + (i + 1) + '] Fuente: ' + it.fuente);
    lineas.push('    Estado: ' + (it.ok ? '✓ OK' : '✗ ' + (it.error || 'sin texto')));
    if (it.chars) lineas.push('    Chars extraídos: ' + it.chars);
    if (it.campos) {
      const claves = ['fNumero', 'fCodigo', 'fRut', 'fPeriodo', 'fEmision', 'fVencimiento',
        'fKwh', 'fSum', 'fPeaje', 'fInt', 'fIntPeaje', 'fOtros', 'fOtrosPeaje', 'fTotal', 'fTipo'];
      const presentes = claves.filter(k => {
        const v = it.campos[k];
        return v !== undefined && v !== null && v !== '' && v !== 0;
      });
      lineas.push('    Campos presentes (' + presentes.length + '/' + claves.length + '):');
      presentes.forEach(k => {
        lineas.push('      ✓ ' + k.padEnd(14) + ' = ' + JSON.stringify(it.campos[k]));
      });
    }
    if (it.preview) lineas.push('    Preview: ' + it.preview.replace(/\n/g, ' ⏎ '));
  });

  lineas.push('');
  lineas.push('▶ RESULTADO FINAL');
  lineas.push('    Fuente elegida: ' + (fuenteFinal || '(ninguna)'));
  lineas.push('    Válido (fNumero && fCodigo): ' + (ok ? 'SÍ' : 'NO'));
  if (camposFinales) {
    const claves = ['fNumero', 'fCodigo', 'fRut', 'fPeriodo', 'fEmision', 'fVencimiento',
      'fKwh', 'fSum', 'fPeaje', 'fInt', 'fIntPeaje', 'fOtros', 'fOtrosPeaje', 'fTotal', 'fTipo'];
    claves.forEach(k => {
      const v = camposFinales[k];
      const tiene = v !== undefined && v !== null && v !== '' && v !== 0;
      lineas.push('    ' + (tiene ? '✓' : '✗') + ' ' +
        k.padEnd(14) + ' = ' + (tiene ? JSON.stringify(v) : '(vacío)'));
    });
  }
  lineas.push(sep);

  Logger.log(lineas.join('\n'));
}

/**
 * Cuenta campos presentes/faltantes en un objeto de campos.
 */
function _contarCamposDetectadosBack(campos) {
  const claves = ['fNumero', 'fCodigo', 'fRut', 'fPeriodo', 'fEmision', 'fVencimiento',
    'fKwh', 'fSum', 'fPeaje', 'fInt', 'fIntPeaje', 'fOtros', 'fOtrosPeaje', 'fTotal'];
  let total = 0;
  const faltantes = [];
  claves.forEach(k => {
    const v = campos[k];
    const tiene = v !== undefined && v !== null && v !== '' && v !== 0;
    if (tiene) total++;
    else faltantes.push(k);
  });
  return { total, totalClaves: claves.length, faltantes };
}

/**
 * Determina si un conjunto de campos es "utilizable" — es decir,
 * tiene los dos identificadores mínimos: N° Factura y Código.
 */
function _camposSonUtilizables(campos) {
  if (!campos) return false;
  return !!(campos.fNumero && campos.fCodigo);
}

