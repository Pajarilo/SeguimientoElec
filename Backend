// ============================================================
//  MANUAL DE USUARIO
//  Devuelve el contenido de manual.html como string para que el
//  frontend lo inyecte en un <iframe srcdoc="...">.
//  Se cachea en memoria durante la ejecución para no releer el
//  archivo si el usuario abre/cierra el modal varias veces.
// ============================================================
let _MANUAL_HTML_CACHE_BACK = null;

function obtenerHTMLManual(){
  if(_MANUAL_HTML_CACHE_BACK !== null) return _MANUAL_HTML_CACHE_BACK;
  try {
    let html = HtmlService
      .createHtmlOutputFromFile('manual')
      .getContent();

    // ─── Incrustar el mapa de imágenes de la hoja "img" ───
    //  El manual se inyecta dentro de un <iframe srcdoc>, donde
    //  google.script.run NO existe. Por eso las imágenes se pasan
    //  como JSON embebido en el propio HTML. Cero hardcodeo: la
    //  fuente sigue siendo la hoja "img" del spreadsheet.
    // ─── Sólo IDs: el HTML se sirve al instante ───
    //  Las imágenes se hidratan en segundo plano desde el propio
    //  manual (ver obtenerImagenesManualHidratadasAsync), así la
    //  ventana se abre en milisegundos y las capturas van apareciendo.
    let mapa = {};
    try { mapa = obtenerImagenesManual(); } catch (e) { mapa = {}; }
    const json = JSON.stringify(mapa || {}).replace(/</g, '\\u003c');

    // Reemplazar los marcadores de versión del HTML por el valor
    // declarado en MANUAL_VERSION. Si el HTML no los tuviera, no pasa nada.
    const version = String(MANUAL_VERSION || '').trim();
    if (version) {
      html = html
        .replace(/__MANUAL_VERSION__/g, version);
    }

    const inyeccion =
      '<script>window.__IMG_MANUAL__ = ' + json + ';<\/script>';

    // Insertar justo antes del </head> para que esté disponible
    // cuando arranque el DOMContentLoaded del manual.
    if (/<\/head>/i.test(html)) {
      html = html.replace(/<\/head>/i, inyeccion + '</head>');
    } else {
      html = inyeccion + html;
    }

    _MANUAL_HTML_CACHE_BACK = html;
    return _MANUAL_HTML_CACHE_BACK;
  } catch (e) {
    return '<!DOCTYPE html><html><body style="font-family:sans-serif;padding:40px;color:#b91c1c">' +
           '<h2>⚠ No se pudo cargar el manual</h2>' +
           '<p>' + String(e.message || e) + '</p>' +
           '<p>Verifica que exista el archivo <code>manual.html</code> en el proyecto.</p>' +
           '</body></html>';
  }
}

function obtenerImagenesManual() {
  const hoja = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('img');
  if (!hoja) return {};
  const lr = hoja.getLastRow();
  if (lr < 2) return {};              // sólo encabezado o vacía
  const datos = hoja.getRange(2, 1, lr - 1, 2).getValues();
  const mapa = {};
  datos.forEach(([clave, id]) => {
    const k = String(clave || '').trim();
    const v = String(id    || '').trim();
    if (k && v) mapa[k] = v;
  });
  return mapa;
}

/**
 * Versión "hidratada" del mapa de imágenes del manual: en vez de
 * devolver { clave: idDrive }, devuelve { clave: dataURI }. El
 * backend lee el blob de cada archivo una sola vez y lo entrega
 * embebido, así el navegador no tiene que ir a buscar nada a Drive.
 *
 * Se cachea en memoria durante la ejecución (ScriptProperties tiene
 * un tope de 9KB por valor — no sirve para guardar binarios grandes).
 * El cache dura lo que dura la ejecución del script, que es
 * suficiente: cuando el usuario abre el manual, se paga el costo
 * una sola vez y los siguientes abrir/cerrar son instantáneos.
 */
let _IMG_HIDRATADAS_CACHE = null;

/**
 * Endpoint expuesto a google.script.run para que el manual, YA ABIERTO,
 * pida las imágenes hidratadas en background. Devuelve
 * { clave: dataURI } y reemplaza los placeholders cuando llega.
 *
 * Va aparte de obtenerImagenesManualHidratadas() para no romper la
 * ruta sincrónica (que sigue disponible por si otro flujo la usa).
 */
function obtenerImagenesManualHidratadasAsync() {
  return obtenerImagenesManualHidratadas();
}

function obtenerImagenesManualHidratadas() {
  // Nota: el cache dura lo que dura la ejecución del script. Si necesitas
  // que un cambio en la hoja "img" se refleje de inmediato, comenta esta
  // línea o bórrala antes de servir el manual.
  if (_IMG_HIDRATADAS_CACHE) return _IMG_HIDRATADAS_CACHE;

  const mapa = obtenerImagenesManual();      // { clave: idDrive }
  const salida = {};

  Object.keys(mapa).forEach(clave => {
    const id = mapa[clave];
    try {
      const file = DriveApp.getFileById(id);
      const blob = file.getBlob();
      const mime = blob.getContentType() || 'image/png';
      const b64  = Utilities.base64Encode(blob.getBytes());
      salida[clave] = 'data:' + mime + ';base64,' + b64;
    } catch (e) {
      // Si una imagen falla, se omite: el frontend deja el placeholder.
      Logger.log('Imagen "' + clave + '" (' + id + ') no se pudo leer: ' + e.message);
    }
  });

  _IMG_HIDRATADAS_CACHE = salida;
  return salida;
}
