/**
 * Recorre todas las filas con PDF_ID y renombra los archivos en Drive
 * al formato estándar.
 *
 *   · Si el archivo ya tiene el nombre correcto → no se toca.
 *   · Si el ID está en papelera o es inaccesible → busca en los Drives
 *     del centro un archivo cuyo nombre contenga el N° de factura y
 *     reemplaza el ID en la BD con el encontrado.
 *   · Si la auto-búsqueda falla → pide el ID manualmente por `ui.prompt`.
 *
 * Invocable desde el menú ⚡ Funciones adicionales.
 */
function renombrarTodosLosPDFs() {
  const ui = SpreadsheetApp.getUi();

  const confirmar = ui.alert(
    '📝 Renombrar PDFs vinculados',
    'Se recorrerán TODAS las filas con PDF_ID en "Resumen Facturación"\n' +
    'y se renombrará cada archivo en Drive al formato:\n\n' +
    '  Periodo_Código_N°Factura_CentroDeCosto_Tipo.pdf\n\n' +
    'Comportamiento:\n' +
    '  · Si el archivo ya tiene el nombre correcto → no se toca.\n' +
    '  · Si el ID está en papelera o es inaccesible, se busca\n' +
    '    automáticamente en los Drives del centro un archivo cuyo nombre\n' +
    '    contenga el N° de factura y se usa ese ID.\n' +
    '  · Si la auto-búsqueda no encuentra nada, se pide el ID manualmente.\n\n' +
    '¿Continuar?',
    ui.ButtonSet.YES_NO
  );
  if (confirmar !== ui.Button.YES) return;

  const ss = SpreadsheetApp.openById(SS_ID);
  const sh = ss.getSheetByName(HOJA_RESUMEN);
  if (!sh) { ui.alert('No existe la hoja "Resumen Facturación".'); return; }

  const lr = Math.max(sh.getLastRow(), 1);
  if (lr < 2) { ui.alert('No hay facturas.'); return; }

  const nCols = Math.max(sh.getLastColumn(), COL.PDF_ID);
  const data  = sh.getRange(2, 1, lr - 1, nCols).getValues();

  let renombrados     = 0;
  let sinCambio       = 0;
  let sinPDF          = 0;
  let autoRecuperados = 0;
  let reemplazados    = 0;
  let pospuestos      = 0;
  const problemas     = [];   // filas sin resolver (se preguntan después)
  const errores       = [];   // errores inesperados

  for (let i = 0; i < data.length; i++) {
    const fila    = data[i];
    const numero  = String(fila[COL.NUMERO - 1] || '').trim();
    const codigo  = String(fila[COL.CODIGO - 1] || '').trim();
    const periodo = String(fila[COL.PERIODO - 1] || '').trim();
    const tipo    = String(fila[COL.TIPO - 1] || '').trim();
    const pdfId   = String(fila[COL.PDF_ID - 1] || '').trim();

    if (!pdfId) { sinPDF++; continue; }
    if (!numero) { sinPDF++; continue; }

    const nombreNuevo = _construirNombreArchivoEstandar({ numero, codigo, periodo, tipo });

    // ─── 1) Intentar acceder al archivo actual ───
    let file = null;
    let motivoProblema = '';
    try {
      file = DriveApp.getFileById(pdfId);
      let trashed = false;
      try { trashed = file.isTrashed(); } catch (e) {}
      if (trashed) { file = null; motivoProblema = 'En papelera'; }
    } catch (e) {
      file = null;
      motivoProblema = 'Inaccesible: ' + (e.message || e);
    }

    // ─── 2) Auto-búsqueda en el Drive del centro ───
    if (!file) {
      const busqueda = _buscarPDFEnDriveDelCentro(codigo, numero);
      if (busqueda.ok && busqueda.encontrado) {
        const rRep = reemplazarPDFFactura(numero, busqueda.id);
        if (rRep.ok) {
          autoRecuperados++;
          try { file = DriveApp.getFileById(busqueda.id); } catch (e) { file = null; }
          Logger.log('[auto-recuperado] N° ' + numero + '  →  ' + busqueda.id +
                     '  (' + busqueda.carpeta + ': ' + busqueda.nombre + ')');
        } else {
          motivoProblema += ' · No se pudo guardar el ID nuevo: ' + rRep.error;
        }
      } else {
        motivoProblema += ' · Auto-búsqueda: ' + (busqueda.error || 'sin resultado');
      }
    }

    // ─── 3) Si sigue sin archivo, registrar para preguntar después ───
    if (!file) {
      problemas.push({
        fila: i + 2, numero, codigo, pdfId, nombreNuevo,
        motivo: motivoProblema || 'No se pudo acceder al archivo'
      });
      continue;
    }

    // ─── 4) Renombrar si corresponde ───
    try {
      const nombreActual = file.getName();
      if (nombreActual === nombreNuevo) { sinCambio++; continue; }
      file.setName(nombreNuevo);
      renombrados++;
    } catch (e) {
      problemas.push({
        fila: i + 2, numero, codigo, pdfId, nombreNuevo,
        motivo: 'Renombrado falló: ' + (e.message || e)
      });
    }
  }

  // ─── 5) Pregunta manual sólo para lo que quedó sin resolver ───
  if (problemas.length) {
    const quiereManual = ui.alert(
      '⚠️ ' + problemas.length + ' PDFs requieren atención',
      'La auto-búsqueda en el Drive del centro no encontró el archivo para:\n\n' +
      problemas.slice(0, 10).map(p =>
        '· Fila ' + p.fila + '  N° ' + p.numero + '  —  ' + p.motivo
      ).join('\n') +
      (problemas.length > 10 ? '\n  … y ' + (problemas.length - 10) + ' más' : '') +
      '\n\n¿Querés ingresar manualmente un ID/URL por cada uno?',
      ui.ButtonSet.YES_NO
    );

    if (quiereManual === ui.Button.YES) {
      problemas.forEach(p => {
        const resp = ui.prompt(
          'Reemplazar PDF · Fila ' + p.fila + '  N° ' + p.numero,
          p.motivo + '\n\n' +
          'Nombre esperado:\n  ' + p.nombreNuevo + '\n\n' +
          'ID actual en la BD:\n  ' + p.pdfId + '\n\n' +
          'Pegá el ID o URL del archivo nuevo (dejá vacío para saltar):',
          ui.ButtonSet.OK_CANCEL
        );
        if (resp.getSelectedButton() !== ui.Button.OK) { pospuestos++; return; }
        const nuevoId = String(resp.getResponseText() || '').trim();
        if (!nuevoId) { pospuestos++; return; }

        const r = reemplazarPDFFactura(p.numero, nuevoId);
        if (r.ok) {
          reemplazados++;
          try {
            const f2 = DriveApp.getFileById(r.id);
            if (f2.getName() !== p.nombreNuevo) {
              f2.setName(p.nombreNuevo);
              renombrados++;
            }
          } catch (e) { /* se resolverá en la próxima corrida */ }
        } else {
          errores.push({ fila: p.fila, numero: p.numero, error: r.error });
        }
      });
    } else {
      pospuestos = problemas.length;
    }
  }

  // ─── 6) Resumen final ───
  const lineas = [];
  lineas.push('📝 Renombrado de PDFs');
  lineas.push('');
  lineas.push('Filas procesadas:      ' + data.length);
  lineas.push('Renombrados:           ' + renombrados);
  lineas.push('Sin cambio (ya OK):    ' + sinCambio);
  lineas.push('Auto-recuperados:      ' + autoRecuperados);
  lineas.push('Reemplazados manual:   ' + reemplazados);
  lineas.push('Pospuestos:            ' + pospuestos);
  lineas.push('Sin PDF vinculado:     ' + sinPDF);
  lineas.push('Errores:               ' + errores.length);

  if (problemas.length && pospuestos) {
    lineas.push('');
    lineas.push('PDFs sin resolver:');
    problemas.slice(0, 20).forEach(p => {
      lineas.push('  · Fila ' + p.fila + ' · N° ' + p.numero + '  — ' + p.motivo);
    });
    Logger.log(JSON.stringify(problemas, null, 2));
  }

  if (errores.length) {
    lineas.push('');
    lineas.push('Errores inesperados:');
    errores.slice(0, 20).forEach(e => {
      lineas.push('  · Fila ' + e.fila + ' · N° ' + e.numero + '\n      ' + e.error);
    });
    Logger.log(JSON.stringify(errores, null, 2));
  }

  Logger.log(lineas.join('\n'));
  ui.alert(lineas.join('\n'));
}

/**
 * Sólo muestra en el log qué renombraría, sin tocar nada.
 * Útil para revisar antes de correr la función real.
 */
function previsualizarRenombradoPDFs() {
  const ss = SpreadsheetApp.openById(SS_ID);
  const sh = ss.getSheetByName(HOJA_RESUMEN);
  if (!sh) { Logger.log('No existe "Resumen Facturación"'); return; }

  const lr = Math.max(sh.getLastRow(), 1);
  if (lr < 2) { Logger.log('Sin facturas'); return; }

  const nCols = Math.max(sh.getLastColumn(), COL.PDF_ID);
  const data  = sh.getRange(2, 1, lr - 1, nCols).getValues();

  const lineas = [];
  let conCambio     = 0;
  let papelera      = 0;
  let inaccesibles  = 0;
  let recuperables  = 0;

  data.forEach((fila, i) => {
    const numero  = String(fila[COL.NUMERO - 1] || '').trim();
    const codigo  = String(fila[COL.CODIGO - 1] || '').trim();
    const periodo = String(fila[COL.PERIODO - 1] || '').trim();
    const tipo    = String(fila[COL.TIPO - 1] || '').trim();
    const pdfId   = String(fila[COL.PDF_ID - 1] || '').trim();
    if (!pdfId || !numero) return;

    const nombreNuevo = _construirNombreArchivoEstandar({ numero, codigo, periodo, tipo });
    let file = null, motivo = '';
    try {
      file = DriveApp.getFileById(pdfId);
      let trashed = false;
      try { trashed = file.isTrashed(); } catch (e) {}
      if (trashed) { file = null; motivo = 'EN PAPELERA'; }
    } catch (e) {
      file = null;
      motivo = 'INACCESIBLE: ' + (e.message || e);
    }

    // Simular auto-búsqueda
    if (!file) {
      const busqueda = _buscarPDFEnDriveDelCentro(codigo, numero);
      if (busqueda.ok && busqueda.encontrado) {
        recuperables++;
        lineas.push('· Fila ' + (i + 2) + '  N° ' + numero + '  ⚠️ ' + motivo +
                    '  →  auto-recuperable');
        lineas.push('    id actual:     ' + pdfId);
        lineas.push('    id encontrado: ' + busqueda.id + '  (' + busqueda.carpeta + ')');
        lineas.push('    nombre encontrado: ' + busqueda.nombre);
        lineas.push('    nombre esperado:   ' + nombreNuevo);
        return;
      }
      if (motivo.indexOf('PAPELERA') !== -1) papelera++;
      else inaccesibles++;
      lineas.push('· Fila ' + (i + 2) + '  N° ' + numero + '  ❌ ' + motivo);
      lineas.push('    id actual:  ' + pdfId);
      lineas.push('    auto-búsqueda:  ' + (busqueda.error || 'sin resultado'));
      return;
    }

    const actual = file.getName();
    if (actual === nombreNuevo) return;

    conCambio++;
    lineas.push('· Fila ' + (i + 2) + '  N° ' + numero);
    lineas.push('    de:  ' + actual);
    lineas.push('    a:   ' + nombreNuevo);
  });

  const cab = [
    '🔍 Previsualización de renombrado',
    '',
    '· A renombrar:             ' + conCambio,
    '· Auto-recuperables:       ' + recuperables + '  (en papelera pero encontrados)',
    '· En papelera (sin match): ' + papelera,
    '· Inaccesibles:            ' + inaccesibles,
    ''
  ].join('\n');

  Logger.log(cab + lineas.join('\n'));
}
