function extraerTextoPDF(nombreArchivo, base64, mimeType) {
  const r1 = _extraerConDriveOCR(nombreArchivo, base64, mimeType);
  if (r1.ok && r1.texto && r1.texto.trim().length > 20) return r1;

  const r2 = _extraerConOCRSpace(nombreArchivo, base64, mimeType);
  if (r2.ok && r2.texto && r2.texto.trim().length > 20) {
    r2.fallbackDesde = r1.error || 'Drive OCR sin texto';
    return r2;
  }

  return {
    ok: false,
    error:
      '⚠️ OCR no disponible.\n\n' +
      '· Drive OCR: ' + (r1.error || 'sin texto') + '\n' +
      '· OCR.space: ' + (r2.error || 'sin texto')
  };
}

function _extraerConDriveOCR(nombreArchivo, base64, mimeType) {
  // Cuota ya agotada → fallar rápido sin llamar a la API
  if (_driveOcrEstaBloqueado()) {
    return { ok: false, error: 'Drive OCR bloqueado por cuota (skip rápido)' };
  }

  let tmpId = null;
  try {
    const bytes = Utilities.base64Decode(base64);
    const blob = Utilities.newBlob(bytes, mimeType || 'application/pdf', nombreArchivo || 'tmp.pdf');
    const file = Drive.Files.insert(
      { title: nombreArchivo || 'tmp' },
      blob,
      { convert: true, ocr: true, ocrLanguage: 'es' }
    );
    tmpId = file.id;
    const doc = DocumentApp.openById(file.id);
    const txtCompleto = doc.getBody().getText();
    if (_esTextoBasuraBack(txtCompleto)) {
      return { ok: false, error: 'Drive OCR devolvió texto corrupto' };
    }
    return { ok: true, texto: txtCompleto, motor: 'Drive OCR' };
  } catch (e) {
    const msg = String(e.message || e);
    // Cuota agotada → bloquear para el resto del lote
    if (/rate limit exceeded for OCR/i.test(msg)
      || /User rate limit exceeded/i.test(msg)) {
      _bloquearDriveOcrPorCuota(msg);
      return { ok: false, error: 'Cuota Drive OCR agotada' };
    }
    return { ok: false, error: msg };
  } finally {
    if (tmpId) { try { DriveApp.getFileById(tmpId).setTrashed(true); } catch (e) { } }
  }
}

function _getOCRSpaceKey() {
  try {
    const ss = SpreadsheetApp.openById(SS_ID);
    let sh = ss.getSheetByName(HOJA_CONFIG);
    if (!sh) return 'helloworld';
    const v = String(sh.getRange('I2').getValue() || '').trim();
    return (v && !/^\d{7,8}-?[\dKk]$/.test(v)) ? v : 'helloworld';
  } catch (e) { return 'helloworld'; }
}

function _extraerConOCRSpace(nombreArchivo, base64, mimeType) {
  try {
    const OCR_API_KEY = _getOCRSpaceKey();
    const bytes = Utilities.base64Decode(base64);
    const blob = Utilities.newBlob(bytes, mimeType || 'application/pdf', nombreArchivo || 'factura.pdf');
    const esPdf = /pdf/i.test(mimeType || '');
    const form = {
      apikey: OCR_API_KEY,
      language: 'spa',
      isOverlayRequired: 'false',
      filetype: esPdf ? 'PDF' : 'AUTO',
      OCREngine: '2',
      scale: 'true',
      isTable: 'true',
      file: blob
    };
    const res = UrlFetchApp.fetch('https://api.ocr.space/parse/image', {
      method: 'post', payload: form, muteHttpExceptions: true, timeout: 60
    });
    const code = res.getResponseCode();
    if (code !== 200) return { ok: false, error: 'HTTP ' + code };
    const json = JSON.parse(res.getContentText());
    if (json.IsErroredOnProcessing) {
      const msg = Array.isArray(json.ErrorMessage) ? json.ErrorMessage.join(' · ') : (json.ErrorMessage || 'Error');
      return { ok: false, error: msg };
    }
    const resultados = json.ParsedResults || [];
    const texto = (resultados[0] && resultados[0].ParsedText) || '';
    if (!texto.trim()) return { ok: false, error: 'Sin texto' };
    if (_esTextoBasuraBack(texto)) return { ok: false, error: 'OCR.space devolvió texto corrupto' };
    return { ok: true, texto: texto, motor: 'OCR.space' };
  } catch (e) { return { ok: false, error: e.message }; }
}

