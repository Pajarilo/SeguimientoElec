function agregarFacturaFront(datos) {
  if (!datos || !datos.numero) throw new Error('Falta el N° de factura');
  if (!datos.cliente) throw new Error('Falta el centro de costo');
  if (!datos.periodo) throw new Error('Falta el período');
  const ss = SpreadsheetApp.openById(SS_ID);
  const sh = ss.getSheetByName(HOJA_RESUMEN);
  const existentes = leerResumen();
  // Normalizar alias legacy "CONSUMO" → "SUMINISTRO" para que coincida
  // con la nomenclatura actual y con los chequeos de recepción de abajo.
  let tipoNuevo = (datos.tipo || 'SUMINISTRO').toUpperCase();
  if (tipoNuevo === 'CONSUMO') tipoNuevo = 'SUMINISTRO';
  const dup = existentes.find(function (f) { return f.numero === String(datos.numero).trim(); });
  if (dup) throw new Error('Ya existe la factura N°' + datos.numero);
  let codigo = datos.codigo || '';
  if (!codigo) { const c = existentes.find(f => f.cliente === datos.cliente && f.codigo); if (c) codigo = c.codigo; }
  // Prioridad para las fechas de recepción al CREAR una factura:
  //   1. Si datos.fechaConsumo / datos.fechaPeaje vienen explícitos
  //      (p.ej. desde CSV de importación), se respetan tal cual.
  //   2. Si no, se deriva de datos.fecha (formulario del modal).
  //   3. Si tampoco hay datos.fecha, se escribe SENTINELA_SIN_FECHA
  //      cuando la columna aplica, para distinguir "recibida sin día"
  //      de "no recibida aún".
  const _fRecep = (aplica, fechaExplicita) => {
    if (!aplica) return '';
    const src = (fechaExplicita != null && fechaExplicita !== '')
      ? fechaExplicita
      : datos.fecha;
    if (!src) return SENTINELA_SIN_FECHA;
    const s = String(src).trim();
    if (SENTINELAS.indexOf(s) !== -1) return s;
    return parseISO(s);
  };
  const fC = _fRecep(
    tipoNuevo === 'SUMINISTRO' || tipoNuevo === 'UNIFICADA',
    datos.fechaConsumo
  );
  const fP = _fRecep(
    tipoNuevo === 'PEAJE' || tipoNuevo === 'UNIFICADA',
    datos.fechaPeaje
  );
  const fE = datos.fechaEmision ? parseISO(datos.fechaEmision) : '';
  const fV = datos.fechaVencimiento ? parseISO(datos.fechaVencimiento) : '';
  const marcaProcesado = datos.procesadoMasivo ? new Date() : '';
  const fila = [
    String(datos.numero).trim(), codigo, datos.cliente, datos.periodo, tipoNuevo,
    Number(datos.kwh) || 0, Number(datos.sum) || 0, Number(datos.peaje) || 0,
    Number(datos.intereses) || 0, Number(datos.otros) || 0,
    Number(datos.intPeaje) || 0, Number(datos.otrosPeaje) || 0,
    Number(datos.total) || 0,
    fC, fP, fE, fV, '', marcaProcesado
  ];
  const lr = sh.getLastRow() + 1;
  // Fijar formatos ANTES de escribir para que las fechas queden como Date
  sh.getRange(lr, COL.CODIGO).setNumberFormat('@');
  sh.getRange(lr, COL.PERIODO).setNumberFormat('@');
  sh.getRange(lr, COL.FECHA_SUMINISTRO, 1, 4).setNumberFormat('dd/mm/yyyy');
  sh.getRange(lr, COL.KWH).setNumberFormat('#,##0.00');
  sh.getRange(lr, COL.SUM, 1, 7).setNumberFormat('$#,##0');
  if (marcaProcesado) sh.getRange(lr, COL.PROCESADO_MASIVO).setNumberFormat('yyyy-mm-dd hh:mm');
  sh.getRange(lr, 1, 1, fila.length).setValues([fila]);
  let pdfInfo = null;
  if (datos.pdfDriveUrl) {
    try {
      // Fuente única de verdad del nombre → _construirNombreArchivoEstandar
      const nombreEst = _construirNombreArchivoEstandar({
        numero:  datos.numero,
        codigo:  codigo,
        periodo: datos.periodo,
        tipo:    tipoNuevo
      });
      const v = vincularPDFDrive(datos.numero, datos.pdfDriveUrl, nombreEst);
      if (v.ok) pdfInfo = { id: v.id, url: v.url, nombre: v.nombre };
    } catch (e) { }
  }

  // Marcar el PDF de esta factura como rectificado en el registro masivo,
  // para que un repaso no vuelva a procesarlo.
  try { _marcarFacturaComoRectificadaEnRegistro(datos.numero); } catch (e) { }

  refrescarSeguimiento();
  return { ok: true, mensaje: 'Factura ' + datos.numero + ' agregada', pdf: pdfInfo };
}

function actualizarFacturaFront(datos, idDrive) {
  if (!datos || !datos.numero) return { ok: false, error: 'Falta el N° de factura' };
  if (!datos.cliente) return { ok: false, error: 'Falta el centro de costo' };
  if (!datos.periodo) return { ok: false, error: 'Falta el período' };
  const sh = SpreadsheetApp.openById(SS_ID).getSheetByName(HOJA_RESUMEN);
  if (!sh) return { ok: false, error: 'No existe hoja Resumen' };
  const data = sh.getDataRange().getValues();
  const numBuscado = String(datos.numero).trim();
  let tipoBuscado = String(datos.tipo || '').toUpperCase();
  if (tipoBuscado === 'CONSUMO') tipoBuscado = 'SUMINISTRO';
  const cliBuscado = String(datos.cliente || '').trim();
  const perBuscado = String(datos.periodo || '').trim();
  let fila = -1;
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][COL.NUMERO - 1]).trim() === numBuscado) { fila = i + 1; break; }
  }
  if (fila === -1) return { ok: false, error: 'Factura no encontrada: ' + numBuscado };
  const pdfIdActual = String(sh.getRange(fila, COL.PDF_ID).getValue() || '').trim();
  const celda = (col) => sh.getRange(fila, col);
  celda(COL.NUMERO).setValue(numBuscado);
  celda(COL.CLIENTE).setValue(cliBuscado);
  celda(COL.PERIODO).setValue(perBuscado).setNumberFormat('@');
  if (datos.codigo) celda(COL.CODIGO).setValue(String(datos.codigo).trim()).setNumberFormat('@');
  if (['SUMINISTRO', 'PEAJE', 'UNIFICADA', 'ARRIENDO_MEDIDOR'].indexOf(tipoBuscado) !== -1) celda(COL.TIPO).setValue(tipoBuscado);
  const _n = (v) => Number(v) || 0;
  celda(COL.KWH).setValue(_n(datos.kwh));
  celda(COL.SUM).setValue(_n(datos.sum));
  celda(COL.PEAJE).setValue(_n(datos.peaje));
  celda(COL.INT).setValue(_n(datos.intereses));
  celda(COL.OTROS).setValue(_n(datos.otros));
  celda(COL.INT_PEAJE).setValue(_n(datos.intPeaje));
  celda(COL.OTROS_PEAJE).setValue(_n(datos.otrosPeaje));
  celda(COL.TOTAL).setValue(_n(datos.total));
  const _setFecha = (col, iso) => {
    const c = celda(col);
    if (!iso) { c.setValue(''); return; }
    const s = String(iso).trim();
    if (SENTINELAS.indexOf(s) !== -1) {
      c.setNumberFormat('@');
      c.setValue(s);
      return;
    }
    const p = s.split('-').map(Number);
    if (isNaN(p[0]) || isNaN(p[1]) || isNaN(p[2])) { c.setValue(''); return; }
    c.setNumberFormat('dd/mm/yyyy');
    c.setValue(new Date(p[0], p[1] - 1, p[2]));
  };
  // ⚠ Sólo se escribe la fecha de recepción si el formulario la trae
  //   explícitamente. Si viene vacía, se respeta el valor actual de la
  //   celda (no se pisa con la fecha de hoy ni con un sentinel).
  const _fRecepVal = (aplica, fechaExplicita) => {
    if (!aplica) return null;                 // null = no tocar
    const src = (fechaExplicita != null && fechaExplicita !== '')
      ? fechaExplicita
      : datos.fecha;
    if (!src) return null;                    // sin dato → no tocar
    const s = String(src).trim();
    if (SENTINELAS.indexOf(s) !== -1) return s;
    return s;                                 // ISO YYYY-MM-DD
  };
  const fC = _fRecepVal(
    tipoBuscado === 'CONSUMO' || tipoBuscado === 'SUMINISTRO' || tipoBuscado === 'UNIFICADA',
    datos.fechaConsumo
  );
  const fP = _fRecepVal(
    tipoBuscado === 'PEAJE' || tipoBuscado === 'UNIFICADA',
    datos.fechaPeaje
  );
  if (fC !== null) _setFecha(COL.FECHA_SUMINISTRO, fC);
  if (fP !== null) _setFecha(COL.FECHA_PEAJE,   fP);
  _setFecha(COL.FECHA_EMISION, datos.fechaEmision);
  _setFecha(COL.FECHA_VENC, datos.fechaVencimiento);
  let pdfIdFinal = pdfIdActual;
  if (idDrive) {
    const idNuevo = String(idDrive).trim();
    if (!pdfIdActual) { celda(COL.PDF_ID).setValue(idNuevo).setNumberFormat('@'); pdfIdFinal = idNuevo; }
    else if (pdfIdActual !== idNuevo) {
      let pagActual = 0, pagNuevo = 0;
      try { pagActual = _contarPaginasPdf(pdfIdActual); } catch (e) { }
      try { pagNuevo = _contarPaginasPdf(idNuevo); } catch (e) { }
      if (pagNuevo > pagActual) { celda(COL.PDF_ID).setValue(idNuevo).setNumberFormat('@'); pdfIdFinal = idNuevo; }
    }
  }
  celda(COL.PROCESADO_MASIVO).setValue(new Date()).setNumberFormat('yyyy-mm-dd hh:mm');
  _configCache = null;

  // Marcar el PDF de esta factura como rectificado en el registro masivo,
  // para que un repaso no vuelva a procesarlo.
  try { _marcarFacturaComoRectificadaEnRegistro(numBuscado); } catch (e) { }

  refrescarSeguimiento();
  return { ok: true, mensaje: 'Factura ' + numBuscado + ' actualizada', pdfId: pdfIdFinal };
}

