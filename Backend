function _extraerConGemini(base64, mimeType, nombreArchivo) {
  if (!GEMINI_API_KEY || !String(GEMINI_API_KEY).trim()) {
    return { ok: false, error: 'GEMINI_API_KEY no configurada' };
  }
  let byteLength = 0;
  try { byteLength = Utilities.base64Decode(base64).length; }
  catch (e) { return { ok: false, error: 'Base64 inválido: ' + e.message }; }
  if (byteLength > GEMINI_MAX_BYTES_INLINE) {
    return { ok: false, error: 'PDF demasiado grande (' + (byteLength / 1024 / 1024).toFixed(1) + ' MB > 20 MB)' };
  }
  const mime = mimeType || 'application/pdf';
  const url = 'https://generativelanguage.googleapis.com/v1beta/models/' +
    GEMINI_MODEL + ':generateContent?key=' + encodeURIComponent(GEMINI_API_KEY);
  const payload = {
    contents: [{
      parts: [
        { text: GEMINI_PROMPT },
        { inline_data: { mime_type: mime, data: base64 } }
      ]
    }],
    generationConfig: {
      temperature: 0.0, topP: 0.1, topK: 1,
      maxOutputTokens: 4096,
      responseMimeType: 'application/json'
    }
  };
  let res;
  try {
    res = UrlFetchApp.fetch(url, {
      method: 'post', contentType: 'application/json',
      payload: JSON.stringify(payload), muteHttpExceptions: true,
      timeout: GEMINI_TIMEOUT
    });
  } catch (e) { return { ok: false, error: 'Red: ' + e.message }; }
  const code = res.getResponseCode();
  const body = res.getContentText();
  if (code !== 200) {
    let detalle = body.slice(0, 400);
    try {
      const err = JSON.parse(body);
      if (err.error && err.error.message) detalle = err.error.message;
    } catch (e) { }
    return { ok: false, error: 'HTTP ' + code + ' · ' + detalle };
  }
  let json;
  try { json = JSON.parse(body); } catch (e) { return { ok: false, error: 'Respuesta no-JSON' }; }
  const cands = json.candidates || [];
  if (!cands.length) {
    const block = json.promptFeedback && json.promptFeedback.blockReason;
    return { ok: false, error: 'Sin candidatos' + (block ? ' (bloqueado: ' + block + ')' : '') };
  }
  const cand = cands[0];
  if (cand.finishReason && cand.finishReason !== 'STOP' && cand.finishReason !== 'MAX_TOKENS') {
    return { ok: false, error: 'finishReason: ' + cand.finishReason };
  }
  const parts = (cand.content && cand.content.parts) || [];
  let texto = '';
  for (const p of parts) { if (p && p.text) texto += p.text; }
  if (!texto.trim()) return { ok: false, error: 'Contenido vacío' };
  texto = texto.trim();
  if (texto.startsWith('```')) {
    texto = texto.replace(/^```(?:json)?\s*/i, '').replace(/```\s*$/, '').trim();
  }
  let campos;
  try { campos = JSON.parse(texto); }
  catch (e) { return { ok: false, error: 'JSON inválido' }; }

  const out = {
    fDTE: true,
    fEmpresa: String(campos.fEmpresa || '').trim() || 'EMOAC',
    fNumero: String(campos.fNumero || '').replace(/^0+/, '').trim(),
    fCodigo: String(campos.fCodigo || '').trim(),
    fRut: String(campos.fRut || '').trim(),
    fPeriodo: String(campos.fPeriodo || '').trim(),
    fEmision: String(campos.fEmision || '').trim(),
    fVencimiento: String(campos.fVencimiento || '').trim(),
    fKwh: _inputANumero(campos.fKwh),
    fSum: Math.round(_inputANumero(campos.fSum)),
    fPeaje: Math.round(_inputANumero(campos.fPeaje)),
    fInt: Math.round(_inputANumero(campos.fInt)),
    fIntPeaje: Math.round(_inputANumero(campos.fIntPeaje)),
    fTotal: Math.round(_inputANumero(campos.fTotal)),
    fTipo: String(campos.fTipo || 'CONSUMO').toUpperCase()
  };
  if (['SUMINISTRO', 'PEAJE', 'UNIFICADA', 'ARRIENDO_MEDIDOR'].indexOf(out.fTipo) === -1) {
    out.fTipo = 'SUMINISTRO';
  }
  if (/^\d{2}-\d{4}$/.test(out.fPeriodo)) {
    const p = out.fPeriodo.split('-');
    out.fPeriodo = p[1] + '-' + p[0];
  }
  if (out.fEmision && !/^\d{4}-\d{2}-\d{2}$/.test(out.fEmision)) {
    const f = _parseFechaDMY(out.fEmision); if (f) out.fEmision = f;
  }
  if (out.fVencimiento && !/^\d{4}-\d{2}-\d{2}$/.test(out.fVencimiento)) {
    const f = _parseFechaDMY(out.fVencimiento); if (f) out.fVencimiento = f;
  }
  return { ok: true, campos: out, motor: 'Gemini (' + GEMINI_MODEL + ')' };
}

function _parsearConCascadaBack(base64, mime, nombre) {
  _diagReset(nombre || 'factura.pdf');

  let mejorCampos = null;
  let mejorFuente = '';
  let mejorScore = -1;

  const _evaluar = (fuente, campos, chars, preview) => {
    const ok = _camposSonUtilizables(campos);
    _diagIntentar(fuente, true, { campos, chars, preview });
    const det = _contarCamposDetectadosBack(campos);
    if (det.total > mejorScore) {
      mejorScore = det.total;
      mejorCampos = campos;
      mejorFuente = fuente;
    }
    return ok;
  };

  if (_driveOcrEstaBloqueado()) {
    _diagIntentar('Drive OCR', false, { error: 'Cuota agotada (saltado)' });
  } else {
    const r1 = _extraerConDriveOCR(nombre, base64, mime);
    if (r1.ok && r1.texto) {
      const campos = _parsearFacturaCompleta(r1.texto);
      if (_evaluar('Drive OCR', campos, r1.texto.length, r1.texto)) {
        _diagReporteFinal(campos, 'Drive OCR', true);
        return { ok: true, campos, fuente: 'Drive OCR' };
      }
    } else {
      _diagIntentar('Drive OCR', false, { error: r1.error });
    }
  }

  const r2 = _extraerConOCRSpace(nombre, base64, mime);
  if (r2.ok && r2.texto) {
    const campos = _parsearFacturaCompleta(r2.texto);
    if (_evaluar('OCR.space', campos, r2.texto.length, r2.texto)) {
      _diagReporteFinal(campos, 'OCR.space', true);
      return { ok: true, campos, fuente: 'OCR.space' };
    }
  } else {
    _diagIntentar('OCR.space', false, { error: r2.error });
  }

  if (GEMINI_API_KEY && String(GEMINI_API_KEY).trim()) {
    const g = _extraerConGemini(base64, mime, nombre);
    if (g.ok && g.campos) {
      if (_evaluar('Gemini (último recurso)', g.campos, 0, '')) {
        _diagReporteFinal(g.campos, 'Gemini (último recurso)', true);
        return { ok: true, campos: g.campos, fuente: 'Gemini (último recurso)' };
      }
    } else {
      _diagIntentar('Gemini (último recurso)', false, { error: g.error });
    }
  } else {
    _diagIntentar('Gemini', false, { error: 'No configurado' });
  }

  _diagReporteFinal(mejorCampos, mejorFuente || '(ninguna)', false);
  return { ok: !!mejorCampos, campos: mejorCampos, fuente: mejorFuente, parcial: true };
}

