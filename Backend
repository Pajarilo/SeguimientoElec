function _enviarCorreoTransicion(r) {
  const l = [];
  l.push('📥 Procesamiento carpeta de transición · ' + new Date().toLocaleString('es-CL'));
  l.push('');
  l.push('PDFs en carpeta:     ' + r.total);
  l.push('Procesados:          ' + r.procesados);
  l.push('Saltados (ya OK):    ' + r.saltados);
  l.push('');
  l.push('Resultados:');
  l.push('  ✓ Nuevas (movidas):    ' + r.okNuevas);
  l.push('  · Sin centro:          ' + r.sinCentro);
  l.push('  · Rectificadas:        ' + r.rectificadas);
  l.push('  · Duplicadas:          ' + r.duplicadas);
  l.push('  · Rev. manual (diffs): ' + r.revManual);
  l.push('  · Rev. manual PDF:     ' + r.revisionManual);
  l.push('  · Errores:             ' + r.errores);

  if (r.detalleOk.length) {
    l.push('');
    l.push('── NUEVAS / SIN CENTRO ──');
    r.detalleOk.forEach(d => {
      l.push('· ' + d.archivo + '  →  N° ' + d.numero + '  ·  ' + (d.centro || '?'));
      if (d.warnings) l.push('   ⚠ ' + d.warnings);
    });
  }

  if (r.detalleRectificadas.length) {
    l.push('');
    l.push('── RECTIFICADAS / CAMBIOS ──');
    r.detalleRectificadas.forEach(d => {
      l.push('· ' + d.archivo + '  →  N° ' + d.numero);
      if (d.diffs) {
        l.push('   Diferencias:');
        d.diffs.split('\n').forEach(x => l.push('   ' + x));
      }
      if (d.warnings) l.push('   ⚠ ' + d.warnings);
    });
  }

  if (r.detalleFallidos.length) {
    l.push('');
    l.push('── FALLIDOS (detalle completo) ──');
    r.detalleFallidos.forEach(d => {
      l.push('· ' + d.archivo);
      l.push('   ' + (d.motivo || 'sin detalle'));
    });
  }

  if (r.tiempoAgotado) {
    l.push('');
    l.push('⏸ Quedan ' + r.restantes + ' PDFs para la próxima ejecución.');
  }

  MailApp.sendEmail({
    to: CORREO_TRANSICION,
    subject: '📥 Transición · ' + r.procesados + ' procesadas (' +
      r.okNuevas + ' ok, ' + r.errores + ' errores)',
    body: l.join('\n')
  });
}