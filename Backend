function importarFacturasFront(facturas) {
  if (!Array.isArray(facturas) || !facturas.length) throw new Error('Sin facturas');
  const ss = SpreadsheetApp.openById(SS_ID);
  const sh = ss.getSheetByName(HOJA_RESUMEN);
  const existentes = leerResumen();
  const filas = []; const errores = []; let duplicadas = 0;
  facturas.forEach(function (f, idx) {
    if (!f.numero) { errores.push('Fila ' + (idx + 1) + ': sin N° factura'); return; }
    if (!f.cliente) { errores.push('Fila ' + (idx + 1) + ': sin centro'); return; }
    if (!f.periodo) { errores.push('Fila ' + (idx + 1) + ': sin período'); return; }
    let tipo = (f.tipo || 'SUMINISTRO').toUpperCase();
    if (tipo === 'CONSUMO') tipo = 'SUMINISTRO';
    const dup = existentes.find(e => e.numero === String(f.numero).trim() && e.cliente === f.cliente && e.periodo === f.periodo && e.tipo === tipo);
    if (dup) { duplicadas++; return; }
    const fC = (tipo === 'SUMINISTRO' || tipo === 'UNIFICADA') && f.fechaConsumo ? parseISO(f.fechaConsumo) : '';
    const fP = (tipo === 'PEAJE' || tipo === 'UNIFICADA') && f.fechaPeaje ? parseISO(f.fechaPeaje) : '';
    const fE = f.fechaEmision ? parseISO(f.fechaEmision) : '';
    const fV = f.fechaVencimiento ? parseISO(f.fechaVencimiento) : '';
    filas.push([String(f.numero).trim(), f.codigo || '', f.cliente, f.periodo, tipo,
    Number(f.kwh) || 0, Number(f.sum) || 0, Number(f.peaje) || 0,
    Number(f.intereses) || 0, Number(f.otros) || 0,
    Number(f.intPeaje) || 0, Number(f.otrosPeaje) || 0,
    Number(f.total) || 0, fC, fP, fE, fV, '', '']);
  });
  if (filas.length) {
    const sr = sh.getLastRow() + 1;
    // Fijar formatos ANTES del setValues para que las fechas queden como Date
    sh.getRange(sr, COL.CODIGO, filas.length, 1).setNumberFormat('@');
    sh.getRange(sr, COL.PERIODO, filas.length, 1).setNumberFormat('@');
    sh.getRange(sr, COL.FECHA_SUMINISTRO, filas.length, 4).setNumberFormat('dd/mm/yyyy');
    sh.getRange(sr, COL.KWH, filas.length, 1).setNumberFormat('#,##0.00');
    sh.getRange(sr, COL.SUM, filas.length, 7).setNumberFormat('$#,##0');
    sh.getRange(sr, 1, filas.length, filas[0].length).setValues(filas);
    refrescarSeguimiento();
  }
  return { ok: true, importadas: filas.length, duplicadas: duplicadas, errores: errores };
}

// ============================================================
//  KPIs
// ============================================================
function calcularResumen() {
  const facturas = leerResumen();
  const hoy = new Date(); hoy.setHours(0, 0, 0, 0);
  const acc = { total_facturas: facturas.length, total_suministro: 0, total_peaje: 0, total_intereses: 0, total_otros: 0, total_facturado: 0, recibidas: 0, pendientes: 0, porEmitir: 0, dentroPlazo: 0, sinInfo: 0, noAplica: 0 };
  facturas.forEach(function (f) {
    acc.total_suministro += f.sum; acc.total_peaje += f.peaje;
    acc.total_intereses += (f.intereses + (f.intPeaje || 0));
    acc.total_otros += (f.otros + (f.otrosPeaje || 0));
    acc.total_facturado += f.total;
    const _esSentinel = (v) => SENTINELAS.indexOf(String(v || '').trim()) !== -1;
    if (f.fechaConsumo === 'N/A' || f.fechaPeaje === 'N/A') { acc.noAplica++; return; }
    if (f.fechaConsumo === 'S/I' || f.fechaPeaje === 'S/I') { acc.sinInfo++; return; }
    // 'Sin fecha' es un sentinel de recepción sin día: no cuenta como fecha real.
    // (No lo clasificamos como S/I ni N/A, sino que cae al flujo de pendientes.)
    const _sinFechaConsumo = f.fechaConsumo === SENTINELA_SIN_FECHA;
    const _sinFechaPeaje   = f.fechaPeaje   === SENTINELA_SIN_FECHA;
    let tieneFecha;
    if (f.tipo === 'UNIFICADA') {
      tieneFecha = f.fechaConsumo && f.fechaPeaje && !_sinFechaConsumo && !_sinFechaPeaje;
    } else if (f.tipo === 'PEAJE') {
      tieneFecha = !!f.fechaPeaje && !_sinFechaPeaje;
    } else {
      tieneFecha = !!f.fechaConsumo && !_sinFechaConsumo;
    }
    if (tieneFecha) { acc.recibidas++; return; }
    const p = f.periodo.split('-').map(Number);
    const pm = p[0] * 12 + (p[1] - 1);
    const hm = hoy.getFullYear() * 12 + hoy.getMonth();
    if (pm >= hm) { acc.porEmitir++; return; }
    const sinInfo = !f.kwh && !f.sum && !f.peaje && !f.total;
    if (sinInfo) { acc.sinInfo++; return; }
    const dl = fechaObjetivoJS(f.periodo);
    if (hoy <= dl) acc.dentroPlazo++;
    else acc.pendientes++;
  });
  return acc;
}

