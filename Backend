function _setCeldaNum(sh, fila, col, val) {
  if (val === undefined || val === null || val === '') return false;
  const n = Number(val);
  if (!isFinite(n) || n <= 0) return false;
  sh.getRange(fila, col).setValue(n);
  return true;
}
function _setCeldaFecha(sh, fila, col, iso) {
  if (!iso) return false;
  const s = String(iso).trim();
  const c = sh.getRange(fila, col);
  if (SENTINELAS.indexOf(s) !== -1) {
    c.setNumberFormat('@');
    c.setValue(s);
    return true;
  }
  if (!/^\d{4}-\d{2}-\d{2}$/.test(s)) return false;
  const p = s.split('-').map(Number);
  c.setNumberFormat('dd/mm/yyyy');
  c.setValue(new Date(p[0], p[1] - 1, p[2]));
  return true;
}
function _setCeldaTexto(sh, fila, col, val) {
  if (val === undefined || val === null) return false;
  const s = String(val).trim();
  if (!s) return false;
  sh.getRange(fila, col).setValue(s).setNumberFormat('@');
  return true;
}

