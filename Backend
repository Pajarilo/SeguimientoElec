function parseDriveId(input) {
  if (!input) return '';
  const s = String(input).trim();
  if (!s) return '';
  if (/^[a-zA-Z0-9_-]{15,}$/.test(s)) return s;
  let m = s.match(/[?&]id=([^&\s]+)/);
  if (m) return decodeURIComponent(m[1]);
  m = s.match(/\/(?:folders|d)\/([^\/?\s&]+)/);
  if (m) return decodeURIComponent(m[1]);
  return s;
}

function subirFacturaDrive(codigoCliente, nombreArchivo, base64, mimeType) {
  const codigo = String(codigoCliente || '').trim();
  if (!codigo) return { ok: false, error: 'Falta el código de cliente.' };
  const config = leerConfig();
  const centro = config.centros.find(c => c.codigo === codigo);
  if (!centro) return { ok: false, error: 'Centro "' + codigo + '" no encontrado en Config.' };
  if (!centro.driveOp) return { ok: false, error: 'El centro "' + centro.cliente + '" no tiene Drive de Operaciones configurado.' };
  const bytes = Utilities.base64Decode(base64);
  const nombre = nombreArchivo || 'factura.pdf';
  const mime = mimeType || 'application/pdf';
  const archivos = [];
  const errores = [];
  if (centro.driveOp) {
    try {
      const f = DriveApp.getFolderById(centro.driveOp).createFile(Utilities.newBlob(bytes, mime, nombre));
      archivos.push({ carpeta: 'Drive de Operaciones', id: f.getId(), url: f.getUrl(), nombre: f.getName() });
    } catch (e) { errores.push({ carpeta: 'Drive de Operaciones', error: e.message }); }
  }
  if (centro.driveCom) {
    try {
      const f = DriveApp.getFolderById(centro.driveCom).createFile(Utilities.newBlob(bytes, mime, nombre));
      archivos.push({ carpeta: 'Drive de la Comunidad', id: f.getId(), url: f.getUrl(), nombre: f.getName() });
    } catch (e) { errores.push({ carpeta: 'Drive de la Comunidad', error: e.message }); }
  }
  if (!archivos.length) {
    return { ok: false, error: 'No se pudo subir. ' + errores.map(e => e.carpeta + ': ' + e.error).join(' · ') };
  }
  return { ok: true, archivos, errores, centro: centro.cliente };
}

function vincularPDFDrive(numero, urlOrId, nombreArchivo, forzar) {
  const id = parseDriveId(urlOrId);
  if (!id) return { ok: false, error: 'Falta el ID o URL del archivo' };

  let file;
  try { file = DriveApp.getFileById(id); }
  catch (e) { return { ok: false, error: 'No se pudo acceder al archivo: ' + e.message }; }

  const sh = SpreadsheetApp.openById(SS_ID).getSheetByName(HOJA_RESUMEN);
  const data = sh.getDataRange().getValues();
  const numBuscado = String(numero).trim();

  const filasDestino   = [];
  const filasConflicto = [];

  for (let i = 1; i < data.length; i++) {
    const numFila = String(data[i][COL.NUMERO - 1] || '').trim();
    const idFila  = String(data[i][COL.PDF_ID  - 1] || '').trim();
    if (numFila === numBuscado) {
      filasDestino.push(i + 1);
    } else if (idFila === id) {
      filasConflicto.push({
        fila:    i + 1,
        numero:  numFila,
        cliente: String(data[i][COL.CLIENTE - 1] || '').trim(),
        periodo: String(data[i][COL.PERIODO - 1] || '').trim()
      });
    }
  }

  if (!filasDestino.length) {
    return { ok: false, error: 'Factura no encontrada: ' + numBuscado };
  }

  if (filasConflicto.length && !forzar) {
    return {
      ok: false,
      conflicto: true,
      id: id,
      numeroNuevo: numBuscado,
      facturasEnConflicto: filasConflicto.map(x => ({
        numero:  x.numero,
        cliente: x.cliente,
        periodo: x.periodo
      }))
    };
  }

  if (nombreArchivo) {
    try { file.setName(String(nombreArchivo).trim()); } catch (e) { }
  }

  filasConflicto.forEach(x => {
    const c = sh.getRange(x.fila, COL.PDF_ID);
    c.setValue('');
    c.setNumberFormat('@');
  });

  filasDestino.forEach(fr => {
    const c = sh.getRange(fr, COL.PDF_ID);
    c.setValue(id);
    c.setNumberFormat('@');
  });

  return {
    ok: true,
    id: id,
    url: 'https://drive.google.com/file/d/' + id + '/view',
    nombre: file.getName(),
    asociados: filasDestino.length,
    desvinculados: filasConflicto.length,
    facturasDesvinculadas: filasConflicto.map(x => ({
      numero:  x.numero,
      cliente: x.cliente,
      periodo: x.periodo
    }))
  };
}

function reemplazarPDFFactura(numero, nuevoId) {
  const num = String(numero || '').trim();
  const id  = parseDriveId(nuevoId);
  if (!num) return { ok: false, error: 'Falta N° factura' };
  if (!id)  return { ok: false, error: 'Falta ID de Drive' };

  let file;
