const HANDLER_TRANSICION = 'procesarCarpetaTransicionTrigger';
const CORREO_TRANSICION = 'rnavarro@usurbanrealty.com';
const TIEMPO_MAX_TRANSICION_MS = 4 * 60 * 1000;


function procesarCarpetaTransicionTrigger() {
  try {
    const r = procesarCarpetaTransicion({ silencioso: true });
    Logger.log('[Trigger transición] ' + JSON.stringify({
      ok: r.ok, procesados: r.procesados, okNuevas: r.okNuevas,
