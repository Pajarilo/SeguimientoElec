const SENTINELA_SIN_FECHA = 'Sin fecha';
const SENTINELAS = [SENTINELA_SIN_FECHA, 'N/A', 'S/I'];

function formatearFechaSegura(valor, tz) {
  if (valor === null || valor === undefined || valor === '') return '';
  if (valor instanceof Date) {
    if (isNaN(valor.getTime())) return '';
    return Utilities.formatDate(valor, tz, 'yyyy-MM-dd');
  }
  const s = String(valor).trim();
  if (SENTINELAS.indexOf(s) !== -1) return s;
  if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
  const m = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);
  if (m) return m[3] + '-' + m[2].padStart(2, '0') + '-' + m[1].padStart(2, '0');
  const d = new Date(s);
  if (!isNaN(d.getTime())) return Utilities.formatDate(d, tz, 'yyyy-MM-dd');
  return '';
}

function normalizarPeriodoLectura(valor) {
  if (valor === null || valor === undefined || valor === '') return '';
  if (valor instanceof Date) {
    if (isNaN(valor.getTime())) return '';
    return valor.getFullYear() + '-' + String(valor.getMonth() + 1).padStart(2, '0');
  }
  const s = String(valor).trim();
  if (/^\d{4}-\d{1,2}$/.test(s)) {
    const p = s.split('-');
    return p[0] + '-' + String(parseInt(p[1], 10)).padStart(2, '0');
  }
  return s;
}

function parseISO(iso) {
  const s = String(iso == null ? '' : iso).trim();
  if (!s) return '';
  let m = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
  if (m) return new Date(+m[1], +m[2] - 1, +m[3]);
  m = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);
  if (m) return new Date(+m[3], +m[2] - 1, +m[1]);
  return s;
}

function fechaObjetivoJS(periodo) {
  const p = periodo.split('-').map(Number);
  const y = p[0], m = p[1];
  const ny = m === 12 ? y + 1 : y;
  const nm = m === 12 ? 1 : m + 1;
  return new Date(ny, nm - 1, DIA_RECEPCION, 0, 0, 0, 0);
}

function formatFechaCorta(iso) {
  if (!iso) return '';
  const s = String(iso);
  if (SENTINELAS.indexOf(s) !== -1) return s;
  const p = s.split('-');
  if (p.length < 3) return s;
  return p[2] + '/' + p[1];
}

