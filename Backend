function actualizarFacturaFront(datos, idDrive) {
  if (!datos || !datos.numero) return { ok: false, error: 'Falta el N° de factura' };
  if (!datos.cliente) return { ok: false, error: 'Falta el centro de costo' };
  if (!datos.periodo) return { ok: false, error: 'Falta el período' };
  const sh = SpreadsheetApp.openById(SS_ID).getSheetByName(HOJA_RESUMEN);
  if (!sh) return { ok: false, error: 'No existe hoja Resumen' };
  const data = sh.getDataRange().getValues();
  const numBuscado = String(datos.numero).trim();
  let tipoBuscado = String(datos.tipo || '').toUpperCase();
  if (tipoBuscado === 'CONSUMO') tipoBuscado = 'SUMINISTRO';
  const cliBuscado = String(datos.cliente || '').trim();
  const perBuscado = String(datos.periodo || '').trim();
  let fila = -1;
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][COL.NUMERO - 1]).trim() === numBuscado) { fila = i + 1; break; }
  }
  if (fila === -1) return { ok: false, error: 'Factura no encontrada: ' + numBuscado };
  const pdfIdActual = String(sh.getRange(fila, COL.PDF_ID).getValue() || '').trim();
  const celda = (col) => sh.getRange(fila, col);
  celda(COL.NUMERO).setValue(numBuscado);
  celda(COL.CLIENTE).setValue(cliBuscado);
  celda(COL.PERIODO).setValue(perBuscado).setNumberFormat('@');
  if (datos.codigo) celda(COL.CODIGO).setValue(String(datos.codigo).trim()).setNumberFormat('@');
  if (['SUMINISTRO', 'PEAJE', 'UNIFICADA', 'ARRIENDO_MEDIDOR'].indexOf(tipoBuscado) !== -1) celda(COL.TIPO).setValue(tipoBuscado);
  const _n = (v) => Number(v) || 0;
  celda(COL.KWH).setValue(_n(datos.kwh));
  celda(COL.SUM).setValue(_n(datos.sum));
  celda(COL.PEAJE).setValue(_n(datos.peaje));
  celda(COL.INT).setValue(_n(datos.intereses));
  celda(COL.INT_PEAJE).setValue(_n(datos.intPeaje));
  celda(COL.TOTAL).setValue(_n(datos.total));
  const _setFecha = (col, iso) => {
    const c = celda(col);
    if (!iso) { c.setValue(''); return; }
    const s = String(iso).trim();
    if (SENTINELAS.indexOf(s) !== -1) {
      c.setNumberFormat('@');
      c.setValue(s);
      return;
    }
    const p = s.split('-').map(Number);
    if (isNaN(p[0]) || isNaN(p[1]) || isNaN(p[2])) { c.setValue(''); return; }
    c.setNumberFormat('dd/mm/yyyy');
    c.setValue(new Date(p[0], p[1] - 1, p[2]));
  };
  const _fRecepVal = (aplica, fechaExplicita) => {
    if (!aplica) return null;
    const src = (fechaExplicita != null && fechaExplicita !== '')
      ? fechaExplicita
      : datos.fecha;
    if (!src) return null;
    const s = String(src).trim();
    if (SENTINELAS.indexOf(s) !== -1) return s;
    return s;
  };
  const fC = _fRecepVal(
    tipoBuscado === 'CONSUMO' || tipoBuscado === 'SUMINISTRO' || tipoBuscado === 'UNIFICADA',
    datos.fechaConsumo
  );
  const fP = _fRecepVal(
    tipoBuscado === 'PEAJE' || tipoBuscado === 'UNIFICADA',
    datos.fechaPeaje
  );
  if (fC !== null) _setFecha(COL.FECHA_SUMINISTRO, fC);
  if (fP !== null) _setFecha(COL.FECHA_PEAJE,   fP);
  _setFecha(COL.FECHA_EMISION, datos.fechaEmision);
  _setFecha(COL.FECHA_VENC, datos.fechaVencimiento);
  let pdfIdFinal = pdfIdActual;
  if (idDrive) {
    const idNuevo = String(idDrive).trim();
    if (!pdfIdActual) { celda(COL.PDF_ID).setValue(idNuevo).setNumberFormat('@'); pdfIdFinal = idNuevo; }
    else if (pdfIdActual !== idNuevo) {
      let pagActual = 0, pagNuevo = 0;
      try { pagActual = _contarPaginasPdf(pdfIdActual); } catch (e) { }
      try { pagNuevo = _contarPaginasPdf(idNuevo); } catch (e) { }
      if (pagNuevo > pagActual) { celda(COL.PDF_ID).setValue(idNuevo).setNumberFormat('@'); pdfIdFinal = idNuevo; }
    }
  }
  celda(COL.PROCESADO_MASIVO).setValue(new Date()).setNumberFormat('yyyy-mm-dd hh:mm');
  _configCache = null;

  try { _marcarFacturaComoRectificadaEnRegistro(numBuscado); } catch (e) { }

  refrescarSeguimiento();
  return { ok: true, mensaje: 'Factura ' + numBuscado + ' actualizada', pdfId: pdfIdFinal };
}

