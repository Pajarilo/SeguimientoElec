function marcarFacturaRevisada(numero) {
  const num = String(numero || '').trim();
  if (!num) return { ok: false, error: 'Falta el N° de factura' };

  try {
    const sh = SpreadsheetApp.openById(SS_ID).getSheetByName(HOJA_RESUMEN);
    if (!sh) return { ok: false, error: 'No existe hoja Resumen' };

    const lr = Math.max(sh.getLastRow(), 1);
    if (lr < 2) return { ok: false, error: 'Sin filas' };

    const nums = sh.getRange(2, COL.NUMERO, lr - 1, 1).getValues();
    let fila = -1;
    for (let i = 0; i < nums.length; i++) {
      if (String(nums[i][0]).trim() === num) { fila = i + 2; break; }
    }
    if (fila === -1) return { ok: false, error: 'Factura no encontrada: ' + num };

    const c = sh.getRange(fila, COL.PROCESADO_MASIVO);
    c.setValue(new Date());
    c.setNumberFormat('yyyy-mm-dd hh:mm');

    return { ok: true, numero: num, fila: fila };
  } catch (e) {
    return { ok: false, error: String(e.message || e) };
  }
}

