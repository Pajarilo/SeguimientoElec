//  RECTIFICAR
// ============================================================
function rectificarFactura(numero, nuevoCliente, nuevoCodigo, nuevoPeriodo) {
  if (!numero) return { ok: false, error: 'Falta el N° de factura' };
  if (!nuevoCliente && !nuevoPeriodo) return { ok: false, error: 'Nada para rectificar' };
  const sh = SpreadsheetApp.openById(SS_ID).getSheetByName(HOJA_RESUMEN);
  const data = sh.getDataRange().getValues();
  const numBuscado = String(numero).trim();
  let movidas = 0;
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][COL.NUMERO - 1]).trim() !== numBuscado) continue;
    if (nuevoCliente) sh.getRange(i + 1, COL.CLIENTE).setValue(String(nuevoCliente).trim());
    if (nuevoCodigo) {
      const c = sh.getRange(i + 1, COL.CODIGO);
      c.setValue(String(nuevoCodigo).trim()); c.setNumberFormat('@');
    }
    if (nuevoPeriodo) {
      const p = sh.getRange(i + 1, COL.PERIODO);
      p.setValue(String(nuevoPeriodo).trim()); p.setNumberFormat('@');
    }
    movidas++;
  }
  if (movidas === 0) return { ok: false, error: 'Factura no encontrada: ' + numBuscado };
  refrescarSeguimiento();
  return { ok: true, numero: numBuscado, movidas: movidas };
}

