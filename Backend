  sh.getRange(nextRow, 2, 1, 9).setValues([[
    String(centro.rut || '').trim(),
    String(centro.codigo).trim(),
    String(centro.cliente).trim(),
    String(centro.empConsumo || '').trim(),
    String(centro.empPeaje || '').trim(),
    '', '', '',
    String(centro.empresa || 'EMOAC').trim() || 'EMOAC'
  ]]);
