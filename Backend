let _configCacheTs = 0;

function leerConfig() {
  const ahora = Date.now();
  if (_configCache && (ahora - _configCacheTs) < CONFIG_TTL_MS) {
    return _configCache;
  }
  const ss = SpreadsheetApp.openById(SS_ID);
  let sh = ss.getSheetByName(HOJA_CONFIG);
  if (!sh) { sh = ss.insertSheet(HOJA_CONFIG); _initConfig(sh); }
  const lr = Math.max(sh.getLastRow(), 1);
  let periodos = [];
  if (lr >= 2) {
    const vals = sh.getRange(2, 1, lr - 1, 1).getValues();
    periodos = vals.map(r => String(r[0]).trim()).filter(p => /^\d{4}-\d{2}$/.test(p));
  }
  let centros = [];
  if (lr >= 2) {
    const colFin = Math.max(sh.getLastColumn(), 9);
    const nCols = Math.min(9, colFin - 1);
    const vals = sh.getRange(2, 2, lr - 1, nCols).getValues();
    centros = vals
      .filter(r => String(r[1] || '').trim() && String(r[2] || '').trim())
      .map(r => ({
        rut: String(r[0] || '').trim() || String(r[7] || '').trim(),
        codigo: String(r[1]).trim(),
        cliente: String(r[2]).trim(),
        empConsumo: String(r[3] || '').trim(),
        empPeaje: String(r[4] || '').trim(),
        driveOp: String(r[5] || '').trim(),
        driveCom: String(r[6] || '').trim(),
        empresa: String(r[8] || '').trim() || 'EMOAC'
      }));
  }
  _configCache = { periodos: periodos || [], centros: centros || [] };
  _configCacheTs = ahora;
  return _configCache;
}

function _invalidarConfigCache() {
  _configCache = null;
  _configCacheTs = 0;
}

