function parseDriveId(input) {
  if (!input) return '';
  const s = String(input).trim();
  if (!s) return '';
  if (/^[a-zA-Z0-9_-]{15,}$/.test(s)) return s;
  let m = s.match(/[?&]id=([^&\s]+)/);
  if (m) return decodeURIComponent(m[1]);
  m = s.match(/\/(?:folders|d)\/([^\/?\s&]+)/);
  if (m) return decodeURIComponent(m[1]);
  return s;
}

function subirFacturaDrive(codigoCliente, nombreArchivo, base64, mimeType) {
  const codigo = String(codigoCliente || '').trim();
  if (!codigo) return { ok: false, error: 'Falta el código de cliente.' };
  const config = leerConfig();
  const centro = config.centros.find(c => c.codigo === codigo);
  if (!centro) return { ok: false, error: 'Centro "' + codigo + '" no encontrado en Config.' };
  if (!centro.driveOp) return { ok: false, error: 'El centro "' + centro.cliente + '" no tiene Drive de Operaciones configurado.' };
  const bytes = Utilities.base64Decode(base64);
  const nombre = nombreArchivo || 'factura.pdf';
  const mime = mimeType || 'application/pdf';
  const archivos = [];
  const errores = [];
  if (centro.driveOp) {
    try {
      const f = DriveApp.getFolderById(centro.driveOp).createFile(Utilities.newBlob(bytes, mime, nombre));
      archivos.push({ carpeta: 'Drive de Operaciones', id: f.getId(), url: f.getUrl(), nombre: f.getName() });
    } catch (e) { errores.push({ carpeta: 'Drive de Operaciones', error: e.message }); }
  }
  if (centro.driveCom) {
    try {
      const f = DriveApp.getFolderById(centro.driveCom).createFile(Utilities.newBlob(bytes, mime, nombre));
      archivos.push({ carpeta: 'Drive de la Comunidad', id: f.getId(), url: f.getUrl(), nombre: f.getName() });
    } catch (e) { errores.push({ carpeta: 'Drive de la Comunidad', error: e.message }); }
  }
  if (!archivos.length) {
    return { ok: false, error: 'No se pudo subir. ' + errores.map(e => e.carpeta + ': ' + e.error).join(' · ') };
  }
  return { ok: true, archivos, errores, centro: centro.cliente };
}

/**
 * Vincula un PDF (ID de Drive) a la factura indicada.
 *
 * Si el ID ya está asociado a OTRA factura distinta y no se pasa
 * `forzar = true`, no toca nada y devuelve:
 *   { ok: false, conflicto: true, facturasEnConflicto: [...] }
 * para que el frontend ofrezca reasignarlo.
 *
 * Con `forzar = true` desvincula el ID de las facturas anteriores y lo
 * asigna a la nueva.
 */
function vincularPDFDrive(numero, urlOrId, nombreArchivo, forzar) {
  const id = parseDriveId(urlOrId);
  if (!id) return { ok: false, error: 'Falta el ID o URL del archivo' };

  let file;
  try { file = DriveApp.getFileById(id); }
  catch (e) { return { ok: false, error: 'No se pudo acceder al archivo: ' + e.message }; }

  const sh = SpreadsheetApp.openById(SS_ID).getSheetByName(HOJA_RESUMEN);
  const data = sh.getDataRange().getValues();
  const numBuscado = String(numero).trim();

  const filasDestino   = [];   // filas de la factura nueva
  const filasConflicto = [];   // filas de otras facturas que ya tienen este ID

  for (let i = 1; i < data.length; i++) {
    const numFila = String(data[i][COL.NUMERO - 1] || '').trim();
    const idFila  = String(data[i][COL.PDF_ID  - 1] || '').trim();
    if (numFila === numBuscado) {
      filasDestino.push(i + 1);
    } else if (idFila === id) {
      filasConflicto.push({
        fila:    i + 1,
        numero:  numFila,
        cliente: String(data[i][COL.CLIENTE - 1] || '').trim(),
        periodo: String(data[i][COL.PERIODO - 1] || '').trim()
      });
    }
  }

  if (!filasDestino.length) {
    return { ok: false, error: 'Factura no encontrada: ' + numBuscado };
  }

  // Conflicto sin permiso explícito → sólo informar, no modificar nada.
  if (filasConflicto.length && !forzar) {
    return {
      ok: false,
      conflicto: true,
      id: id,
      numeroNuevo: numBuscado,
      facturasEnConflicto: filasConflicto.map(x => ({
        numero:  x.numero,
        cliente: x.cliente,
        periodo: x.periodo
      }))
    };
  }

  // Renombrar sólo cuando ya decidimos aplicar el cambio.
  if (nombreArchivo) {
    try { file.setName(String(nombreArchivo).trim()); } catch (e) {}
  }

  // Desvincular de las facturas anteriores.
  filasConflicto.forEach(x => {
    const c = sh.getRange(x.fila, COL.PDF_ID);
    c.setValue('');
    c.setNumberFormat('@');
  });

  // Asignar a la factura nueva.
  filasDestino.forEach(fr => {
    const c = sh.getRange(fr, COL.PDF_ID);
    c.setValue(id);
    c.setNumberFormat('@');
  });

  return {
    ok: true,
    id: id,
    url: 'https://drive.google.com/file/d/' + id + '/view',
    nombre: file.getName(),
    asociados: filasDestino.length,
    desvinculados: filasConflicto.length,
    facturasDesvinculadas: filasConflicto.map(x => ({
      numero:  x.numero,
      cliente: x.cliente,
      periodo: x.periodo
    }))
  };
}

/**
 * Reemplaza el PDF_ID de una factura por otro (para cuando el
 * original fue a la papelera y el usuario consigue el nuevo ID).
 * No renombra ni copia el archivo nuevo: sólo actualiza la BD.
 * Si el archivo nuevo tiene el nombre estándar, se respeta tal cual.
 */
function reemplazarPDFFactura(numero, nuevoId) {
  const num = String(numero || '').trim();
  const id  = parseDriveId(nuevoId);
  if (!num) return { ok: false, error: 'Falta N° factura' };
  if (!id)  return { ok: false, error: 'Falta ID de Drive' };

  // Confirmar acceso al archivo nuevo.
  let file;
  try { file = DriveApp.getFileById(id); }
  catch (e) { return { ok: false, error: 'No se puede acceder al archivo: ' + e.message }; }

  // Detectar si el archivo nuevo está en papelera.
  let enPapelera = false;
  try { enPapelera = file.isTrashed(); } catch (e) {}
  if (enPapelera) return { ok: false, error: 'El archivo indicado está en la papelera.' };

  const sh = SpreadsheetApp.openById(SS_ID).getSheetByName(HOJA_RESUMEN);
  const data = sh.getDataRange().getValues();
  let fila = -1;
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][COL.NUMERO - 1]).trim() === num) { fila = i + 1; break; }
  }
  if (fila === -1) return { ok: false, error: 'Factura no encontrada: ' + num };

  const c = sh.getRange(fila, COL.PDF_ID);
  c.setValue(id);
  c.setNumberFormat('@');

  return {
    ok: true,
    numero: num,
    id: id,
    nombre: file.getName(),
    url: file.getUrl()
  };
}

/**
 * Verifica el estado del archivo apuntado por un PDF_ID:
 *   · ok         → existe y no está en papelera
 *   · papelera   → existe pero está trashed
 *   · inexistente→ no se puede acceder (borrado definitivo o sin permisos)
 */
function verificarEstadoPDF(id) {
  const limpio = parseDriveId(id);
  if (!limpio) return { ok: false, estado: 'inexistente', error: 'ID vacío' };
  try {
    const file = DriveApp.getFileById(limpio);
    let trashed = false;
    try { trashed = file.isTrashed(); } catch (e) {}
    if (trashed) {
      return { ok: true, estado: 'papelera', id: limpio, nombre: file.getName() };
    }
    return {
      ok: true, estado: 'ok', id: limpio,
      nombre: file.getName(), url: file.getUrl()
    };
  } catch (e) {
    return { ok: false, estado: 'inexistente', error: String(e.message || e) };
  }
}

/**
 * Busca en el Drive de Operaciones (y, si aplica, en el de la Comunidad)
 * del centro un archivo cuyo nombre contenga el N° de factura.
 * Devuelve el PRIMER match encontrado con su metadata.
 *
 * @param {string} codigo    Código del centro (clave en Config)
 * @param {string} numero    N° de factura a buscar en el nombre
 * @returns {{
 *   ok: boolean,
 *   encontrado: boolean,
 *   id?: string, nombre?: string, url?: string,
 *   carpeta?: 'Operaciones'|'Comunidad',
 *   error?: string
 * }}
 */
function _buscarPDFEnDriveDelCentro(codigo, numero) {
  const cod = String(codigo || '').trim();
  const num = String(numero || '').trim();
  if (!cod) return { ok: false, encontrado: false, error: 'Falta código de centro' };
  if (!num) return { ok: false, encontrado: false, error: 'Falta N° de factura' };

  const cfg = leerConfig();
  const centro = cfg.centros.find(c => String(c.codigo || '').trim() === cod);
  if (!centro) return { ok: false, encontrado: false, error: 'Centro no encontrado: ' + cod };

  const carpetas = [];
  if (centro.driveOp)  carpetas.push({ tipo: 'Operaciones', id: centro.driveOp });
  if (centro.driveCom && centro.driveCom !== centro.driveOp) {
    carpetas.push({ tipo: 'Comunidad', id: centro.driveCom });
  }
  if (!carpetas.length) {
    return { ok: false, encontrado: false, error: 'El centro no tiene Drive configurado' };
  }

  // El N° puede venir con o sin ceros a la izquierda. Se busca por
  // coincidencia parcial del número (con word boundary) para tolerar
  // nombres como "..._56390_..." o "..._00056390_...".
  const numLimpio = num.replace(/^0+/, '') || num;
  const reNum = new RegExp('(?:^|[^0-9])0*' + numLimpio + '(?:[^0-9]|$)');

  for (const carpeta of carpetas) {
    let folder;
    try { folder = DriveApp.getFolderById(carpeta.id); }
    catch (e) { continue; }   // carpeta inaccesible → siguiente

    const files = folder.getFiles();
    while (files.hasNext()) {
      const f = files.next();
      let nombre = '';
      try { nombre = f.getName(); } catch (e) { continue; }

      // Sólo PDFs y que contengan el N° de factura.
      if (!/\.pdf$/i.test(nombre)) continue;
      if (!reNum.test(nombre)) continue;

      // Verificar que no esté en papelera (por las dudas).
      let trashed = false;
      try { trashed = f.isTrashed(); } catch (e) {}
      if (trashed) continue;

      return {
        ok: true,
        encontrado: true,
        id: f.getId(),
        nombre: nombre,
        url: f.getUrl(),
        carpeta: carpeta.tipo
      };
    }
  }

  return {
    ok: true,
    encontrado: false,
    error: 'No se encontró ningún PDF con N° ' + num + ' en los Drives del centro'
  };
}

/**
 * Copia (o renombra in-place) un PDF ya existente en Drive a los
 * repositorios de Operaciones y Comunidad del centro indicado.
 * Si el archivo ya está en alguno de ellos, sólo lo renombra.
 * Si no está, lo copia.
 *
 * @param {string} idOrigen       ID o URL del archivo PDF
 * @param {string} codigoCliente  Código del centro (clave en Config)
 * @param {string} nombreArchivo  Nombre final del archivo (con .pdf)
 * @returns {{ ok:boolean, archivos?:Array, errores?:Array, centro?:string, error?:string }}
 */
function copiarPDFDriveADestinos(idOrigen, codigoCliente, nombreArchivo) {
  const codigo = String(codigoCliente || '').trim();
  if (!codigo) return { ok: false, error: 'Falta el código de cliente' };
  const id = parseDriveId(idOrigen);
  if (!id) return { ok: false, error: 'Falta el ID del archivo origen' };
  const config = leerConfig();
  const centro = config.centros.find(c => c.codigo === codigo);
  if (!centro) return { ok: false, error: 'Centro no encontrado: ' + codigo };
  if (!centro.driveOp && !centro.driveCom) return { ok: false, error: 'El centro "' + centro.cliente + '" no tiene Drive configurado.' };
  let fileOrigen;
  try { fileOrigen = DriveApp.getFileById(id); }
  catch (e) { return { ok: false, error: 'No se pudo acceder al archivo de origen: ' + e.message }; }
  const nombre = String(nombreArchivo || fileOrigen.getName() || 'factura.pdf').trim();
  const foldersOrigen = {};
  try {
    const parents = fileOrigen.getParents();
    while (parents.hasNext()) { foldersOrigen[parents.next().getId()] = true; }
  } catch (e) { }
  const enOp = centro.driveOp && foldersOrigen[centro.driveOp];
  const enCom = centro.driveCom && foldersOrigen[centro.driveCom];
  const opIgualCom = centro.driveOp && centro.driveCom && centro.driveOp === centro.driveCom;
  const archivos = [];
  const errores = [];
  if (enOp || enCom || opIgualCom) {
    try {
      fileOrigen.setName(nombre);
      archivos.push({
        carpeta: enOp && enCom ? 'Operaciones + Comunidad' : enOp ? 'Drive de Operaciones' : 'Drive de la Comunidad',
        id: fileOrigen.getId(), url: fileOrigen.getUrl(), nombre: fileOrigen.getName(), accion: 'renombrado'
      });
    } catch (e) { errores.push({ carpeta: 'Renombrado', error: e.message }); }
    if (!enCom && centro.driveCom && !opIgualCom) {
      try {
        const blob = fileOrigen.getBlob(); const bytes = blob.getBytes();
        const mime = blob.getContentType() || 'application/pdf';
        const nueva = DriveApp.getFolderById(centro.driveCom).createFile(Utilities.newBlob(bytes, mime, nombre));
        archivos.push({ carpeta: 'Drive de la Comunidad', id: nueva.getId(), url: nueva.getUrl(), nombre: nueva.getName(), accion: 'copiado' });
      } catch (e) { errores.push({ carpeta: 'Drive de la Comunidad', error: e.message }); }
    }
    if (!enOp && centro.driveOp && !opIgualCom) {
      try {
        const blob = fileOrigen.getBlob(); const bytes = blob.getBytes();
        const mime = blob.getContentType() || 'application/pdf';
        const nueva = DriveApp.getFolderById(centro.driveOp).createFile(Utilities.newBlob(bytes, mime, nombre));
        archivos.push({ carpeta: 'Drive de Operaciones', id: nueva.getId(), url: nueva.getUrl(), nombre: nueva.getName(), accion: 'copiado' });
      } catch (e) { errores.push({ carpeta: 'Drive de Operaciones', error: e.message }); }
    }
  } else {
    const blob = fileOrigen.getBlob(); const bytes = blob.getBytes();
    const mime = blob.getContentType() || 'application/pdf';
    if (centro.driveOp) {
      try {
        const nueva = DriveApp.getFolderById(centro.driveOp).createFile(Utilities.newBlob(bytes, mime, nombre));
        archivos.push({ carpeta: 'Drive de Operaciones', id: nueva.getId(), url: nueva.getUrl(), nombre: nueva.getName(), accion: 'copiado' });
      } catch (e) { errores.push({ carpeta: 'Drive de Operaciones', error: e.message }); }
    }
    if (centro.driveCom && centro.driveCom !== centro.driveOp) {
      try {
        const nueva = DriveApp.getFolderById(centro.driveCom).createFile(Utilities.newBlob(bytes, mime, nombre));
        archivos.push({ carpeta: 'Drive de la Comunidad', id: nueva.getId(), url: nueva.getUrl(), nombre: nueva.getName(), accion: 'copiado' });
      } catch (e) { errores.push({ carpeta: 'Drive de la Comunidad', error: e.message }); }
    }
  }
  if (!archivos.length) return { ok: false, error: 'No se pudo procesar el PDF. ' + errores.map(e => e.carpeta + ': ' + e.error).join(' · ') };
  return { ok: true, archivos, errores, centro: centro.cliente };
}

