/* ============================================================
 *  PROCESADOR MASIVO DE PDFs (v5) — con diagnóstico
 * ============================================================ */

const HOJA_PDF_PROCESADOS = '_PDF_Procesados';
const TIEMPO_MAX_MS = 5 * 60 * 1000;
const PROP_KEY_ESTADO_PDF = 'EMOAC_PDF_STATE_V1';
const ESTADOS_PROCESADOS = { ok: 1, rectificada: 1 };
const ESTADOS_REINTENTABLES = { error_ocr: 1, error_parseo: 1 };

function procesarCarpetaPDFsUI() {
  const ui = SpreadsheetApp.getUi();
  const r1 = ui.prompt('Paso 1/3 — Carpeta', 'Pega la URL o el ID de la carpeta de Drive a procesar.\nSe recorrerán también las subcarpetas.', ui.ButtonSet.OK_CANCEL);
  if (r1.getSelectedButton() !== ui.Button.OK) return;
  const url = r1.getResponseText().trim();
  if (!url) { ui.alert('No se ingresó URL/ID.'); return; }

  const r2 = ui.alert('Paso 2/3 — Cobertura', '¿Deseas OMITIR los PDFs ya procesados?', ui.ButtonSet.YES_NO_CANCEL);
  if (r2 === ui.Button.CANCEL) return;
  const omitirProcesados = (r2 === ui.Button.YES);

  const r3 = ui.alert('Paso 3/3 — Facturas recientes', '¿Deseas OMITIR las facturas procesadas hace menos de 1 día?', ui.ButtonSet.YES_NO_CANCEL);
  if (r3 === ui.Button.CANCEL) return;
  const omitirRecientes = (r3 === ui.Button.YES);

  const _limpieza = _limpiarReintentablesDelRegistro();
  const estado = {
    url: url, modo: 3,
    incluirProcesados: !omitirProcesados,
    reprocesarRecientes: !omitirRecientes,
    reintentablesLimpiados: _limpieza.borradas + _limpieza.rectificadas,
    gemini: !!(GEMINI_API_KEY && String(GEMINI_API_KEY).trim()),
    creado: new Date().toISOString()
  };
  _guardarEstadoPDF(estado);
  _limpiarTriggersPDF();
  asegurarHeaderProcesadoMasivo();

  let resultado;
  try { resultado = _ejecutarLotePDF(estado); }
  catch (e) { ui.alert('❌ Error: ' + e.message); return; }

  if (resultado.tiempoAgotado) {
    _programarSiguienteEjecucionPDF();
    try { SpreadsheetApp.getActiveSpreadsheet().toast('⏳ Procesamiento en curso. Siguiente tanda ~1 min.', 'Procesamiento masivo', 15); } catch (e) { }
    return;
  }
  _borrarEstadoPDF();
  _limpiarTriggersPDF();
  const msg = _resumenResultado(resultado, estado) + '\n\n✅ Procesamiento completo.';
  try { ui.alert(msg); }
  catch (e) {
    try { SpreadsheetApp.getActiveSpreadsheet().toast('✅ Procesamiento completo · ' + resultado.ok + ' facturas', 'Procesamiento masivo', 30); } catch (e2) { }
  }
}

function _continuarEjecucionPDF() {
  const estado = _leerEstadoPDF();
  if (!estado) { _limpiarTriggersPDF(); return; }
  let resultado;
  try { resultado = _ejecutarLotePDF(estado); }
  catch (e) { Logger.log('Error continuación: ' + e.message); _borrarEstadoPDF(); _limpiarTriggersPDF(); return; }
  if (resultado.tiempoAgotado) { _programarSiguienteEjecucionPDF(); return; }
  _borrarEstadoPDF();
  _limpiarTriggersPDF();
  const msg = _resumenResultado(resultado, estado) + '\n\n✅ Procesamiento completo.';
  try { SpreadsheetApp.getActiveSpreadsheet().toast('✅ ' + resultado.ok + ' facturas · ' + resultado.errores + ' errores', 'Procesamiento masivo', 30); } catch (e) { }
  try {
    const email = Session.getEffectiveUser().getEmail();
    MailApp.sendEmail({ to: email, subject: '✅ Procesamiento masivo terminado', body: msg + '\n\nRevisa "' + HOJA_PDF_PROCESADOS + '" para el detalle.' });
  } catch (e) { Logger.log('No se pudo enviar email: ' + e.message); }
  Logger.log(msg);
}

function _guardarEstadoPDF(estado) { PropertiesService.getScriptProperties().setProperty(PROP_KEY_ESTADO_PDF, JSON.stringify(estado)); }
function _leerEstadoPDF() {
  const s = PropertiesService.getScriptProperties().getProperty(PROP_KEY_ESTADO_PDF);
  if (!s) return null;
  try { return JSON.parse(s); } catch (e) { return null; }
}
function _borrarEstadoPDF() { PropertiesService.getScriptProperties().deleteProperty(PROP_KEY_ESTADO_PDF); }
function _programarSiguienteEjecucionPDF() {
  _limpiarTriggersPDF();
  ScriptApp.newTrigger('_continuarEjecucionPDF').timeBased().after(60 * 1000).create();
}
function _limpiarTriggersPDF() {
  ScriptApp.getProjectTriggers().forEach(t => {
    if (t.getHandlerFunction() === '_continuarEjecucionPDF') {
      try { ScriptApp.deleteTrigger(t); } catch (e) { }
    }
  });
}

function _registrarPDFEnDup(dupRegistro, numero, tipo, id, path, paginas) {
  if (!dupRegistro || !id) return;
  const num = String(numero || '').trim();
  const tpo = String(tipo || '').toUpperCase();
  if (!num || !tpo) return;
  const key = num + '|' + tpo;
  if (!dupRegistro[key]) dupRegistro[key] = [];
  if (dupRegistro[key].some(a => a.id === id)) return;
  dupRegistro[key].push({ id, path: path || '', paginas: Number(paginas) || 0 });
}

function _calcularDuplicados(dupRegistro) {
  const resultado = [];
  Object.entries(dupRegistro || {}).forEach(([key, archivos]) => {
    if (!archivos || archivos.length < 2) return;
    const [numero, tipo] = key.split('|');
    resultado.push({ numero, tipo, archivos: archivos.slice().sort((a, b) => a.id.localeCompare(b.id)) });
  });
  resultado.sort((a, b) => a.numero.localeCompare(b.numero));
  return resultado;
}

function _ejecutarLotePDF(estado) {
  const folderId = parseDriveId(estado.url);
  if (!folderId) throw new Error('URL/ID inválido.');
  let folder;
  try { folder = DriveApp.getFolderById(folderId); }
  catch (e) { throw new Error('No se pudo acceder a la carpeta: ' + e.message); }

  const pdfs = [];
  _listarPDFsRecursivo(folder, pdfs, '');
  const totalEncontrados = pdfs.length;

  const reg = cargarRegistroPDFs();
  let lista = pdfs.slice();
  let totalFiltradosPorRegistro = 0;
  if (!estado.incluirProcesados) {
    const antes = lista.length;
    lista = lista.filter(p => {
      let id;
      try { id = p.file.getId(); } catch (e) { return false; }
      const prev = reg[id];
      return !prev || !ESTADOS_PROCESADOS[prev.estado];
    });
    totalFiltradosPorRegistro = antes - lista.length;
  }

  lista.sort((a, b) => {
    let da, db;
    try { da = a.file.getDateCreated().getTime(); } catch (e) { da = 0; }
    try { db = b.file.getDateCreated().getTime(); } catch (e) { db = 0; }
    return db - da;
  });

  const inicio = Date.now();
  const delayMs = estado.modo === 3 ? 120000 : 0;
  const resultado = {
    total: lista.length, procesados: 0, saltados: 0,
    ok: 0, duplicadas: 0, rectificadas: 0, revManual: 0, errores: 0,
    restantes: 0, tiempoAgotado: false, detalle: [], duplicados: [],
    totalEncontrados, totalFiltradosPorRegistro,
    gemini: !!estado.gemini
  };
  const dupRegistro = {};

  asegurarCentroTemporal();
  const existentes = leerResumen();
  const config = leerConfig();

  for (let i = 0; i < lista.length; i++) {
    if (Date.now() - inicio > TIEMPO_MAX_MS) {
      resultado.tiempoAgotado = true;
      resultado.restantes = lista.length - i;
      break;
    }
    const item = lista[i];
    let fileId;
    try { fileId = item.file.getId(); } catch (e) { fileId = ''; }

    if (fileId && !estado.incluirProcesados) {
      const prev = reg[fileId];
      if (prev && ESTADOS_PROCESADOS[prev.estado]) { resultado.saltados++; continue; }
    }

    if (delayMs > 0 && resultado.procesados > 0) {
      if (Date.now() - inicio + delayMs > TIEMPO_MAX_MS) {
        resultado.tiempoAgotado = true;
        resultado.restantes = lista.length - i;
        break;
      }
      Utilities.sleep(delayMs);
    }

    const r = _procesarUnPDF(item, existentes, config, true, {
      reprocesarRecientes: !!estado.reprocesarRecientes,
      dupRegistro
    });

    if (fileId) {
      const _detalleFinal = [r.detalle, r.diag].filter(Boolean).join('  ||  ');
      reg[fileId] = {
        path: item.path,
        estado: r.estado,
        detalle: _detalleFinal,
        ts: new Date().toISOString(),
        numero: r.numeroFactura || ''
      };
    }

    if (r.estado === 'ok') resultado.ok++;
    else if (r.estado === 'rectificada') resultado.rectificadas++;
    else if (r.estado === 'rev_manual') resultado.revManual++;
    else if (r.estado === 'duplicada') resultado.duplicadas++;
    else resultado.errores++;
    resultado.procesados++;

    if (r.estado === 'rev_manual') resultado.detalle.push({ archivo: item.path, revision: r.detalle, warning: r.warning });
    else if (r.detalle && r.estado !== 'ok' && r.estado !== 'duplicada') resultado.detalle.push({ archivo: item.path, error: r.detalle });
    else if (r.warning) resultado.detalle.push({ archivo: item.path, warning: r.warning });

    guardarRegistroPDFs(reg);
  }

  guardarRegistroPDFs(reg);
  refrescarSeguimiento();
  resultado.duplicados = _calcularDuplicados(dupRegistro);
  Logger.log(JSON.stringify(resultado, null, 2));
  return resultado;
}

function _resumenResultado(r, estado) {
  const lineas = [];
  const modoTxt = estado.modo === 1 ? 'una vez' : estado.modo === 3 ? 'indefinido con pausas' : ('modo ' + estado.modo);
  const coberturaTxt = estado.incluirProcesados ? 'TODOS' : 'solo NO procesados';
  const motorTxt = estado.gemini ? 'OCR primero · Gemini como último recurso' : 'OCR tradicional';
  lineas.push('📊 Resultado del lote');
  lineas.push('');
  lineas.push('Modo:      ' + modoTxt);
  lineas.push('Cobertura: ' + coberturaTxt);
  lineas.push('Motor:     ' + motorTxt);
  lineas.push('');
  lineas.push('PDFs en carpeta:      ' + (r.totalEncontrados != null ? r.totalEncontrados : '?'));
  if (r.totalFiltradosPorRegistro > 0) lineas.push('  · Ya procesados:    ' + r.totalFiltradosPorRegistro);
  lineas.push('PDFs en lote:         ' + r.total);
  lineas.push('Saltados (registro):  ' + r.saltados);
  lineas.push('Procesados:          ' + r.procesados);
  lineas.push('  · Creadas:         ' + r.ok);
  lineas.push('  · Rectificadas:    ' + (r.rectificadas || 0));
  lineas.push('  · Rev. manual:     ' + (r.revManual || 0));
  lineas.push('  · Duplicadas:      ' + r.duplicadas);
  lineas.push('  · Errores:         ' + r.errores);
  if (r.tiempoAgotado) { lineas.push(''); lineas.push('⏸️ Restantes: ' + r.restantes); }

  const conProblemas = (r.detalle || []).filter(d => d.error || d.warning || d.revision);
  if (conProblemas.length) {
    lineas.push('');
    lineas.push('Detalle (primeros 15):');
    conProblemas.slice(0, 15).forEach(d => {
      lineas.push('· ' + d.archivo);
      if (d.revision) { lineas.push('   [rev_manual] ' + (d.warning || '')); d.revision.split('\n').forEach(l => lineas.push('   ' + l)); }
      else lineas.push('   ' + (d.error || d.warning));
    });
  }

  const dups = (r.duplicados || []);
  if (dups.length) {
    lineas.push('');
    lineas.push('🔍 Duplicados detectados:');
    dups.forEach(d => {
      lineas.push('');
      lineas.push('  ' + d.numero + ' · ' + d.tipo);
      d.archivos.forEach(a => lineas.push('    ' + a.id + ' (' + a.paginas + ' páginas)'));
    });
  }
  return lineas.join('\n');
}

