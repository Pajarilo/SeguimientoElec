//  SEGUIMIENTO
// ============================================================
function refrescarSeguimiento() {
  const ss = SpreadsheetApp.openById(SS_ID);
  const config = leerConfig();
  const facturas = leerResumen();
  const porSuministro = {}; const porPeaje = {}; const porArriendo = {};
  function estaCompleto(f) {
    const hasMonto = (Number(f.sum) > 0) || (Number(f.peaje) > 0);
    const hasKwh = Number(f.kwh) > 0;
    const S = SENTINELAS;
    const em = f.fechaEmision; const ve = f.fechaVencimiento;
    const hasEm = em && S.indexOf(em) === -1;
    const hasVe = ve && S.indexOf(ve) === -1;
    return hasMonto && hasKwh && hasEm && hasVe;
  }
  facturas.forEach(function (f) {
    let cod = f.codigo || '';
    if (!cod) {
      const m = config.centros.find(function (e) { return e.cliente === f.cliente; });
      if (m) cod = m.codigo;
    }
    if (!cod) cod = '—';
    const completo = estaCompleto(f);
    if (f.tipo === 'SUMINISTRO' || f.tipo === 'UNIFICADA') {
      if (!porSuministro[cod]) porSuministro[cod] = {};
      if (!porSuministro[cod][f.periodo]) porSuministro[cod][f.periodo] = [];
      porSuministro[cod][f.periodo].push({ numero: f.numero, fecha: f.fechaConsumo, completo: completo });
    }
    if (f.tipo === 'PEAJE' || f.tipo === 'UNIFICADA') {
      if (!porPeaje[cod]) porPeaje[cod] = {};
      if (!porPeaje[cod][f.periodo]) porPeaje[cod][f.periodo] = [];
      porPeaje[cod][f.periodo].push({ numero: f.numero, fecha: f.fechaPeaje, completo: completo });
    }
    if (f.tipo === 'ARRIENDO_MEDIDOR') {
      if (!porArriendo[cod]) porArriendo[cod] = {};
      if (!porArriendo[cod][f.periodo]) porArriendo[cod][f.periodo] = [];
      porArriendo[cod][f.periodo].push({ numero: f.numero, fecha: f.fechaPeaje || f.fechaConsumo, completo: completo });
    }
  });
  escribirHojaSeguimiento(ss, HOJA_SUMINISTRO, porSuministro, config);
  escribirHojaSeguimiento(ss, HOJA_PEAJE, porPeaje, config);
  escribirHojaSeguimiento(ss, HOJA_ARRIENDO, porArriendo, config);
}

function escribirHojaSeguimiento(ss, nombre, datosPorCodigo, config) {
  let sh = ss.getSheetByName(nombre);
  if (!sh) sh = ss.insertSheet(nombre);
  sh.clear();
  const MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
  const PERIODOS = config.periodos;
  const headers = ['Centro de costo (Código)'].concat(PERIODOS.map(function (p) {
    const partes = p.split('-');
    return MESES[parseInt(partes[1], 10) - 1] + '-' + partes[0];
  }));
  sh.getRange(1, 1, 1, headers.length).setValues([headers]);

  let centrosVisibles = config.centros.filter(function (e) {
    return !_esCentroFantasmaBack(e.codigo, e.cliente);
  });

  // ─── Arriendo de medidor: ocultar centros sin ninguna factura ───
  //  En esta hoja no se espera factura en todos los períodos, así
  //  que las filas de centros que nunca tuvieron arriendo en la
  //  ventana visible se omiten por completo.
  const esArriendo = (nombre === HOJA_ARRIENDO);
  if (esArriendo) {
    centrosVisibles = centrosVisibles.filter(function (e) {
      const datos = datosPorCodigo[e.codigo] || {};
      return Object.keys(datos).some(function (per) {
        return (datos[per] || []).length > 0;
      });
    });
  }

  const filas = centrosVisibles.map(function (e) {
    const fila = [e.cliente + ' (' + e.codigo + ')'];
    const datos = datosPorCodigo[e.codigo] || {};
    PERIODOS.forEach(function (periodo) {
      const items = datos[periodo] || [];
      if (items.length === 0) {
        fila.push(esArriendo ? '—' : estadoTextoPeriodo(periodo));
      } else {
        const fechas = items
          .map(f => f.fecha)
          .filter(x => x && SENTINELAS.indexOf(String(x)) === -1);
        if (fechas.length > 0) {
          fila.push(fechas.map(formatFechaCorta).join(' / '));
        } else {
          const completo = items.every(it => it.completo);
          fila.push(completo ? 'Sin fecha' : 'Sin fecha (⚠)');
        }
      }
    });
    return fila;
  });
  if (filas.length) sh.getRange(2, 1, filas.length, headers.length).setValues(filas);
  sh.getRange(1, 1, 1, headers.length)
    .setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');
  if (filas.length) {
    const rango = sh.getRange(2, 2, filas.length, PERIODOS.length);
    const reglas = [];
    if (!esArriendo) {
      reglas.push(
        SpreadsheetApp.newConditionalFormatRule().whenTextEqualTo('Pendiente').setBackground('#fef3c7').setFontColor('#92400e').setRanges([rango]).build(),
        SpreadsheetApp.newConditionalFormatRule().whenTextEqualTo('Por Emitir').setBackground('#dcfce7').setFontColor('#166534').setRanges([rango]).build(),
        SpreadsheetApp.newConditionalFormatRule().whenTextEqualTo('S/I').setBackground('#f3f4f6').setFontColor('#6b7280').setRanges([rango]).build(),
        SpreadsheetApp.newConditionalFormatRule().whenTextEqualTo('N/A').setBackground('#e5e7eb').setFontColor('#6b7280').setRanges([rango]).build()
      );
    }
    reglas.push(
      SpreadsheetApp.newConditionalFormatRule().whenTextContains('Sin fecha').setBackground('#e0f2fe').setFontColor('#075985').setRanges([rango]).build(),
      SpreadsheetApp.newConditionalFormatRule().whenTextContains('⚠').setBackground('#fef9c3').setFontColor('#b45309').setRanges([rango]).build(),
      SpreadsheetApp.newConditionalFormatRule().whenTextContains('/').setBackground('#d1fae5').setFontColor('#065f46').setRanges([rango]).build()
    );
    sh.setConditionalFormatRules(reglas);
  }
  sh.setColumnWidth(1, 260);
  for (let i = 2; i <= PERIODOS.length + 1; i++) sh.setColumnWidth(i, 95);
  sh.setFrozenRows(1); sh.setFrozenColumns(1); sh.setRowHeight(1, 30);
  if (filas.length) sh.getRange(2, 2, filas.length, PERIODOS.length).setHorizontalAlignment('center');
}

function estadoTextoPeriodo(periodo) {
  const hoy = new Date(); hoy.setHours(0, 0, 0, 0);
  const p = periodo.split('-').map(Number);
  const pm = p[0] * 12 + (p[1] - 1);
  const hm = hoy.getFullYear() * 12 + hoy.getMonth();
  if (pm >= hm) return 'Por Emitir';
  const dl = fechaObjetivoJS(periodo);
  if (hoy <= dl) return 'En plazo';
  return 'Pendiente';
}

// ============================================================
//  IMPORTAR CSV
// ============================================================
function importarFacturasFront(facturas) {
  if (!Array.isArray(facturas) || !facturas.length) throw new Error('Sin facturas');
  const ss = SpreadsheetApp.openById(SS_ID);
  const sh = ss.getSheetByName(HOJA_RESUMEN);
  const existentes = leerResumen();
  const filas = []; const errores = []; let duplicadas = 0;
  facturas.forEach(function (f, idx) {
    if (!f.numero) { errores.push('Fila ' + (idx + 1) + ': sin N° factura'); return; }
    if (!f.cliente) { errores.push('Fila ' + (idx + 1) + ': sin centro'); return; }
    if (!f.periodo) { errores.push('Fila ' + (idx + 1) + ': sin período'); return; }
    let tipo = (f.tipo || 'SUMINISTRO').toUpperCase();
    if (tipo === 'CONSUMO') tipo = 'SUMINISTRO';
    const dup = existentes.find(e => e.numero === String(f.numero).trim() && e.cliente === f.cliente && e.periodo === f.periodo && e.tipo === tipo);
    if (dup) { duplicadas++; return; }
    const fC = (tipo === 'SUMINISTRO' || tipo === 'UNIFICADA') && f.fechaConsumo ? parseISO(f.fechaConsumo) : '';
    const fP = (tipo === 'PEAJE' || tipo === 'UNIFICADA') && f.fechaPeaje ? parseISO(f.fechaPeaje) : '';
    const fE = f.fechaEmision ? parseISO(f.fechaEmision) : '';
    const fV = f.fechaVencimiento ? parseISO(f.fechaVencimiento) : '';
    filas.push([String(f.numero).trim(), f.codigo || '', f.cliente, f.periodo, tipo,
    Number(f.kwh) || 0, Number(f.sum) || 0, Number(f.peaje) || 0,
    Number(f.intereses) || 0,
    Number(f.intPeaje) || 0,
    Number(f.total) || 0,
    fC, fP, fE, fV, '', '']);
  });
  if (filas.length) {
    const sr = sh.getLastRow() + 1;
    sh.getRange(sr, COL.CODIGO, filas.length, 1).setNumberFormat('@');
    sh.getRange(sr, COL.PERIODO, filas.length, 1).setNumberFormat('@');
    sh.getRange(sr, COL.FECHA_SUMINISTRO, filas.length, 4).setNumberFormat('dd/mm/yyyy');
    sh.getRange(sr, COL.KWH, filas.length, 1).setNumberFormat('#,##0.00');
    sh.getRange(sr, COL.SUM, filas.length, 2).setNumberFormat('$#,##0');
    sh.getRange(sr, COL.INT, filas.length, 2).setNumberFormat('$#,##0');
    sh.getRange(sr, COL.TOTAL, filas.length, 1).setNumberFormat('$#,##0');
    sh.getRange(sr, 1, filas.length, filas[0].length).setValues(filas);
    refrescarSeguimiento();
  }
  return { ok: true, importadas: filas.length, duplicadas: duplicadas, errores: errores };
}

// ============================================================
//  KPIs
// ============================================================
function calcularResumen() {
  const facturas = leerResumen();
  const hoy = new Date(); hoy.setHours(0, 0, 0, 0);
  const acc = { total_facturas: facturas.length, total_suministro: 0, total_peaje: 0, total_intereses: 0, total_facturado: 0, recibidas: 0, pendientes: 0, porEmitir: 0, dentroPlazo: 0, sinInfo: 0, noAplica: 0 };
  facturas.forEach(function (f) {
    acc.total_suministro += f.sum; acc.total_peaje += f.peaje;
    acc.total_intereses += (f.intereses + (f.intPeaje || 0));
    acc.total_facturado += f.total;
    if (f.fechaConsumo === 'N/A' || f.fechaPeaje === 'N/A') { acc.noAplica++; return; }
    if (f.fechaConsumo === 'S/I' || f.fechaPeaje === 'S/I') { acc.sinInfo++; return; }
    const _sinFechaConsumo = f.fechaConsumo === SENTINELA_SIN_FECHA;
    const _sinFechaPeaje   = f.fechaPeaje   === SENTINELA_SIN_FECHA;
    let tieneFecha;
    if (f.tipo === 'UNIFICADA') {
      tieneFecha = f.fechaConsumo && f.fechaPeaje && !_sinFechaConsumo && !_sinFechaPeaje;
    } else if (f.tipo === 'PEAJE') {
      tieneFecha = !!f.fechaPeaje && !_sinFechaPeaje;
    } else {
      tieneFecha = !!f.fechaConsumo && !_sinFechaConsumo;
    }
    if (tieneFecha) { acc.recibidas++; return; }
    const p = f.periodo.split('-').map(Number);
    const pm = p[0] * 12 + (p[1] - 1);
    const hm = hoy.getFullYear() * 12 + hoy.getMonth();
    if (pm >= hm) { acc.porEmitir++; return; }
    const sinInfo = !f.kwh && !f.sum && !f.peaje && !f.total;
    if (sinInfo) { acc.sinInfo++; return; }
    const dl = fechaObjetivoJS(f.periodo);
    if (hoy <= dl) acc.dentroPlazo++;
    else acc.pendientes++;
  });
  return acc;
}

