/**
 * Convierte a Date las fechas que estén guardadas como texto en
 * la hoja "Resumen Facturación" (F.Recep Consumo, F.Recep Peaje,
 * F.Emisión, F.Venc). Ejecutar UNA VEZ.
 */
function convertirFechasTextoADate() {
  const ui = SpreadsheetApp.getUi();
  const sh = SpreadsheetApp.openById(SS_ID).getSheetByName(HOJA_RESUMEN);
  if (!sh) { ui.alert('No existe la hoja ' + HOJA_RESUMEN); return; }
  const lr = sh.getLastRow();
  if (lr < 2) { ui.alert('Sin datos.'); return; }

  const cols = [COL.FECHA_SUMINISTRO, COL.FECHA_PEAJE, COL.FECHA_EMISION, COL.FECHA_VENC];
  let convertidas = 0;

  cols.forEach(col => {
    const rango = sh.getRange(2, col, lr - 1, 1);
    const vals = rango.getValues();
    let cambio = false;
    const nuevos = vals.map(r => {
      const v = r[0];
      if (v instanceof Date) return [v];
      if (v === null || v === undefined || v === '') return [v];
      const s = String(v).trim();
      if (SENTINELAS.indexOf(s) !== -1) return [v];
      let m = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);
      if (m) { cambio = true; convertidas++; return [new Date(+m[1], +m[2]-1, +m[3])]; }
      m = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);
      if (m) { cambio = true; convertidas++; return [new Date(+m[3], +m[2]-1, +m[1])]; }
      return [v];
    });
    if (cambio) {
      rango.setNumberFormat('dd/mm/yyyy');
      rango.setValues(nuevos);
    }
  });

  Logger.log('✓ Fechas convertidas a Date: ' + convertidas);
  ui.alert('✓ Conversión completada.\n\nFechas convertidas: ' + convertidas);
}

/**
 * Consolida en UNA sola fila el centro "Sin asignar":
 *   · Renombra todas las facturas del Resumen que apunten a
 *     variantes previas (TEMP, ⚠️ Sin asignar) al nuevo formato
 *     "Sin asignar" / "Sin código".
 *   · Deja en Config una única fila fantasma.
 *
 * Ejecutar UNA VEZ desde el menú ⚡ Funciones adicionales.
 */
function consolidarCentroSinAsignar() {
  const ui = SpreadsheetApp.getUi();
  const ok = ui.alert(
    '🧹 Consolidar centro "Sin asignar"',
    'Se unificarán las variantes TEMP / ⚠️ Sin asignar en una sola:\n\n' +
    '  Centro: "Sin asignar"  ·  Código: "Sin código"\n\n' +
    'Se actualizarán las facturas del Resumen y la hoja Config.\n\n¿Continuar?',
    ui.ButtonSet.YES_NO
  );
  if (ok !== ui.Button.YES) return;

  const CODIGO_NUEVO  = 'Sin código';
  const CLIENTE_NUEVO = 'Sin asignar';
  const ss = SpreadsheetApp.openById(SS_ID);
  const shResumen = ss.getSheetByName(HOJA_RESUMEN);
  const shConfig  = ss.getSheetByName(HOJA_CONFIG);

  let facturasActualizadas = 0;
  let filasConfigBorradas  = 0;

  // 1) Normalizar facturas
  if (shResumen) {
    const lr = shResumen.getLastRow();
    if (lr >= 2) {
      const data = shResumen.getRange(2, 1, lr - 1, COL.CLIENTE).getValues();
      for (let i = 0; i < data.length; i++) {
        const cliente = String(data[i][COL.CLIENTE - 1] || '').trim();
        const codigo  = String(data[i][COL.CODIGO  - 1] || '').trim();
        if (!_esCentroFantasmaBack(codigo, cliente)) continue;
        let cambio = false;
        if (cliente !== CLIENTE_NUEVO) {
          shResumen.getRange(i + 2, COL.CLIENTE).setValue(CLIENTE_NUEVO);
          cambio = true;
        }
        if (codigo !== CODIGO_NUEVO) {
          shResumen.getRange(i + 2, COL.CODIGO).setValue(CODIGO_NUEVO).setNumberFormat('@');
          cambio = true;
        }
        if (cambio) facturasActualizadas++;
      }
    }
  }

  // 2) Normalizar Config (dejar sólo una fila fantasma)
  if (shConfig) {
    const lrC = Math.max(shConfig.getLastRow(), 1);
    const filasGhost = [];
    if (lrC >= 2) {
      const vals = shConfig.getRange(2, 2, lrC - 1, 9).getValues();
      for (let i = 0; i < vals.length; i++) {
        const codigo  = String(vals[i][1] || '').trim();
        const cliente = String(vals[i][2] || '').trim();
        if (_esCentroFantasmaBack(codigo, cliente)) filasGhost.push(i + 2);
      }
    }
    filasGhost.sort((a, b) => b - a).forEach(fila => {
      shConfig.deleteRow(fila);
      filasConfigBorradas++;
    });
    _asegurarColumnaEmpresa(shConfig);
    const nextRow = Math.max(shConfig.getLastRow(), 1) + 1;
    shConfig.getRange(nextRow, 2, 1, 9).setValues([[
      '', CODIGO_NUEVO, CLIENTE_NUEVO, '', '', '', '', '', 'EMOAC'
    ]]);
    _configCache = null;
  }

  refrescarSeguimiento();
  ui.alert(
    '✓ Consolidación completada.\n\n' +
    '· Facturas actualizadas: ' + facturasActualizadas + '\n' +
    '· Filas Config borradas: ' + filasConfigBorradas + '\n\n' +
    'Se dejó una única fila "Sin asignar" / "Sin código".'
  );
}
// ============================================================
//  NOMBRE ESTÁNDAR DE PDF — FUENTE ÚNICA DE VERDAD
//  Formato: Periodo_Código_N°Factura_CentroDeCosto_Tipo.pdf
//
//  Acepta un objeto con cualquiera de estas claves (prioriza las
//  que vienen del parser, con fallback a las del modal):
//    · numero / fNumero
//    · codigo / fCodigo
//    · periodo / fPeriodo
//    · tipo / fTipo
//
//  El nombre del centro se resuelve por código desde `leerConfig()`,
//  así no depende del DOM ni del option seleccionado.
// ============================================================
function _construirNombreArchivoEstandar(datos, centro) {
  const d = datos || {};

  const codigo  = String(d.codigo  != null ? d.codigo  : (d.fCodigo  || '')).trim();
  const numero  = String(d.numero  != null ? d.numero  : (d.fNumero  || '')).trim() || 'sin-numero';
  const periodo = String(d.periodo != null ? d.periodo : (d.fPeriodo || '')).trim() || 'sin-periodo';
  const tipoRaw = String(d.tipo    != null ? d.tipo    : (d.fTipo    || '')).trim().toUpperCase();

  let etiquetaTipo = tipoRaw;
  if (tipoRaw === 'CONSUMO')          etiquetaTipo = 'Suministro';
  else if (tipoRaw === 'PEAJE')       etiquetaTipo = 'Peaje';
  else if (tipoRaw === 'UNIFICADA')   etiquetaTipo = 'Unificada';
  else if (tipoRaw === 'ARRIENDO_MEDIDOR') etiquetaTipo = 'ArriendoMedidor';

  // El centro puede venir por parámetro (evita lookup) o resolverse
  // por código contra Config.
  let centroNombre = '';
  if (centro && String(centro.codigo || '').trim() === codigo) {
    centroNombre = String(centro.cliente || '').trim();
  } else if (codigo) {
    const cfg = leerConfig();
    const c = cfg.centros.find(x => String(x.codigo || '').trim() === codigo);
    if (c) centroNombre = String(c.cliente || '').trim();
    // Si no se encontró con el cache actual, forzar relectura y
    // reintentar antes de caer a "sin-centro".
    if (!centroNombre) {
      _invalidarConfigCache();
      const cfg2 = leerConfig();
      const c2 = cfg2.centros.find(x => String(x.codigo || '').trim() === codigo);
      if (c2) centroNombre = String(c2.cliente || '').trim();
    }
  }

  const codigoSafe = codigo || 'sin-codigo';
  const centroSafe = centroNombre
    ? centroNombre.replace(/[\/\\:*?"<>|]/g, '-')
    : 'sin-centro';
  const tipoSafe   = etiquetaTipo || 'X';

  return periodo + '_' + codigoSafe + '_' + numero + '_' + centroSafe + '_' + tipoSafe + '.pdf';
}


/**
