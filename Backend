function _getHojaProcesados(ss) {
  let sh = ss.getSheetByName(HOJA_PDF_PROCESADOS);
  if (!sh) {
    sh = ss.insertSheet(HOJA_PDF_PROCESADOS);
    sh.getRange(1, 1, 1, 6).setValues([['File ID', 'Ruta', 'Estado', 'Detalle', 'Fecha', 'N° Factura']]);
    sh.getRange(1, 1, 1, 6).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
    sh.setFrozenRows(1);
    _aplicarFiltroProcesados(sh);
    sh.hideSheet();
    return sh;
  }
  if (sh.getLastColumn() < 6) {
    const c = sh.getRange(1, 6);
    if (!String(c.getValue() || '').trim()) {
      c.setValue('N° Factura').setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
    }
    sh.setColumnWidth(6, 120);
  }
  return sh;
}

function _aplicarFiltroProcesados(sh) {
  if (!sh) return;
  try {
    const filtroPrev = sh.getFilter();
    if (filtroPrev) filtroPrev.remove();
    const lr = Math.max(sh.getLastRow(), 1);
    const rango = sh.getRange(1, 1, lr, 5);
    const filtro = rango.createFilter();
    const criterio = SpreadsheetApp.newFilterCriteria().setHiddenValues(['ok', 'rectificada']).build();
    filtro.setColumnFilterCriteria(3, criterio);
  } catch (e) { Logger.log('_aplicarFiltroProcesados error: ' + e.message); }
}

function cargarRegistroPDFs() {
  const ss = SpreadsheetApp.openById(SS_ID);
  const sh = _getHojaProcesados(ss);
  const lr = sh.getLastRow();
  if (lr < 2) return {};
  const nCols = Math.max(sh.getLastColumn(), 5);
  const data = sh.getRange(2, 1, lr - 1, nCols).getValues();
  const reg = {};
  data.forEach(r => {
    const id = String(r[0] || '').trim();
    if (!id) return;
    reg[id] = {
      path: String(r[1] || ''),
      estado: String(r[2] || ''),
      detalle: String(r[3] || ''),
      ts: r[4] instanceof Date ? r[4].toISOString() : String(r[4] || ''),
      numero: String(r[5] || '').trim()
    };
  });
  return reg;
}

function guardarRegistroPDFs(reg) {
  const ss = SpreadsheetApp.openById(SS_ID);
  const sh = _getHojaProcesados(ss);
  const filas = Object.entries(reg).map(([id, v]) => [
    id, v.path || '', v.estado || '', (v.detalle || '').slice(0, 4500), v.ts || '', v.numero || ''
  ]);
  const lr = sh.getLastRow();
  if (lr >= 2) sh.getRange(2, 1, lr - 1, 6).clearContent();
  if (filas.length) sh.getRange(2, 1, filas.length, 6).setValues(filas);
  _aplicarFiltroProcesados(sh);
}

function limpiarRegistroPDFs() {
  const ss = SpreadsheetApp.openById(SS_ID);
  const sh = _getHojaProcesados(ss);
  const lr = sh.getLastRow();
  if (lr >= 2) sh.getRange(2, 1, lr - 1, 5).clearContent();
  _aplicarFiltroProcesados(sh);
}

function _esReintentable(estado) { return !!ESTADOS_REINTENTABLES[estado]; }

function _fechasProcesadasPorFactura() {
  const sh = SpreadsheetApp.openById(SS_ID).getSheetByName(HOJA_RESUMEN);
  if (!sh) return {};
  const lr = sh.getLastRow();
  if (lr < 2) return {};
  const data = sh.getRange(2, 1, lr - 1, COL.PROCESADO_MASIVO).getValues();
  const mapa = {};
  data.forEach(r => {
    const num = String(r[COL.NUMERO - 1] || '').trim();
    if (!num) return;
    const tsRaw = r[COL.PROCESADO_MASIVO - 1];
    if (!(tsRaw instanceof Date) || isNaN(tsRaw.getTime())) return;
    if (!mapa[num] || tsRaw.getTime() > mapa[num].getTime()) mapa[num] = tsRaw;
  });
  return mapa;
}

function _limpiarReintentablesDelRegistro() {
  const reg = cargarRegistroPDFs();
  const fechasBD = _fechasProcesadasPorFactura();
  let borradas = 0, rectificadas = 0;
  Object.keys(reg).forEach(id => {
    const entrada = reg[id];
    if (ESTADOS_REINTENTABLES[entrada.estado]) { delete reg[id]; borradas++; return; }
    if (ESTADOS_PROCESADOS[entrada.estado]) return;
    const num = entrada.numero || _extraerNumeroDePath(entrada.path);
    if (!num) return;
    const fechaBD = fechasBD[num];
    if (!fechaBD) return;
    const fechaReg = entrada.ts ? new Date(entrada.ts) : null;
    if (!fechaReg || isNaN(fechaReg.getTime())) return;
    if (fechaBD.getTime() > fechaReg.getTime()) {
      reg[id].estado = 'rectificada';
      reg[id].detalle = 'Marcada como rectificada: BD actualizada (' + fechaBD.toISOString() + ')';
      reg[id].ts = fechaBD.toISOString();
      if (!reg[id].numero) reg[id].numero = num;
      rectificadas++;
    }
  });
  if (borradas > 0 || rectificadas > 0) guardarRegistroPDFs(reg);
  return { borradas, rectificadas };
}

function _extraerNumeroDePath(path) {
  if (!path) return '';
  const s = String(path);
  let m = s.match(/dte[\-_][^\/]+?-(\d{3,8})\.pdf$/i); if (m) return m[1];
  m = s.match(/\d{4}-\d{2}_[^_]+_(\d{1,8})_[^\/]+\.pdf$/i); if (m) return m[1];
  m = s.match(/_(\d{3,8})_[^\/]+\.pdf$/i); if (m) return m[1];
  return '';
}

/**
 * Marca como "rectificada" todas las entradas del registro
 * `_PDF_Procesados` cuyo N° de factura coincida, y refresca su ts.
 * Con esto, un repaso masivo no volverá a procesar esos PDFs
 * (porque 'rectificada' está en ESTADOS_PROCESADOS).
 */
function _marcarFacturaComoRectificadaEnRegistro(numero) {
  const num = String(numero || '').trim();
  if (!num) return { actualizadas: 0 };

  const reg = cargarRegistroPDFs();
  const ahora = new Date().toISOString();
  let actualizadas = 0;

  Object.keys(reg).forEach(id => {
    const entrada = reg[id];
    if (!entrada) return;

    const numEntrada = String(
      entrada.numero || _extraerNumeroDePath(entrada.path) || ''
    ).trim();

    if (numEntrada !== num) return;
    if (entrada.estado === 'rectificada') return;  // ya está marcada, no tocar

    entrada.estado = 'rectificada';
    entrada.ts = ahora;
    entrada.detalle = (entrada.detalle || '') +
      '  ||  Rectificada manualmente desde el modal (' + ahora + ')';
    if (!entrada.numero) entrada.numero = num;

    actualizadas++;
  });

  if (actualizadas > 0) guardarRegistroPDFs(reg);
  return { actualizadas };
}

function _diffFacturaPDF(facturaExistente, campos) {
  const diffs = [];
  const _fmtNum = (n) => {
    const num = Number(n);
    if (!isFinite(num) || num === 0) return '0';
    return Math.round(num).toLocaleString('es-CL');
  };
  function _pushDif(a, b, esNum, label) {
    const aa = esNum ? (Number(a) || 0) : String(a == null ? '' : a).trim();
    const bb = esNum ? (Number(b) || 0) : String(b == null ? '' : b).trim();
    if (aa === bb) return;
    const aaTxt = esNum ? _fmtNum(aa) : (aa || '—');
    const bbTxt = esNum ? _fmtNum(bb) : (bb || '—');
    diffs.push('   · ' + label + ':  ' + aaTxt + '  →  ' + bbTxt);
  }
  _pushDif(facturaExistente.codigo, campos.fCodigo, false, 'Código cliente');
  _pushDif(facturaExistente.periodo, campos.fPeriodo, false, 'Período');
  _pushDif(facturaExistente.tipo, campos.fTipo, false, 'Tipo');
  _pushDif(facturaExistente.fechaEmision, campos.fEmision, false, 'F. Emisión');
  _pushDif(facturaExistente.fechaVencimiento, campos.fVencimiento, false, 'F. Vencimiento');
  _pushDif(facturaExistente.kwh, campos.fKwh, true, 'kWh');
  _pushDif(facturaExistente.sum, campos.fSum, true, 'Suministro Neto');
  _pushDif(facturaExistente.peaje, campos.fPeaje, true, 'Peaje');
  _pushDif(facturaExistente.intereses, campos.fInt, true, 'Int. Sum.');
  _pushDif(facturaExistente.intPeaje, campos.fIntPeaje, true, 'Int. Peaje');
  _pushDif(facturaExistente.otros, campos.fOtros, true, 'Otros Sum.');
  _pushDif(facturaExistente.otrosPeaje, campos.fOtrosPeaje, true, 'Otros Peaje');
  _pushDif(facturaExistente.total, campos.fTotal, true, 'Total');
  return diffs;
}

function _procesarUnPDF(item, existentes, config, copiarADestinos, opciones) {
  _diagReset(item.path);
  const r = _procesarUnPDF_interno(item, existentes, config, copiarADestinos, opciones);
  r.diag = _DIAG_INTENTOS.map(it =>
    '[' + it.fuente + '] ' + (it.ok ? 'OK' : 'FALLO(' + (it.error || '') + ')')
  ).join(' | ');
  return r;
}

function _procesarUnPDF_interno(item, existentes, config, copiarADestinos, opciones) {
  opciones = opciones || {};
  const file = item.file;

  // 1) Obtener base64
  let base64, mime;
  try {
    const blob = file.getBlob();
    base64 = Utilities.base64Encode(blob.getBytes());
    mime = blob.getContentType() || 'application/pdf';
  } catch (e) {
    return { estado: 'error_ocr', detalle: 'Lectura falló: ' + e.message };
  }

  // 2) Cascada: Drive OCR → OCR.space → Gemini
  let campos = null;
  let motorUsado = '';
  let mejorScore = -1;
  let mejorCampos = null;
  let mejorMotor = '';

  const _evaluar = (motor, c, chars, preview) => {
    _diagIntentar(motor, true, { campos: c, chars, preview });
    const det = _contarCamposDetectadosBack(c);
    if (det.total > mejorScore) {
      mejorScore = det.total;
      mejorCampos = c;
      mejorMotor = motor;
    }
    return _camposSonUtilizables(c);
  };

  // 2.1) Drive OCR — sólo si no está bloqueado por cuota
  if (_driveOcrEstaBloqueado()) {
    _diagIntentar('Drive OCR', false, { error: 'Cuota agotada (saltado)' });
  } else {
    const r1 = _extraerConDriveOCR(file.getName(), base64, mime);
    if (r1.ok && r1.texto) {
      const c1 = _parsearFacturaCompleta(r1.texto);
      if (_evaluar('Drive OCR', c1, r1.texto.length, r1.texto)) {
        campos = c1; motorUsado = 'Drive OCR';
        _diagReporteFinal(campos, motorUsado, true);
        return _finalizarProcesamientoPDF(item, campos, motorUsado, existentes, config, copiarADestinos, opciones);
      }
    } else {
      _diagIntentar('Drive OCR', false, { error: r1.error });
    }
  }

  // 2.2) OCR.space
  const r2 = _extraerConOCRSpace(file.getName(), base64, mime);
  if (r2.ok && r2.texto) {
    const c2 = _parsearFacturaCompleta(r2.texto);
    if (_evaluar('OCR.space', c2, r2.texto.length, r2.texto)) {
      campos = c2; motorUsado = 'OCR.space';
      _diagReporteFinal(campos, motorUsado, true);
      return _finalizarProcesamientoPDF(item, campos, motorUsado, existentes, config, copiarADestinos, opciones);
    }
  } else {
    _diagIntentar('OCR.space', false, { error: r2.error });
  }

  // 2.3) Gemini — ÚLTIMO RECURSO
  if (GEMINI_API_KEY && String(GEMINI_API_KEY).trim()) {
    const g = _extraerConGemini(base64, mime, file.getName());
    if (g.ok && g.campos) {
      if (_evaluar('Gemini (último recurso)', g.campos, 0, '')) {
        campos = g.campos; motorUsado = 'Gemini (último recurso)';
        _diagReporteFinal(campos, motorUsado, true);
        return _finalizarProcesamientoPDF(item, campos, motorUsado, existentes, config, copiarADestinos, opciones);
      }
    } else {
      _diagIntentar('Gemini (último recurso)', false, { error: g.error });
    }
  } else {
    _diagIntentar('Gemini', false, { error: 'No configurado' });
  }

  // 3) Ningún resultado utilizable → usar el mejor parcial
  _diagReporteFinal(mejorCampos, mejorMotor || '(ninguna)', false);

  if (!mejorCampos) {
    return { estado: 'error_ocr', detalle: 'Ninguna fuente pudo extraer campos' };
  }

  if (!mejorCampos.fNumero) {
    return { estado: 'error_parseo', detalle: 'No se detectó N° factura [mejor fuente: ' + mejorMotor + ']' };
  }
  if (!mejorCampos.fCodigo) {
    return { estado: 'error_parseo', detalle: 'No se detectó código de cliente [mejor fuente: ' + mejorMotor + ']' };
  }
  if (!mejorCampos.fPeriodo) {
    return { estado: 'error_parseo', detalle: 'No se detectó período' };
  }

  return _finalizarProcesamientoPDF(item, mejorCampos, mejorMotor, existentes, config, copiarADestinos, opciones);
}


/**
 * Copia el PDF a los destinos del centro (Operaciones + Comunidad)
 * con el nombre estándar y vincula el archivo resultante a la factura.
 *
 * @returns {{ ok:boolean, idFinal:string, warning:string }}
 */
function _copiarYVincularPDF(file, numero, codigo, periodo, tipo, centro) {
  const nombreEst = _construirNombreArchivoEstandar({
    numero:  numero,
    codigo:  codigo,
    periodo: periodo,
    tipo:    tipo
  }, centro);

  let idFinal = '';
  let warning = '';

  if (!(centro.driveOp || centro.driveCom)) {
    return { ok: true, idFinal: '', warning: '' };   // nada que hacer
  }

  try {
    const copia = copiarPDFDriveADestinos(file.getId(), centro.codigo, nombreEst);
    if (copia.ok && copia.archivos && copia.archivos.length) {
      idFinal = copia.archivos[0].id;
      const vinc = vincularPDFDrive(numero, idFinal, nombreEst);
      if (!vinc.ok && vinc.error) {
        warning = 'PDF copiado pero no vinculado: ' + vinc.error;
      }
    } else if (!copia.ok) {
      warning = 'PDF no copiado: ' + (copia.error || 'sin detalle');
    }
  } catch (e) {
    warning = 'PDF no copiado: ' + e.message;
  }

  return { ok: !warning, idFinal, warning };
}
/**
 * Aplica los campos extraídos al proceso masivo (crear/rectificar factura).
 */
function _finalizarProcesamientoPDF(item, campos, motorUsado, existentes, config, copiarADestinos, opciones) {
  const file = item.file;
  const _normCod = (s) => String(s || '').trim().replace(/[\.\s\-]/g, '').toUpperCase();
  const codBuscado = _normCod(campos.fCodigo);

  const centro = codBuscado
    ? config.centros.find(c => _normCod(c.codigo) === codBuscado)
    : null;

  let warningCentro = '';
  if (!centro) {
    const esRutAciertaCod = /^\d{7,8}-[\dKk]$/.test(String(campos.fCodigo || ''));
    const tempCentro = config.centros.find(c => _esCentroFantasmaBack(c.codigo, c.cliente));
    if (!tempCentro) {
      return { estado: 'error_centro', detalle: 'Centro no encontrado y no hay centro "Sin asignar": ' + campos.fCodigo };
    }
    warningCentro = esRutAciertaCod
      ? 'RUT cliente Acierta "' + campos.fCodigo + '" no está en Config → agrégalo. Asignado a Sin asignar.'
      : 'Código "' + (campos.fCodigo || '—') + '" no reconocido → asignado a Sin asignar.';
  }
  const centroFinal = centro || config.centros.find(c => _esCentroFantasmaBack(c.codigo, c.cliente));

  let warningRut = '';
  if (campos.fRut && !_esRutEmoac(campos.fRut) && !centroFinal.rut) {
    try {
      const rRut = guardarRutCentroConfig(centroFinal.codigo, campos.fRut);
      if (rRut.ok && rRut.guardado) centroFinal.rut = rRut.rut;
      else if (!rRut.ok) warningRut = 'RUT no guardado: ' + rRut.error;
    } catch (e) { warningRut = 'RUT no guardado: ' + e.message; }
  }

  const tipo = (campos.fTipo || 'SUMINISTRO').toUpperCase();
  const esTemporal = _esCentroFantasmaBack(centroFinal.codigo, centroFinal.cliente);

  const dup = existentes.find(f => String(f.numero).trim() === String(campos.fNumero).trim());

  if (dup) {
    const info = obtenerInfoFactura(String(campos.fNumero).trim(), tipo);
    if (info.ok && info.pdfId) {
      let pagExist = 0;
      try { pagExist = _contarPaginasPdf(info.pdfId); } catch (e) { }
      _registrarPDFEnDup(opciones.dupRegistro, campos.fNumero, tipo, info.pdfId, '(vinculado en la BD)', pagExist);
    }
    let pagNuevo = 0;
    try { pagNuevo = _contarPaginasPdf(file); } catch (e) { }
    let idNuevo = '';
    try { idNuevo = file.getId(); } catch (e) { }
    _registrarPDFEnDup(opciones.dupRegistro, campos.fNumero, tipo, idNuevo, item.path, pagNuevo);

    if (!opciones.reprocesarRecientes && info.ok && info.procesadoMasivo) {
      const edadMs = Date.now() - info.procesadoMasivo.getTime();
      const UN_DIA_MS = 24 * 60 * 60 * 1000;
      if (edadMs < UN_DIA_MS) return { estado: 'duplicada', detalle: '', warning: 'Omitida: procesada <1 día' };
    }

    const paginasNuevo = _contarPaginasPdf(file);
    const pdfIdActual = info.ok ? info.pdfId : '';
    const paginasActual = pdfIdActual ? _contarPaginasPdf(pdfIdActual) : 0;
    let reemplazar = false;
    if (!pdfIdActual) reemplazar = true;
    else if (paginasNuevo > paginasActual) reemplazar = true;

    // Si hay que reemplazar el PDF: copiarlo a los destinos con el nombre
    // estándar y quedarnos con el ID nuevo. Misma lógica que al crear.
    let idDriveFinal = '';
    if (reemplazar && copiarADestinos) {
      const rCop = _copiarYVincularPDF(
        file, campos.fNumero, centroFinal.codigo, campos.fPeriodo, tipo, centroFinal
      );
      if (rCop.idFinal) idDriveFinal = rCop.idFinal;
      // El warning se propaga al warningFinal (abajo).
      if (rCop.warning) warningCentro += ' · ' + rCop.warning;
    }

    let rRect = { ok: false };
    try {
      rRect = actualizarFacturaDesdePDF({
        numero: String(campos.fNumero).trim(),
        tipo: tipo,
        cliente: esTemporal ? '' : centroFinal.cliente,
        codigo:  esTemporal ? '' : centroFinal.codigo,
        periodo: campos.fPeriodo || '',
        kwh: campos.fKwh, sum: campos.fSum, peaje: campos.fPeaje,
        intereses: campos.fInt, intPeaje: campos.fIntPeaje,
        otros: campos.fOtros, otrosPeaje: campos.fOtrosPeaje,
        total: campos.fTotal,
        fechaEmision: campos.fEmision, fechaVencimiento: campos.fVencimiento,
        // ⚠ La fecha de recepción NO se infiere del PDF ni del momento
        //   del procesamiento: debe quedar vacía para que el usuario la
        //   registre manualmente desde el modal o al hacer click en la
        //   celda del Seguimiento.
        fechaConsumo: '', fechaPeaje: ''
      }, idDriveFinal, new Date());
    } catch (e) { return { estado: 'error_otro', detalle: 'Rectificar: ' + e.message }; }
    if (!rRect.ok) return { estado: 'error_otro', detalle: 'Rectificar: ' + rRect.error };

    const diffs = _diffFacturaPDF(dup, campos);
    let msgPag = reemplazar
      ? (pdfIdActual ? 'Reemplazado (' + paginasNuevo + '>' + paginasActual + ')' : 'Vinculado (' + paginasNuevo + ')')
      : 'Rectificada';
    const warningFinal = msgPag + ' · Motor: ' + motorUsado;

    if (diffs.length) return { estado: 'rev_manual', detalle: 'Diferencias:\n' + diffs.join('\n'), warning: warningFinal };
    return { estado: 'rectificada', detalle: '', warning: warningFinal };
  }

  // Crear factura nueva
  const datos = {
    numero: String(campos.fNumero).trim(),
    codigo: centroFinal.codigo,
    cliente: centroFinal.cliente,
    periodo: campos.fPeriodo,
    tipo: tipo,
    // ⚠ La fecha de recepción NO se infiere del PDF ni del momento del
    //   procesamiento masivo. Se deja en blanco para que el usuario la
    //   registre manualmente al hacer click en la celda del Seguimiento.
    fecha: '',
    fechaConsumo: '',
    fechaPeaje: '',
    fechaEmision: campos.fEmision || '',
    fechaVencimiento: campos.fVencimiento || '',
    kwh: campos.fKwh || 0, sum: campos.fSum || 0, peaje: campos.fPeaje || 0,
    intereses: campos.fInt || 0, intPeaje: campos.fIntPeaje || 0,
    otros: campos.fOtros || 0, otrosPeaje: campos.fOtrosPeaje || 0,
    total: campos.fTotal || 0,
    pdfDriveUrl: '',
    procesadoMasivo: true
  };

  try { agregarFacturaFront(datos); }
  catch (e) { return { estado: 'error_otro', detalle: 'Al guardar: ' + e.message }; }

  // ─── Copiar el PDF a los destinos del centro y vincularlo a la
  //     factura recién creada. Se usa la MISMA función que en la rama
  //     "duplicada": _construirNombreArchivoEstandar → nombre único.
  let warning = '';
  if (copiarADestinos && (centroFinal.driveOp || centroFinal.driveCom)) {
    const nombreEst = _construirNombreArchivoEstandar(campos, centroFinal);
    try {
      const copia = copiarPDFDriveADestinos(file.getId(), centroFinal.codigo, nombreEst);
      if (copia.ok && copia.archivos && copia.archivos.length) {
        const idCopia = copia.archivos[0].id;
        // Vincular el ID copiado a la factura (queda en la columna PDF_ID).
        const vinc = vincularPDFDrive(campos.fNumero, idCopia, nombreEst);
        if (!vinc.ok && vinc.error) {
          warning = 'Factura creada; PDF copiado pero no vinculado: ' + vinc.error;
        }
      } else if (!copia.ok) {
        warning = 'Factura creada, PDF no copiado: ' + (copia.error || 'sin detalle');
      }
    } catch (e) {
      warning = 'Factura creada, PDF no copiado: ' + e.message;
    }
  }

  let pagRecienCreado = 0;
  try { pagRecienCreado = _contarPaginasPdf(file); } catch (e) { }
  let idRecienCreado = '';
  try { idRecienCreado = file.getId(); } catch (e) { }
  _registrarPDFEnDup(opciones.dupRegistro, campos.fNumero, tipo, idRecienCreado, item.path, pagRecienCreado);

  existentes.push({ numero: campos.fNumero, cliente: centroFinal.cliente, periodo: campos.fPeriodo, tipo: tipo });

  const warningsFinales = [warningCentro, warning, warningRut].filter(Boolean).join(' · ');
  return { estado: 'ok', detalle: '', warning: warningsFinales, numeroFactura: String(campos.fNumero || '').trim() };
}

function _listarPDFsRecursivo(folder, acc, path) {
  const pathActual = path ? path + '/' + folder.getName() : folder.getName();
  const files = folder.getFiles();
  while (files.hasNext()) {
    const f = files.next();
    if (f.getMimeType() === MimeType.PDF || /\.pdf$/i.test(f.getName())) {
      acc.push({ file: f, path: pathActual + '/' + f.getName() });
    }
  }
  const subs = folder.getFolders();
  while (subs.hasNext()) _listarPDFsRecursivo(subs.next(), acc, pathActual);
}

// ============================================================
//  Cuenta páginas de un PDF
// ============================================================
function _contarPaginasPdf(idOrFile) {
  try {
    const file = (typeof idOrFile === 'string') ? DriveApp.getFileById(idOrFile) : idOrFile;
    const blob = file.getBlob();
    const bytes = blob.getBytes();
    const s = Utilities.newBlob(bytes).getDataAsString('ISO-8859-1');
    const countMatch = s.match(/\/Count\s+(\d+)/);
    if (countMatch) { const n = parseInt(countMatch[1], 10); if (n > 0) return n; }
    const m1 = s.match(/\/Type\s*\/Page(?!s)/g);
    if (m1) return m1.length;
    return 0;
  } catch (e) { Logger.log('_contarPaginasPdf error: ' + e.message); return 0; }
}

