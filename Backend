function _inputANumero(v) {
  if (v == null) return 0;
  if (typeof v === 'number') return isFinite(v) ? v : 0;
  let s = String(v).trim();
  if (!s) return 0;
  s = s.replace(/[\$\s]/g, '');
  if (!s) return 0;
  if (s.includes(',')) s = s.replace(/\./g, '').replace(',', '.');
  else if (s.includes('.') && /^\d{1,3}(\.\d{3})+$/.test(s)) s = s.replace(/\./g, '');
  const n = Number(s);
  return isFinite(n) ? n : 0;
}

/* ═══════════════════════════════════════════════════════════════
 *  ★★★  BLOQUE DE PARSING — ÚNICO PUNTO DE MODIFICACIÓN  ★★★
 *
 *  Contrato de cada parser:
 *    · Recibe texto OCR CRUDO (String).
 *    · Devuelve objeto con:
 *        { fDTE, fEmpresa, fNumero, fCodigo, fRut, fPeriodo,
 *          fEmision, fVencimiento, fKwh, fSum, fPeaje, fInt,
 *          fIntPeaje, fOtros, fOtrosPeaje, fTotal, fTipo }
 *
 *  Funciones:
 *    · _detectarProveedor(t0)       → 'EMOAC' | 'ACIERTA'
 *    · _parsearEMOACDTE(t0)         → Parser EMOAC
 *    · _parsearAciertaDTE(t0)       → Parser Acierta
 *    · _parsearFacturaCompleta(t0)  → Router
 *
 *  El vencimiento NUNCA se calcula — sólo se extrae del PDF.
 * ═══════════════════════════════════════════════════════════════ */

function _detectarProveedor(t0) {
  const t = String(t0 || '')
    .replace(/[–—−]/g, '-')
    .replace(/[\u00A0\u1680\u2000-\u200A\u202F\u205F\u3000]/g, ' ');
  if (/77\.?\s*333\.?\s*033\s*-?\s*6/.test(t)) return 'ACIERTA';
  if (/76\.?\s*208\.?\s*888\s*-?\s*6/.test(t)
    || /EMOAC\s*SPA|COPE?C\s*EMOAC|Copecemoac/i.test(t)) return 'EMOAC';
  if (/\b(?:ENER|POTE|PEAJ|PASS)\.?\s*\d{2,}/i.test(t)) return 'ACIERTA';
  return 'EMOAC';
}

// ============================================================
//  Helper: convierte "OCHO MILLONES TRESCIENTOS DOS MIL
//  TREINTA Y TRES Pesos chilenos" → 8302033
// ============================================================
function _numeroEnPalabrasAPeso(texto) {
  if (!texto) return 0;
  const t = String(texto).toUpperCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/\s+/g, ' ').trim();
  const m = t.match(/\bSON\s+([A-Z ]+?)\s+PESOS?\b/);
  if (!m) return 0;
  const palabras = m[1].split(/\s+/).filter(Boolean);

  const UNI = {
    CERO: 0, UNO: 1, UN: 1, UNA: 1, DOS: 2, TRES: 3, CUATRO: 4, CINCO: 5,
    SEIS: 6, SIETE: 7, OCHO: 8, NUEVE: 9,
    DIEZ: 10, ONCE: 11, DOCE: 12, TRECE: 13, CATORCE: 14, QUINCE: 15,
    DIECISEIS: 16, DIECISIETE: 17, DIECIOCHO: 18, DIECINUEVE: 19,
    VEINTE: 20, VEINTIUNO: 21, VEINTIUN: 21, VEINTIDOS: 22, VEINTITRES: 23,
    VEINTICUATRO: 24, VEINTICINCO: 25, VEINTISEIS: 26, VEINTISIETE: 27,
    VEINTIOCHO: 28, VEINTINUEVE: 29,
    TREINTA: 30, CUARENTA: 40, CINCUENTA: 50, SESENTA: 60,
    SETENTA: 70, OCHENTA: 80, NOVENTA: 90,
    CIEN: 100, CIENTO: 100, DOSCIENTOS: 200, TRESCIENTOS: 300,
    CUATROCIENTOS: 400, QUINIENTOS: 500, SEISCIENTOS: 600,
    SETECIENTOS: 700, OCHOCIENTOS: 800, NOVECIENTOS: 900
  };

  let total = 0, actual = 0;
  for (const p of palabras) {
    if (p === 'MIL') {
      actual = (actual === 0 ? 1 : actual) * 1000;
      total += actual; actual = 0;
    } else if (p === 'MILLON' || p === 'MILLONES') {
      actual = (actual === 0 ? 1 : actual) * 1000000;
      total += actual; actual = 0;
    } else if (p === 'Y' || p === 'DE') {
      continue;
    } else if (p in UNI) {
      actual += UNI[p];
    }
  }
  total += actual;
  return total;
}

// ============================================================
//  Busca una fecha DD-MM-YYYY (formato chileno) junto a una
//  etiqueta. Asume que el OCR siempre produce las etiquetas
//  literales indicadas (normalizadas por NFD, sin acentos).
// ============================================================
// ============================================================
//  Extrae emisión y vencimiento del encabezado.
//  Estrategia SEMÁNTICA (no depende del orden de las etiquetas
//  ni del layout de tabla, que puede variar en el OCR):
//    1. Localizar la posición del primer "FECHA EMISIÓN" o
//       "FECHA VENCIMIENTO" en el texto.
//    2. Extraer TODAS las fechas DD-MM-YYYY en los 1500 chars
//       siguientes.
//    3. Desduplicar y ordenar cronológicamente.
//       · La menor → emisión.
//       · La mayor → vencimiento.
//  En toda factura chilena: emisión ≤ vencimiento. Es invariante.
// ============================================================
function _extraerFechasEmiVen(txt) {
  if (!txt) return { emision: '', vencimiento: '' };

  const posEmi = txt.search(/FECHA\s*EMISI[OÓ0]N/i);
  const posVen = txt.search(/FECHA\s*VENCIMIENTO/i);

  // Punto de partida: el primer label que aparezca.
  // Si ninguno aparece, arrancamos del inicio del texto.
  let inicio = 0;
  if (posEmi >= 0 && posVen >= 0) inicio = Math.min(posEmi, posVen);
  else if (posEmi >= 0) inicio = posEmi;
  else if (posVen >= 0) inicio = posVen;

  const VENTANA = 1500;
  const zona = txt.slice(inicio, inicio + VENTANA);

  const RE_FECHA = /(\d{1,2})\s*[-\/\.]\s*(\d{1,2})\s*[-\/\.]\s*(\d{4})/g;
  const encontradas = [];
  let m;
  while ((m = RE_FECHA.exec(zona)) !== null) {
    const dd = parseInt(m[1], 10);
    const mm = parseInt(m[2], 10);
    const yy = parseInt(m[3], 10);
    if (dd >= 1 && dd <= 31 && mm >= 1 && mm <= 12 && yy >= 2000 && yy <= 2099) {
      encontradas.push(yy + '-' + String(mm).padStart(2, '0') + '-' + String(dd).padStart(2, '0'));
    }
  }

  // Diagnóstico (queda en el log de Apps Script).
  try {
    Logger.log('[FECHAS] posEmi=' + posEmi + ' posVen=' + posVen +
      ' zona=' + JSON.stringify(zona.slice(0, 180)) +
      ' fechas=' + JSON.stringify(encontradas));
  } catch (e) { }

  if (!encontradas.length) return { emision: '', vencimiento: '' };

  const unicas = [...new Set(encontradas)].sort();

  if (unicas.length === 1) {
    // Sólo una fecha: no podemos asegurar a qué campo pertenece.
    // Asumimos emisión (suele ser la única que se imprime en muchos DTE).
    return { emision: unicas[0], vencimiento: '' };
  }

  // ≥ 2 fechas: la menor es emisión, la mayor es vencimiento.
  // Si todas las fechas son iguales (poco probable pero posible en OCR
  // que sólo imprime una fecha repetida), dejar vencimiento vacío para
  // no repetir el mismo valor en ambos campos.
  if (unicas.length >= 2 && unicas[0] === unicas[unicas.length - 1]) {
    return { emision: unicas[0], vencimiento: '' };
  }
  return {
    emision: unicas[0],
    vencimiento: unicas[unicas.length - 1]
  };
}

function _parsearEMOACDTE(textoOriginal) {
  const t0 = String(textoOriginal || '');
  const out = { fDTE: true, fEmpresa: 'EMOAC' };

  const tN = t0
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/[\u00A0\u1680\u2000-\u200A\u202F\u205F\u3000]/g, ' ')
    .replace(/[\u200B-\u200D\uFEFF]/g, '')
    .replace(/[ \t]+/g, ' ');

  // ─── 1) CÓDIGO CLIENTE ───
  let codigoCliente = '';
  {
    const m = tN.match(/COD\.?\s*CLIENTE\s*:?\s*([0-9][0-9Kk\.\-]{2,18})/i);
    if (m) {
      const v = m[1].trim().replace(/\s+/g, '').replace(/\./g, '');
      if (v && !_esRutEmoac(v) && !/^76\d{7}/.test(v.replace(/-/g, ''))) codigoCliente = v;
    }
  }
  if (!codigoCliente) {
    const mCod = tN.match(/COD\.?\s*CLIENTE/i);
    if (mCod) {
      const fromCod = tN.slice(mCod.index + mCod[0].length);
      const idxStop = fromCod.search(
        /\b(?:PEDIDO|ORDEN|FACTURA|SUBTOTAL|TOTAL|INDICADOR|BARRA|COMUNA|BANCO|CONTACTO|DESTINATARIO|EMAIL|MES\s+DE\s+CONSUMO)\b/i
      );
      const ventana = idxStop >= 0 ? fromCod.slice(0, idxStop) : fromCod.slice(0, 500);
      const reCand = /\b(\d{1,3}(?:\.\d{3}){1,3}(?:-[\dKk])?|\d{5,8}(?:-[\dKk])?)\b/g;
      const cands = [];
      let mm;
      while ((mm = reCand.exec(ventana)) !== null) {
        const raw = mm[1];
        if (raw.indexOf('.') >= 0) continue;
        const norm = raw.replace(/\./g, '').toUpperCase();
        if (_esRutEmoac(norm) || _esRutAcierta(norm)) continue;
        if (/^(19|20)\d{2}(?:-.*)?$/.test(norm)) continue;
        cands.push(norm);
      }
      if (cands.length) {
        codigoCliente = cands[cands.length - 1];
        _logDiag('[EMOAC] Código (COD. CLIENTE → último no-RUT): ' + codigoCliente +
          ' de [' + cands.join(', ') + ']');
      }
    }
  }

  // ─── 2) RUT receptor ───
  let rutReceptor = '';
  {
    const mRut = tN.match(/(?:RUT\s*RECEPTOR|R\.?\s*U\.?\s*T\.?\s*(?:RECEPTOR|DEL\s*CLIENTE))\s*:?\s*([\d\.]{7,12}\s*-\s*[\dKk])/i);
    if (mRut) {
      const r = mRut[1].replace(/[\.\s]/g, '');
      if (!_esRutEmoac(r)) rutReceptor = r;
    }
    if (!rutReceptor) {
      const mSec = tN.match(/(?:Se[ñn]or(?:\(es\)|es)?|Cliente)[\s\S]{0,500}?/i);
      if (mSec) {
        const bloque = tN.slice(mSec.index, mSec.index + 500);
        const mRut2 = bloque.match(/R\.?\s*U\.?\s*T\.?\s*:?\s*(\d{1,3}(?:\.\d{3}){2}\s*-\s*[\dKk])/i)
          || bloque.match(/(\d{1,3}(?:\.\d{3}){2}\s*-\s*[\dKk])/);
        if (mRut2) {
          const r = mRut2[1].replace(/[\.\s]/g, '');
          if (!_esRutEmoac(r)) rutReceptor = r;
        }
      }
    }
    if (!rutReceptor) {
      const todos = [];
      const reRut = /(\d{1,3}(?:\.\d{3}){2}\s*-\s*[\dKk])/g;
      let mm;
      while ((mm = reRut.exec(tN)) !== null) {
        const r = mm[1].replace(/[\.\s]/g, '');
        if (!_esRutEmoac(r)) todos.push(r);
      }
      const unicos = [...new Set(todos)];
      if (unicos.length >= 1) rutReceptor = unicos[0];
    }
  }

  if (codigoCliente) {
    out.fCodigo = codigoCliente;
    out.fRut = rutReceptor || codigoCliente;
  } else if (rutReceptor) {
    out.fRut = rutReceptor;
  }

  // ─── 3) N° FACTURA ───
  //  Se acota la búsqueda al encabezado superior (antes de "S.I.I.",
  //  "NOMBRE" o "PEDIDO") para no confundir el N° real con la
  //  referencia del pie:
  //    "Nota De Débito Electrónica · Corrige Montos ·
  //     Factura Electrónica N° 49285"
  //  Se acepta 1..12 dígitos: las "NOTA DE DÉBITO/CRÉDITO ELECTRÓNICA"
  //  de EMOAC usan N° cortos (ej. 628); los DTE corrientes usan 5-8.
  {
    const idxSII    = tN.search(/S\.?\s*I\.?\s*I\.?/i);
    const idxNombre = tN.search(/\bNOMBRE\s*:/i);
    const idxPedido = tN.search(/\bPEDIDO\b/i);
    let finCab = tN.length;
    [idxSII, idxNombre, idxPedido].forEach(i => { if (i > 0 && i < finCab) finCab = i; });
    if (finCab > 1500) finCab = 1500;
    const cabecera = tN.slice(0, finCab);

    let numero = '';

    // 3.1) Tipo de documento + N° dentro del encabezado
    const m1 = cabecera.match(
      /(?:NOTA\s+DE\s+(?:D[EÉ]BITO|CR[EÉ]DITO)|FACTURA)\s+ELECTR[ÓO]NICA[\s\S]{0,80}?N[°ºoO0]?\s*[:\.\-\s]{0,8}0*(\d{1,12})/i
    );
    if (m1) numero = m1[1];

    // 3.2) Fallback: cualquier "N° <numero>" dentro del encabezado
    if (!numero) {
      const m2 = cabecera.match(/N[°ºoO]\s*[:\.\-\s]{0,8}0*(\d{1,12})/);
      if (m2) numero = m2[1];
    }

    // 3.3) Fallback final: patrones tradicionales (para DTE atípicos
    //      que no pongan el N° antes de S.I.I. / NOMBRE / PEDIDO)
    if (!numero) {
      const patrones = [
        /(?:FOLIO|N[°ºo]?\s*(?:DE\s*)?FACTURA|FACTURA\s*N[°ºo]?|N[°ºo]?\s*DOCUMENTO|N[°ºo]?\s*DTE|N[°ºo]?\s*INTERNO)\s*:?\s*0*(\d{1,12})/i,
        /\bN[°º]\s*:?\s*0*(\d{1,12})/
      ];
      for (const re of patrones) {
        const m = tN.match(re);
        if (m) { numero = m[1]; break; }
      }
    }

    if (numero && !/^0+$/.test(numero) && !/^(19|20)\d{2}$/.test(numero)) {
      out.fNumero = numero;
    }
  }

  // ─── 4) FECHAS — sólo se extraen, nunca se calculan ───
  {
    const _f = _extraerFechasEmiVen(tN);
    out.fEmision = _f.emision;
    out.fVencimiento = _f.vencimiento;
  }

  // 🔎 Diagnóstico — quitar cuando funcione
  try {
    const ctxE = tN.match(/.{0,40}EMISI.{0,60}/i);
    const ctxV = tN.match(/.{0,40}VENCIMIENTO.{0,60}/i);
    Logger.log('[EMOAC FECHAS] emisión ctx: ' + (ctxE ? JSON.stringify(ctxE[0]) : '(no encontrado)'));
    Logger.log('[EMOAC FECHAS] vencim. ctx: ' + (ctxV ? JSON.stringify(ctxV[0]) : '(no encontrado)'));
    Logger.log('[EMOAC FECHAS] resultado: emi=' + out.fEmision + ' ven=' + out.fVencimiento);
  } catch (e) { }

  // ─── 5) PREPROCESADO DE LA TABLA DE CARGOS (SOLO PÁGINA 1) ───
  //  Todo lo que sigue trabaja exclusivamente con la tabla oficial
  //  CODIGO/DETALLE/CANTIDAD/PRECIO UNIT/TOTAL y el pie Afecto/Exento/
  //  IVA/Total de la página 1. Nunca se usan "Mes de consumo", "Monto
  //  neto", "Monto exento" ni "Total a pagar" (esos viven en el
  //  reporte informativo de páginas siguientes).
  let t = t0;
  t = t.replace(/([A-Za-zÁÉÍÓÚÑáéíóúñ])(\d)/g, '$1 $2');
  t = t.replace(/(\d)([A-Za-zÁÉÍÓÚÑáéíóúñ])/g, '$1 $2');

  // ─── 6) PERÍODO — desde la línea de detalle "CODIGO ... / MES AÑO" ───
  const MESES_TXT = {
    ENERO: '01', FEBRERO: '02', MARZO: '03', ABRIL: '04', MAYO: '05', JUNIO: '06',
    JULIO: '07', AGOSTO: '08', SEPTIEMBRE: '09', SETIEMBRE: '09',
    OCTUBRE: '10', NOVIEMBRE: '11', DICIEMBRE: '12'
  };
  {
    const mPer = tN.match(/\/\s*(ENERO|FEBRERO|MARZO|ABRIL|MAYO|JUNIO|JULIO|AGOSTO|SEPTIEMBRE|SETIEMBRE|OCTUBRE|NOVIEMBRE|DICIEMBRE)\s+(\d{4})/i);
    if (mPer) {
      const mes = MESES_TXT[mPer[1].toUpperCase()];
      if (mes) out.fPeriodo = mPer[2] + '-' + mes;
    }
    if (!out.fPeriodo) {
      const mPer2 = tN.match(/per[ií]odo\s*:?\s*(\d{2})[\-\/](\d{4})/i);
      if (mPer2) out.fPeriodo = mPer2[2] + '-' + mPer2[1];
    }
  }

  // ─── 7) MONTOS — por códigos 691xxx de la tabla oficial (página 1) ───
  //  Suministro (afecto):        691020 ENERGIA, 691021 CARGO DEMANDA HP
  //  Legales (cargo suministro): 691023 CEN, 691024 TRANSPORTE,
  //                              691034 LEY 20.780, 691035 SERV.PUB BASE,
  //                              691036 SERV.PUB FET
  //  Peaje distribución (DX):    691029 COMPRA POTENCIA DX,
  //                              691030 ENERGIA DX, 691032 POTENCIA
  //                              SUMINISTRADA DX, 691038 CARGO FIJO DX,
  //                              691039 CARGO POTENCIA HP DX
  //  Intereses suministro:       691010
  //  Intereses peaje (DX):       691040
  //  Otros peaje (DX):           691041
  // Suministro: 691020, 691021, 691024, 691035, 691036, 691023, 691034
  const SUM = { '691020': 1, '691021': 1, '691024': 1, '691035': 1, '691036': 1 };
  const LEGALES = { '691023': 1, '691034': 1 };
  // Peaje: 691029, 691030, 691032, 691038, 691039
  const PEAJE = { '691029': 1, '691030': 1, '691032': 1, '691038': 1, '691039': 1 };
  // Arriendo medidor: 691041
  const ARRIENDO = { '691041': 1 };
  const INT_SUM = { '691010': 1 };
  const INT_PEAJE = { '691040': 1 };
  const OTROS_PEAJE = {};

  let sum = 0, peaje = 0, intSum = 0, intPeaje = 0, otrosPeaje = 0, arriendo = 0, kwh = 0;
  let tieneSum = false, tienePeaje = false, tieneArriendo = false;

  const RE_NUM = /\d+(?:[.,]\d+)*/g;
  const codeRe = /691(?:010|020|021|023|024|029|030|032|034|035|036|038|039|040|041)/g;
  const positions = [];
  let mcPos;
  while ((mcPos = codeRe.exec(t)) !== null) positions.push(mcPos.index);
  positions.push(t.length);

  for (let ci = 0; ci < positions.length - 1; ci++) {
    let chunk = t.substring(positions[ci], positions[ci + 1]);
    // Cortar el chunk cuando aparezca cualquier marcador de fin de fila.
    // Se añaden "Nota De Débito" y "Corrige Montos" porque la nota de
    // referencia al pie ("... Corrige Montos Factura Electrónica N° 49285")
    // contiene un N° que el parser confundía con el monto del cargo.
    const corte = chunk.search(
      /\b(Afecto|Exento|IVA|Total[\s:$]|Son\s|Timbre|Verifique|Nota\s+De\s+D|Corrige\s+Montos)/i
    );
    if (corte > 0) chunk = chunk.substring(0, corte);
    const mc = chunk.match(/^(691\d{3})/);
    if (!mc) continue;
    const cod = mc[1];

    RE_NUM.lastIndex = 0;
    const nums = [];
    let mm;
    while ((mm = RE_NUM.exec(chunk)) !== null) nums.push(mm[0]);
    if (nums.length < 2) continue;
    const total = _inputANumero(nums[nums.length - 1]);

    if (SUM[cod] || LEGALES[cod]) { sum += total; tieneSum = true; }
    else if (PEAJE[cod]) { peaje += total; tienePeaje = true; }
    else if (ARRIENDO[cod]) {
      // 691041 sólo es Arriendo de Medidor si el texto de la fila lo dice.
      // Si no, es un cargo de peaje (OTROS DX).
      const esArriendoMedidor = /ARRIENDO\s*(DE\s*)?MEDIDOR/i.test(chunk);
      if (esArriendoMedidor) { arriendo += total; tieneArriendo = true; }
      else                   { peaje    += total; tienePeaje    = true; }
    }
    else if (OTROS_PEAJE[cod]) { otrosPeaje += total; }
    else if (INT_SUM[cod]) { intSum += total; }
    else if (INT_PEAJE[cod]) { intPeaje += total; }

    // El kWh puede venir de la fila de suministro (691020)
    // o de la fila de peaje (691030 ENERGIA DX).
    if ((cod === '691020' || cod === '691030') && !kwh) {
      // La cantidad precede a la palabra KWH en el layout de EMOAC.
      // Ejemplos:
      //   "ENERGIA 2287 / AGOSTO 2026 181.618,540 KWH ..."
      //   "ENERGIA DX 9458517 / JUNIO 2026 23.244,400 KWH ..."
      // El patrón captura el número en notación chilena seguido de KWH.
      const mK = chunk.match(/(\d{1,3}(?:\.\d{3})*(?:,\d+)?)\s*KWH/i);
      if (mK) kwh = _inputANumero(mK[1]);
    }
  }

  // ─── 8) TOTAL — extraído SOLO de la página 1, NUNCA calculado ───
  //  La página 1 contiene la única fuente oficial del total:
  //    · "Total$22.530.025"  (pegado al $, sin espacio)
  //    · o "Total: $22.530.025" / "Total $ 22.530.025"
  //  Además, al final de la página 1 aparece SIEMPRE:
  //    · "Son … Pesos chilenos"  (número en palabras)
  //  Las páginas informativas (2, 3, …) traen "Total a pagar" y
  //  "Subtotal suministro" con valores que pueden diferir del oficial
  //  (por redondeo o por desfase del reporte). Por eso acotamos la
  //  búsqueda al bloque de página 1: desde el inicio hasta el texto
  //  "Son … Pesos chilenos" o el Timbre SII.
  let totalPagar = 0;
  {
    // Delimitar zona de página 1
    let zonaPag1 = tN;
    const idxSon    = tN.search(/\bSon\s+[A-ZÁÉÍÓÚÑ\s]+\s+Pesos\s+chilenos/i);
    const idxTimbre = tN.search(/Timbre\s+Electr[oó]nico|Res\.\s*80\s+del/i);
    const cortes = [idxSon, idxTimbre].filter(x => x > 0);
    if (cortes.length) zonaPag1 = tN.slice(0, Math.min(...cortes));

    // 1) "Total" con $ obligatorio, dentro de la página 1
    const m1 = zonaPag1.match(/\bTotal\s*[:\-]?\s*\$+\s*([\d\.]+(?:,\d+)?)/i);
    if (m1) {
      const n = _inputANumero(m1[1]);
      if (n >= 100000 && !(n >= 690000 && n <= 692000)) totalPagar = n;
    }

    // 2) Respaldo: "Total a pagar $X" (por si el layout viniera sin "Total$X")
    if (!totalPagar) {
      const m2 = zonaPag1.match(/\bTotal\s*a\s*pagar\s*[:\-]?\s*\$+\s*([\d\.]+(?:,\d+)?)/i);
      if (m2) {
        const n = _inputANumero(m2[1]);
        if (n >= 100000 && !(n >= 690000 && n <= 692000)) totalPagar = n;
      }
    }

    // 3) Último recurso: número en palabras ("Son … Pesos chilenos")
    if (!totalPagar) {
      totalPagar = _numeroEnPalabrasAPeso(tN);
    }
  }

  out.fSum = Math.round(sum + intSum);
  out.fPeaje = Math.round(peaje + intPeaje);
  out.fKwh = kwh;
  out.fInt = Math.round(intSum);
  out.fIntPeaje = Math.round(intPeaje);
  out.fOtros = 0;
  out.fOtrosPeaje = Math.round(otrosPeaje + arriendo);
  out.fTotal = Math.round(totalPagar) || 0;
  // Prioridad pedida por el usuario:
  //   sum + peaje      → UNIFICADA
  //   sum + arriendo   → CONSUMO
  //   peaje + arriendo → PEAJE
  //   solo arriendo    → ARRIENDO_MEDIDOR
  //   solo peaje       → PEAJE
  //   resto            → CONSUMO
  out.fTipo = (tieneSum && tienePeaje)      ? 'UNIFICADA'
            : (tieneSum && tieneArriendo)   ? 'SUMINISTRO'
            : (tienePeaje && tieneArriendo) ? 'PEAJE'
            : (tieneArriendo)               ? 'ARRIENDO_MEDIDOR'
            : (tienePeaje)                  ? 'PEAJE'
            :                                 'SUMINISTRO';

  if (!out.fPeriodo && out.fEmision) out.fPeriodo = out.fEmision.slice(0, 7);

  // ⚠ Vencimiento: NUNCA se calcula. Si no aparece en el PDF, queda vacío.

  return out;
}

function _parsearAciertaDTE(textoOriginal) {
  const _log = (m) => { try { Logger.log('[Acierta] ' + m); } catch(e) {} };
  const t0 = String(textoOriginal || '');
  const out = { fDTE: true, fEmpresa: 'Acierta' };

  _log('t0.length=' + t0.length);
  _log('t0(0..500)=' + JSON.stringify(t0.slice(0, 500)));

  const tN = t0
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/[\u00A0\u1680\u2000-\u200A\u202F\u205F\u3000]/g, ' ')
    .replace(/[\u200B-\u200D\uFEFF]/g, '')
    .replace(/[“”„«»]/g, '"')
    .replace(/[‘’]/g, "'")
    .replace(/[–—−]/g, '-')
    .replace(/[ \t]+/g, ' ');

  // ─── 1) N° FACTURA ───
  try {
    let num = '';
    let m = tN.match(/FACTURA\s+ELECTR[OÓ]NICA[\s\S]{0,150}?\b0*(\d{4,12})\b/i);
    if (m) num = m[1].replace(/^0+/, '');
    if (!num) {
      m = tN.match(/\bN[°ºoO0]\s*[:\.\-]?\s*0*(\d{4,12})\b/i);
      if (m) num = m[1].replace(/^0+/, '');
    }
    if (/^(19|20)\d{2}$/.test(num)) num = '';
    if (/^5[6-9]\d{7,}$/.test(num)) num = '';
    if (num) out.fNumero = num;
    _log('fNumero=' + out.fNumero);
  } catch (e) { _log('ERR 1: ' + e.message); }

  // ─── 2) RUT / CÓDIGO CLIENTE ───
  try {
    let rut = '';
    let re = /(?<!\d)(\d{1,3}\.\d{3}\.\d{3})\s*-?\s*([\dKk])(?![\d])/g;
    let mm;
    while ((mm = re.exec(tN)) !== null) {
      const r = mm[1].replace(/\./g, '') + '-' + mm[2].toUpperCase();
      if (!_esRutAcierta(r) && !_esRutEmoac(r)) { rut = r; break; }
    }
    if (!rut) {
      re = /(?<!\d)(\d{7,8})\s*-\s*([\dKk])(?![\d])/g;
      while ((mm = re.exec(tN)) !== null) {
        const r = mm[1] + '-' + mm[2].toUpperCase();
        if (!_esRutAcierta(r) && !_esRutEmoac(r)) { rut = r; break; }
      }
    }
    if (rut) { out.fCodigo = rut; out.fRut = rut; }
    _log('fCodigo=' + out.fCodigo);
  } catch (e) { _log('ERR 2: ' + e.message); }

  // ─── 3) EMISIÓN / VENCIMIENTO ───
  try {
    const mE = tN.match(/Emisi[oó0]n\s*:?\s*(\d{1,2})\s*[-\/\.]\s*(\d{1,2})\s*[-\/\.]\s*(\d{4})/i);
    if (mE) out.fEmision = mE[3] + '-' +
      String(parseInt(mE[2], 10)).padStart(2, '0') + '-' +
      String(parseInt(mE[1], 10)).padStart(2, '0');

    const mV = tN.match(/Vencimiento\s*:?\s*(\d{1,2})\s*[-\/\.]\s*(\d{1,2})\s*[-\/\.]\s*(\d{4})/i);
    if (mV) out.fVencimiento = mV[3] + '-' +
      String(parseInt(mV[2], 10)).padStart(2, '0') + '-' +
      String(parseInt(mV[1], 10)).padStart(2, '0');
    _log('fEmision=' + out.fEmision + ' fVencimiento=' + out.fVencimiento);
  } catch (e) { _log('ERR 3: ' + e.message); }

  // ─── 4) PERÍODO ───
  try {
    const m = tN.match(/periodo\s*:?\s*(\d{2})\s*[-\/]\s*(\d{4})/i);
    if (m) out.fPeriodo = m[2] + '-' + m[1];
    if (!out.fPeriodo && out.fEmision) out.fPeriodo = out.fEmision.slice(0, 7);
    _log('fPeriodo=' + out.fPeriodo);
  } catch (e) { _log('ERR 4: ' + e.message); }

  // ─── 5) MONTOS DEL PIE ───
  let exento = 0, neto = 0, iva = 0, total = 0;
  try {
    const _monto = (etq) => {
      const re = new RegExp(etq + '[\\s\\S]{0,30}?\\$\\s*(\\d{1,3}(?:\\.\\d{3})+(?:,\\d+)?)', 'i');
      const mm = tN.match(re);
      return mm ? _inputANumero(mm[1]) : 0;
    };
    exento = _monto('\\bExento');
    neto   = _monto('\\bNeto\\s*:');
    iva    = _monto('I\\.?\\s*V\\.?\\s*A\\.?');
    total  = _monto('\\bTotal\\s*:');
    if (!neto)  neto  = _monto('\\bNeto');
    if (!total) total = _monto('\\bTotal');
    _log('exento=' + exento + ' neto=' + neto + ' iva=' + iva + ' total=' + total);
  } catch (e) { _log('ERR 5: ' + e.message); }

  // ─── 6) PEAJE ───
  let peaje = 0;
  try {
    const re = /PEAJES?\s*DX([\s\S]{0,80}?)(?=\d+\s*(?:PASS|ENER|POTE|PEAJ)\b|\s*(?:Exento|Neto|I\.?V\.?A\.?|Total)\b|$)/i;
    const m = tN.match(re);
    if (m) {
      const nums = m[1].match(/\d{1,3}(?:\.\d{3})+/g) || [];
      const validos = nums.map(n => _inputANumero(n)).filter(n => n >= 1000);
      if (validos.length) peaje = validos[validos.length - 1];
    }
    _log('peaje=' + peaje);
  } catch (e) { _log('ERR 6: ' + e.message); }

  // ─── 7) kWh ───
  let kwh = 0;
  try {
    const m = tN.match(/ENERG[IÍ]A\s*(\d{1,3}(?:\.\d{3})+,\d{1,3})/i);
    if (m) kwh = _inputANumero(m[1]);
    if (!kwh) {
      const m2 = tN.match(/ENERG[IÍ]A\s*(\d{3,}(?:,\d{1,3})?)/i);
      if (m2) kwh = _inputANumero(m2[1]);
    }
    _log('kwh=' + kwh);
  } catch (e) { _log('ERR 7: ' + e.message); }

  // ─── 8) SUMINISTRO NETO ───
  let sum = 0;
  try {
    if (neto > 0) sum = neto + exento - peaje;
    else if (total > 0) sum = total - iva - peaje;
    if (sum < 0) sum = 0;
  } catch (e) { _log('ERR 8: ' + e.message); }

  out.fSum        = Math.round(sum);
  out.fPeaje      = Math.round(peaje);
  out.fKwh        = kwh;
  out.fTotal      = Math.round(total || (neto + iva + exento));
  out.fInt        = 0;
  out.fIntPeaje   = 0;
  out.fOtros      = 0;
  out.fOtrosPeaje = 0;
  out.fTipo       = (out.fPeaje > 0 && out.fSum > 0) ? 'UNIFICADA'
                  : (out.fPeaje > 0) ? 'PEAJE'
                  : 'CONSUMO';

  _log('RESULTADO: ' + JSON.stringify(out));
  return out;
}

function _parsearFacturaCompleta(textoOriginal) {
  const t0 = String(textoOriginal || '');
  const proveedor = _detectarProveedor(t0);
  Logger.log('[Router] Proveedor detectado: ' + proveedor);
  try {
    const r = (proveedor === 'ACIERTA') ? _parsearAciertaDTE(t0) : _parsearEMOACDTE(t0);
    return r || {};
  } catch (e) {
    Logger.log('[Router] ✗ ERROR en ' + proveedor + ': ' + e.message +
               ' | stack: ' + (e.stack || '(sin stack)'));
    return { fDTE: true, fEmpresa: proveedor, _error: String(e.message || e) };
  }
}

