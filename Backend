function agregarFacturaFront(datos) {
  if (!datos || !datos.numero) throw new Error('Falta el N° de factura');
  if (!datos.cliente) throw new Error('Falta el centro de costo');
  if (!datos.periodo) throw new Error('Falta el período');
  const ss = SpreadsheetApp.openById(SS_ID);
  const sh = ss.getSheetByName(HOJA_RESUMEN);
  const existentes = leerResumen();
  let tipoNuevo = (datos.tipo || 'SUMINISTRO').toUpperCase();
  if (tipoNuevo === 'CONSUMO') tipoNuevo = 'SUMINISTRO';
  const dup = existentes.find(function (f) { return f.numero === String(datos.numero).trim(); });
  if (dup) throw new Error('Ya existe la factura N°' + datos.numero);
  let codigo = datos.codigo || '';
  if (!codigo) { const c = existentes.find(f => f.cliente === datos.cliente && f.codigo); if (c) codigo = c.codigo; }
  const _fRecep = (aplica, fechaExplicita) => {
    if (!aplica) return '';
    const src = (fechaExplicita != null && fechaExplicita !== '')
      ? fechaExplicita
      : datos.fecha;
    if (!src) return SENTINELA_SIN_FECHA;
    const s = String(src).trim();
    if (SENTINELAS.indexOf(s) !== -1) return s;
    return parseISO(s);
  };
  const fC = _fRecep(
    tipoNuevo === 'SUMINISTRO' || tipoNuevo === 'UNIFICADA',
    datos.fechaConsumo
  );
  const fP = _fRecep(
    tipoNuevo === 'PEAJE' || tipoNuevo === 'UNIFICADA',
    datos.fechaPeaje
  );
  const fE = datos.fechaEmision ? parseISO(datos.fechaEmision) : '';
  const fV = datos.fechaVencimiento ? parseISO(datos.fechaVencimiento) : '';
  const marcaProcesado = datos.procesadoMasivo ? new Date() : '';
  const fila = [
    String(datos.numero).trim(), codigo, datos.cliente, datos.periodo, tipoNuevo,
    Number(datos.kwh) || 0, Number(datos.sum) || 0, Number(datos.peaje) || 0,
    Number(datos.intereses) || 0,
    Number(datos.intPeaje) || 0,
    Number(datos.total) || 0,
    fC, fP, fE, fV, '', marcaProcesado
  ];
  const lr = sh.getLastRow() + 1;
  sh.getRange(lr, COL.CODIGO).setNumberFormat('@');
  sh.getRange(lr, COL.PERIODO).setNumberFormat('@');
  sh.getRange(lr, COL.FECHA_SUMINISTRO, 1, 4).setNumberFormat('dd/mm/yyyy');
  sh.getRange(lr, COL.KWH).setNumberFormat('#,##0.00');
  sh.getRange(lr, COL.SUM, 1, 2).setNumberFormat('$#,##0');
  sh.getRange(lr, COL.INT, 1, 2).setNumberFormat('$#,##0');
  sh.getRange(lr, COL.TOTAL).setNumberFormat('$#,##0');
