function _parseFechaDMY(str) {
  if (!str) return '';
  let mm = String(str).match(/(\d{1,2})[-\/\.](\d{1,2})[-\/\.](\d{2,4})/);
  if (mm) {
    const y = mm[3].length === 2 ? ('20' + mm[3]) : mm[3];
    const d = String(parseInt(mm[1], 10)).padStart(2, '0');
    const mo = String(parseInt(mm[2], 10)).padStart(2, '0');
    if (+mo >= 1 && +mo <= 12 && +d >= 1 && +d <= 31) return y + '-' + mo + '-' + d;
  }
  mm = String(str).match(/(\d{4})[-\/\.](\d{1,2})[-\/\.](\d{1,2})/);
  if (mm) return mm[1] + '-' + String(parseInt(mm[2], 10)).padStart(2, '0') + '-' + String(parseInt(mm[3], 10)).padStart(2, '0');
  return '';
}

function _extraerFechaTras(txt, etiqueta, tolerante) {
  const gap = tolerante ? 150 : 40;
  let re = new RegExp(etiqueta + '[^\\d\\n]{0,' + gap + '}(\\d{1,2}\\s*[-\\/\\.]\\s*\\d{1,2}\\s*[-\\/\\.]\\s*\\d{2,4})', 'i');
  let mm = txt.match(re);
  if (mm) return mm[1];
  re = new RegExp(etiqueta + '[\\s\\S]{0,' + gap + '}?(\\d{1,2}\\s*[-\\/\\.]\\s*\\d{1,2}\\s*[-\\/\\.]\\s*\\d{2,4})', 'i');
  mm = txt.match(re);
  if (mm) return mm[1];
  const idx = txt.search(new RegExp(etiqueta, 'i'));
  if (idx >= 0) {
    const sub = txt.slice(idx + etiqueta.length, idx + etiqueta.length + 300);
    const mF = sub.match(/(\d{1,2}\s*[-\/\.]\s*\d{1,2}\s*[-\/\.]\s*\d{2,4})/);
    if (mF) return mF[1];
  }
  return '';
}

