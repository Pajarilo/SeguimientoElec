    const actual = String(data[i][COL_CLIENTE - 1] || '').trim();
    if (MAPA[actual]) { sh.getRange(i + 1, COL_CLIENTE).setValue(MAPA[actual]); cambios++; }
  }
  SpreadsheetApp.getUi().alert('✓ Nombres normalizados: ' + cambios);
}

function previsualizarRenombradoPDFs() {
  const ss = SpreadsheetApp.openById(SS_ID);
  const sh = ss.getSheetByName(HOJA_RESUMEN);
  if (!sh) { Logger.log('No existe "Resumen Facturación"'); return; }
  const lr = Math.max(sh.getLastRow(), 1);
  if (lr < 2) { Logger.log('Sin facturas'); return; }
  const nCols = Math.max(sh.getLastColumn(), COL.PDF_ID);
  const data  = sh.getRange(2, 1, lr - 1, nCols).getValues();
  const lineas = [];
  let conCambio = 0, papelera = 0, inaccesibles = 0, recuperables = 0;
  data.forEach((fila, i) => {
    const numero  = String(fila[COL.NUMERO - 1] || '').trim();
    const codigo  = String(fila[COL.CODIGO - 1] || '').trim();
    const periodo = String(fila[COL.PERIODO - 1] || '').trim();
    const tipo    = String(fila[COL.TIPO - 1] || '').trim();
    const pdfId   = String(fila[COL.PDF_ID - 1] || '').trim();
    if (!pdfId || !numero) return;
    const nombreNuevo = _construirNombreArchivoEstandar({ numero, codigo, periodo, tipo });
    let file = null, motivo = '';
    try {
      file = DriveApp.getFileById(pdfId);
      let trashed = false;
      try { trashed = file.isTrashed(); } catch (e) {}
      if (trashed) { file = null; motivo = 'EN PAPELERA'; }
    } catch (e) { file = null; motivo = 'INACCESIBLE: ' + (e.message || e); }
    if (!file) {
      const busqueda = _buscarPDFEnDriveDelCentro(codigo, numero);
      if (busqueda.ok && busqueda.encontrado) { recuperables++;
        lineas.push('· Fila ' + (i + 2) + '  N° ' + numero + '  ⚠️ ' + motivo + '  →  auto-recuperable');
        return;
      }
      if (motivo.indexOf('PAPELERA') !== -1) papelera++; else inaccesibles++;
      lineas.push('· Fila ' + (i + 2) + '  N° ' + numero + '  ❌ ' + motivo);
      return;
    }
    const actual = file.getName();
    if (actual === nombreNuevo) return;
    conCambio++;
    lineas.push('· Fila ' + (i + 2) + '  N° ' + numero);
    lineas.push('    de:  ' + actual);
    lineas.push('    a:   ' + nombreNuevo);
  });
  const cab = ['🔍 Previsualización de renombrado','',
    '· A renombrar:             ' + conCambio,
    '· Auto-recuperables:       ' + recuperables,
    '· En papelera (sin match): ' + papelera,
    '· Inaccesibles:            ' + inaccesibles,''].join('\n');
  Logger.log(cab + lineas.join('\n'));
}

function _extraerFechasEmiVen(txt) {
  if (!txt) return { emision: '', vencimiento: '' };

  const posEmi = txt.search(/FECHA\s*EMISI[OÓ0]N/i);
  const posVen = txt.search(/FECHA\s*VENCIMIENTO/i);

  let inicio = 0;
  if (posEmi >= 0 && posVen >= 0) inicio = Math.min(posEmi, posVen);
  else if (posEmi >= 0) inicio = posEmi;
  else if (posVen >= 0) inicio = posVen;

  const VENTANA = 1500;
  const zona = txt.slice(inicio, inicio + VENTANA);

  const RE_FECHA = /(\d{1,2})\s*[-\/\.]\s*(\d{1,2})\s*[-\/\.]\s*(\d{4})/g;
  const encontradas = [];
  let m;
  while ((m = RE_FECHA.exec(zona)) !== null) {
    const dd = parseInt(m[1], 10);
    const mm = parseInt(m[2], 10);
    const yy = parseInt(m[3], 10);
    if (dd >= 1 && dd <= 31 && mm >= 1 && mm <= 12 && yy >= 2000 && yy <= 2099) {
      encontradas.push(yy + '-' + String(mm).padStart(2, '0') + '-' + String(dd).padStart(2, '0'));
    }
  }

  try {
    Logger.log('[FECHAS] posEmi=' + posEmi + ' posVen=' + posVen +
      ' zona=' + JSON.stringify(zona.slice(0, 180)) +
      ' fechas=' + JSON.stringify(encontradas));
  } catch (e) { }

  if (!encontradas.length) return { emision: '', vencimiento: '' };

  const unicas = [...new Set(encontradas)].sort();

  if (unicas.length === 1) {
    return { emision: unicas[0], vencimiento: '' };
  }

  if (unicas.length >= 2 && unicas[0] === unicas[unicas.length - 1]) {
    return { emision: unicas[0], vencimiento: '' };
  }
  return {
    emision: unicas[0],
    vencimiento: unicas[unicas.length - 1]
  };
}

function _parsearEMOACDTE(textoOriginal) {
  const t0 = String(textoOriginal || '');
  const out = { fDTE: true, fEmpresa: 'EMOAC' };

  const tN = t0
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/[\u00A0\u1680\u2000-\u200A\u202F\u205F\u3000]/g, ' ')
    .replace(/[\u200B-\u200D\uFEFF]/g, '')
    .replace(/[ \t]+/g, ' ');

  // ─── 1) CÓDIGO CLIENTE ───
  let codigoCliente = '';
  {
    const m = tN.match(/COD\.?\s*CLIENTE\s*:?\s*([0-9][0-9Kk\.\-]{2,18})/i);
    if (m) {
      const v = m[1].trim().replace(/\s+/g, '').replace(/\./g, '');
      if (v && !_esRutEmoac(v) && !/^76\d{7}/.test(v.replace(/-/g, ''))) codigoCliente = v;
    }
  }
  if (!codigoCliente) {
    const mCod = tN.match(/COD\.?\s*CLIENTE/i);
    if (mCod) {
      const fromCod = tN.slice(mCod.index + mCod[0].length);
      const idxStop = fromCod.search(
        /\b(?:PEDIDO|ORDEN|FACTURA|SUBTOTAL|TOTAL|INDICADOR|BARRA|COMUNA|BANCO|CONTACTO|DESTINATARIO|EMAIL|MES\s+DE\s+CONSUMO)\b/i
      );
      const ventana = idxStop >= 0 ? fromCod.slice(0, idxStop) : fromCod.slice(0, 500);
      const reCand = /\b(\d{1,3}(?:\.\d{3}){1,3}(?:-[\dKk])?|\d{5,8}(?:-[\dKk])?)\b/g;
      const cands = [];
      let mm;
      while ((mm = reCand.exec(ventana)) !== null) {
        const raw = mm[1];
        if (raw.indexOf('.') >= 0) continue;
        const norm = raw.replace(/\./g, '').toUpperCase();
        if (_esRutEmoac(norm) || _esRutAcierta(norm)) continue;
        if (/^(19|20)\d{2}(?:-.*)?$/.test(norm)) continue;
        cands.push(norm);
      }
      if (cands.length) {
        codigoCliente = cands[cands.length - 1];
        _logDiag('[EMOAC] Código (COD. CLIENTE → último no-RUT): ' + codigoCliente +
          ' de [' + cands.join(', ') + ']');
      }
    }
  }

  // ─── 2) RUT receptor ───
  let rutReceptor = '';
  {
    const mRut = tN.match(/(?:RUT\s*RECEPTOR|R\.?\s*U\.?\s*T\.?\s*(?:RECEPTOR|DEL\s*CLIENTE))\s*:?\s*([\d\.]{7,12}\s*-\s*[\dKk])/i);
    if (mRut) {
      const r = mRut[1].replace(/[\.\s]/g, '');
      if (!_esRutEmoac(r)) rutReceptor = r;
    }
    if (!rutReceptor) {
      const mSec = tN.match(/(?:Se[ñn]or(?:\(es\)|es)?|Cliente)[\s\S]{0,500}?/i);
      if (mSec) {
        const bloque = tN.slice(mSec.index, mSec.index + 500);
        const mRut2 = bloque.match(/R\.?\s*U\.?\s*T\.?\s*:?\s*(\d{1,3}(?:\.\d{3}){2}\s*-\s*[\dKk])/i)
          || bloque.match(/(\d{1,3}(?:\.\d{3}){2}\s*-\s*[\dKk])/);
        if (mRut2) {
          const r = mRut2[1].replace(/[\.\s]/g, '');
          if (!_esRutEmoac(r)) rutReceptor = r;
        }
      }
    }
    if (!rutReceptor) {
      const todos = [];
      const reRut = /(\d{1,3}(?:\.\d{3}){2}\s*-\s*[\dKk])/g;
      let mm;
      while ((mm = reRut.exec(tN)) !== null) {
        const r = mm[1].replace(/[\.\s]/g, '');
        if (!_esRutEmoac(r)) todos.push(r);
      }
      const unicos = [...new Set(todos)];
      if (unicos.length >= 1) rutReceptor = unicos[0];
    }
  }

  if (codigoCliente) {
    out.fCodigo = codigoCliente;
    out.fRut = rutReceptor || codigoCliente;
  } else if (rutReceptor) {
    out.fRut = rutReceptor;
  }

  // ─── 3) N° FACTURA ───
  {
    const idxSII    = tN.search(/S\.?\s*I\.?\s*I\.?/i);
    const idxNombre = tN.search(/\bNOMBRE\s*:/i);
    const idxPedido = tN.search(/\bPEDIDO\b/i);
    let finCab = tN.length;
    [idxSII, idxNombre, idxPedido].forEach(i => { if (i > 0 && i < finCab) finCab = i; });
    if (finCab > 1500) finCab = 1500;
    const cabecera = tN.slice(0, finCab);

    let numero = '';

    const m1 = cabecera.match(
      /(?:NOTA\s+DE\s+(?:D[EÉ]BITO|CR[EÉ]DITO)|FACTURA)\s+ELECTR[ÓO]NICA[\s\S]{0,80}?N[°ºoO0]?\s*[:\.\-\s]{0,8}0*(\d{1,12})/i
    );
    if (m1) numero = m1[1];

    if (!numero) {
      const m2 = cabecera.match(/N[°ºoO]\s*[:\.\-\s]{0,8}0*(\d{1,12})/);
      if (m2) numero = m2[1];
    }

    if (!numero) {
      const patrones = [
        /(?:FOLIO|N[°ºo]?\s*(?:DE\s*)?FACTURA|FACTURA\s*N[°ºo]?|N[°ºo]?\s*DOCUMENTO|N[°ºo]?\s*DTE|N[°ºo]?\s*INTERNO)\s*:?\s*0*(\d{1,12})/i,
        /\bN[°º]\s*:?\s*0*(\d{1,12})/
      ];
      for (const re of patrones) {
        const m = tN.match(re);
        if (m) { numero = m[1]; break; }
      }
    }

    if (numero && !/^0+$/.test(numero) && !/^(19|20)\d{2}$/.test(numero)) {
      out.fNumero = numero;
    }
  }

  // ─── 4) FECHAS ───
  {
    const _f = _extraerFechasEmiVen(tN);
    out.fEmision = _f.emision;
    out.fVencimiento = _f.vencimiento;
  }

  // ─── 5) PREPROCESADO DE LA TABLA DE CARGOS ───
  let t = t0;
  t = t.replace(/([A-Za-zÁÉÍÓÚÑáéíóúñ])(\d)/g, '$1 $2');
  t = t.replace(/(\d)([A-Za-zÁÉÍÓÚÑáéíóúñ])/g, '$1 $2');

  // ─── 6) PERÍODO ───
  const MESES_TXT = {
    ENERO: '01', FEBRERO: '02', MARZO: '03', ABRIL: '04', MAYO: '05', JUNIO: '06',
    JULIO: '07', AGOSTO: '08', SEPTIEMBRE: '09', SETIEMBRE: '09',
    OCTUBRE: '10', NOVIEMBRE: '11', DICIEMBRE: '12'
  };
  {
    const mPer = tN.match(/\/\s*(ENERO|FEBRERO|MARZO|ABRIL|MAYO|JUNIO|JULIO|AGOSTO|SEPTIEMBRE|SETIEMBRE|OCTUBRE|NOVIEMBRE|DICIEMBRE)\s+(\d{4})/i);
    if (mPer) {
      const mes = MESES_TXT[mPer[1].toUpperCase()];
      if (mes) out.fPeriodo = mPer[2] + '-' + mes;
    }
    if (!out.fPeriodo) {
      const mPer2 = tN.match(/per[ií]odo\s*:?\s*(\d{2})[\-\/](\d{4})/i);
      if (mPer2) out.fPeriodo = mPer2[2] + '-' + mPer2[1];
    }
  }

  // ─── 7) MONTOS — por códigos 691xxx ───
  //  Simplificación: los montos de 691041 ("OTROS DX" / "ARRIENDO
  //  MEDIDOR") se suman DIRECTAMENTE a fPeaje. El flag tieneArriendo
  //  sólo sirve para clasificar el fTipo cuando la factura contiene
  //  ese único cargo.
  const SUM = { '691020': 1, '691021': 1, '691024': 1, '691035': 1, '691036': 1 };
  const LEGALES = { '691023': 1, '691034': 1 };
  const PEAJE = { '691029': 1, '691030': 1, '691032': 1, '691038': 1, '691039': 1 };
  const COD_691041 = { '691041': 1 };
  const INT_SUM = { '691010': 1 };
  const INT_PEAJE = { '691040': 1 };

  let sum = 0, peaje = 0, intSum = 0, intPeaje = 0, kwh = 0;
  let tieneSum = false, tienePeaje = false, tieneArriendo = false;

  const RE_NUM = /\d+(?:[.,]\d+)*/g;
  const codeRe = /691(?:010|020|021|023|024|029|030|032|034|035|036|038|039|040|041)/g;
  const positions = [];
  let mcPos;
  while ((mcPos = codeRe.exec(t)) !== null) positions.push(mcPos.index);
  positions.push(t.length);

  for (let ci = 0; ci < positions.length - 1; ci++) {
    let chunk = t.substring(positions[ci], positions[ci + 1]);
    const corte = chunk.search(
      /\b(Afecto|Exento|IVA|Total[\s:$]|Son\s|Timbre|Verifique|Nota\s+De\s+D|Corrige\s+Montos)/i
    );
    if (corte > 0) chunk = chunk.substring(0, corte);
    const mc = chunk.match(/^(691\d{3})/);
    if (!mc) continue;
    const cod = mc[1];

    RE_NUM.lastIndex = 0;
    const nums = [];
    let mm;
    while ((mm = RE_NUM.exec(chunk)) !== null) nums.push(mm[0]);
    if (nums.length < 2) continue;
    const total = _inputANumero(nums[nums.length - 1]);

    if (SUM[cod] || LEGALES[cod]) { sum += total; tieneSum = true; }
    else if (PEAJE[cod]) { peaje += total; tienePeaje = true; }
    else if (COD_691041[cod]) {
      // ────────────────────────────────────────────────────────────
      //  REGLA DE NEGOCIO — 691041 (EMOAC)
      // ────────────────────────────────────────────────────────────
      //  El monto va SIEMPRE a fPeaje.
      //
      //  ⚠ IMPORTANTE — 691041 NO es siempre "Arriendo Medidor":
      //    · "OTROS DX ..."        → cargo genérico de distribución.
      //    · "ARRIENDO DE MEDIDOR" → arriendo propiamente tal.
      //    · Sólo se activa tieneArriendo si el TEXTO lo dice
      //      EXPLÍCITAMENTE. Eso permite clasificar la factura como
      //      ARRIENDO_MEDIDOR cuando ese es el único cargo.
      //    · En cualquier otro caso, la factura se clasifica como
      //      PEAJE (tienePeaje = true).
      // ────────────────────────────────────────────────────────────
      peaje += total;
      const esArriendoMedidor = /ARRIENDO\s*(DE\s*)?MEDIDOR/i.test(chunk);
      if (esArriendoMedidor) tieneArriendo = true;
      else                   tienePeaje    = true;
      _logDiag('[EMOAC] 691041 → peaje=' + total +
        ' · esArriendoMedidor=' + esArriendoMedidor +
        ' · chunk=' + JSON.stringify(chunk.slice(0, 160)));
    }
    else if (INT_SUM[cod]) { intSum += total; }
    else if (INT_PEAJE[cod]) { intPeaje += total; }

    if ((cod === '691020' || cod === '691030') && !kwh) {
      const mK = chunk.match(/(\d{1,3}(?:\.\d{3})*(?:,\d+)?)\s*KWH/i);
      if (mK) kwh = _inputANumero(mK[1]);
    }
  }

  // ─── 8) TOTAL ───
  let totalPagar = 0;
  {
    let zonaPag1 = tN;
    const idxSon    = tN.search(/\bSon\s+[A-ZÁÉÍÓÚÑ\s]+\s+Pesos\s+chilenos/i);
    const idxTimbre = tN.search(/Timbre\s+Electr[oó]nico|Res\.\s*80\s+del/i);
    const cortes = [idxSon, idxTimbre].filter(x => x > 0);
    if (cortes.length) zonaPag1 = tN.slice(0, Math.min(...cortes));

    const m1 = zonaPag1.match(/\bTotal\s*[:\-]?\s*\$+\s*([\d\.]+(?:,\d+)?)/i);
    if (m1) {
      const n = _inputANumero(m1[1]);
      if (n >= 100000 && !(n >= 690000 && n <= 692000)) totalPagar = n;
    }

    if (!totalPagar) {
      const m2 = zonaPag1.match(/\bTotal\s*a\s*pagar\s*[:\-]?\s*\$+\s*([\d\.]+(?:,\d+)?)/i);
      if (m2) {
        const n = _inputANumero(m2[1]);
        if (n >= 100000 && !(n >= 690000 && n <= 692000)) totalPagar = n;
      }
    }

    if (!totalPagar) {
      totalPagar = _numeroEnPalabrasAPeso(tN);
    }
  }

  // ─── Fallback 691041 por ETIQUETA ───
  //  Si el loop por código no capturó nada para 691041 (código
  //  garabateado por OCR), se busca la etiqueta literal.
  {
    const yaHay691041 = /691041/.test(t);
    if (!yaHay691041) {
      const _rxEtiqueta = /(?:ARRIENDO\s+(?:DE\s+)?MEDIDOR|OTROS\s+DX)/i;
      const _mEt = tN.match(_rxEtiqueta);
      if (_mEt) {
        const _idxEt = _mEt.index;
        const _zonaEt = tN.slice(_idxEt, _idxEt + 400);
        const _corteEt = _zonaEt.search(
          /\b(Afecto|Exento|IVA|Total[\s:$]|Son\s|Timbre|Verifique|Nota\s+De\s+D|Corrige\s+Montos)\b/i
        );
        const _zonaUtil = _corteEt > 20 ? _zonaEt.slice(0, _corteEt) : _zonaEt;

        const _candsEt = (_zonaUtil.match(/\d{1,3}(?:\.\d{3})+(?:,\d+)?|\d{3,}(?:,\d+)?/g) || [])
          .map(n => _inputANumero(n))
          .filter(v => v >= 1000 && v !== 691041);
        if (_candsEt.length) {
          const _montoEt = _candsEt[_candsEt.length - 1];
          peaje += _montoEt;
          if (/ARRIENDO\s*(DE\s*)?MEDIDOR/i.test(_mEt[0])) tieneArriendo = true;
          else tienePeaje = true;
          _logDiag('[EMOAC] 691041 por ETIQUETA "' + _mEt[0] + '": ' + _montoEt +
            ' · sumado a peaje · zona=' + JSON.stringify(_zonaUtil.slice(0, 200)));
        }
      }
    }
  }

  out.fSum = Math.round(sum + intSum);
  out.fPeaje = Math.round(peaje + intPeaje);
  out.fKwh = kwh;
  out.fInt = Math.round(intSum);
  out.fIntPeaje = Math.round(intPeaje);
  out.fTotal = Math.round(totalPagar) || 0;

  out.fTipo = (tieneSum && tienePeaje)      ? 'UNIFICADA'
            : (tieneSum && tieneArriendo)   ? 'SUMINISTRO'
            : (tienePeaje && tieneArriendo) ? 'PEAJE'
            : (tieneArriendo)               ? 'ARRIENDO_MEDIDOR'
            : (tienePeaje)                  ? 'PEAJE'
            :                                 'SUMINISTRO';

  if (!out.fPeriodo && out.fEmision) out.fPeriodo = out.fEmision.slice(0, 7);

  return out;
}

function _parsearAciertaDTE(textoOriginal) {
  const _log = (m) => { try { Logger.log('[Acierta] ' + m); } catch (e) { } };
  const t0 = String(textoOriginal || '');
  const out = { fDTE: true, fEmpresa: 'Acierta' };

  const tN = t0
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/[\u00A0\u1680\u2000-\u200A\u202F\u205F\u3000]/g, ' ')
    .replace(/[\u200B-\u200D\uFEFF]/g, '')
    .replace(/[“”„«»]/g, '"')
    .replace(/[‘’]/g, "'")
    .replace(/[–—−]/g, '-')
    .replace(/[ \t]+/g, ' ');

  // ─── 1) N° FACTURA ───
  try {
    let num = '';
    let m = tN.match(/FACTURA\s+ELECTR[OÓ]NICA[\s\S]{0,150}?\b0*(\d{4,12})\b/i);
    if (m) num = m[1].replace(/^0+/, '');
    if (!num) {
      m = tN.match(/\bN[°ºoO0]\s*[:\.\-]?\s*0*(\d{4,12})\b/i);
      if (m) num = m[1].replace(/^0+/, '');
    }
    if (/^(19|20)\d{2}$/.test(num)) num = '';
    if (/^5[6-9]\d{7,}$/.test(num)) num = '';
    if (num) out.fNumero = num;
  } catch (e) { }

  // ─── 2) RUT / CÓDIGO CLIENTE ───
  try {
    let rut = '';
    let re = /(?<!\d)(\d{1,3}\.\d{3}\.\d{3})\s*-?\s*([\dKk])(?![\d])/g;
    let mm;
    while ((mm = re.exec(tN)) !== null) {
      const r = mm[1].replace(/\./g, '') + '-' + mm[2].toUpperCase();
      if (!_esRutAcierta(r) && !_esRutEmoac(r)) { rut = r; break; }
    }
    if (!rut) {
      re = /(?<!\d)(\d{7,8})\s*-\s*([\dKk])(?![\d])/g;
      while ((mm = re.exec(tN)) !== null) {
        const r = mm[1] + '-' + mm[2].toUpperCase();
        if (!_esRutAcierta(r) && !_esRutEmoac(r)) { rut = r; break; }
      }
    }
    if (rut) { out.fCodigo = rut; out.fRut = rut; }
  } catch (e) { }

  // ─── 3) EMISIÓN / VENCIMIENTO ───
  try {
    const mE = tN.match(/Emisi[oó0]n\s*:?\s*(\d{1,2})\s*[-\/\.]\s*(\d{1,2})\s*[-\/\.]\s*(\d{4})/i);
    if (mE) out.fEmision = mE[3] + '-' +
      String(parseInt(mE[2], 10)).padStart(2, '0') + '-' +
      String(parseInt(mE[1], 10)).padStart(2, '0');

    const mV = tN.match(/Vencimiento\s*:?\s*(\d{1,2})\s*[-\/\.]\s*(\d{1,2})\s*[-\/\.]\s*(\d{4})/i);
    if (mV) out.fVencimiento = mV[3] + '-' +
      String(parseInt(mV[2], 10)).padStart(2, '0') + '-' +
      String(parseInt(mV[1], 10)).padStart(2, '0');
  } catch (e) { }

  // ─── 4) PERÍODO ───
  try {
    const m = tN.match(/periodo\s*:?\s*(\d{2})\s*[-\/]\s*(\d{4})/i);
    if (m) out.fPeriodo = m[2] + '-' + m[1];
    if (!out.fPeriodo && out.fEmision) out.fPeriodo = out.fEmision.slice(0, 7);
  } catch (e) { }

  // ─── 5) MONTOS DEL PIE ───
  let exento = 0, neto = 0, iva = 0, total = 0;
  try {
    const _monto = (etq) => {
      const re = new RegExp(etq + '[\\s\\S]{0,30}?\\$\\s*(\\d{1,3}(?:\\.\\d{3})+(?:,\\d+)?)', 'i');
      const mm = tN.match(re);
      return mm ? _inputANumero(mm[1]) : 0;
    };
    exento = _monto('\\bExento');
    neto   = _monto('\\bNeto\\s*:');
    iva    = _monto('I\\.?\\s*V\\.?\\s*A\\.?');
    total  = _monto('\\bTotal\\s*:');
    if (!neto)  neto  = _monto('\\bNeto');
    if (!total) total = _monto('\\bTotal');
  } catch (e) { }

  // ─── 6) PEAJE ───
  let peaje = 0;
  try {
    const re = /PEAJES?\s*DX([\s\S]{0,80}?)(?=\d+\s*(?:PASS|ENER|POTE|PEAJ)\b|\s*(?:Exento|Neto|I\.?V\.?A\.?|Total)\b|$)/i;
    const m = tN.match(re);
    if (m) {
      const nums = m[1].match(/\d{1,3}(?:\.\d{3})+/g) || [];
      const validos = nums.map(n => _inputANumero(n)).filter(n => n >= 1000);
      if (validos.length) peaje = validos[validos.length - 1];
    }
  } catch (e) { }

  // ─── 7) kWh ───
  let kwh = 0;
  try {
    const m = tN.match(/ENERG[IÍ]A\s*(\d{1,3}(?:\.\d{3})+,\d{1,3})/i);
    if (m) kwh = _inputANumero(m[1]);
    if (!kwh) {
      const m2 = tN.match(/ENERG[IÍ]A\s*(\d{3,}(?:,\d{1,3})?)/i);
      if (m2) kwh = _inputANumero(m2[1]);
    }
  } catch (e) { }

  // ─── 8) SUMINISTRO NETO ───
  let sum = 0;
  try {
    if (neto > 0) sum = neto + exento - peaje;
    else if (total > 0) sum = total - iva - peaje;
    if (sum < 0) sum = 0;
  } catch (e) { }

  out.fSum        = Math.round(sum);
  out.fPeaje      = Math.round(peaje);
  out.fKwh        = kwh;
  out.fTotal      = Math.round(total || (neto + iva + exento));
  out.fInt        = 0;
  out.fIntPeaje   = 0;
  out.fTipo       = (out.fPeaje > 0 && out.fSum > 0) ? 'UNIFICADA'
                  : (out.fPeaje > 0) ? 'PEAJE'
                  : 'SUMINISTRO';

  return out;
}

function _parsearFacturaCompleta(textoOriginal) {
  const t0 = String(textoOriginal || '');
  const proveedor = _detectarProveedor(t0);
  Logger.log('[Router] Proveedor detectado: ' + proveedor);
  try {
    const _charsNoWS = t0.replace(/\s/g, '').length;
    Logger.log('[Router] Texto recibido: ' + t0.length + ' chars (' +
      _charsNoWS + ' no-ws). Preview:\n' + t0.slice(0, 4000));
  } catch (e) { }
  try {
    const r = (proveedor === 'ACIERTA') ? _parsearAciertaDTE(t0) : _parsearEMOACDTE(t0);
    return r || {};
  } catch (e) {
    Logger.log('[Router] ✗ ERROR en ' + proveedor + ': ' + e.message +
      ' | stack: ' + (e.stack || '(sin stack)'));
    return { fDTE: true, fEmpresa: proveedor, _error: String(e.message || e) };
  }
}

