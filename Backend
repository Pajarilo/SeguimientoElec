function _esTextoBasuraBack(txt) {
  if (!txt) return true;
  const s = String(txt);
  const palabras = s.match(/[A-Za-zÁÉÍÓÚÑáéíóúñ]{3,}/g) || [];
  if (palabras.length < 8) return true;
  const unos = (s.match(/(?:^|\s)1(?:\s|$)/g) || []).length;
  if (unos > 30) return true;
  const tokens = s.split(/\s+/).filter(Boolean);
  if (tokens.length > 50) {
    const unosTokens = tokens.filter(t => t === '1').length;
    if (unosTokens / tokens.length > 0.5) return true;
  }
  const rareza = (s.match(/[¢£¤¥¦§¨©ª«¬®¯°±²³´µ¶·¸¹º»¼½¾¿]/g) || []).length;
  if (rareza > 15) return true;
  return false;
}

// ============================================================
//  Detector de "centro fantasma" (Sin asignar / TEMP)
//  Sirve para excluirlo de las hojas de seguimiento y de
//  cualquier listado. NO afecta los datos del Resumen.
// ============================================================
function _esCentroFantasmaBack(codigo, cliente) {
  const c = String(codigo || '').trim().toUpperCase();
  const n = String(cliente || '').trim().toUpperCase();
  if (c === 'TEMP') return true;
  if (c.indexOf('SIN C') === 0) return true;   // "Sin código"
  if (n.indexOf('SIN ASIGNAR') !== -1) return true;
  if (n.indexOf('\u26A0') !== -1) return true; // ⚠
  return false;
}

