function instalarTriggerTransicion() {
  _limpiarTriggersTransicion();
  try {
    ScriptApp.newTrigger(HANDLER_TRANSICION).timeBased().everyHours(1).create();
    try { SpreadsheetApp.getUi().alert('✓ Procesado automático activado (cada 1 hora).'); } catch (e) { }
  } catch (e) {
    try { SpreadsheetApp.getUi().alert('❌ ' + e.message); } catch (e2) { }
  }
}

function desinstalarTriggerTransicion() {
  _limpiarTriggersTransicion();
  try { SpreadsheetApp.getUi().alert('✓ Procesado automático detenido.'); } catch (e) { }
}

