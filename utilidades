function limpiarRegistroPDFsUI() {
  const ui = SpreadsheetApp.getUi();
  const reg = cargarRegistroPDFs();
  const total = Object.keys(reg).length;
  if (!total) { ui.alert('El registro ya está vacío.'); return; }
  const r = ui.alert(
    '🗑️ Limpiar registro',
    'Se borrarán ' + total + ' entradas.\n\nLa próxima ejecución procesará TODOS los PDFs.',
    ui.ButtonSet.YES_NO
  );
  if (r !== ui.Button.YES) return;
  limpiarRegistroPDFs();
  ui.alert('✓ Registro limpiado.');
}

function procesarCarpetaPDFsUI() {
  const ui = SpreadsheetApp.getUi();
  const r1 = ui.prompt('Paso 1/3 — Carpeta', 'Pega la URL o el ID de la carpeta de Drive a procesar.\nSe recorrerán también las subcarpetas.', ui.ButtonSet.OK_CANCEL);
  if (r1.getSelectedButton() !== ui.Button.OK) return;
  const url = r1.getResponseText().trim();
  if (!url) { ui.alert('No se ingresó URL/ID.'); return; }

  const r2 = ui.alert('Paso 2/3 — Cobertura', '¿Deseas OMITIR los PDFs ya procesados?', ui.ButtonSet.YES_NO_CANCEL);
  if (r2 === ui.Button.CANCEL) return;
  const omitirProcesados = (r2 === ui.Button.YES);

  const r3 = ui.alert('Paso 3/3 — Facturas recientes', '¿Deseas OMITIR las facturas procesadas hace menos de 1 día?', ui.ButtonSet.YES_NO_CANCEL);
  if (r3 === ui.Button.CANCEL) return;
  const omitirRecientes = (r3 === ui.Button.YES);

  const _limpieza = _limpiarReintentablesDelRegistro();
  const estado = {
    url: url, modo: 3,
    incluirProcesados: !omitirProcesados,
    reprocesarRecientes: !omitirRecientes,
    reintentablesLimpiados: _limpieza.borradas + _limpieza.rectificadas,
    gemini: !!(GEMINI_API_KEY && String(GEMINI_API_KEY).trim()),
    creado: new Date().toISOString()
  };
  _guardarEstadoPDF(estado);
  _limpiarTriggersPDF();

  let resultado;
  try { resultado = _ejecutarLotePDF(estado); }
  catch (e) {
    Logger.log('❌ procesarCarpetaPDFsUI: ' + e.message + '\n' + (e.stack || '(sin stack)'));
    ui.alert('❌ Error: ' + e.message + '\n\n(Ver > Registros para el detalle)');
    return;
  }

  if (resultado.tiempoAgotado) {
    _programarSiguienteEjecucionPDF();
    try { SpreadsheetApp.getActiveSpreadsheet().toast('⏳ Procesamiento en curso. Siguiente tanda ~1 min.', 'Procesamiento masivo', 15); } catch (e) { }
    return;
  }
  _borrarEstadoPDF();
  _limpiarTriggersPDF();
  const msg = _resumenResultado(resultado, estado) + '\n\n✅ Procesamiento completo.';
  try { ui.alert(msg); }
  catch (e) {
    try { SpreadsheetApp.getActiveSpreadsheet().toast('✅ Procesamiento completo · ' + resultado.ok + ' facturas', 'Procesamiento masivo', 30); } catch (e2) { }
  }
}

function procesarCarpetaTransicionUI() {
  const ui = SpreadsheetApp.getUi();
