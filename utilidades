function _initConfig(sh) {
  sh.clear();
  const hdr = ['Periodo', 'RUT', 'Código', 'Cliente', 'Empalme Suministro', 'Empalme Peaje', 'DriveOp', 'DriveCom', 'Rut (legacy)', 'Empresa', 'Códigos legado'];
  sh.getRange(1, 1, 1, hdr.length).setValues([hdr]);
  sh.getRange(1, 1, 1, hdr.length).setFontWeight('bold').setBackground('#1e293b').setFontColor('#ffffff');
  if (PERIODOS_SEED.length) {
    sh.getRange(2, 1, PERIODOS_SEED.length, 1).setValues(PERIODOS_SEED.map(p => [p]));
    sh.getRange(2, 1, PERIODOS_SEED.length, 1).setNumberFormat('@');
  }
  if (CENTROS_SEED.length) {
    sh.getRange(2, 2, CENTROS_SEED.length, 10).setValues(
      CENTROS_SEED.map(c => [
        c.rut || '', c.codigo || '', c.cliente || '',
        c.empConsumo || '', c.empPeaje || '',
        c.driveOp || '', c.driveCom || '', '',
        c.empresa || 'EMOAC',
        c.codigosLegado || ''         // ← columna K
      ])
    );
  }
  sh.setColumnWidth(1, 100); sh.setColumnWidth(3, 120); sh.setColumnWidth(4, 220);
  sh.setColumnWidth(5, 140); sh.setColumnWidth(6, 140); sh.setColumnWidth(7, 280);
  sh.setColumnWidth(8, 280); sh.setColumnWidth(9, 140); sh.setColumnWidth(10, 120);
  sh.setColumnWidth(11, 220);
  sh.setFrozenRows(1);
}

