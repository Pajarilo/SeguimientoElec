function probarGemini() {
  try {
    if (!GEMINI_API_KEY || !String(GEMINI_API_KEY).trim()) {
      mostrarMensajeSeguro('⚠ GEMINI_API_KEY no configurada.');
      return;
    }
    const url = 'https://generativelanguage.googleapis.com/v1beta/models/' +
      GEMINI_MODEL + ':generateContent?key=' + encodeURIComponent(GEMINI_API_KEY);
    const payload = { contents: [{ parts: [{ text: 'Responde únicamente con la palabra OK.' }] }] };
    const res = UrlFetchApp.fetch(url, {
      method: 'post', contentType: 'application/json',
      payload: JSON.stringify(payload), muteHttpExceptions: true, timeout: 30
    });
    const code = res.getResponseCode();
    const body = res.getContentText();
    if (code !== 200) { mostrarMensajeSeguro('❌ HTTP ' + code + '\n\n' + body.slice(0, 500)); return; }
    const json = JSON.parse(body);
    const txt = (json.candidates && json.candidates[0] && json.candidates[0].content &&
      json.candidates[0].content.parts && json.candidates[0].content.parts[0].text) || '(sin texto)';
    mostrarMensajeSeguro('✓ Gemini OK\n\nModelo: ' + GEMINI_MODEL + '\nRespuesta: ' + txt.trim());
  } catch (e) { mostrarMensajeSeguro('❌ ' + e.message); }
}

function probarParsingUI() {
  const ui = SpreadsheetApp.getUi();
  const r = ui.prompt('Probar parser', 'Pega el texto OCR crudo (se verá en el log de Apps Script):', ui.ButtonSet.OK_CANCEL);
  if (r.getSelectedButton() !== ui.Button.OK) return;
  const texto = r.getResponseText();
  if (!texto) return;
  _diagReset('(texto pegado)');
  const campos = _parsearFacturaCompleta(texto);
  if (campos && campos._error) {
    ui.alert('❌ El parser lanzó un error:\n\n' + campos._error + '\n\nRevisa el log.');
    return;
  }
  _diagIntentar('Parser manual', true, { campos, chars: texto.length, preview: texto });
  _diagReporteFinal(campos, 'Parser manual', _camposSonUtilizables(campos));
  const det = _contarCamposDetectadosBack(campos);
  ui.alert('✓ Parsing ejecutado\n\nCampos detectados: ' + det.total + '/' + det.totalClaves +
    (det.faltantes.length ? '\nFaltan: ' + det.faltantes.join(', ') : '\n¡Completo!') +
    '\n\nRevisa el log (Ver > Registros) para el reporte detallado.');
}

