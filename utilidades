// ─── Asegura que exista la fila fantasma "Sin asignar / Sin código"
//     en la hoja Config antes de procesar un lote masivo. ───
function asegurarCentroTemporal() {
  const CODIGO_TEMP  = 'Sin código';
  const CLIENTE_TEMP = 'Sin asignar';
  const ss = SpreadsheetApp.openById(SS_ID);
  let sh = ss.getSheetByName(HOJA_CONFIG);
  if (!sh) {
    _configCache = null;
    leerConfig();
    sh = ss.getSheetByName(HOJA_CONFIG);
  }
  const lr = Math.max(sh.getLastRow(), 1);
  if (lr >= 2) {
    const vals = sh.getRange(2, 3, lr - 1, 2).getValues();
    for (let i = 0; i < vals.length; i++) {
      const c = String(vals[i][0] || '').trim();
      const n = String(vals[i][1] || '').trim();
      // Reconoce cualquier variante previa (TEMP / ⚠️ Sin asignar / Sin asignar)
      if (_esCentroFantasmaBack(c, n)) {
        _configCache = null;
        return { ok: true, codigo: c || CODIGO_TEMP, cliente: n || CLIENTE_TEMP };
      }
    }
  }
  _asegurarColumnaEmpresa(sh);
  const nextRow = lr + 1;
  sh.getRange(nextRow, 2, 1, 9).setValues([[
    '', CODIGO_TEMP, CLIENTE_TEMP, '', '', '', '', '', 'EMOAC'
  ]]);
  _configCache = null;
  return { ok: true, codigo: CODIGO_TEMP, cliente: CLIENTE_TEMP };
}

// ─── Rectifica TODOS los campos de una factura existente a partir de
//     los datos extraídos por el parser. No toca F.Recep Consumo /
//     F.Recep Peaje salvo que el caller las pase explícitamente. ───
function actualizarFacturaDesdePDF(datos, idDrive, tsProcesado) {
  if (!datos || !datos.numero) return { ok: false, error: 'Falta el N° de factura' };
  const sh = SpreadsheetApp.openById(SS_ID).getSheetByName(HOJA_RESUMEN);
  const data = sh.getDataRange().getValues();
  const numBuscado = String(datos.numero).trim();
  const tipoNuevo  = String(datos.tipo || '').toUpperCase();

  // ─── Localizar la fila por N° Factura (identificador único) ───
  let fila = -1;
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][COL.NUMERO - 1]).trim() === numBuscado) { fila = i + 1; break; }
  }
  if (fila === -1) return { ok: false, error: 'Factura no encontrada: ' + numBuscado };

  const campos = [];
  const _track = (col, fn) => { if (fn()) campos.push(col); };

  if (['SUMINISTRO','PEAJE','UNIFICADA','ARRIENDO_MEDIDOR'].indexOf(tipoNuevo) !== -1) {
    sh.getRange(fila, COL.TIPO).setValue(tipoNuevo); campos.push(COL.TIPO);
  }

  // Centro de costo también se rectifica.
  // ─── Rectificación de cliente / código ─────────────────────────
  //  Si el llamador envía `cliente` (aunque sea "") se actualiza el
  //  cliente, y se actualiza el código en el mismo paso (incluso a
  //  vacío, para evitar que un código viejo quede huérfano cuando el
  //  centro destino no tiene código). Si `cliente` viene vacío, no se
  //  toca el centro: el llamador indicó que no hay info para decidir.
  if (datos.cliente) {
    const cCli = sh.getRange(fila, COL.CLIENTE);
    cCli.setValue(String(datos.cliente).trim());
    campos.push(COL.CLIENTE);

    const cCod = sh.getRange(fila, COL.CODIGO);
    const codNuevo = String(datos.codigo || '').trim();
    cCod.setValue(codNuevo).setNumberFormat('@');
    campos.push(COL.CODIGO);
  }

  // Período: setValue con formato texto para no perder ceros.
  if (datos.periodo && /^\d{4}-\d{2}$/.test(String(datos.periodo).trim())) {
    const c = sh.getRange(fila, COL.PERIODO);
    c.setValue(String(datos.periodo).trim());
    c.setNumberFormat('@');
    campos.push(COL.PERIODO);
  }

  _track(COL.KWH,         () => _setCeldaNum(sh, fila, COL.KWH,         datos.kwh));
  _track(COL.SUM,         () => _setCeldaNum(sh, fila, COL.SUM,         datos.sum));
  _track(COL.PEAJE,       () => _setCeldaNum(sh, fila, COL.PEAJE,       datos.peaje));
  _track(COL.INT,         () => _setCeldaNum(sh, fila, COL.INT,         datos.intereses));
  _track(COL.INT_PEAJE,   () => _setCeldaNum(sh, fila, COL.INT_PEAJE,   datos.intPeaje));
  _track(COL.TOTAL,       () => _setCeldaNum(sh, fila, COL.TOTAL,       datos.total));
  _track(COL.FECHA_EMISION, () => _setCeldaFecha(sh, fila, COL.FECHA_EMISION, datos.fechaEmision));
  _track(COL.FECHA_VENC,    () => _setCeldaFecha(sh, fila, COL.FECHA_VENC,    datos.fechaVencimiento));

  // ⚠ F.Recep Consumo / F.Recep Peaje: sólo se escriben si el caller las
  //   pasa EXPLÍCITAMENTE y no vacías. El procesador masivo pasa '' para
  //   ambas, por lo que nunca pisa una fecha ya registrada por el usuario.
  if (datos.fechaConsumo != null && datos.fechaConsumo !== '') {
    _track(COL.FECHA_SUMINISTRO, () => _setCeldaFecha(sh, fila, COL.FECHA_SUMINISTRO, datos.fechaConsumo));
  }
  if (datos.fechaPeaje != null && datos.fechaPeaje !== '') {
    _track(COL.FECHA_PEAJE, () => _setCeldaFecha(sh, fila, COL.FECHA_PEAJE, datos.fechaPeaje));
  }

  let idFinal = '';
  if (idDrive) {
    const c = sh.getRange(fila, COL.PDF_ID);
    c.setValue(String(idDrive).trim()).setNumberFormat('@');
    idFinal = idDrive; campos.push(COL.PDF_ID);
  }

  const cTs = sh.getRange(fila, COL.PROCESADO_MASIVO);
  cTs.setValue(tsProcesado instanceof Date ? tsProcesado : new Date());
  cTs.setNumberFormat('yyyy-mm-dd hh:mm');
  campos.push(COL.PROCESADO_MASIVO);

  return { ok: true, fila: fila, campos: campos, idDrive: idFinal };
}

// ─── Lee la fila de una factura por N° y devuelve su PDF_ID y
//     timestamp de procesamiento. Usado para decidir si hay que
//     reemplazar el PDF o sólo rectificar los campos. ───
function obtenerInfoFactura(numero, tipo) {
  if (!numero) return { ok: false, error: 'Falta N° de factura' };
  const sh = SpreadsheetApp.openById(SS_ID).getSheetByName(HOJA_RESUMEN);
  if (!sh) return { ok: false, error: 'No existe hoja Resumen' };
  const data = sh.getDataRange().getValues();
  const numBuscado = String(numero).trim();
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][COL.NUMERO - 1]).trim() !== numBuscado) continue;
    const fila = i + 1;
    const pdfId = String(data[i][COL.PDF_ID - 1] || '').trim();
    const tsRaw = data[i][COL.PROCESADO_MASIVO - 1];
    const ts = (tsRaw instanceof Date && !isNaN(tsRaw.getTime())) ? tsRaw : null;
    return { ok: true, fila: fila, pdfId: pdfId, procesadoMasivo: ts };
  }
  return { ok: false, error: 'Factura no encontrada' };
}

// ─── Setters genéricos usados por actualizarFacturaDesdePDF ───
function _setCeldaNum(sh, fila, col, val) {
  if (val === undefined || val === null || val === '') return false;
  const n = Number(val);
  if (!isFinite(n) || n <= 0) return false;
  sh.getRange(fila, col).setValue(n);
  return true;
}
function _setCeldaFecha(sh, fila, col, iso) {
  if (!iso) return false;
  const s = String(iso).trim();
  const c = sh.getRange(fila, col);
  if (SENTINELAS.indexOf(s) !== -1) {
    c.setNumberFormat('@');
    c.setValue(s);
    return true;
  }
  if (!/^\d{4}-\d{2}-\d{2}$/.test(s)) return false;
  const p = s.split('-').map(Number);
  c.setNumberFormat('dd/mm/yyyy');
  c.setValue(new Date(p[0], p[1] - 1, p[2]));
  return true;
}
function _setCeldaTexto(sh, fila, col, val) {
  if (val === undefined || val === null) return false;
  const s = String(val).trim();
  if (!s) return false;
  sh.getRange(fila, col).setValue(s).setNumberFormat('@');
  return true;
}